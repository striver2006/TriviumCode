# ==============================================================================
# TriviumCode - 环境配置模板 (.env.example)
# 请复制本文件为 .env，并填入您的真实 API 密钥。切勿将包含私钥的 .env 文件提交到 Git！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 智谱 ZCode (Zhipu BigModel / ZCode Agent)
# ------------------------------------------------------------------------------
# 格式为: {API Key ID}.{secret}，注意中间有且仅有一个英文字符句点
ZCODE_API_KEY=your_zcode_api_key_id.your_zcode_secret
# 可选：指定 ZCode 使用的特定大模型 (如 glm-4-plus, glm-4-air, glm-4-flash)
ZCODE_MODEL=glm-4-plus

# ------------------------------------------------------------------------------
# 2. Google Antigravity (Gemini / Antigravity Agent)
# ------------------------------------------------------------------------------
# Antigravity 默认读取本机 Keyring / agy 自身登录态；
# 若需在容器或脚本中显式指定，可在此填入：
# ANTIGRAVITY_API_KEY=your_google_antigravity_or_gemini_key
# 可选：指定 Antigravity 使用的大模型 (如 gemini-2.5-pro, gemini-2.5-flash)
ANTIGRAVITY_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 3. Claude Code (Anthropic)
# ------------------------------------------------------------------------------
# Claude Code 默认读取官方登录会话或系统环境变量：
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-3-7-sonnet-latest

# ------------------------------------------------------------------------------
# 4. 流水线留痕与工件目录配置
# ------------------------------------------------------------------------------
# 审核工件与留痕归档根路径 (默认为项目根目录下的 .reviews)
REVIEW_ARTIFACTS_DIR=.reviews
