{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "criteria_version",
    "diagnostic_only",
    "raw_value_comparison",
    "old_complete_config_sha256",
    "current_complete_config_sha256",
    "changes",
    "components",
    "source_refs",
    "configuration_consumption_refs",
    "criteria_approval_ref",
    "applicable_diagnostic",
    "reasons",
    "can_prove",
    "cannot_prove",
    "changes_canonical_original_status",
    "hops",
    "chain_reconstruction_verified",
    "reconstructed_old_is_original_sample"
  ],
  "properties": {
    "schema": {
      "const": "auth-timestamp-chain.v2"
    },
    "criteria_version": {
      "const": "auth-cache-timestamp-applicability-v1"
    },
    "diagnostic_only": {
      "const": true
    },
    "raw_value_comparison": {
      "type": "boolean"
    },
    "old_complete_config_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_complete_config_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "expected",
          "observed"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "expected": {},
          "observed": {}
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "configuration_consumption_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "criteria_approval_ref": {
      "type": "null"
    },
    "applicable_diagnostic": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "can_prove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cannot_prove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_canonical_original_status": {
      "const": false
    },
    "chain_reconstruction_verified": {
      "type": "boolean"
    },
    "reconstructed_old_is_original_sample": {
      "const": false
    },
    "hops": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "observation_ref",
          "old_complete_config_sha256",
          "current_complete_config_sha256",
          "raw_value_comparison",
          "changes",
          "applicable_diagnostic"
        ],
        "properties": {
          "observation_ref": {
            "$ref": "#/$defs/ref"
          },
          "old_complete_config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "current_complete_config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_value_comparison": {
            "type": "boolean"
          },
          "changes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "path",
                "old_value",
                "new_value",
                "old_ok",
                "new_ok"
              ],
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "old_value": {
                  "type": "string",
                  "minLength": 1
                },
                "new_value": {
                  "type": "string",
                  "minLength": 1
                },
                "old_ok": {
                  "type": "boolean"
                },
                "new_ok": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "applicable_diagnostic": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applicable_diagnostic": {
            "const": true
          }
        },
        "required": [
          "applicable_diagnostic"
        ]
      },
      "then": {
        "properties": {
          "hops": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32
          },
          "chain_reconstruction_verified": {
            "const": true
          },
          "raw_value_comparison": {
            "const": true
          }
        }
      }
    }
  ]
}
