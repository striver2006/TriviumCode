{
  "targets": [
    "src/trivium/naming.ts",
    "src/trivium/driver-claim.ts",
    "src/trivium/hooks.ts"
  ],
  "suites": [
    "dist/test/test/unit/topic-arg-quoting.test.js"
  ],
  "cases": [
    {
      "id": "M1",
      "desc": "一律不加引号（改前的裸拼形态）",
      "file": "src/trivium/naming.ts",
      "find": "  return SHELL_SAFE_ARG.test(s) ? s : `'${s.replace(/'/g, `'\\\\''`)}'`;\n",
      "replace": "  return s;\n",
      "expect": "dist/test/test/unit/topic-arg-quoting.test.js"
    },
    {
      "id": "M2",
      "desc": "内含单引号的转义写错（只加反斜杠）",
      "file": "src/trivium/naming.ts",
      "find": "  return SHELL_SAFE_ARG.test(s) ? s : `'${s.replace(/'/g, `'\\\\''`)}'`;\n",
      "replace": "  return SHELL_SAFE_ARG.test(s) ? s : `'${s.replace(/'/g, `\\\\'`)}'`;\n",
      "expect": "dist/test/test/unit/topic-arg-quoting.test.js"
    },
    {
      "id": "M3",
      "desc": "白名单内也加引号（现存主题的输出不再逐字不变）",
      "file": "src/trivium/naming.ts",
      "find": "  return SHELL_SAFE_ARG.test(s) ? s : `'${s.replace(/'/g, `'\\\\''`)}'`;\n",
      "replace": "  return `'${s.replace(/'/g, `'\\\\''`)}'`;\n",
      "expect": "dist/test/test/unit/topic-arg-quoting.test.js"
    },
    {
      "id": "M4",
      "desc": "认领命令回退成裸拼",
      "file": "src/trivium/driver-claim.ts",
      "find": "`trivium topic claim --topic ${shellQuoteArg(topic)} --stage",
      "replace": "`trivium topic claim --topic ${topic} --stage",
      "expect": "dist/test/test/unit/topic-arg-quoting.test.js"
    },
    {
      "id": "M5",
      "desc": "失守作废命令回退成裸拼（只有源码护栏能抓）",
      "file": "src/trivium/hooks.ts",
      "find": "`--topic ${shellQuoteArg(g.topic)} --stage ${g.stage} 作废这一轮",
      "replace": "`--topic ${g.topic} --stage ${g.stage} 作废这一轮",
      "expect": "dist/test/test/unit/topic-arg-quoting.test.js"
    }
  ]
}
