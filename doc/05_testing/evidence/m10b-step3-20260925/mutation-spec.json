{
  "targets": [
    "src/trivium/hook-config.ts",
    "src/trivium/preflight.ts",
    "src/trivium/init.ts",
    "src/trivium/cli.ts",
    "src/trivium/review.ts",
    "src/trivium/meta.ts",
    "src/trivium/report.ts"
  ],
  "suites": [
    "dist/test/test/unit/hook-config.test.js",
    "dist/test/test/unit/preflight.test.js",
    "dist/test/test/unit/init.test.js",
    "dist/test/test/unit/run-meta.test.js",
    "dist/test/test/unit/report.test.js",
    "dist/test/test/integration/hooks-command.test.js",
    "dist/test/test/integration/fault-injection.test.js"
  ],
  "cases": [
    {
      "id": "H1",
      "desc": "ZCode 工具名单混进 NotebookEdit ⇒「渲染：zcode-config 形态……」红",
      "file": "src/trivium/hook-config.ts",
      "find": "const ZCODE_HOOK_TOOLS: ReadonlySet<string> = new Set(['Write', 'Edit', 'Bash']);",
      "replace": "const ZCODE_HOOK_TOOLS: ReadonlySet<string> = new Set(['Write', 'Edit', 'Bash', 'NotebookEdit']);",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H2",
      "desc": "超时不换算成 timeoutMs（照搬 timeout 秒）⇒ 渲染用例红",
      "file": "src/trivium/hook-config.ts",
      "find": "...(timeout !== undefined ? { timeoutMs: timeout * 1000 } : {}),",
      "replace": "...(timeout !== undefined ? { timeout } : {}),",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H3",
      "desc": "护栏失效提示仍点名 Claude 的配置文件 ⇒ 渲染用例红",
      "file": "src/trivium/hook-config.ts",
      "find": "? h.command.split(CLAUDE_SETTINGS_MENTION).join(`${targetPath} 中的 TriviumCode Hook`)",
      "replace": "? h.command",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H4",
      "desc": "显式 enabled: false 也被翻回 true（停用态被重跑覆盖）⇒「保留用户已有……显式 enabled: false 不翻回」红",
      "file": "src/trivium/hook-config.ts",
      "find": "    if (hooks['enabled'] === undefined) {",
      "replace": "    if (hooks['enabled'] !== true) {",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H5",
      "desc": "ZCode 在场判定不看 hooks.enabled ⇒「hooks.enabled 不为 true ⇒ false」红",
      "file": "src/trivium/hook-config.ts",
      "find": "    if (!hooks || hooks['enabled'] !== true) return false;\n",
      "replace": "    if (!hooks) return false;\n",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H6",
      "desc": "必需集去掉 pre-bash ⇒「缺 pre-bash 一道 ⇒ false」红（代码双审 r3 后必需集改为四道，本条改写）",
      "file": "src/trivium/hook-config.ts",
      "find": "  { event: 'PreToolUse', name: 'pre-bash' },\n",
      "replace": "",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H7",
      "desc": "有效等级永不降级 ⇒ hook-config 与预检的降级用例红",
      "file": "src/trivium/hook-config.ts",
      "find": "  const present = await hookConfigPresent(projectRoot, agent);",
      "replace": "  const present = true;",
      "expect": "dist/test/test/unit/preflight.test.js"
    },
    {
      "id": "H8",
      "desc": "缺省 Driver 恒打护栏行 ⇒「缺省 Driver、Hook 配置在场 ⇒ 不打这行」红",
      "file": "src/trivium/preflight.ts",
      "find": "    if (driver !== DEFAULT_DRIVER || guard.downgraded) {",
      "replace": "    if (driverAgent !== undefined) {",
      "expect": "dist/test/test/unit/preflight.test.js"
    },
    {
      "id": "H9",
      "desc": "缺省 Driver 降级时不打（回到只看非缺省）⇒「登记 L1 而 Hook 配置不在场 ⇒ 降为 L2」红",
      "file": "src/trivium/preflight.ts",
      "find": "    if (driver !== DEFAULT_DRIVER || guard.downgraded) {",
      "replace": "    if (driver !== DEFAULT_DRIVER) {",
      "expect": "dist/test/test/unit/preflight.test.js"
    },
    {
      "id": "H10",
      "desc": "init 只合并 Claude 形态的一家 ⇒ 集成「init：两家的 Hook 配置一起合并」红",
      "file": "src/trivium/init.ts",
      "find": "  await mergeAllHooks(ctx.projectRoot, path.join(assetRoot, 'hooks/hooks.json'), report, dryRun);",
      "replace": "  await mergeHooks(ctx.projectRoot, path.join(assetRoot, 'hooks/hooks.json'), report, dryRun);",
      "expect": "dist/test/test/integration/hooks-command.test.js"
    },
    {
      "id": "H11",
      "desc": "hooks --agent 忽略指定的家、两家一起写 ⇒ 集成「只写该家的配置，不碰 Claude 的」红",
      "file": "src/trivium/cli.ts",
      "find": "  await mergeAllHooks(ctx.projectRoot, path.join(assetRoot, 'hooks/hooks.json'), report, dryRun, [agent]);",
      "replace": "  await mergeAllHooks(ctx.projectRoot, path.join(assetRoot, 'hooks/hooks.json'), report, dryRun);",
      "expect": "dist/test/test/integration/hooks-command.test.js"
    },
    {
      "id": "H12",
      "desc": "review 不把有效等级写进 run.json ⇒ 集成「缺省（不给 --critics）……」红",
      "file": "src/trivium/review.ts",
      "find": "    ...(driverAgent ? { driverGuardLevel: (await effectiveGuardLevel(ctx.projectRoot, driverAgent)).level } : {}),\n",
      "replace": "",
      "expect": "dist/test/test/integration/fault-injection.test.js"
    },
    {
      "id": "H13",
      "desc": "newRunMeta 缺省补 L1（替没检查过的运行作证）⇒ run-meta「不传不补」红",
      "file": "src/trivium/meta.ts",
      "find": "    ...(i.driverGuardLevel !== undefined ? { driver_guard_level: i.driverGuardLevel } : {}),",
      "replace": "    driver_guard_level: i.driverGuardLevel ?? 'L1',",
      "expect": "dist/test/test/unit/run-meta.test.js"
    },
    {
      "id": "H14",
      "desc": "report 不读 driver_guard_level ⇒「时间线带 Driver（护栏）列」红",
      "file": "src/trivium/report.ts",
      "find": "  base.driverGuardLevel = meta.driver_guard_level ?? null;\n",
      "replace": "",
      "expect": "dist/test/test/unit/report.test.js"
    },
    {
      "id": "H15",
      "desc": "合并不按 gate hook-<name> 识别同一条（重跑叠加、升级不替换）⇒ 幂等与升级用例红",
      "file": "src/trivium/hook-config.ts",
      "find": "      const at = cur.findIndex((c) => [...hookNamesOf(c)].some((n) => mine.has(n)));",
      "replace": "      const at = cur.findIndex((c) => JSON.stringify(c) === sig);",
      "expect": "dist/test/test/unit/init.test.js"
    },
    {
      "id": "H16",
      "desc": "必需集去掉 Stop（代码双审 r3 CODEX-01 的原形）⇒「单独摘掉 Stop 或 pre-commit 也 ⇒ false」红",
      "file": "src/trivium/hook-config.ts",
      "find": "  { event: 'Stop', name: 'stop' },\n",
      "replace": "",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H17",
      "desc": "必需集去掉 pre-commit（CODEX-01）⇒ 同上红",
      "file": "src/trivium/hook-config.ts",
      "find": "  { event: 'PreToolUse', name: 'pre-commit' },\n",
      "replace": "",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H18",
      "desc": "不看 disableAllHooks（GLM-01 ①的原形）⇒「disableAllHooks……」红",
      "file": "src/trivium/hook-config.ts",
      "find": "    if (disabled) return false;\n",
      "replace": "",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H19",
      "desc": "只看项目层的 disableAllHooks、不认 local 层优先（GLM-01）⇒ 同上红",
      "file": "src/trivium/hook-config.ts",
      "find": "    const disabled = typeof localFlag === 'boolean' ? localFlag : config['disableAllHooks'] === true;",
      "replace": "    const disabled = config['disableAllHooks'] === true;",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H20",
      "desc": "不校验 hooks 键形态（GLM-02 的原形）⇒「嵌套键形态不对……」红",
      "file": "src/trivium/hook-config.ts",
      "find": "    (hooksRaw !== undefined && !isObj(hooksRaw)) ||\n",
      "replace": "    false ||\n",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H21",
      "desc": "ZCode 渲染不校验事件名（GLM-04 的原形）⇒「事件名不在 ZCode 的事件枚举里 ⇒ 当场抛」红",
      "file": "src/trivium/hook-config.ts",
      "find": "    if (!ZCODE_HOOK_EVENTS.has(event)) {",
      "replace": "    if (ZCODE_HOOK_EVENTS.size < 0) {",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H22",
      "desc": "dry-run 仍说「已写入 / 已备份」（CODEX-04 的原形之一）⇒ dry-run 用例红",
      "file": "src/trivium/hook-config.ts",
      "find": "  const done = dryRun ? '将' : '已';",
      "replace": "  const done = '已';",
      "expect": "dist/test/test/unit/hook-config.test.js"
    },
    {
      "id": "H23",
      "desc": "不检测 .gitignore 忽略（CODEX-03 ≡ GLM-05 的原形）⇒「配置被 .gitignore 忽略时如实说……」红",
      "file": "src/trivium/hook-config.ts",
      "find": "  return r.code === 0;",
      "replace": "  return r.code === 12345;",
      "expect": "dist/test/test/unit/hook-config.test.js"
    }
  ]
}
