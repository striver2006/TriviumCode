diff --git a/src/sum.cjs b/src/sum.cjs
index 308dbb8..66e1139 100644
--- a/src/sum.cjs
+++ b/src/sum.cjs
@@ -1,6 +1,11 @@
 'use strict';
-// 初始实现：仅做加法。输入校验需求见 requirements.md。
+// 按 requirements.md 实现输入校验（待审改动：本文件相对基线的 diff 即被审对象）。
 function sum(a, b) {
+  for (const [name, v] of [['a', a], ['b', b]]) {
+    if (typeof v !== 'number' || !Number.isFinite(v)) {
+      throw new TypeError(`sum: 参数 ${name} 必须是有限 number，得到 ${typeof v}`);
+    }
+  }
   return a + b;
 }
 module.exports = { sum };
diff --git a/test/sum.test.cjs b/test/sum.test.cjs
index 2da9ba5..b596ed9 100644
--- a/test/sum.test.cjs
+++ b/test/sum.test.cjs
@@ -2,7 +2,18 @@
 const { test } = require('node:test');
 const assert = require('node:assert/strict');
 const { sum } = require('../src/sum.cjs');
-test('两个正常数相加', () => {
+
+test('正常数（含负数与小数）', () => {
   assert.equal(sum(1, 2), 3);
-  assert.equal(sum(10, 32), 42);
+  assert.equal(sum(-1.5, 0.5), -1);
+});
+test('a 位非法输入拒绝', () => {
+  for (const bad of ['a', NaN, Infinity, -Infinity, true, null, undefined]) {
+    assert.throws(() => sum(bad, 1), /参数 a/, `a=${String(bad)} 应拒绝`);
+  }
+});
+test('b 位非法输入拒绝', () => {
+  for (const bad of ['b', NaN, Infinity, -Infinity, true, null, undefined]) {
+    assert.throws(() => sum(1, bad), /参数 b/, `b=${String(bad)} 应拒绝`);
+  }
 });
