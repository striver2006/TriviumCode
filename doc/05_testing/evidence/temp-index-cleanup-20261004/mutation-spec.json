      "id": "M5",
      "file": "src/trivium/util/git.ts",
      "expect": "dist/test/test/integration/worktree-hash-cleanup.test.js",
      "desc": "删不掉就抛（漂移复算那一处会把运行判 failed）",
      "find": "    if (left && !indexResidueNoticed) {\n",
      "replace": "    if (left) throw new Error('删除失败 ' + left.code);\n    if (left && !indexResidueNoticed) {\n"
