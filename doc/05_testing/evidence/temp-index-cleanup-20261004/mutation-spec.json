    {
      "id": "M6",
      "file": "src/trivium/retention.ts",
      "expect": "dist/test/test/unit/retention.test.js",
      "desc": "到期目录删不掉后 break，后面的目录不再处理",
      "find": "        out.removeFailed.push({ dir, code: left.code });\n",
      "replace": "        out.removeFailed.push({ dir, code: left.code });\n        break;\n"
    },
    {
      "id": "M7",
      "file": "src/trivium/retention.ts",
      "expect": "dist/test/test/unit/retention.test.js",
      "desc": "删不掉后直接 continue，不落回凭据抹除",
      "find": "        out.removeFailed.push({ dir, code: left.code });\n",
      "replace": "        out.removeFailed.push({ dir, code: left.code });\n        continue;\n"
    },
    {
      "id": "M8",
      "file": "src/trivium/retention.ts",
      "expect": "dist/test/test/unit/retention.test.js",
      "desc": "删不掉不记 removeFailed",
      "find": "        out.removeFailed.push({ dir, code: left.code });\n",
      "replace": ""
