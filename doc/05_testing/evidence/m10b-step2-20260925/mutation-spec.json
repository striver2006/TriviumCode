    {
      "id": "U1",
      "desc": "EV-61 原条目：USAGE 的 --only 退回写死两家 ⇒ 帮助文本与注册表对账",
      "file": "src/trivium/cli.ts",
      "find": "      --only ${CRITIC_AGENT_IDS.join('|')}  仅跑一侧。",
      "replace": "      --only gemini|glm  仅跑一侧。",
      "expect": "dist/test/test/integration/usage-registry-parity.test.js"
