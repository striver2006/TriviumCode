      "file": "src/trivium/init.ts",
      "find": "      if (readers.some((a) => a.criticEnabled && a.criticReadsInstructionFiles)) sections.push('critic');",
      "replace": "      if (readers.some((a) => a.criticEnabled)) sections.push('critic');",
