      "file": "src/trivium/gate.ts",
      "desc": "M-later：照传真实后续轮次（loadRoundReviews 的 planFinal）",
      "find": "        planFinal: { subjectRerunIndex: mark.subject_rerun_index, laterSubjectRerunIndexes: [] },\n",
      "replace": "        planFinal: round.planFinal ?? { subjectRerunIndex: mark.subject_rerun_index, laterSubjectRerunIndexes: [] },\n",
