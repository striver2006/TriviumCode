      "file": "src/trivium/gate.ts",
      "desc": "M-stop：最新一次没有裁决件即不复核（不往旧里找）",
      "find": "      if (!disp) continue;\n",
      "replace": "      if (!disp) return { kind: 'skipped' };\n",
      "expect": "dist/test/test/unit/plan-final-recheck.test.js"
    },
    {
