      "replace": "        void codexReadonlyIndeterminateWarning;\n",
      "expect": "dist/test/test/unit/fixture-repo-init.test.js"
    },
    {
      "id": "M7",
      "desc": "probeCodex 不把未判定成因带出",
      "file": "src/trivium/probes/codex.ts",
      "find": "    readonlyIndeterminate = applied.indeterminate;\n",
      "replace": "",
