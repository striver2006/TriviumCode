      "file": "src/trivium/run-protocol.ts",
      "find": "    if (!c || c.kind !== 'run' || (r.reason !== 'pid_gone' && r.reason !== 'pid_reused')) continue;",
      "replace": "    if (!c || (r.reason !== 'pid_gone' && r.reason !== 'pid_reused')) continue;",
