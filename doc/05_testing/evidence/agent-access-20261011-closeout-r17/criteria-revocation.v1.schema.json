{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "decision_id",
    "criterion_version",
    "source_ref",
    "reason",
    "at"
  ],
  "properties": {
    "schema": {
      "const": "criteria-revocation.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_version": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
