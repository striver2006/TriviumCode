{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "criteria_candidate", "diagnostic_only", "model_declared", "actual_provider_inference", "real_model_attempt", "server_identity", "live_reference", "source_fingerprints", "controlled_fingerprints", "explicit_deviations", "bridge", "readonlyArgs", "schema_settings", "target_manifest", "raw_ref", "transport_ref", "cleanup", "mechanism_pass", "reasons", "replaces_original_criteria"],
  "properties": {
    "schema": {"const": "controlled-mechanism.v1"},
    "criteria_candidate": {"const": "restricted-tool-surface-and-path-v2"},
    "diagnostic_only": {"const": true},
    "model_declared": {"type": "string", "minLength": 1},
    "actual_provider_inference": {"const": false},
    "real_model_attempt": {"type": "null"},
    "server_identity": {"type": "null"},
    "live_reference": {"type": ["object", "null"]},
    "source_fingerprints": {"type": "object"},
    "controlled_fingerprints": {"type": "object"},
    "explicit_deviations": {"type": "array", "items": {"type": "string"}},
    "bridge": {"type": "array", "items": {"type": "object", "required": ["pid", "parent_pid", "lstart", "comm", "image", "image_sha256"], "properties": {"pid": {"type": "integer", "minimum": 1}, "parent_pid": {"type": "integer", "minimum": 1}, "lstart": {"type": "string"}, "comm": {"type": "string"}, "image": {"type": "string"}, "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "readonlyArgs": {"type": ["array", "null"], "items": {"type": "string"}},
    "schema_settings": {"type": ["object", "null"]},
    "target_manifest": {"type": "object", "required": ["deny", "targets", "sha256"], "properties": {"deny": {"type": ["array", "null"], "items": {"type": "string"}}, "targets": {"type": ["array", "null"], "items": {"type": "string"}}, "sha256": {"type": ["string", "null"]}}},
    "raw_ref": {"$ref": "#/$defs/ref"},
    "transport_ref": {"$ref": "#/$defs/ref"},
    "cleanup": {"type": "object", "required": ["server_closed", "home_removed", "fixture_removed"], "properties": {"server_closed": {"type": ["boolean", "null"]}, "home_removed": {"type": ["boolean", "null"]}, "fixture_removed": {"type": ["boolean", "null"]}}, "additionalProperties": false},
    "mechanism_pass": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "replaces_original_criteria": {"const": false},
    "writes": {"type": "array", "items": {"type": "object"}},
    "reads": {"type": "array", "items": {"type": "object"}},
    "greps": {"type": "array", "items": {"type": "object"}},
    "global_pairing": {"type": "object"},
    "permission_mode": {"type": ["object", "null"]},
    "tool_surface": {"type": ["object", "null"]},
    "schema_delivery": {"type": ["object", "null"]},
    "sentinel_detection": {"type": ["boolean", "null"]}
  },
  "$defs": {"ref": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}}
}
