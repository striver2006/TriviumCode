      "find": "  const m = CONTEXT_WINDOW_SUFFIX.exec(value);",
      "replace": "  const m = null;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M1b",
      "desc": "同 M1，对集成 E11",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "  const m = CONTEXT_WINDOW_SUFFIX.exec(value);",
      "replace": "  const m = null;",
      "expect": "dist/test/test/integration/claude-gateway-env.test.js"
    },
    {
      "id": "M8",
      "desc": "剥了也白剥：字符集判据改看原值",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "  if (!/^[\\w./:+-]{1,128}$/.test(base)) return false;",
      "replace": "  if (!/^[\\w./:+-]{1,128}$/.test(value)) return false;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M8b",
