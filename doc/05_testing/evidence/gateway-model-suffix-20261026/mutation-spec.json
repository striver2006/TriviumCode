      "find": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`\\[[1-9][0-9]{0,3}[km]\\]`;",
      "replace": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`\\[[^\\]]*\\]`;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M4",
      "desc": "过宽：可剥多个后缀",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`\\[[1-9][0-9]{0,3}[km]\\]`;",
      "replace": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`(?:\\[[1-9][0-9]{0,3}[km]\\])+`;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M5a",
      "desc": "过宽：后缀大小写不敏感",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "  const m = CONTEXT_WINDOW_SUFFIX.exec(value);",
      "replace": "  const m = new RegExp(CONTEXT_WINDOW_SUFFIX.source, 'i').exec(value);",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M5b",
      "desc": "过宽：后缀位数不限、可以 0 开头",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`\\[[1-9][0-9]{0,3}[km]\\]`;",
      "replace": "const CONTEXT_WINDOW_SUFFIX_PATTERN = String.raw`\\[[0-9]+[km]\\]`;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M6",
      "desc": "剥得到后缀就直接放行，跳过其余判据",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "  const base = stripContextWindowSuffix(value);\n  if (!/^[\\w./:+-]{1,128}$/.test(base)) return false;",
      "replace": "  const base = stripContextWindowSuffix(value);\n  if (base !== value) return true;\n  if (!/^[\\w./:+-]{1,128}$/.test(base)) return false;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
