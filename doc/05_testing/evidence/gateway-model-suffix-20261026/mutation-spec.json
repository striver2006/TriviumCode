      "find": "  if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(base)) return false;",
      "replace": "  if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)) return false;",
      "expect": "dist/test/test/unit/claude-gateway-scrub.test.js"
    },
    {
      "id": "M9",
      "desc": "profile 元数据不放行后缀",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "const PROFILE_MODEL_VALUE = String.raw`[\\w.\\/:+-]+(?:${CONTEXT_WINDOW_SUFFIX_PATTERN})?`;",
      "replace": "const PROFILE_MODEL_VALUE = String.raw`[\\w.\\/:+-]+`;",
      "expect": "dist/test/test/unit/access-modes.test.js"
    },
    {
      "id": "M10",
      "desc": "profile 元数据放行任意方括号内容",
      "file": "src/trivium/adapters/claude-route.ts",
      "find": "const PROFILE_MODEL_VALUE = String.raw`[\\w.\\/:+-]+(?:${CONTEXT_WINDOW_SUFFIX_PATTERN})?`;",
      "replace": "const PROFILE_MODEL_VALUE = String.raw`[\\w.\\/:+-]+(?:\\[[^\\]]*\\])?`;",
      "expect": "dist/test/test/unit/access-modes.test.js"
    },
    {
      "id": "M11",
