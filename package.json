{
  "name": "triviumcode",
  "version": "0.1.0",
  "description": "Driver-DualCritic 主攻双审流水线编排器：Claude Code 主攻 + Antigravity/ZCode 背靠背双审",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs --with-tests",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "test:unit": "node --test \"dist/test/test/unit/**/*.test.js\"",
    "check": "npm run typecheck && npm run build && npm test",
    "install:local": "node dist/install.cjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
