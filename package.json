{
  "name": "triviumcode",
  "version": "1.3.4",
  "description": "主攻与多方独立审查流水线编排器，支持四家 Agent、动态选侧与审计留痕",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "render": "node scripts/build.mjs --render-only",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs --with-tests",
    "test": "node scripts/run-tests.mjs \"dist/test/**/*.test.js\"",
    "test:unit": "node scripts/run-tests.mjs \"dist/test/test/unit/**/*.test.js\"",
    "check": "npm run typecheck && npm run build && npm test",
    "install:local": "node dist/install.cjs",
    "install:check": "node scripts/install-check.mjs",
    "release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "typescript": "^5.7.0"
  }
}
