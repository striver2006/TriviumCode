{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trivium.review.v1",
  "title": "TriviumCode 审查结论",
  "description": "两侧审查员共用的输出契约（设计 §6.5）。agy 侧用 --json-schema 强制，zcode 侧用提示词约定 + 解析器校验。",
  "type": "object",
  "required": ["schema", "verdict", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "trivium.review.v1" },
    "verdict": {
      "enum": ["approve", "approve-with-nits", "request-changes", "block"],
      "description": "整体判断"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "不超过 8 行的总判断，先说最危险的一条"
    },
    "findings": {
      "type": "array",
      "description": "空数组合法，表示该侧未发现问题；但元数据会标 empty_review: true，文件照常落盘",
      "items": {
        "type": "object",
        "required": [
          "id", "severity", "layer", "kind",
          "location", "problem", "evidence", "suggestion", "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AGY|GLM)-(r[0-9]+-)?[0-9]{2,}$",
            "description": "编号前缀固定：Antigravity 为 AGY-，ZCode 为 GLM-；重跑时追加轮次如 AGY-r2-01"
          },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "layer": { "enum": ["requirement", "plan", "code", "rca"] },
          "kind": {
            "enum": [
              "correctness", "security", "concurrency", "contract",
              "test-gap", "maintainability", "scope-drift", "performance"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "如 src/auth/oidc.ts:88 或 plan §3.2"
          },
          "problem": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "读了哪些文件/跑了哪些命令/为什么成立。引用的文件必须出现在 consulted 中"
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "description": "修复方向。禁止给出大段可粘贴补丁"
          },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "agreed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "认为正确的部分，防止只挑刺"
    },
    "not_covered": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本次未覆盖的范围，暴露盲区。必填"
    },
    "consulted": {
      "type": "array",
      "items": { "type": "string" },
      "description": "实际读过的项目文件相对路径，与工具轨迹交叉核对（§11.4）"
    }
  }
}
