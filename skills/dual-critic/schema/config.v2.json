{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trivium.config.v2",
  "title": "TriviumCode 项目配置 v2",
  "description": "设计 §13.1 + §13.1.1。v1 保留为历史契约：loadCtx 检测到 v1 会做内存迁移后再校验，磁盘上的旧配置不改也能跑。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "archive_root",
    "topic",
    "runtime",
    "isolation",
    "review",
    "agents",
    "profiles",
    "active_profile",
    "gate",
    "preflight",
    "verify",
    "retention",
    "probe",
    "probe_ttl_days"
  ],
  "properties": {
    "schema": {
      "const": "trivium.config.v2"
    },
    "archive_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.)(?!/).+",
      "description": "项目相对路径，不得逃出项目根"
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_len"
      ],
      "properties": {
        "max_len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "forbid_chars": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "deprecated": true,
          "description": "已废弃（2026-10-08，EV-30 ④）：从未被读取——主题名校验是 naming.ts 的独立实现（禁 / \\ ..、前导点、控制字符与保留后缀），不可配置。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "run_root"
      ],
      "properties": {
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peer_artifact_globs",
        "context_max_docs"
      ],
      "properties": {
        "peer_artifact_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_via_cli": {
          "enum": [
            "auto",
            "off"
          ],
          "deprecated": true,
          "description": "已废弃（2026-10-06，EV-30 ③）：从未被读取——路径级 deny 注不注入只看探针实测（path_deny.supported）。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
        },
        "context_max_docs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_policy",
        "allow_partial_flag",
        "timeout_s",
        "wait_timeout_s",
        "heartbeat_stale_s",
        "retry",
        "cache",
        "min_tool_calls",
        "min_project_reads",
        "on_drift",
        "on_drift_related",
        "sensitive_globs",
        "skip_doc_only_review",
        "skip_globs",
        "never_skip_globs",
        "default_critics",
        "max_critics"
      ],
      "properties": {
        "parallel": {
          "type": "boolean",
          "deprecated": true,
          "description": "已废弃（2026-10-06，EV-30 ②）：从未被读取——审查各侧恒并行；单侧调试用 --critics。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
        },
        "failure_policy": {
          "enum": [
            "strict",
            "degrade"
          ]
        },
        "allow_partial_flag": {
          "type": "boolean",
          "description": "允许部分入选审核者失败后降级续跑。v1 叫 allow_single_flag，旧名长期保留为别名，由 loadCtx 内存迁移搬过来。改名的理由：三审挂一侧后剩两侧，那是 partial 不是 single。"
        },
        "timeout_s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "wait_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heartbeat_stale_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transient_max"
          ],
          "properties": {
            "transient_max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cache": {
          "type": "boolean"
        },
        "min_tool_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "min_project_reads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "on_drift": {
          "enum": [
            "warn",
            "fail"
          ]
        },
        "on_drift_related": {
          "enum": [
            "warn",
            "fail"
          ]
        },
        "sensitive_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_doc_only_review": {
          "type": "boolean"
        },
        "skip_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never_skip_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_critics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "不给 --critics 时的默认审核者集合。每项必须在 agents 里有配置、必须是 criticEnabled 的 Agent、且长度不超过 max_critics——三条都是跨字段约束，schema 表达不了，由 schemas.ts 补校。此处同样不枚举 Agent id（纪律 7）。"
        },
        "max_critics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "单次运行可选审核者的基数上限（FR-29：1～3）。"
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "description": "逐 Agent 的配置段，键是注册表的 Agent id。键只要求「是已登记 Agent」，不要求 criticEnabled——Driver 自身也需要配置容身之处（设计 13.1.1）。键是否已登记、vendor 是否与注册表相符，由 schemas.ts 在 ajv 之后按注册表补校：Agent 身份的唯一来源是注册表（纪律 7），在 schema 里抄第二份，新增一家时改一漏二不会报错。值以 vendor 为判别式做可辨识联合——两家字段集合完全不同，压成同构 record 会让校验形同虚设。codex 的形状于 M8 第 3 步加入 oneOf，claude 于 M9 第 4 步加入——四家至此全部就位。**副作用**：schemas.ts 的 configurableVendors() 从本处现取判别式，四支齐备后「已登记但形状未定义」变成空集，那条报错分支随之不可达。",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "bin",
              "agent",
              "effort"
            ],
            "properties": {
              "vendor": {
                "const": "antigravity"
              },
              "bin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agent": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan",
                  "code",
                  "bug"
                ],
                "properties": {
                  "plan": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "code": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "bug": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              },
              "readonly_commands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "deprecated": true,
                "description": "已废弃（2026-10-01，EV-15）：从未被读取，agy 侧工具面里没有命令工具。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
              },
              "tiers": {
                "$ref": "#/$defs/tiersCommon"
              },
              "default_tier": {
                "$ref": "#/$defs/tierName"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "entry"
            ],
            "properties": {
              "vendor": {
                "const": "zcode"
              },
              "entry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_turns": {
                "type": "integer",
                "minimum": 1,
                "deprecated": true,
                "description": "已废弃（2026-10-08，EV-30 ⑥）：从未被读取——zcode 0.16.5 拒绝 --max-turns（M0 坑清单 C-01），无处可接。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
              },
              "unsupported_override": {
                "enum": [
                  "reject",
                  "annotate"
                ],
                "deprecated": true,
                "description": "已废弃（2026-10-08，EV-30 ⑦）：从未被读取——实际模型与请求不同时由 model_unenforced 在 run.json 与 guard 播报里标注、不阻断；设 reject 也不会拒跑。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
              },
              "tiers": {
                "$ref": "#/$defs/tiersModelOnly"
              },
              "default_tier": {
                "$ref": "#/$defs/tierName"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "bin",
              "profile"
            ],
            "properties": {
              "vendor": {
                "const": "openai"
              },
              "bin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "profile": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "厂商 profile 名，对应 $CODEX_HOME/<name>.config.toml（0.154.0 的 -p 是文件分层，不是 config.toml 里的 [profiles.*] 段）。它同时是「模型属于哪个 provider 家族」的唯一判定依据——实测 model_provider 随 -p 走，按模型 slug 前缀猜家族会随目录命名漂移。"
              },
              "effort": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan",
                  "code",
                  "bug"
                ],
                "properties": {
                  "plan": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "code": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "bug": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "deprecated": true,
                "description": "已废弃（2026-10-07，M11 第 4 步，设计 11.5）：从未被读取（effortFor 只给 antigravity 取值），且 low/medium/high 统一枚举违反 11.5 禁令 ①。保留属性与原类型约束只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。思考等级改由档位条目的 effort 表达。"
              },
              "tiers": {
                "$ref": "#/$defs/tiersOpenai"
              },
              "default_tier": {
                "$ref": "#/$defs/tierName"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor"
            ],
            "properties": {
              "vendor": {
                "const": "anthropic"
              },
              "tiers": {
                "$ref": "#/$defs/tiersCommon"
              },
              "default_tier": {
                "$ref": "#/$defs/tierName"
              }
            },
            "description": "claude 的配置段（M9 第 4 步）。**只有判别式，没有其它字段**——这是刻意的不对称，不是漏写。另三家段里的入口覆盖（gemini/codex 的 bin、glm 的 entry）都有真实消费方（doctor.ts 传给各自探针、adapters/codex.ts 取 cfg.bin ?? probe.entrypoint）；claude 侧的入口由探针独占——适配器的 run 与 authProbe 都读 probe.cli.claude.entrypoint，doctor 调 probeClaude 时第一个参数逐字传 null。加 bin 即加死字段，而本仓已有两条「登记而无消费方」的未结条目（EV-06 / EV-15），其危害是让后来者以为该字段已经生效。阶段级 effort 不加：M6 探针当时没有对应旗标；M11 第 1 步实测 2.1.291 已有 --effort 但不校验、不回读（设计 3.7），思考等级由 tiers 的 effort 表达，M11 第 6 步起经 --effort 透传，取值集合由探针解析帮助文本落盘（probe.cli.claude.effort_levels）。真需要本机入口覆盖时再放宽本支是向后兼容的，反向删字段不是。"
          }
        ]
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "description": "档位表，键是 Agent id。逐阶段的值有三形态（设计 11.5，M11 第 4 步放开）：裸 slug ｜ {tier} ｜ {model, effort}，见 $defs/stageModel。M7b 只收裸 slug，理由是当时拿不到模型的形态「schema 合法、运行期必然失败」；放开后由预检与 review 准备阶段的「档位组合合法」与「模型 slug 合法」两格守住（未定义的档、原生枚举外的 effort 等退 64、零工件；解析不出模型同样退 64——v1.3.131 前此处误记为 69）。Agent 级 effort 键无读取点，见 BACKLOG。",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "$ref": "#/$defs/stageModel"
            },
            "code": {
              "$ref": "#/$defs/stageModel"
            },
            "bug": {
              "$ref": "#/$defs/stageModel"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      }
    },
    "active_profile": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_defer",
        "block_business_write_when_awaiting_approval",
        "approval_lock_scope",
        "approval_lock_ttl_h",
        "block_commit",
        "stop_hook_max_blocks",
        "reason_policy",
        "joint_blocker_policy"
      ],
      "properties": {
        "require_adjudication": {
          "type": "boolean",
          "deprecated": true,
          "description": "已废弃（2026-10-08，EV-30 ⑤）：从未被读取——闸门恒强制逐条裁决，设 false 不放松任何检查。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
        },
        "allow_defer": {
          "type": "boolean"
        },
        "block_business_write_when_awaiting_approval": {
          "type": "boolean"
        },
        "approval_lock_scope": {
          "enum": [
            "session",
            "global"
          ]
        },
        "approval_lock_ttl_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "block_commit": {
          "type": "boolean"
        },
        "stop_hook_max_blocks": {
          "type": "integer",
          "minimum": 1,
          "description": "0 会让 count > 0 恒真，收工拦截一次都不生效"
        },
        "max_check_retries": {
          "type": "integer",
          "minimum": 0,
          "deprecated": true,
          "description": "已废弃（2026-10-01，EV-30 ①）：从未被读取——gate --check 重跑几次是入口命令正文里的流程约定，不是配置项。保留属性只为带着它的旧配置照常通过校验；出现时 doctor / preflight 提示一条，可从配置里去掉。"
        },
        "reason_policy": {
          "enum": [
            "warn",
            "hard"
          ]
        },
        "joint_blocker_policy": {
          "enum": [
            "warn",
            "hard"
          ]
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_cache_ttl_h"
      ],
      "properties": {
        "auth_cache_ttl_h": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "test"
      ],
      "properties": {
        "build": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_dir_days"
      ],
      "properties": {
        "run_dir_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probe": {
      "type": "object",
      "description": "由 doctor 实测回填。各家结论按 cliName 索引落在 cli 段——键集的唯一来源是 agents/registry.ts，schema 只校形状、不枚举任何 Agent 身份（纪律 12）。",
      "properties": {
        "cli": {
          "type": "object",
          "description": "按 CLI 名索引的探针结论。additionalProperties 承载共有形状，各家的专属字段由该对象自身的 additionalProperties:true 放行。",
          "additionalProperties": {
            "$ref": "#/$defs/commonProbe"
          }
        }
      },
      "additionalProperties": true
    },
    "probe_ttl_days": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "$defs": {
    "commonProbe": {
      "type": "object",
      "description": "各家探针结论的共有事实。required 是真正的防线：字段拼错（entrypont）在 additionalProperties:true 下不会被拒，但缺了 required 里的正确名字就会——否则错误要潜伏到适配层读取时才以运行期异常爆发（M6 计划双审 AGY-06）。",
      "required": [
        "entrypoint",
        "version",
        "probed_at",
        "models",
        "path_deny",
        "scratch_paths",
        "isolation"
      ],
      "additionalProperties": true,
      "properties": {
        "entrypoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "CLI 可执行入口绝对路径"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "probed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "这一键何时探的；TTL 按它判定"
        },
        "version_probe": {
          "type": [
            "object",
            "null"
          ],
          "description": "怎么再取一次版本。null = 未记录，该侧版本漂移无从检查",
          "required": [
            "runner",
            "args",
            "extract"
          ],
          "additionalProperties": false,
          "properties": {
            "runner": {
              "type": [
                "string",
                "null"
              ],
              "description": "跑 entrypoint 需要的运行时。**当前只识别 'node' 与 null（直接执行）；其它值一律视为未支持**——读侧会把该侧记为「无法校验版本」并在预检输出里点名，而不是静默按直接执行处理。记的是「需要什么运行时」这个事实，不是某个 node 的绝对路径：路径随机器与版本管理器变，落盘会立刻过期。类型层不在此处用 enum 收窄，是为了让盘上的未支持值走「说不认识」而不是被 ajv 拒成格式错误。"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extract": {
              "type": [
                "string",
                "null"
              ],
              "description": "抠版本号的正则，取第 1 捕获组"
            }
          }
