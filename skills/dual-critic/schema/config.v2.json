{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trivium.config.v2",
  "title": "TriviumCode 项目配置 v2",
  "description": "设计 §13.1 + §13.1.1。v1 保留为历史契约：loadCtx 检测到 v1 会做内存迁移后再校验，磁盘上的旧配置不改也能跑。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "archive_root",
    "topic",
    "runtime",
    "isolation",
    "review",
    "agents",
    "profiles",
    "active_profile",
    "gate",
    "preflight",
    "verify",
    "retention",
    "probe",
    "probe_ttl_days"
  ],
  "properties": {
    "schema": {
      "const": "trivium.config.v2"
    },
    "archive_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.)(?!/).+",
      "description": "项目相对路径，不得逃出项目根"
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_len",
        "forbid_chars"
      ],
      "properties": {
        "max_len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "forbid_chars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "run_root"
      ],
      "properties": {
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peer_artifact_globs",
        "deny_via_cli",
        "context_max_docs"
      ],
      "properties": {
        "peer_artifact_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_via_cli": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "context_max_docs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parallel",
        "failure_policy",
        "allow_partial_flag",
        "timeout_s",
        "wait_timeout_s",
        "heartbeat_stale_s",
        "retry",
        "cache",
        "min_tool_calls",
        "min_project_reads",
        "on_drift",
        "on_drift_related",
        "sensitive_globs",
        "block_severities",
        "skip_doc_only_review",
        "skip_globs",
        "never_skip_globs",
        "default_critics",
        "max_critics"
      ],
      "properties": {
        "parallel": {
          "type": "boolean"
        },
        "failure_policy": {
          "enum": [
            "strict",
            "degrade"
          ]
        },
        "allow_partial_flag": {
          "type": "boolean",
          "description": "允许部分入选审核者失败后降级续跑。v1 叫 allow_single_flag，旧名长期保留为别名，由 loadCtx 内存迁移搬过来。改名的理由：三审挂一侧后剩两侧，那是 partial 不是 single。"
        },
        "timeout_s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "wait_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heartbeat_stale_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transient_max"
          ],
          "properties": {
            "transient_max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cache": {
          "type": "boolean"
        },
        "min_tool_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "min_project_reads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "code",
            "bug"
          ],
          "properties": {
            "plan": {
              "type": "number",
              "minimum": 0
            },
            "code": {
              "type": "number",
              "minimum": 0
            },
            "bug": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "on_drift": {
          "enum": [
            "warn",
            "fail"
          ]
        },
        "on_drift_related": {
          "enum": [
            "warn",
            "fail"
          ]
        },
        "sensitive_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "block_severities": {
          "type": "array",
          "items": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          }
        },
        "skip_doc_only_review": {
          "type": "boolean"
        },
        "skip_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never_skip_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_critics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "不给 --critics 时的默认审核者集合。每项必须在 agents 里有配置、必须是 criticEnabled 的 Agent、且长度不超过 max_critics——三条都是跨字段约束，schema 表达不了，由 schemas.ts 补校。此处同样不枚举 Agent id（纪律 7）。"
        },
        "max_critics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "单次运行可选审核者的基数上限（FR-29：1～3）。"
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "description": "逐 Agent 的配置段，键是注册表的 Agent id。键只要求「是已登记 Agent」，不要求 criticEnabled——Driver 自身也需要配置容身之处（设计 13.1.1）。键是否已登记、vendor 是否与注册表相符，由 schemas.ts 在 ajv 之后按注册表补校：Agent 身份的唯一来源是注册表（纪律 7），在 schema 里抄第二份，新增一家时改一漏二不会报错。值以 vendor 为判别式做可辨识联合——两家字段集合完全不同，压成同构 record 会让校验形同虚设。codex / claude 的形状随 M8 / M9 / M10 加入 oneOf。",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "bin",
              "agent",
              "effort",
              "readonly_commands"
            ],
            "properties": {
              "vendor": {
                "const": "antigravity"
              },
              "bin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agent": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan",
                  "code",
                  "bug"
                ],
                "properties": {
                  "plan": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "code": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "bug": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              },
              "readonly_commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "entry",
              "max_turns",
              "unsupported_override"
            ],
            "properties": {
              "vendor": {
                "const": "zcode"
              },
              "entry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_turns": {
                "type": "integer",
                "minimum": 1
              },
              "unsupported_override": {
                "enum": [
                  "reject",
                  "annotate"
                ]
              }
            }
          }
        ]
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "description": "档位表，键是 Agent id。M7b 只接受裸 slug（逐阶段的模型名字符串），不接受 {tier} 或 {model, effort}——现实现拿不到模型即退 69，接受一个「schema 层合法、运行期必然失败」的形态正是本项目反对的。M11 随档位全链路放开。",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "bug": {
              "type": "string"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      }
    },
    "active_profile": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_adjudication",
        "allow_defer",
        "block_business_write_when_awaiting_approval",
        "approval_lock_scope",
        "approval_lock_ttl_h",
        "block_commit",
        "stop_hook_max_blocks",
        "max_check_retries",
        "reason_policy",
        "joint_blocker_policy"
      ],
      "properties": {
        "require_adjudication": {
          "type": "boolean"
        },
        "allow_defer": {
          "type": "boolean"
        },
        "block_business_write_when_awaiting_approval": {
          "type": "boolean"
        },
        "approval_lock_scope": {
          "enum": [
            "session",
            "global"
          ]
        },
        "approval_lock_ttl_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "block_commit": {
          "type": "boolean"
        },
        "stop_hook_max_blocks": {
          "type": "integer",
          "minimum": 1,
          "description": "0 会让 count > 0 恒真，收工拦截一次都不生效"
        },
        "max_check_retries": {
          "type": "integer",
          "minimum": 0
        },
        "reason_policy": {
          "enum": [
            "warn",
            "hard"
          ]
        },
        "joint_blocker_policy": {
          "enum": [
            "warn",
            "hard"
          ]
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_cache_ttl_h"
      ],
      "properties": {
        "auth_cache_ttl_h": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "test"
      ],
      "properties": {
        "build": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_dir_days"
      ],
      "properties": {
        "run_dir_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probe": {
      "type": "object",
      "description": "由 doctor 实测回填，形状随探针演进，这里只要求是对象",
      "additionalProperties": true
    },
    "probe_ttl_days": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
