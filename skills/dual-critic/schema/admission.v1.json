{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trivium.admission.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "trivium.admission.v1"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schema",
    "records"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "case_id"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tested_at": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "pass",
                  "fail",
                  "untested"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                }
              }
            },
            "required": [
              "state",
              "evidence"
            ]
          }
        },
        "deny_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "record_id",
        "agent",
        "project_root",
        "binding_sha256",
        "tested_at",
        "expires_at",
        "checks",
        "deny_paths"
      ]
    }
  }
}
