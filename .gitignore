# ==============================================================================
# TriviumCode - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 敏感凭据与本地环境配置 (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
credentials.json

# ------------------------------------------------------------------------------
# 操作系统缓存工件
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDE 与编辑器配置
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# AI 辅助编程与编辑器会话工件
.zcode/
.cursor/
.windsurf/

# Claude Code：忽略个人状态，但保留随仓库分发的 Hook 配置（设计 5.3 / 审核意见 RV-06）
.claude/*
!.claude/settings.json
.claude/settings.local.json

# VS Code (保留工作区推荐插件与通用配置，忽略个人状态)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# ------------------------------------------------------------------------------
# 运行时缓存与依赖库
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
package-lock.json.bak

# TriviumCode 构建产物（esbuild，设计 5.2：不进 Git）
/dist/
skills/dual-critic/scripts/trivium.cjs

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 临时与日志文件
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 多智能体协同流水线工件
# 保持审计文档(.md)与变更补丁(.patch)留痕入库，忽略临时运行锁与中间缓存
# ------------------------------------------------------------------------------
.reviews/*.lock
.reviews/*.tmp
.reviews/*.cache

# ------------------------------------------------------------------------------
# TriviumCode 编排器运行时目录 (.trivium/)
# config.yaml 为团队共享策略，进 Git；其余为本机状态与探针结论，不进 Git
# 由 `trivium init` 幂等写入，见设计 5.3 / protocol/gitignore.snippet
# ------------------------------------------------------------------------------
.trivium/bin/
.trivium/logs/
.trivium/lock/
.trivium/state.json
.trivium/config.local.yaml
# 版本迁移时 init 留下的原文备份（含本机注释，属一次性产物，不进 Git）
.trivium/*.trivium-backup

# 变异验证的原文备份。
# **兜底而非主手段**：变异脚本已改为把备份落在仓外（scratchpad），这条只防脚本被改回原地备份。
# 2026-09-15 M8 第 1 步：两份 .mutbak 真的漏进了送审补丁（581 行，两侧审查各逮一次），
# 其中一份还是修 /private 归一之前的**缺陷版**实现——入仓会让读者看到两份实现、其一已知是错的。
*.mutbak
