# ==============================================================================
# TriviumCode - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 敏感凭据与本地环境配置 (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
credentials.json

# ------------------------------------------------------------------------------
# 操作系统缓存工件
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDE 与编辑器配置
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# AI 辅助编程与编辑器会话工件（各家在项目内的本机配置目录；skill 入口装在用户级，不进项目）
.zcode/
.gemini/
.cursor/
.windsurf/
# Codex 项目内本机配置与会话工件
/.codex/

# Claude Code：本仓不随 Git 分发 Hook 配置——每台机器自己跑 trivium init（settings.json 是本机产物，
# 且 Windows/macOS 各渲染各的形态，入库会来回翻）。不要改写成裸 `.claude/` 行：trivium init 见到那种
# 整体忽略写法会改回白名单（init.ts 的 gitignore 修正，审核意见 RV-06）；`.claude/*` 不触发它。
.claude/*

# VS Code (保留工作区推荐插件与通用配置，忽略个人状态)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# ------------------------------------------------------------------------------
# 运行时缓存与依赖库
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
package-lock.json.bak

# TriviumCode 构建产物（esbuild，设计 5.2：不进 Git）
/dist/
skills/dual-critic/scripts/trivium.cjs
# 发布物：缺省不入库（2026-10-24 双平台统一）；2026-10-27 起正式包按版本放进 releases/<x.y.z>/ 入库，
# 便于两台机器之间传包上传 Release——只放开版本子目录，releases/ 根下的临时产物照旧忽略
/releases/*
!/releases/README.md
!/releases/[0-9]*.[0-9]*.[0-9]*/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 临时与日志文件
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 多智能体协同流水线工件
# 保持审计文档(.md)与变更补丁(.patch)留痕入库，忽略临时运行锁与中间缓存
# ------------------------------------------------------------------------------
.reviews/*.lock
.reviews/*.tmp
.reviews/*.cache

# ------------------------------------------------------------------------------
# TriviumCode 编排器运行时目录 (.trivium/)
# config.yaml 为团队共享策略，进 Git；其余为本机状态与探针结论，不进 Git
# 由 `trivium init` 幂等写入，见设计 5.3 / protocol/gitignore.snippet
# ------------------------------------------------------------------------------
.trivium/bin/
.trivium/logs/
.trivium/lock/
.trivium/state.json
.trivium/config.local.yaml
.trivium/admission.local.json
# 版本迁移时 init 留下的原文备份（含本机注释，属一次性产物，不进 Git）
.trivium/*.trivium-backup

# 变异验证的原文备份。
# **兜底而非主手段**：变异脚本已改为把备份落在仓外（scratchpad），这条只防脚本被改回原地备份。
# 2026-09-15 M8 第 1 步：两份 .mutbak 真的漏进了送审补丁（581 行，两侧审查各逮一次），
# 其中一份还是修 /private 归一之前的**缺陷版**实现——入仓会让读者看到两份实现、其一已知是错的。
*.mutbak
.mutation-check-running
