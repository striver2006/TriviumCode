# ==============================================================================
# TriviumCode - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 敏感凭据与本地环境配置 (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
credentials.json

# ------------------------------------------------------------------------------
# 操作系统缓存工件
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDE 与编辑器配置
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# VS Code (保留工作区推荐插件与通用配置，忽略个人状态)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# ------------------------------------------------------------------------------
# 运行时缓存与依赖库
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
package-lock.json.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 临时与日志文件
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 多智能体协同流水线工件
# 保持审计文档(.md)与变更补丁(.patch)留痕入库，忽略临时运行锁与中间缓存
# ------------------------------------------------------------------------------
.reviews/*.lock
.reviews/*.tmp
.reviews/*.cache
