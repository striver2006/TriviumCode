+  ['M8', 'startRun 不追加共享根项', R, '        ...(sharedRoots ? [sharedRoots] : []),', '        ...(sharedRoots ? [] : []),', I('shared-root-start')],
+  ['M9', 'relevant 只传入选审核者', R, SCAN, "checkSharedReadRoots([...rc.sides], undefined, '本次运行')", I('shared-root-start')],
+  ['M10', '共享根项挪到必读剔除之后', R,
