+    const cell = { cell: `--start ${json ? '--json' : '人读'} 扫描家目录${scan === 'clean' ? '干净' : '有同名入口'}`, old_code: o.code, new_code: nw.code, old_wait: o.wait_code, new_wait: nw.wait_code };
