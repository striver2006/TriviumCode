+  ['M5', '没有段的家归到原因①', D, '        : input.ran.has(a.cliName) ? groups.fixed', '        : true ? groups.fixed', U('doctor-unused-overrides')],
+  ['M6', 'cmdDoctor 不判模型键', C, KEYS, '  void modelRaw;', U('doctor-unused-overrides')],
+  ['M7', 'cmdDoctor 判模型键的 picked 写成空集', C, KEYS,
