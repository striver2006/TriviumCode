+    U('doctor-unused-overrides')],
+  ['M2', 'overridesFor 不记消费', D, '    consumedOverrides.add(id);', '    void consumedOverrides;', U('doctor-unused-overrides')],
+  ['M3', '提示推进 blockers', D,
