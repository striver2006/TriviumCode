+
+  const r = await cli(fx.root, [...startArgs(topic), '--json'], STUB, 120_000, { [ENTRY_SCAN_HOME_ENV]: await dirtyHome() });
+  assert.equal(r.code, EXIT.OK, `${r.stdout}\n${r.stderr}`);
