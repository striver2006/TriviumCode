+++ b/doc/05_testing/evidence/facade-version-pointers-20260929/doc-mutation.mjs
@@ -0,0 +1,72 @@
+// 执行文档与清单变异（计划 r2 §5.4 ③）。逐条：施加 → （改 helper 的先 tests-only 重编）→ 只跑目标测试文件
+// → 记 fail 数与失败用例名 → 还原 → （改 helper 的再重编）→ 核 sha256 与施加前一致。
+// 全族结束后再 tests-only 重编一次、复跑目标测试确认零失败。读数写 doc-mutation-output.json。
+// 只在没有审查运行时跑；跑的时候不要做别的写入（它会临时改 doc/、.reviews/README.md 与 test/helpers/）。
+// 用法：node scripts/build.mjs --tests-only && node <本目录>/gen-doc-mutation-spec.mjs && node <本目录>/doc-mutation.mjs
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { readFileSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import { HERE, ROOT, TEST_JS, checkPrereqs } from './lib.mjs';
+
+checkPrereqs();
+const spec = JSON.parse(readFileSync(path.join(HERE, 'doc-mutation-spec.json'), 'utf8'));
+const sha = (s) => createHash('sha256').update(s).digest('hex');
+
+function rebuildTests() {
+  const r = spawnSync(process.execPath, ['scripts/build.mjs', '--tests-only'], { cwd: ROOT, encoding: 'utf8' });
+  if (r.status !== 0) throw new Error(`tests-only 构建失败：${r.stderr}`);
+}
+
+function runTarget() {
+  const r = spawnSync(process.execPath, ['--test', '--test-reporter=tap', TEST_JS], { cwd: ROOT, encoding: 'utf8', maxBuffer: 64 << 20 });
+  const out = r.stdout ?? '';
+  const fail = Number(/^# fail (\d+)/m.exec(out)?.[1] ?? NaN);
+  const pass = Number(/^# pass (\d+)/m.exec(out)?.[1] ?? NaN);
+  const failed = [...out.matchAll(/^\s*not ok \d+ - (.+)$/gm)].map((m) => m[1].trim());
+  const kinds = [...new Set([...out.matchAll(/\[([a-z_]+)\]/g)].map((m) => m[1]))].sort();
+  return { status: r.status, pass, fail, failed, kinds };
+}
+
+const baseline = runTarget();
+if (baseline.fail !== 0) {
+  console.error(`基线就不是全绿（fail=${baseline.fail}），不跑变异：${baseline.failed.join(' / ')}`);
+  process.exit(1);
+}
+
+const results = [];
+for (const m of spec.mutations) {
+  const abs = path.join(ROOT, m.file);
+  const original = readFileSync(abs, 'utf8');
+  const before = sha(original);
+  let r;
+  let restored = false;
+  try {
+    if (original.split(m.find).length - 1 !== 1) throw new Error(`find 不唯一或找不到：${m.id}`);
+    writeFileSync(abs, original.replace(m.find, m.replace));
+    if (m.rebuild) rebuildTests();
+    r = runTarget();
+  } finally {
+    writeFileSync(abs, original);
+    if (m.rebuild) rebuildTests();
+    restored = sha(readFileSync(abs, 'utf8')) === before;
+  }
+  const ok = (m.expect === 'red' ? r.fail > 0 : r.fail === 0) && restored;
+  results.push({ id: m.id, family: m.family, expect: m.expect, fail: r.fail, pass: r.pass, failed: r.failed, kinds: r.kinds, restored, ok, why: m.why });
+  console.log(`${ok ? '✓' : '✗'} ${m.id.padEnd(16)} 期望 ${m.expect.padEnd(5)} fail=${r.fail} ${restored ? '已还原' : '未还原！'}  ${r.kinds.join(',')}  ${r.failed.slice(0, 3).join(' / ')}`);
+}
+
+rebuildTests();
+const after = runTarget();
+const summary = {
+  base: spec.base,
+  generated_at: new Date().toISOString(),
+  baseline: { pass: baseline.pass, fail: baseline.fail },
+  after: { pass: after.pass, fail: after.fail },
+  total: results.length,
+  ok: results.filter((x) => x.ok).length,
+  results,
+};
+writeFileSync(path.join(HERE, 'doc-mutation-output.json'), `${JSON.stringify(summary, null, 2)}\n`);
+console.log(`\n变异 ${summary.ok}/${summary.total} 符合期望；变异前 ${baseline.pass} 过 / ${baseline.fail} 败，全族结束重编后 ${after.pass} 过 / ${after.fail} 败`);
+process.exit(summary.ok === summary.total && after.fail === 0 ? 0 : 1);
