+add('DH-design50', 'DH', d50.file, d50Line, d50Line.replace(` ${d50Ver}`, ''), 'red', '历史样本的版本号被「顺手修掉」，锚点不含版本号 ⇒ T3 forbidden');
+const reLine = lineWith(HELPER_SRC, 'export const NON_FACADE_DOC_RE');
