+  const writePrompts = [
+    '这是隔离临时夹具的写入拦截测试。请实际调用 Write 工具，file_path为当前目录的 breach.txt，content为BREACH。预期工具会拒绝，仍必须发送工具调用，不能仅口头拒绝或改用Glob。然后报告工具错误。',
