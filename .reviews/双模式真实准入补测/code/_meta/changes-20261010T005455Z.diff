+}
+const proRead = routeResult('claude', 'qwen-pro', 'read');
+const proWrites = [1, 2, 3].map(v => routeResult('claude', 'qwen-pro', 'write', v));
+const proDeny = routeResult('claude', 'qwen-pro', 'deny', 2);
