index 00000000..871fa0cf
--- /dev/null
+++ b/extension/scripts/runStdoutE2E.mjs
@@ -0,0 +1,136 @@
+// 安装态 E1 时序。子进程必须等到文件、Webview、M3 三处回读才会退出。
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import * as fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { stdoutWorkspace } from '../test/e2e/stdoutWorkspace.mjs';
+import { until, installVsix, command, openWorkspace } from '../test/e2e/workbench.mjs';
+
+const json = async p => JSON.parse(await fs.readFile(p, 'utf8'));
+const hash = b => createHash('sha256').update(b).digest('hex');
+const base = await fs.realpath(await fs.mkdtemp(path.join(process.platform === 'darwin' ? '/tmp' : os.tmpdir(), 'trivium-e1-host-')));
+const vsix = process.env.TRIVIUM_TEST_VSIX;
+assert.ok(vsix, '请指定 TRIVIUM_TEST_VSIX');
+const code = process.env.VSCODE_EXECUTABLE_PATH;
+assert.ok(code, '请指定 VSCODE_EXECUTABLE_PATH');
+const children = [];
+const report = { base, code, vsix: path.resolve(vsix), vsixSha: hash(await fs.readFile(vsix)), windows: [] };
+console.log(base);
+async function prepare(w) {
+  const f = w.frame;
+  await f.locator('#entry').selectOption('B');
+  await f.locator('#driver').selectOption(w.driver);
+  await f.locator('#topic').fill(w.topic);
+  await f.locator('#body').fill(w.focus);
+  await f.locator('#btnPrechain').click();
+  await until('前置链', async () => {
+    const error = await f.locator('#steps .fail').allTextContents();
+    if (error.length) throw new Error(error.join(' '));
+    return f.locator('#btnIgnite').isEnabled();
+  });
+  await f.evaluate(() => {
+    window.e1Audit = { leaked: false, messages: 0 };
+    const marker = ['sk-', 'unitFixture0123456789', 'abcdefghijk'].join('');
+    window.addEventListener('message', e => {
+      if (e.data.type === 'stdout') window.e1Audit.messages++;
+      if (JSON.stringify(e.data).includes(marker)) window.e1Audit.leaked = true;
+    });
+    new MutationObserver(() => {
+      if (document.querySelector('#runs').textContent.includes(marker)) window.e1Audit.leaked = true;
+    }).observe(document.querySelector('#runs'), { childList: true, subtree: true, characterData: true });
+  });
+}
+async function observe(w) {
+  const f = w.frame;
+  const start = await until('点火返回 ' + w.root, () => json(path.join(w.root, '.trivium/start.json')).catch(() => null));
+  const { run_id: runId, run_dir: runDir } = start;
+  const card = f.locator('#runs .card').filter({ hasText: runId });
+  const result = { root: w.root, topic: w.topic, runId, runDir, profile: w.profile, installedJs: w.installedJs, core: w.core, coreSha: w.coreSha, sides: {} };
+  report.windows.push(result);
+  const status = () => json(path.join(runDir, 'status.json'));
+  const state = await until('工作进程登记', async () => { const s = await status(); return s.worker_pid && s; });
+  const cmd = execFileSync('ps', ['-p', String(state.worker_pid), '-o', 'command='], { encoding: 'utf8' }).trim();
+  assert.ok(cmd.includes(w.core), cmd);
+  result.worker = { pid: state.worker_pid, command: cmd };
+  const sides = w.critics.map(id => ({
+    id, out: path.join(runDir, id, 'out'), file: name => path.join(w.control, id + '-' + name),
+    view: card.locator('.critic-stdout[data-critic="' + id + '"] .log-lines'),
+  }));
+  for (const s of sides) {
+    const p = await until('审核者启动 ' + s.id, () => json(s.file('producer.json')).catch(() => null));
+    const meta = await json(path.join(s.out, 'stdout-live.json'));
+    const stdout = path.join(s.out, meta.file);
+    await until(s.id + ' 磁盘标记', async () => (await fs.readFile(stdout, 'utf8')).includes(p.marker));
+    const diskAt = Date.now();
+    await s.view.filter({ hasText: p.marker }).waitFor();
+    await s.view.scrollIntoViewIfNeeded();
+    assert.ok(await s.view.isVisible());
+    const domAt = Date.now();
+    assert.equal(await fs.stat(s.file('exit.json')).catch(() => null), null);
+    assert.match(execFileSync('ps', ['-p', String(p.pid), '-o', 'command='], { encoding: 'utf8' }), /fixture-|controlledCritic/);
+    result.sides[s.id] = { ...p, stdout, diskAt, domAt, attempt: meta.attempt };
+  }
+  await command(w.page, 'Terminal: Kill the Active Terminal Instance');
+  await f.locator('#modeBadge.m3').waitFor();
+  assert.equal((await status()).phase, 'running');
+  for (const s of sides) await fs.writeFile(s.file('release-first'), '');
+  for (const s of sides) {
+    const r = result.sides[s.id];
+    await s.view.filter({ hasText: 'M3-' + r.marker }).waitFor();
+    assert.ok((await card.innerText()).includes(w.topic));
+    r.m3At = Date.now();
+  }
+  for (const s of sides) await fs.writeFile(s.file('release-last'), '');
+  for (const s of sides) {
+    const r = result.sides[s.id];
+    const e = await until('退出回执', () => json(s.file('exit.json')).catch(() => null));
+    assert.ok(r.sent <= r.diskAt && r.diskAt <= r.domAt && r.domAt <= r.m3At && r.m3At <= e.at);
+    const bytes = await until('最终 stdout', async () => {
+      const i = await json(path.join(s.out, 'stdout-live.json'));
+      return i.state === 'complete' && fs.readFile(r.stdout);
+    });
+    Object.assign(r, { exitAt: e.at, bytes: bytes.length, sha256: hash(bytes), expected: e });
+    assert.equal(r.sha256, e.sha256, s.id);
+    assert.equal(bytes.length, e.bytes);
+  }
+  const archive = path.join(w.root, '.reviews', w.topic, 'plan/_meta', 'run-' + runId + '.json');
+  const a = await until('终态归档', async () => {
+    const m = await json(archive);
+    return ['failed', 'success'].includes(m.status) && m;
+  });
+  result.diskAudit = await until('逐次写入的磁盘回读', () => json(path.join(w.control, 'disk-audit.json')).catch(() => null));
+  for (const id of w.critics) {
+    assert.ok(result.diskAudit[id].writes >= 2);
+    assert.equal(result.diskAudit[id].leaked, false);
+  }
+  result.archive = archive;
+  result.status = a.status;
+  result.audit = await f.evaluate(() => window.e1Audit);
+  assert.equal(result.audit.leaked, false);
+  assert.ok(result.audit.messages > 0);
+  assert.equal(a.status, 'success', archive);
+}
+try {
+  report.packedJsSha = hash(execFileSync('unzip', ['-p', vsix, 'extension/dist/extension.js']));
+  report.extensionVersion = JSON.parse(execFileSync('unzip', ['-p', vsix, 'extension/package.json'])).version;
+  const windows = [];
+  for (const driver of ['claude', 'codex']) {
+    const fx = await stdoutWorkspace(base, 'workspace-' + driver, driver, 'controlled');
+    const windowBase = path.join(base, driver);
+    await fs.mkdir(windowBase);
+    await installVsix({ base: windowBase, code, vsix });
+    const w = await openWorkspace(fx, { base: windowBase, code, vsix, children });
+    w.installedJs = path.join(windowBase, 'extensions', 'triviumcode.trivium-cockpit-' + report.extensionVersion, 'dist/extension.js');
+    assert.equal(hash(await fs.readFile(w.installedJs)), report.packedJsSha);
+    await prepare(w);
+    windows.push(w);
+  }
+  await Promise.all(windows.map(w => w.frame.locator('#btnIgnite').click()));
+  await Promise.all(windows.map(observe));
+  report.passed = true;
+} finally {
+  await fs.writeFile(path.join(base, 'report.json'), JSON.stringify(report, null, 2));
+  for (const child of children) child.kill();
+}
diff --git a/extension/scripts/runStdoutLifecycle.mjs b/extension/scripts/runStdoutLifecycle.mjs
new file mode 100644
index 00000000..8aaa2ecf
--- /dev/null
+++ b/extension/scripts/runStdoutLifecycle.mjs
@@ -0,0 +1,148 @@
+// 真实安装态覆盖旧核心、隐藏/恢复、取消、重试和磁盘故障，并独立计量空闲期。
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import * as fs from 'node:fs/promises';
+import path from 'node:path';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { resolveCliPathFromVSCodeExecutablePath } from '@vscode/test-electron';
+import { installVsix, openWorkspace, until } from '../test/e2e/workbench.mjs';
+import { stdoutWorkspace } from '../test/e2e/stdoutWorkspace.mjs';
+import { portForHost, hostCounters } from '../test/e2e/hostCounters.mjs';
+const exec = promisify(execFile);
+const base = await fs.realpath(await fs.mkdtemp('/tmp/tv-e1-life-'));
+const vsix = process.env.TRIVIUM_TEST_VSIX;
+const code = process.env.VSCODE_EXECUTABLE_PATH;
+const children = [];
+const report = { base, vsix, scenarios: [] };
+const json = async f => JSON.parse(await fs.readFile(f, 'utf8'));
+console.log(base);
+async function scenario(kind) {
+  const baseline = kind === 'idle-baseline';
+  const legacy = kind === 'legacy' || baseline;
+  const fx = await stdoutWorkspace(base, kind, 'codex', 'latch', legacy ? process.env.TRIVIUM_BASELINE_ASSETS : undefined);
+  const port = await portForHost();
+  const w = await openWorkspace(fx, { base, code, vsix, children, inspectExtensions: port });
+  const measure = await hostCounters(port);
+  try {
+    const tv = async (...args) => {
+      const { stdout } = await exec(path.join(w.root, '.trivium/bin/trivium'), [...args, '--json'], { cwd: w.root });
+      return stdout.trim() ? JSON.parse(stdout) : null;
+    };
+    if (kind === 'fault') await fs.writeFile(path.join(w.control, 'fault.json'), JSON.stringify({ claude: 'short', gemini: 'permanent', glm: 'slow' }));
+    if (kind === 'retry' || kind === 'timeout') {
+      const wrapper = path.join(w.root, '.trivium/bin/trivium');
+      const specs = Object.fromEntries(w.critics.map(id => [id, { stdout:'latch', mode:'ok', findings:0 }]));
+      specs.claude.attempts = kind === 'retry' ? [{ stdout:'latch', mode:'fail', note:'ECONNRESET' }, { stdout:'latch', mode:'ok', findings:0 }] : [{ stdout:'latch', mode:'timeout' }];
+      await fs.writeFile(wrapper, (await fs.readFile(wrapper,'utf8')).replace(/^export TRIVIUM_STUB_CRITIC=.*$/m, "export TRIVIUM_STUB_CRITIC='" + JSON.stringify(specs) + "'"));
+    }
+    const start = await tv('review','--start','--entry','B','--stage','plan','--topic',w.topic,'--driver',w.driver,
+      '--critics',w.critics.join(','),'--focus',w.focus);
+    const card = w.frame.locator('#runs .card').filter({hasText:start.run_id});
+    const r = { kind, runId: start.run_id, runDir: start.run_dir, core: w.core, coreSha: w.coreSha, sides:{} };
+    report.scenarios.push(r);
+    const dir = id => path.join(start.run_dir, id, 'out');
+    const read = (id, name) => json(path.join(dir(id), name));
+    await until('实际管道发出首批', () => Promise.all(w.critics.map(id => read(id,'producer.json'))).catch(() => null));
+    const release = n => Promise.all(w.critics.map(id => fs.writeFile(path.join(dir(id),'release-' + n), '')));
+    if (baseline) await card.locator('.phase.running').waitFor();
+    else if (legacy) {
+      await card.getByText(/旧核心不提供/).first().waitFor();
+      assert.equal(await card.locator('.critic-stdout .log-lines').allTextContents().then(a => a.join('')), '');
+    } else if (kind === 'fault') {
+      await card.getByText(/实时写入暂缓/).first().waitFor();
+    } else {
+      await card.locator('.critic-stdout .log-lines').filter({hasText:'E1-'}).first().waitFor();
+    }
+    if (kind === 'hidden' || baseline) {
+      const draws = [], messages = [];
+      await w.page.exposeFunction('e1Observed', (type, at) => (type === 'paint' ? draws : messages).push(at));
+      await w.frame.evaluate(() => {
+        new MutationObserver(mutations => {
+          if (mutations.some(m => m.target.parentElement?.closest('.critic-stdout'))) window.e1Observed('paint', Date.now());
+        }).observe(document.getElementById('runs'), { subtree: true, characterData: true, childList: true });
+        window.addEventListener('message', e => { if (e.data.type === 'stdout') window.e1Observed('message', Date.now()); });
+      });
+      r.beforeHide = await measure.sample();
+      if (!baseline) assert.ok(r.beforeHide.live > 0 && r.beforeHide.opens > 0, '已验证监视器能观察到活动');
+      await exec(resolveCliPathFromVSCodeExecutablePath(code), ['--user-data-dir', w.profile, '--extensions-dir', path.join(base,'extensions'), '--reuse-window', path.join(w.root,'README.md')]);
+      await w.page.locator('.tab.active').filter({hasText:'README.md'}).waitFor();
+      await until('隐藏后释放文件监听', async () => (await measure.sample()).live === 0);
+      r.hiddenStart = await measure.sample();
+      await release(0);
+      await sleep(1500);
+      r.hiddenEnd = await measure.sample();
+      assert.equal(r.hiddenStart.opens, r.hiddenEnd.opens);
+      assert.equal(r.hiddenStart.timers, r.hiddenEnd.timers);
+      r.reopenedAt = Date.now();
+      await w.page.locator('.tab').filter({hasText:'Trivium 驾驶舱'}).first().click();
+      const activeFrame = await until('恢复驾驶舱上下文', async () => {
+        for (const f of w.page.frames()) if (await f.locator('#runs .card').count()) return f;
+      });
+      if (!baseline) await Promise.all(w.critics.map(id => activeFrame.locator('.critic-stdout .log-lines').filter({hasText:'E1-' + start.run_id + '-' + id + '-1'}).waitFor()));
+      r.restoredAt = Date.now();
+      r.hiddenMessages = messages.filter(t => t >= r.hiddenStart.at && t <= r.hiddenEnd.at).length;
+      r.hiddenPaints = draws.filter(t => t >= r.hiddenStart.at && t <= r.hiddenEnd.at).length;
+      assert.equal(r.hiddenMessages, 0);
+      assert.equal(r.hiddenPaints, 0);
+      if (!baseline) assert.ok(r.restoredAt-r.reopenedAt <= 1000, '恢复尾部超过一秒');
+    } else if (kind !== 'cancel') await release(0);
+    if (kind === 'cancel') await tv('review','--cancel', start.run_id);
+    else await release(1);
+    const ended = await until('运行已结束', async () => {
+      const s = await json(path.join(start.run_dir, 'status.json'));
+      return ['failed','cancelled','success'].includes(s.phase) && s;
+    }, 90);
+    r.phase = ended.phase;
+    assert.equal(r.phase, kind === 'cancel' ? 'cancelled' : kind === 'timeout' ? 'failed' : 'success');
+    for (const id of w.critics) {
+      const i = await read(id, 'stdout-live.json').catch(() => null);
+      r.sides[id] = i;
+      if (legacy) assert.equal(i, null);
+      else if (kind === 'cancel') assert.equal(i.state,'incomplete');
+      else if (kind === 'fault') {
+        assert.equal(i.state, {claude:'complete', gemini:'incomplete', glm:'recovered'}[id]);
+        const summary = card.locator('.critic-stdout[data-critic="' + id + '"] summary');
+        await summary.filter({ hasText: {claude:'完整记录',gemini:'完整性未确认',glm:'已恢复'}[id] }).waitFor();
+        const content = await fs.readFile(path.join(dir(id),i.file),'utf8');
+        const expected = [0,1].map(n => ('E1-' + start.run_id + '-' + id + '-' + n).padEnd(255,'.') + '\n').join('');
+        assert.equal(content, id === 'gemini' ? '' : expected);
+      }
+      else assert.equal(i.state,'complete');
+      if (kind === 'retry' && id === 'claude') {
+        assert.equal(i.attempt, 2);
+        assert.equal((await read(id,'attempt-1/stdout-live.json')).attempt, 1);
+      }
+    }
+    if (kind === 'timeout') await card.locator('.critic-stdout[data-critic="claude"] summary').filter({ hasText:'超时' }).waitFor();
+    if (kind !== 'cancel') {
+      const meta = await json(path.join(w.root,'.reviews',w.topic,'plan/_meta','run-' + start.run_id + '.json'));
+      assert.ok(Object.values(meta.critics).every(c => c.cli_version === 'stub/0.0.0'));
+    }
+    await until('终态释放全部 stdout 监听', async () => (await measure.sample()).live === 0);
+    if (kind === 'hidden' || baseline) {
+      r.idle = [];
+      await sleep(1500);
+      for (let i=0; i<5; i++) {
+        const before = await measure.sample();
+        await sleep(60000);
+        const after = await measure.sample();
+        r.idle.push({ before, after });
+        assert.equal(after.opens, before.opens);
+        assert.equal(after.timers, before.timers);
+        assert.equal(after.live, 0);
+      }
+    }
+    console.log(kind, r.runId, r.phase);
+  } finally {
+    measure.close();
+    w.child.kill();
+  }
+}
+try {
+  await installVsix({ base, code, vsix });
+  for (const kind of process.argv.slice(2)) await scenario(kind);
+} finally {
+  await fs.writeFile(path.join(base,'report.json'),JSON.stringify(report,null,2));
+  for (const child of children) if (!child.killed) child.kill();
+}
diff --git a/extension/scripts/runStdoutPerf.mjs b/extension/scripts/runStdoutPerf.mjs
new file mode 100644
index 00000000..d6c290c3
--- /dev/null
+++ b/extension/scripts/runStdoutPerf.mjs
@@ -0,0 +1,153 @@
+// 在同一台 Mac 上交替运行基线和 E1。每轮单独启动安装态工作台和三侧 worker。
+import assert from 'node:assert/strict';
+import { execFile, execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import * as fs from 'node:fs/promises';
+import path from 'node:path';
+import { promisify } from 'node:util';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { stdoutWorkspace } from '../test/e2e/stdoutWorkspace.mjs';
+import { baseline } from '../test/e2e/perfBaseline.mjs';
+import { openWorkspace, installVsix, until } from '../test/e2e/workbench.mjs';
+import { extensionRoot } from '../test/e2e/workspace.mjs';
+const exec = promisify(execFile);
+const json = async file => JSON.parse(await fs.readFile(file, 'utf8'));
+const base = await fs.realpath(await fs.mkdtemp('/tmp/tv-e1p-'));
+console.log(base);
+const code = process.env.VSCODE_EXECUTABLE_PATH;
+assert.ok(code);
+const variants = [
+  { id: 'base', assets: await baseline(base), vsix: path.join(extensionRoot, 'trivium-cockpit-0.3.0-glm-relay.vsix') },
+  { id: 'e1', assets: path.resolve(extensionRoot, '../skills/dual-critic'), vsix: process.env.TRIVIUM_TEST_VSIX },
+];
+for (const v of variants) {
+  v.base = path.join(base, v.id);
+  await fs.mkdir(v.base);
+  await installVsix({ ...v, code });
+  v.vsixSha = createHash('sha256').update(await fs.readFile(v.vsix)).digest('hex');
+}
+const children = [];
+async function hostPid(profile) {
+  let entries = [];
+  for await (const file of fs.glob('logs/*/window*/exthost/exthost.log', { cwd: profile })) entries.push(file);
+  const m = /Extension host with pid (\d+) started/.exec(await fs.readFile(path.join(profile, entries.sort().at(-1)), 'utf8'));
+  return Number(m[1]);
+}
+async function sample(pid) {
+  const { stdout } = await exec('ps', ['-p', String(pid), '-o', 'time=,rss=']);
+  const [time, rss] = stdout.trim().split(/\s+/);
+  return { at: Date.now(), cpu: time.split(':').reduce((t, n) => t * 60 + Number(n), 0), rssKiB: Number(rss) };
+}
+async function observe(frame, every) {
+  await frame.evaluate(every => {
+    window.perfSample = { received: {}, visible: {} };
+    const box = document.getElementById('runs');
+    const marks = /E1-[A-Za-z0-9-]+-(\d+)\./g;
+    let drawing = false;
+    function draw() {
+      drawing = false;
+      const cards = box.querySelectorAll('.critic-stdout');
+      if (cards.length) cards[Math.floor(cards.length / 2)].scrollIntoView({ block: 'center' });
+      for (const details of cards) {
+        const port = details.querySelector('.log').getBoundingClientRect();
+        const node = details.querySelector('pre').firstChild;
+        if (!node || !details.open) continue;
+        for (const m of node.textContent.matchAll(marks)) {
+          if (Number(m[1]) % every) continue;
+          const key = m[0].slice(0, -1);
+          if (window.perfSample.visible[key]) continue;
+          const range = new Range();
+          range.setStart(node, m.index);
+          range.setEnd(node, m.index + key.length);
+          const r = range.getBoundingClientRect();
+          if (r.top + r.height / 2 >= Math.max(port.top, 0) && r.bottom - r.height / 2 <= Math.min(port.bottom, innerHeight)
+              && r.left >= Math.max(port.left, 0) - 1 && r.right <= Math.min(port.right, innerWidth) + 1) {
+            window.perfSample.visible[key] = Date.now();
+          }
+        }
+      }
+    }
+    new MutationObserver(() => {
+      if (!drawing) { drawing = true; requestAnimationFrame(draw); }
+    }).observe(box, { childList: true, characterData: true, subtree: true });
+    window.addEventListener('message', e => {
+      if (e.data.type !== 'stdout') return;
+      for (const m of e.data.text.matchAll(marks)) {
+        if (!(Number(m[1]) % every)) window.perfSample.received[m[0].slice(0, -1)] ??= Date.now();
+      }
+    });
+  }, every);
+}
+async function trial(v, mode, round) {
+  const count = mode === 'dense' ? 512 : 60;
+  const size = mode === 'dense' ? 16384 : 256;
+  const every = mode === 'dense' ? 25 : 4;
+  const fx = await stdoutWorkspace(v.base, mode + round, 'codex', mode, v.assets);
+  const w = await openWorkspace(fx, { ...v, code, children });
+  await w.page.bringToFront();
+  // 三侧视口须同时落在桌面，缩放与运行负载无关，两版一致。
+  for (let i = 0; i < 3; i++) await w.page.keyboard.press('Meta+-');
+  await observe(w.frame, every);
+  const extPid = await hostPid(w.profile);
+  const host = [await sample(extPid)];
+  let stop = false;
+  const meter = (async () => {
+    while (!stop) { await sleep(100); host.push(await sample(extPid)); }
+  })();
+  let result;
+  try {
+    const started = Date.now();
+    const start = JSON.parse(execFileSync(path.join(w.root, '.trivium/bin/trivium'), ['review','--start','--entry','B',
+      '--stage','plan','--topic',w.topic,'--driver',w.driver,'--critics',w.critics.join(','),'--focus',w.focus,'--json'],
+    { cwd: w.root, encoding: 'utf8' }));
+    const status = path.join(start.run_dir, 'status.json');
+    const ended = await until('审查终态', async () => {
+      const s = await json(status);
+      return ['success','failed','cancelled'].includes(s.phase) && s;
+    }, 90);
+    const end = Date.now();
+    stop = true;
+    await meter;
+    assert.equal(ended.phase, 'success');
+    const worker = await until('退出计量', () => json(path.join(w.control, 'worker-' + ended.worker_pid + '.json')).catch(() => null));
+    assert.equal(worker.core, w.core);
+    const ui = await w.frame.evaluate(() => window.perfSample);
+    const archive = await json(path.join(w.root, '.reviews', w.topic, 'plan/_meta', 'run-' + start.run_id + '.json'));
+    result = { variant: v.id, round, mode, start, started, end, elapsedMs: end - started, worker, host, extPid,
+      hostCpu: host.at(-1).cpu - host[0].cpu, hostPeakKiB: Math.max(...host.map(x => x.rssKiB)),
+      coreCpu: (worker.usage.userCPUTime + worker.usage.systemCPUTime)/1e6, corePeakKiB: worker.usage.maxRSS,
+      coreSha: w.coreSha, vsix: v.vsix, vsixSha: v.vsixSha, sides: {} };
+    for (const id of w.critics) {
+      assert.equal(archive.critics[id].cli_version, 'stub/0.0.0');
+      const out = path.join(start.run_dir, id, 'out');
+      const producer = await json(path.join(out, 'producer.json'));
+      const stat = await fs.stat(path.join(out, 'stdout.jsonl'));
+      assert.equal(stat.size, count * size);
+      const samples = producer.samples.filter((_, i) => i % every === 0).map(s => ({
+        ...s, received: ui.received[s.mark] ?? null, visible: ui.visible[s.mark] ?? null,
+      }));
+      const delays = samples.filter(s => s.visible).map(s => s.visible-s.sent).sort((a,b) => a-b);
+      const writes = worker.writes.filter(x => path.dirname(x.file) === out);
+      const bytes = writes.filter(x => path.basename(x.file) === 'stdout.jsonl').reduce((a,x) => a+x.bytes, 0);
+      const metadata = writes.filter(x => path.basename(x.file).startsWith('stdout-live.')).reduce((a,x) => a+x.bytes,0);
+      result.sides[id] = { samples, bytes, expectedBytes: stat.size, metadata, fingerprint: archive.critics[id].cli_version,
+        missing: samples.length-delays.length, p95Ms: delays[Math.ceil(delays.length*.95)-1] ?? null };
+    }
+    return result;
+  } finally {
+    stop = true;
+    await meter;
+    w.child.kill();
+  }
+}
+try {
+  for (let round = 0; round <= Number(process.env.TRIVIUM_PERF_ROUNDS ?? 5); round++) {
+    for (const mode of ['sparse','dense']) for (const v of (round % 2 ? [...variants].reverse() : variants)) {
+      if (process.env.TRIVIUM_PERF_VARIANT && v.id !== process.env.TRIVIUM_PERF_VARIANT) continue;
+      const r = await trial(v, mode, round);
+      const file = path.join(base, v.id + '-' + mode + '-' + round + '.json');
+      await fs.writeFile(file, JSON.stringify(r));
+      console.log(file, r.elapsedMs, Object.values(r.sides).map(s => [s.missing, s.p95Ms, s.bytes]));
+    }
+  }
+} finally { for (const p of children) if (!p.killed) p.kill(); }
