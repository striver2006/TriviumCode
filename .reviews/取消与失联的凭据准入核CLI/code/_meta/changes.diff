+ */
+export function scrubHoldWhy(a: ScrubAdmission): string {
+  if (!a.worker.gone || !a.cli || a.cli.gone) return a.worker.why;
+  return `${a.worker.why}，但审查员 CLI 未确认结束——${a.cli.blockers.map((b) => b.detail).join('；')}`;
 }
 
