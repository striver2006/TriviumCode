+  await writeRunMeta(layout, 'plan', meta);
+  await registerRun(layout, meta, { triviumDir: ctx.triviumDir, heartbeatStaleMs: 120_000 });
+  return { runDir, carrier, dead, runJson: path.join(metaDir(layout, 'plan'), `run-${runId}.json`) };
+}
