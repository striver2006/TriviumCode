@@ -0,0 +1,29 @@
+#!/usr/bin/env node
+/**
+ * M10b 第 3 步变异验证的包装：跑 `scripts/mutation-check.mjs <本目录>/<规格>`，
+ * 把装置的 stdout 与 stderr 原样写进对应的输出文件（会话里的命令不带重定向，输出由脚本自己写）。
+ * 退出码透传装置的退出码。仓库根按脚本位置推导（EV-103）。
+ *
+ * 用法：
+ *   node doc/05_testing/evidence/m10b-step3-20260925/run.mjs                      # mutation-spec.json → mutation-output.txt
+ *   node doc/05_testing/evidence/m10b-step3-20260925/run.mjs mutation-spec-2.json # → mutation-output-2.txt
+ */
+import { spawn } from 'node:child_process';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(HERE, '../../../..');
+const spec = process.argv[2] ?? 'mutation-spec.json';
+const suffix = /^mutation-spec(-\d+)?\.json$/.exec(spec)?.[1] ?? '';
+const child = spawn(process.execPath, [path.join(ROOT, 'scripts/mutation-check.mjs'), path.join(HERE, spec)], {
+  cwd: ROOT,
+  stdio: ['ignore', 'pipe', 'pipe'],
+});
+let out = '';
+child.stdout.on('data', (d) => { out += d; process.stdout.write(d); });
+child.stderr.on('data', (d) => { out += d; process.stderr.write(d); });
+const code = await new Promise((resolve) => child.on('close', resolve));
+await fs.writeFile(path.join(HERE, `mutation-output${suffix}.txt`), out, 'utf8');
+process.exit(code ?? 1);
diff --git a/src/trivium/hook-config.ts b/src/trivium/hook-config.ts
new file mode 100644
index 0000000..ce79995
--- /dev/null
+++ b/src/trivium/hook-config.ts
@@ -0,0 +1,332 @@
+/**
+ * 项目内 Hook 配置的渲染、合并与在场判定（M10b 第 3 步，计划 r10 §3.1.2、§3.2、§3.3；r9 §3.4）。
+ *
+ * **单一来源**：两家的 Hook 都由运行时根里的 `hooks/hooks.json`（Claude Code 形态）派生。
+ * 注册表的 `hookConfigTarget` 登记每家落在哪个文件、是什么形态；本模块按形态渲染：
+ *
+ *   claude-settings  原样合并进 `.claude/settings.json` 的 `hooks.<事件>[]`
+ *   zcode-config     合并进 `.zcode/config.json` 的 `hooks.events.<事件>[]`：
+ *                    matcher 只留 ZCode 工具注册表里有的名字（`NotebookEdit` 不在其中）；
+ *                    超时 `timeout`（秒）换成 `timeoutMs`（毫秒）；护栏失效提示里的配置文件名换成本家的
+ *
+ * **只增不删、不覆盖用户已有的 Hook**（两家同口径）：按事件追加；同一条 TriviumCode Hook 以它调用的
+ * `gate hook-<name>` 识别，命令文本变了就原位替换旧条目（升级），而不是叠加第二条。
+ *
+ * 本模块**只渲染与安装，不参与任何判定**（r5 §6.1「通过时」）：拦不拦由 `hooks.ts` 决定，
+ * 装没装上由 {@link hookConfigPresent} 回答，给 `preflight` 定当轮护栏等级用（B1，r10 §3.3）。
+ */
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import {
+  type AgentDescriptor, type GuardLevel, type GuardProfile, type HookConfigFormat, guardProfileOf,
+} from './agents/registry.js';
+import { ensureDir, exists, writeAtomic } from './util/fsx.js';
+import { warn } from './util/log.js';
+
+/** `hooks/hooks.json` 里的一条事件条目（Claude Code 形态） */
+export interface HookEntry {
+  matcher?: string;
+  hooks: { type: string; command: string; timeout?: number }[];
+}
+
+export interface HookSource {
+  hooks: Record<string, HookEntry[]>;
+}
+
+/** 与 `init.ts` 的 `InitReport` 同形：`hooks` 命令与 `init` 共用同一份汇报 */
+export interface HookMergeReport {
+  created: string[];
+  updated: string[];
+  skipped: string[];
+  notes: string[];
+}
+
+/** 一条 hooks 条目里调用了哪些 `gate hook-<name>`（TriviumCode 的 Hook 身份） */
+export function hookNamesOf(entry: unknown): Set<string> {
+  const out = new Set<string>();
+  for (const m of JSON.stringify(entry).matchAll(/gate hook-([a-z-]+)/g)) out.add(m[1]!);
+  return out;
+}
+
+export async function loadHookSource(hooksJsonPath: string): Promise<HookSource | null> {
+  if (!(await exists(hooksJsonPath))) return null;
+  return JSON.parse(await fs.readFile(hooksJsonPath, 'utf8')) as HookSource;
+}
+
+// ─────────────────────────── 渲染 ───────────────────────────
+
+/**
+ * ZCode 工具注册表里、本仓 Hook 要挂的那几个工具名（第 1 步报告 §3.2 来源 ①）。
+ *
+ * matcher 只写精确名单（r10 §3.2.2）：ZCode 对「只含字母数字下划线与 `|`」的 matcher 按 `|` 拆成精确名，
+ * 否则当**不锚定**的正则——`Write` 会误匹配 `TodoWrite`。`NotebookEdit` 不在 ZCode 注册表里，渲染时去掉；
+ * `ApplyPatch` 经 ZCode 的 matcher 别名会被 `Write|Edit` 覆盖，但路径嵌在 `operation.path`、
+ * `extractTargetPath` 取不到（报告 §3.2 第 3 条），是登记在案的已知边界，不在这里补。
+ */
+const ZCODE_HOOK_TOOLS: ReadonlySet<string> = new Set(['Write', 'Edit', 'Bash']);
+
+/** 护栏失效提示里点名的配置文件：渲染到别家时要换成别家的，否则提示把人指到一个不起作用的文件 */
+const CLAUDE_SETTINGS_MENTION = '.claude/settings.json 中的 TriviumCode Hook';
+
+function toZcodeEntry(entry: HookEntry, targetPath: string): HookEntry {
+  let matcher: string | undefined;
+  if (entry.matcher !== undefined) {
+    const kept = entry.matcher.split('|').filter((n) => ZCODE_HOOK_TOOLS.has(n));
+    if (kept.length === 0) {
+      // 源里新加了一条 ZCode 没有的工具名：静默丢掉整条就是「装上了却不拦」，当场抛
+      throw new Error(`hooks.json 的 matcher「${entry.matcher}」在 ZCode 上一个工具名都不剩，无法渲染`);
+    }
+    matcher = kept.join('|');
+  }
+  return {
+    ...(matcher !== undefined ? { matcher } : {}),
+    hooks: entry.hooks.map((h) => {
+      const { timeout, ...rest } = h;
+      const command = h.command.includes(CLAUDE_SETTINGS_MENTION)
+        ? h.command.split(CLAUDE_SETTINGS_MENTION).join(`${targetPath} 中的 TriviumCode Hook`)
+        : h.command;
+      return {
+        ...rest,
+        command,
+        ...(timeout !== undefined ? { timeoutMs: timeout * 1000 } : {}),
+      } as HookEntry['hooks'][number];
+    }),
+  };
+}
+
+/** 按形态渲染出「事件 → 条目列表」。ZCode 事件名与 Claude Code 同名（报告 §3.1 的事件枚举） */
+export function renderHookEvents(
+  format: HookConfigFormat,
+  source: HookSource,
+  targetPath: string,
+): Record<string, HookEntry[]> {
+  if (format === 'claude-settings') return source.hooks;
+  const out: Record<string, HookEntry[]> = {};
+  for (const [event, entries] of Object.entries(source.hooks)) {
+    out[event] = entries.map((e) => toZcodeEntry(e, targetPath));
+  }
+  return out;
+}
+
+// ─────────────────────────── 合并 ───────────────────────────
+
+/** 按事件追加、按 `gate hook-<name>` 原位替换；返回改动计数（两家共用） */
+function mergeEvents(
+  existing: Record<string, unknown[]>,
+  incoming: Record<string, HookEntry[]>,
+): { added: number; replaced: number } {
+  let added = 0;
+  let replaced = 0;
+  for (const [event, entries] of Object.entries(incoming)) {
+    const cur = Array.isArray(existing[event]) ? existing[event] : [];
+    for (const entry of entries) {
+      const sig = JSON.stringify(entry);
+      const mine = hookNamesOf(entry);
+      /*
+       * 同一条 TriviumCode Hook 的识别依据是它调用的 `gate hook-<name>`，不是命令全文。
+       * 命令文本或超时一变就按全文比，重跑会在同一事件下叠加第二条、每次工具调用双倍执行。
+       * 升级时应当**替换**旧条目，而不是跳过或叠加。
+       */
+      const at = cur.findIndex((c) => [...hookNamesOf(c)].some((n) => mine.has(n)));
+      if (at === -1) {
+        cur.push(entry);
+        added++;
+      } else if (JSON.stringify(cur[at]) !== sig) {
+        cur[at] = entry;
+        replaced++;
+      }
+    }
+    existing[event] = cur;
+  }
+  return { added, replaced };
+}
+
+async function readJsonObject(
+  target: string,
+  report: HookMergeReport,
+): Promise<{ ok: true; had: boolean; raw: string | null; value: Record<string, unknown> } | { ok: false }> {
+  if (!(await exists(target))) return { ok: true, had: false, raw: null, value: {} };
+  const raw = await fs.readFile(target, 'utf8');
+  try {
+    const value = JSON.parse(raw) as unknown;
+    if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new Error('不是 JSON 对象');
+    return { ok: true, had: true, raw, value: value as Record<string, unknown> };
+  } catch {
+    warn(`${target} 不是合法的 JSON 对象，为避免破坏内容，跳过 Hook 合并。请手工合并。`);
+    report.notes.push(`${target} 解析失败，未合并 Hook`);
+    return { ok: false };
+  }
+}
+
+/**
+ * 把本仓 Hook 合并进 `agent` 的项目内配置文件。`agent.hookConfigTarget` 为 null 时什么都不做。
+ *
+ * 写前备份为 `<文件>.trivium-backup`；全部条目已就位时不写、记一条「已就位」。
+ */
+export async function mergeAgentHooks(
+  projectRoot: string,
+  agent: AgentDescriptor,
+  source: HookSource,
+  report: HookMergeReport,
+  dryRun: boolean,
+): Promise<void> {
+  const spec = agent.hookConfigTarget;
+  if (!spec) return;
+  const target = path.join(projectRoot, spec.path);
+  const read = await readJsonObject(target, report);
+  if (!read.ok) return;
+  const { had, raw, value: config } = read;
+
+  let changed: { added: number; replaced: number };
+  let enabledNote: string | null = null;
+  /** ZCode 形态：本次把缺席的 `hooks.enabled` 补成了 true（条目都已就位时也要写盘） */
+  let enabledSet = false;
+  if (spec.format === 'claude-settings') {
+    const existing = (config['hooks'] ?? {}) as Record<string, unknown[]>;
+    changed = mergeEvents(existing, renderHookEvents(spec.format, source, spec.path));
+    config['hooks'] = existing;
+  } else {
+    const hooks = (config['hooks'] ?? {}) as Record<string, unknown>;
+    const events = (hooks['events'] ?? {}) as Record<string, unknown[]>;
+    changed = mergeEvents(events, renderHookEvents(spec.format, source, spec.path));
+    hooks['events'] = events;
+    /*
+     * `enabled` 缺省为 false（ZCode 自己的缺省），不开就一条都不跑。
+     * **只在缺席时置 true**：用户显式写了 false 是「停用」这一态（r10 §3.2.3），重跑 init 不该把它翻回来。
+     */
+    if (hooks['enabled'] === undefined) {
+      hooks['enabled'] = true;
+      enabledSet = true;
+    } else if (hooks['enabled'] === false) {
+      enabledNote = `${target} 的 hooks.enabled 为 false：TriviumCode Hook 已写入但不会运行（停用态，按你的设置保留）`;
+    }
+    config['hooks'] = hooks;
+  }
+  if (enabledNote) report.notes.push(enabledNote);
+
+  if (changed.added === 0 && changed.replaced === 0 && !enabledSet) {
+    report.skipped.push(`${target}（Hook 已就位）`);
+    return;
+  }
+  await ensureDir(path.dirname(target));
+  if (!dryRun) {
+    if (had && raw !== null) await fs.writeFile(`${target}.trivium-backup`, raw, 'utf8');
+    await writeAtomic(target, JSON.stringify(config, null, 2) + '\n');
+  }
+  (had ? report.updated : report.created).push(target);
+  if (changed.replaced > 0) report.notes.push(`已把 ${target} 里 ${changed.replaced} 条旧版 TriviumCode Hook 替换为当前版本`);
+  if (had) report.notes.push(`已备份原 ${path.basename(target)} 到 ${path.basename(target)}.trivium-backup`);
+  if (spec.format === 'zcode-config') {
+    /*
+     * 工作区 Hook 要在 ZCode 桌面端信任后才跑，声明一变就退回待信任（静态 `stale_digest`）；
+     * 信任待定期间写工具照常执行、Hook 不跑，对模型与用户都不可见（报告 §3.1.1）。不提示就等于没装。
+     */
+    report.notes.push(
+      `已写入 ${target}：请在 ZCode 桌面端重新信任该工作区，信任前 Hook 不跑。` +
+        '命令行（--prompt）模式下工作区 Hook 整体关闭；子代理里的工具调用不过工作区 Hook（尽力拦截，不兜底）',
+    );
+  }
+}
+
+// ─────────────────────────── 在场判定与有效等级 ───────────────────────────
+
+/**
+ * 定级要求在场的 Hook（B1）：写工具与 Bash 两道。缺任一道，写入就有一条无人判定的路。
+ * `hook-stop` / `hook-session-start` 不影响「写入拦不拦得住」，不进这道判定。
+ */
+const REQUIRED_FOR_GUARD: readonly string[] = ['pre-write', 'pre-bash'];
+
+/**
+ * 该家的 TriviumCode Hook 配置**当前**是否在场：文件在、是合法 JSON，且 {@link REQUIRED_FOR_GUARD} 各有一条。
+ * ZCode 形态另要求 `hooks.enabled === true`（缺省 false 即一条都不跑）。
+ *
+ * **只看存在性，不看内容**（r5 §6.2 边界 R-r）：命令被改成放行、matcher 被缩窄、wrapper 或全局副本被替换，
+ * 这里都看不见。它回答的是「配置段被移除」这一种形态，不宣称更多。
+ */
+export async function hookConfigPresent(projectRoot: string, agent: AgentDescriptor): Promise<boolean> {
+  const spec = agent.hookConfigTarget;
+  if (!spec) return false;
+  const target = path.join(projectRoot, spec.path);
+  let config: Record<string, unknown>;
+  try {
+    config = JSON.parse(await fs.readFile(target, 'utf8')) as Record<string, unknown>;
+  } catch {
+    return false;
+  }
+  let events: Record<string, unknown>;
+  if (spec.format === 'claude-settings') {
+    events = (config['hooks'] ?? {}) as Record<string, unknown>;
+  } else {
+    const hooks = (config['hooks'] ?? {}) as Record<string, unknown>;
+    if (hooks['enabled'] !== true) return false;
+    events = (hooks['events'] ?? {}) as Record<string, unknown>;
+  }
+  const pre = events['PreToolUse'];
+  if (!Array.isArray(pre)) return false;
+  const names = new Set(pre.flatMap((e) => [...hookNamesOf(e)]));
+  return REQUIRED_FOR_GUARD.every((n) => names.has(n));
+}
+
+export interface EffectiveGuard {
+  /** 本次运行实际成立的等级 */
+  level: GuardLevel;
+  /** 注册表登记的等级 */
+  registered: GuardLevel;
+  profile: GuardProfile;
+  /** 登记为 L1 却因 Hook 配置不在场降为 L2 */
+  downgraded: boolean;
+}
+
+/**
+ * 当轮 Driver 的**有效**护栏等级（B1，r10 §3.3 收窄后的口径）。
+ *
+ * 只对**登记为 L1** 的载体判「Hook 配置当前是否在场」，不在场即降 L2；登记为 L2 的直接返回 L2，
+ * 不再读任何探针字段（D-3 撤回了 `hooks_deny_ok`）。
+ */
+export async function effectiveGuardLevel(projectRoot: string, agent: AgentDescriptor): Promise<EffectiveGuard> {
+  const profile = guardProfileOf(agent);
+  if (agent.guardLevel !== 'L1') {
+    return { level: agent.guardLevel, registered: agent.guardLevel, profile, downgraded: false };
+  }
+  const present = await hookConfigPresent(projectRoot, agent);
+  return {
+    level: present ? 'L1' : 'L2',
+    registered: 'L1',
+    profile,
+    downgraded: !present,
+  };
+}
+
+/**
+ * 闸门停点那一句「在此期间不得修改业务文件」的后半句，按当轮 Driver 的**有效**护栏等级措辞（M10b 第 3 步）。
+ *
+ * 此前一律写「（Hook 会拦下）」：对 glm（L2，尽力拦截）、codex / gemini（L2，没有 Hook）以及 Hook 配置不在场的
+ * claude 都不成立（第 2 步薄冒烟核出）。说「会拦下」而实际不拦，比不说更糟——执笔者会放心去写。
+ */
+export function gateHoldNotice(g: EffectiveGuard): string {
+  const tail = '越界不会被事前拦下，会在审批前复核与跑后漂移复算时暴露。';
+  if (g.level === 'L1') return '在此期间不得修改业务文件（Hook 会拦下）。';
+  if (g.downgraded) return `在此期间不得修改业务文件——本项目的 Hook 配置不在场（登记 L1，本次按 L2 计），靠你自觉；${tail}`;
+  if (g.profile === 'l2-hook') return `在此期间不得修改业务文件——本载体的 Hook 只作尽力拦截、不兜底（L2），靠你自觉；${tail}`;
+  return `在此期间不得修改业务文件——本载体没有 Hook 拦截（L2），全靠你自觉；${tail}`;
+}
+
+/**
+ * 护栏等级的人读文案（与入口资产注入段同源：都按 {@link GuardProfile} 分三档，r10 §3.1.3）。
+ * glm 打印「L2，有尽力拦截 Hook，不兜底」，不再有「L2 = 无事前写拦截」这种与 glm 实况相反的说法。
+ */
+export function describeGuard(agent: AgentDescriptor, g: EffectiveGuard): string {
+  const target = agent.hookConfigTarget?.path ?? '';
+  if (g.downgraded) {
+    return `L2（登记 L1，但 ${target} 里的 TriviumCode Hook 不在场，本次按 L2 计：写入没有事前拦截，` +
+      '靠审批前复核、_meta 唯一事实、防覆盖与跑后复算兜底；修复：trivium init 或 trivium hooks --agent ' + agent.id + '）';
+  }
+  switch (g.profile) {
+    case 'l1-hook':
+      return `L1（${target} 的 Hook 兜得住写入）`;
+    case 'l2-hook':
+      return `L2（有尽力拦截的 Hook：${target}，不兜底——只在桌面端、已信任、主代理、matcher 覆盖、不超时时生效）`;
+    case 'l2-none':
+      return 'L2（该载体没有 Hook 机制，写入没有事前拦截，靠审批前复核、_meta 唯一事实、防覆盖与跑后复算兜底）';
+  }
+}
diff --git a/test/integration/hooks-command.test.ts b/test/integration/hooks-command.test.ts
new file mode 100644
index 0000000..c1991b0
--- /dev/null
+++ b/test/integration/hooks-command.test.ts
@@ -0,0 +1,75 @@
+/**
+ * `trivium hooks --agent <id>` 与 `trivium init` 的 Hook 多目标（M10b 第 3 步，r5 §6.1、r10 §3.1.2 / §3.2）。
+ *
+ * 走真实打包 CLI：命令分派、旗标解析、退出码与 `--json` 输出只有子进程这一层能证明接上了。
+ * 家的取法经注册表（`hookConfigTarget.format`），不写死哪家是哪种形态。零配额：不拉起任何 Agent。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { bundleMissing, bundleSkipReason, cli, makeFixture } from '../helpers/fixture.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import { extractJsonCandidate } from '../../src/trivium/parse.js';
+import { AGENTS } from '../../src/trivium/agents/registry.js';
+import { hookNamesOf } from '../../src/trivium/hook-config.js';
+
+const skip = { skip: bundleMissing && bundleSkipReason };
+const ZCODE_FMT = AGENTS.find((a) => a.hookConfigTarget?.format === 'zcode-config')!;
+const CLAUDE_FMT = AGENTS.find((a) => a.hookConfigTarget?.format === 'claude-settings')!;
+const NO_HOOK = AGENTS.find((a) => a.hookConfigTarget === null)!;
+
+function json(stdout: string): Record<string, unknown> {
+  const c = extractJsonCandidate(stdout);
+  assert.ok(c, `输出里没有 JSON：${stdout}`);
+  return JSON.parse(c.json) as Record<string, unknown>;
+}
+
+test('hooks --agent <ZCode 形态的家>：只写该家的配置，不碰 Claude 的', skip, async () => {
+  const { root } = await makeFixture({ topic: 'T', draft: false });
+  const r = await cli(root, ['hooks', '--agent', ZCODE_FMT.id, '--json']);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  const out = json(r.stdout);
+  assert.equal(out['agent'], ZCODE_FMT.id);
+  const zp = path.join(root, ZCODE_FMT.hookConfigTarget!.path);
+  const cfg = JSON.parse(await fs.readFile(zp, 'utf8')) as { hooks: { enabled: boolean; events: Record<string, unknown[]> } };
+  assert.equal(cfg.hooks.enabled, true);
+  const names = Object.values(cfg.hooks.events).flat().flatMap((e) => [...hookNamesOf(e)]);
+  assert.ok(names.includes('pre-write') && names.includes('pre-bash'), names.join('、'));
+  await assert.rejects(fs.access(path.join(root, CLAUDE_FMT.hookConfigTarget!.path)), '只合并指定的一家');
+  assert.ok((out['notes'] as string[]).some((n) => /重新信任/.test(n)), '写入 ZCode 配置后必须提示重新信任');
+});
+
+test('hooks：没有 Hook 机制的家 ⇒ 退 64 并说明 L2；缺 --agent、未登记的 id ⇒ 退 64', skip, async () => {
+  const { root } = await makeFixture({ topic: 'T', draft: false });
+  const none = await cli(root, ['hooks', '--agent', NO_HOOK.id]);
+  assert.equal(none.code, EXIT.USAGE, none.stdout + none.stderr);
+  assert.match(none.stdout + none.stderr, /没有 Hook 机制/);
+  const missing = await cli(root, ['hooks']);
+  assert.equal(missing.code, EXIT.USAGE);
+  assert.match(missing.stdout + missing.stderr, new RegExp(ZCODE_FMT.id), '报错要列出能渲染的家');
+  const unknown = await cli(root, ['hooks', '--agent', 'nosuch']);
+  assert.equal(unknown.code, EXIT.USAGE);
+  for (const f of [ZCODE_FMT, CLAUDE_FMT]) {
+    await assert.rejects(fs.access(path.join(root, f.hookConfigTarget!.path)), '拒绝时零写入');
+  }
+});
+
+test('hooks --dry-run：报告会写什么，但一个文件都不落', skip, async () => {
+  const { root } = await makeFixture({ topic: 'T', draft: false });
+  const r = await cli(root, ['hooks', '--agent', ZCODE_FMT.id, '--dry-run', '--json']);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  assert.deepEqual(json(r.stdout)['created'], [path.join(root, ZCODE_FMT.hookConfigTarget!.path)]);
+  await assert.rejects(fs.access(path.join(root, ZCODE_FMT.hookConfigTarget!.path)));
+});
+
+test('init：两家的 Hook 配置一起合并（r5 §6.1「trivium init 同时合并两家」）', skip, async () => {
+  const { root } = await makeFixture({ topic: 'T', draft: false });
+  const r = await cli(root, ['init', '--json']);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  for (const a of AGENTS.filter((x) => x.hookConfigTarget)) {
+    const p = path.join(root, a.hookConfigTarget!.path);
+    const text = await fs.readFile(p, 'utf8');
+    assert.match(text, /gate hook-pre-write/, `${a.id} 的 ${a.hookConfigTarget!.path} 没有合并进 Hook`);
+  }
+});
diff --git a/test/unit/hook-config.test.ts b/test/unit/hook-config.test.ts
new file mode 100644
index 0000000..673b361
--- /dev/null
+++ b/test/unit/hook-config.test.ts
@@ -0,0 +1,236 @@
+/**
+ * 项目内 Hook 配置的渲染、合并与在场判定（M10b 第 3 步，计划 r10 §3.1.2、§3.2、§3.3；r9 §3.4）。
+ *
+ * 渲染源用仓库里**真实的** `skills/dual-critic/hooks/hooks.json`：ZCode 形态是从它派生的，
+ * 拿一份手写的最小源测，就测不到「源里新加一条 ZCode 没有的工具名」「护栏失效提示点名的文件」这类真实形态。
+ * 注册表按形态取家（`hookConfigTarget.format`），不写死哪家是哪种形态。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import os from 'node:os';
+import { promises as fs } from 'node:fs';
+import {
+  describeGuard, effectiveGuardLevel, gateHoldNotice, hookConfigPresent, hookNamesOf, loadHookSource, mergeAgentHooks,
+  renderHookEvents, type HookEntry, type HookMergeReport, type HookSource,
+} from '../../src/trivium/hook-config.js';
+import { AGENTS, DEFAULT_DRIVER, entryCommandOf, type AgentDescriptor } from '../../src/trivium/agents/registry.js';
+import { REPO_ROOT } from '../helpers/fixture.js';
+
+const HOOKS_JSON = path.join(REPO_ROOT, 'skills/dual-critic/hooks/hooks.json');
+const byFormat = (f: string): AgentDescriptor => {
+  const a = AGENTS.find((x) => x.hookConfigTarget?.format === f);
+  assert.ok(a, `注册表里没有登记 ${f} 形态的家——本组用例的前提不成立`);
+  return a;
+};
+const CLAUDE_FMT = byFormat('claude-settings');
+const ZCODE_FMT = byFormat('zcode-config');
+const NO_HOOK = AGENTS.find((a) => a.hookConfigTarget === null)!;
+
+const report = (): HookMergeReport => ({ created: [], updated: [], skipped: [], notes: [] });
+async function project(): Promise<string> {
+  return fs.mkdtemp(path.join(os.tmpdir(), 'trivium-hookcfg-'));
+}
+async function source(): Promise<HookSource> {
+  const s = await loadHookSource(HOOKS_JSON);
+  assert.ok(s, '读不到仓库的 hooks.json');
+  return s;
+}
+async function readJson(p: string): Promise<Record<string, unknown>> {
+  return JSON.parse(await fs.readFile(p, 'utf8')) as Record<string, unknown>;
+}
+function zcodeEvents(cfg: Record<string, unknown>): Record<string, HookEntry[]> {
+  return ((cfg['hooks'] as Record<string, unknown>)['events'] ?? {}) as Record<string, HookEntry[]>;
+}
+const allNames = (events: Record<string, HookEntry[]>): string[] =>
+  Object.values(events).flat().flatMap((e) => [...hookNamesOf(e)]).sort();
+
+// ─────────────────────────── 渲染 ───────────────────────────
+
+test('渲染：claude-settings 形态原样返回源（与改动前的合并逐字相同）', async () => {
+  const s = await source();
+  assert.equal(renderHookEvents('claude-settings', s, '.claude/settings.json'), s.hooks);
+});
+
+test('渲染：zcode-config 形态——matcher 只留 ZCode 有的工具名、timeout 换成 timeoutMs、提示点名本家配置文件', async () => {
+  const s = await source();
+  const target = ZCODE_FMT.hookConfigTarget!.path;
+  const z = renderHookEvents('zcode-config', s, target);
+  assert.deepEqual(Object.keys(z).sort(), Object.keys(s.hooks).sort(), '事件与源同名同集（ZCode 事件枚举含这五个）');
+  assert.deepEqual(allNames(z), allNames(s.hooks), '五个 gate hook-* 一个不少、一个不多');
+  for (const e of Object.values(z).flat()) {
+    if (e.matcher !== undefined) {
+      assert.match(e.matcher, /^[A-Za-z0-9_|]+$/, '只写精确名单形态：否则 ZCode 当不锚定正则，Write 会误配 TodoWrite');
+      assert.ok(!e.matcher.split('|').includes('NotebookEdit'), 'NotebookEdit 不在 ZCode 工具注册表里');
+    }
+    for (const h of e.hooks as Record<string, unknown>[]) {
+      assert.equal(h['timeout'], undefined, 'ZCode 不认 timeout（秒）');
+      assert.equal(typeof h['timeoutMs'], 'number');
+      assert.ok(!String(h['command']).includes('.claude/settings.json'), '护栏失效提示不能把人指到 Claude 的配置文件');
+    }
+  }
+  const preWrite = z['PreToolUse']!.find((e) => hookNamesOf(e).has('pre-write'))!;
+  assert.deepEqual(preWrite.matcher!.split('|').sort(), ['Edit', 'Write']);
+  const srcPreWrite = s.hooks['PreToolUse']!.find((e) => hookNamesOf(e).has('pre-write'))!;
+  assert.equal((preWrite.hooks[0] as Record<string, unknown>)['timeoutMs'], srcPreWrite.hooks[0]!.timeout! * 1000);
+  assert.match(preWrite.hooks[0]!.command, new RegExp(`${target.replace(/\./g, '\\.')} 中的 TriviumCode Hook`));
+});
+
+test('渲染：matcher 在 ZCode 上一个工具名都不剩 ⇒ 当场抛（静默丢掉整条就是「装上了却不拦」）', () => {
+  const s: HookSource = { hooks: { PreToolUse: [{ matcher: 'NotebookEdit', hooks: [{ type: 'command', command: 'x gate hook-pre-write' }] }] } };
+  assert.throws(() => renderHookEvents('zcode-config', s, '.zcode/config.json'), /一个工具名都不剩/);
+});
+
+// ─────────────────────────── 合并 ───────────────────────────
+
+test('合并（ZCode）：新项目 ⇒ 建 .zcode/config.json、hooks.enabled 置 true、提示重新信任', async () => {
+  const root = await project();
+  const r = report();
+  await mergeAgentHooks(root, ZCODE_FMT, await source(), r, false);
+  const p = path.join(root, ZCODE_FMT.hookConfigTarget!.path);
+  const cfg = await readJson(p);
