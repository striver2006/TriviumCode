+assert.ok(code && vsix && path.isAbsolute(program), '需要 VS Code、最终 VSIX 和绝对交互入口');
+const base = await fs.mkdtemp(path.join(tmpdir(), 'trivium-glm-entry-'));
+const children = [];
+const topic = '入口实测' + path.basename(base).slice(-6);
+const marker = path.basename(base).slice(-6).toUpperCase();
+const initial = '本次为隔离工作区的入口 A 点火验收。使用已认领的现有计划和本工作区的 .trivium/bin/trivium 发起入口 A 的计划审查，审核者是桩。得到本次运行号后请回复 ' + marker + 'A 后紧接 31 乘 17 的结果。本次采样到这里等待续话，勿审批。';
+const questions = [
+  { mode:'busy', text:'请只回复 ' + marker + 'B 后紧接 47 乘 13 的结果。', answer:marker + 'B611' },
+  { mode:'idle', text:'请只回复 ' + marker + 'C 后紧接 29 乘 19 的结果。', answer:marker + 'C551' },
+];
+const digest = async file => createHash('sha256').update(await fs.readFile(file)).digest('hex');
+const summary = {base, topic, program, node, vsix, vsixSha256:await digest(vsix), programSha256:await digest(program), sends:[]};
+const save = async () => fs.writeFile(path.join(base,'result.json'), JSON.stringify(summary,null,2));
+const rows = file => fs.readFile(file, 'utf8').then(t => t.split('\n').flatMap(l => {
+  try { return [JSON.parse(l)]; } catch { return []; }
+}), () => []);
+async function logFile(root) {
+  const items = await fs.readdir(root, {recursive:true});
+  const files = items.filter(f => /[/\\]zcode-[^/\\]+[/\\]zcode-\d{4}-\d\d-\d\d\.jsonl$/.test(f));
+  assert.ok(files.length <= 1, '此新窗口应只有一个 GLM 协同终端');
+  return files[0] && path.join(root,files[0]);
+}
+try {
+  await installVsix({code,base,vsix});
+  const local = YAML.parse(await fs.readFile(path.resolve(extensionRoot,'../.trivium/config.local.yaml'),'utf8'));
+  const {entrypoint, version, version_probe, probed_at} = local.probe.cli.zcode;
+  const fx = await makeWorkspace(base,'repo',topic,{id:'glm',probe:{entrypoint,version,version_probe,probed_at}});
+  const settings = { 'trivium.launch.glmInteractivePath':program };
+  if (node) settings['trivium.launch.glmNodePath'] = node;
+  await fs.mkdir(path.join(fx.root,'.vscode'),{recursive:true});
+  await fs.writeFile(path.join(fx.root,'.vscode/settings.json'), JSON.stringify(settings));
+  const config = path.join(fx.root,'.trivium/config.yaml');
+  const cfg = YAML.parse(await fs.readFile(config,'utf8'));
+  cfg.verify = {build:['node --version'],test:['git status --short']};
+  await fs.writeFile(config,YAML.stringify(cfg));
+  const shared = path.join(fx.root,'.trivium/config.local.yaml');
+  const before = await digest(shared);
+  const w = await openWorkspace(fx,{base,code,vsix,children,terminalAccess:true});
+  Object.assign(summary,{workspace:fx.root, profile:w.profile, extensions:path.join(base,'extensions'), probeEntrypoint:entrypoint});
+  await save();
+  const f = w.frame;
+  await f.locator('#driver').selectOption('glm');
+  await f.locator('#entry').selectOption('A');
+  const others = f.locator('#critics .chip.on').filter({hasNotText:'Antigravity'});
+  while (await others.count()) await others.first().click();
+  await f.locator('#topic').fill(topic);
+  await f.locator('#body').fill(initial);
+  await f.locator('#btnPrechain').click();
+  await until('前置链',async () => {
+    const errors = await f.locator('#steps .fail').allTextContents();
+    assert.equal(errors.length,0,errors.join(' '));
+    return f.locator('#btnIgnite').isEnabled();
+  });
+  await f.locator('#btnIgnite').click();
+  console.log('真实 GLM 窗口：',fx.root,'；若原生客户端请求信任、选模或权限，须由 Bob 在此窗口确认。',base);
+  const logs = path.join(w.profile,'logs');
+  const file = await until('独占 ZCode 日志',() => logFile(logs),300);
+  const started = await until('主会话开始',async () => (await rows(file)).find(r => r.module === 'core.runtime' && r.event === 'turn.started'),1200);
+  summary.sessionId = started.sessionId;
+  summary.logFile = file;
+  const modelFile = path.join(homedir(),'.zcode/cli/rollout','model-io-' + started.sessionId + '.jsonl');
+  const readModel = async () => (await rows(modelFile)).filter(r => r.sessionId === started.sessionId && r.querySource === 'main_turn');
+  const terminalText = async () => (await w.page.locator('.xterm-accessibility-tree').allTextContents()).join('\n');
+  summary.banner = await f.locator('#banner').innerText();
+  for (const q of questions) {
+    if (q.mode === 'idle') await until('原生空闲输入提示',async () => {
+      const s = await terminalText();
+      return /Type a prompt|输入提示词/i.test(s) && !/esc to interrupt/i.test(s);
+    },120);
+    await f.locator('#relayInput').fill(q.text);
+    const clicked = Date.now();
+    await f.locator('#btnRelay').click();
+    summary.sends.push({mode:q.mode,clicked,exactInput:q.text});
+    await save();
+    const reply = await until('真实 GLM ' + q.mode + ' 回答', async () =>
+      (await readModel()).find(r => r.response?.text?.includes(q.answer)),1800);
+    const inputs = reply.request.messages.filter(m => m.role === 'user' && m.content === q.text);
+    assert.equal(inputs.length,1);
+    Object.assign(summary.sends.at(-1),{turnId:reply.turnId, answer:q.answer, startedAt:reply.startedAt, completedAt:reply.completedAt});
+    await until('主轮次结束', async () => (await rows(file)).some(r => r.sessionId === started.sessionId &&
+      r.turnId === reply.turnId && r.event === 'turn.completed'),60);
+    await save();
+  }
+  const model = await readModel();
+  const opening = model.find(r => r.response?.text?.includes(marker + 'A527'));
+  assert.ok(opening);
+  const entryTurn = model.filter(r => r.turnId === opening.turnId);
+  assert.ok(entryTurn.some(r => r.request.messages.some(m => m.role === 'user' && JSON.stringify(m.content).includes(topic))));
+  assert.ok((await terminalText()).includes('/skill dual-run') || entryTurn.some(r =>
+    r.request.messages.some(m => m.role === 'user' && JSON.stringify(m.content).includes('/skill dual-run'))));
+  assert.ok(summary.sends[0].clicked < Date.parse(opening.completedAt));
+  assert.ok(summary.sends[1].clicked >= Date.parse(summary.sends[0].completedAt));
+  assert.equal(new Set([opening.turnId,...summary.sends.map(s=>s.turnId)]).size,3);
+  for (const q of questions) {
+    const turns = model.filter(r => {
+      const users = r.request.messages.filter(m=>m.role === 'user');
+      return users.at(-1)?.content === q.text;
+    });
+    assert.equal(new Set(turns.map(r=>r.turnId)).size,1);
+  }
+  const state = JSON.parse(await fs.readFile(path.join(fx.root,'.trivium/state.json'),'utf8'));
+  const gate = state.gates[topic + '/plan'];
+  assert.equal(gate.session_id,started.sessionId);
+  const run = JSON.parse(await fs.readFile(path.join(fx.root,'.reviews',topic,'plan/_meta','run-'+gate.run_id+'.json'),'utf8'));
+  assert.equal(run.driver,'glm');
+  assert.equal(run.topic,topic);
+  assert.equal(run.entry,'A');
+  assert.deepEqual(Object.keys(run.critics),['gemini']);
+  assert.equal(run.critics.gemini.cli_version,'stub/0.0.0');
+  const card = f.locator('#runs .card').filter({hasText:topic}).filter({hasText:gate.run_id});
+  await card.first().waitFor();
+  Object.assign(summary,{runId:gate.run_id,entry:run.entry,entryTurn:opening.turnId,model:opening.model.modelId,
+    entryAnswer:marker+'A527', critic:run.critics.gemini.cli_version, sharedProbeUnchanged:before === await digest(shared)});
+  assert.ok(summary.sharedProbeUnchanged);
+  await command(w.page,'Terminal: Kill the Active Terminal Instance');
+  await f.locator('#modeBadge.m3').waitFor();
+  assert.ok(await card.count());
+  summary.m3 = true;
+  console.log('安装态入口 A、续话与 M3 通过', summary.runId);
+} catch (e) {
+  summary.error = e.message;
+  process.exitCode = 1;
+  console.error(summary.error);
+} finally {
+  await save();
+  for (const child of children) child.kill();
+}
diff --git a/extension/src/launch/glmInteractive.ts b/extension/src/launch/glmInteractive.ts
new file mode 100644
index 00000000..f0b3643a
--- /dev/null
+++ b/extension/src/launch/glmInteractive.ts
@@ -0,0 +1,88 @@
+// 仅供驾驶舱 M1 使用。核心审核者始终从自己的探针取入口。
+import { constants } from 'node:fs';
+import { access, readFile, realpath, stat } from 'node:fs/promises';
+import { homedir } from 'node:os';
+import path from 'node:path';
+import { parseWrapperNodePath, scriptProviderEnv } from './carriers';
+
+export interface InteractiveProgram {
+  entrypoint: string;
+  launchMode: 'direct' | 'shellCommand';
+  source: '设置' | '自动发现' | '探针';
+  nodePath?: string;
+  scriptEnv?: Record<string, string>;
+}
+
+interface Options {
+  trusted: boolean;
+  configuredPath?: string;
+  configuredNode?: string;
+  cli?: Record<string, unknown>;
+  wrapper: string;
+  searchDirs?: string[];
+}
+
+async function accessibleFile(file: string, mode: number): Promise<boolean> {
+  try {
+    if (!path.isAbsolute(file) || !(await stat(file)).isFile()) return false;
+    await access(file, mode);
+    return true;
+  } catch { return false; }
+}
+
+async function desktopWithoutTui(file: string): Promise<boolean> {
+  if (!file.endsWith('/ZCode.app/Contents/Resources/glm/zcode.cjs')) return false;
+  // 已实测的桌面脚本在普通 Node 下动态导入外部 TUI。允许将来内置该模块的版本。
+  if (!/import\(\s*['"]@zcode\/tui['"]\s*\)/.test(await readFile(file, 'utf8'))) return false;
+  let dir = path.dirname(file);
+  for (;;) {
+    if (await stat(path.join(dir, 'node_modules/@zcode/tui')).then(s => s.isDirectory(), () => false)) return false;
+    const parent = path.dirname(dir);
+    if (parent === dir) return true;
+    dir = parent;
+  }
+}
+
+async function interpreter(o: Options): Promise<string> {
+  if (o.configuredNode) {
+    if (await accessibleFile(o.configuredNode, constants.X_OK)) return o.configuredNode;
+    throw new Error('请修正 trivium.launch.glmNodePath，须填写可执行 Node 的绝对路径：' + o.configuredNode);
+  }
+  const runner = (o.cli?.version_probe as {runner?: unknown} | undefined)?.runner;
+  if (typeof runner === 'string' && await accessibleFile(runner, constants.X_OK)) return runner;
+  const wrapper = await readFile(o.wrapper, 'utf8').catch(() => '');
+  const node = parseWrapperNodePath(wrapper);
+  if (node && await accessibleFile(node, constants.X_OK)) return node;
+  throw new Error('请在终端运行 command -v node，将绝对路径填入 trivium.launch.glmNodePath。');
+}
+
+export async function resolveGlmInteractive(o: Options): Promise<InteractiveProgram> {
+  if (!o.trusted) throw new Error('请先确认当前工作区可信，再启动 GLM 交互终端。');
+  const dirs = o.searchDirs ?? [...(process.env.PATH ?? '').split(path.delimiter),
+    path.join(homedir(), '.local/bin'), '/opt/homebrew/bin', '/usr/local/bin'];
+  const candidates: [string, InteractiveProgram['source']][] = [];
+  if (o.configuredPath) candidates.push([o.configuredPath, '设置']);
+  else {
+    for (const dir of new Set(dirs.filter(p => path.isAbsolute(p)))) candidates.push([path.join(dir, 'zcode'), '自动发现']);
+    if (typeof o.cli?.entrypoint === 'string') candidates.push([o.cli.entrypoint, '探针']);
+  }
+  let reason = '';
+  const fix = '请在终端运行 command -v zcode，将绝对路径填入 trivium.launch.glmInteractivePath，或填写独立发行目录的 bin/zcode.mjs。';
+  for (const [candidate, source] of candidates) {
+    const file = path.isAbsolute(candidate) ? await realpath(candidate).catch(() => '') : '';
+    const script = /\.[cm]?js$/i.test(file);
+    if (!file || !await accessibleFile(file, script ? constants.R_OK : constants.X_OK)) {
+      if (source === '设置') throw new Error('GLM 交互入口无效：' + candidate + '。' + fix);
+      continue;
+    }
+    if (await desktopWithoutTui(file)) {
+      reason = '桌面脚本 ' + file + ' 缺少 @zcode/tui。';
+      if (source === '设置') break;
+      continue;
+    }
+    if (!script) return { source, launchMode: 'direct', entrypoint: candidate };
+    return { source, launchMode: 'shellCommand', entrypoint: file, nodePath: await interpreter(o),
+      scriptEnv: source === '探针' ? scriptProviderEnv(o.cli?.provider_config) : undefined };
+  }
+  throw new Error((reason || '未找到可用的 GLM 交互入口。') + fix);
+}
diff --git a/extension/test/unit/glmInteractive.test.ts b/extension/test/unit/glmInteractive.test.ts
new file mode 100644
index 00000000..ee6977a7
--- /dev/null
+++ b/extension/test/unit/glmInteractive.test.ts
@@ -0,0 +1,56 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { chmod, mkdir, mkdtemp, rm, symlink, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { resolveGlmInteractive } from '../../src/launch/glmInteractive';
+
+test('GLM 主攻入口优先级、独立解释器、兼容探针与错误提示', async t => {
+  const root = await mkdtemp(path.join(tmpdir(), 'GLM paths '));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const script = path.join(root, 'real package.mjs');
+  const wrapper = path.join(root, 'trivium');
+  const direct = path.join(root, 'official zcode');
+  const shim = path.join(root, 'zcode');
+  await writeFile(script, '');
+  await writeFile(direct, '#!/bin/sh\n', { mode: 0o755 });
+  await writeFile(wrapper, 'exec "' + process.execPath + '" "/a/trivium.cjs" "$@"');
+  const provider = {builtin_file: '/builtin', personal_file: '/personal'};
+  const cli = {entrypoint: script, version_probe: {runner: 'node'}, provider_config: provider};
+  const o = {trusted: true, wrapper, searchDirs: [root], cli};
+  const original = JSON.stringify(cli);
+  const legacy = await resolveGlmInteractive(o);
+  assert.equal(legacy.source, '探针');
+  assert.equal(legacy.nodePath, process.execPath);
+  assert.equal(legacy.scriptEnv?.ZCODE_PERSONAL_PROVIDER_CONFIG_FILE, '/personal');
+  await symlink(script, shim);
+  const found = await resolveGlmInteractive(o);
+  assert.equal(found.source, '自动发现');
+  assert.ok(found.entrypoint.endsWith('real package.mjs'));
+  assert.equal(found.scriptEnv, undefined);
+  assert.deepEqual(await resolveGlmInteractive({...o, configuredPath: direct, configuredNode: '脚本专用'}),
+    {source:'设置', entrypoint:direct, launchMode:'direct'});
+  const explicit = await resolveGlmInteractive({...o, configuredPath:script, configuredNode:process.execPath});
+  assert.equal(explicit.nodePath, process.execPath);
+  assert.equal(explicit.source, '设置');
+  assert.equal(explicit.scriptEnv, undefined);
+  for (const bad of ['zcode', root, path.join(root, 'missing')]) {
+    await assert.rejects(resolveGlmInteractive({...o, configuredPath:bad}), /glmInteractivePath/);
+  }
+  await chmod(direct, 0o644);
+  await assert.rejects(resolveGlmInteractive({...o, configuredPath:direct}), /glmInteractivePath/);
+  await assert.rejects(resolveGlmInteractive({...o, configuredNode:root}), /glmNodePath/);
+  await assert.rejects(resolveGlmInteractive({...o, trusted:false}), /可信/);
+  assert.equal(JSON.stringify(cli), original, '驾驶舱解析只读共享探针');
+
+  const desktop = path.join(root, 'ZCode.app/Contents/Resources/glm/zcode.cjs');
+  await mkdir(path.dirname(desktop), {recursive:true});
+  await writeFile(desktop, 'import("@zcode/tui")');
+  await rm(shim);
+  await symlink(desktop, shim);
+  assert.equal((await resolveGlmInteractive(o)).source, '探针');
+  await assert.rejects(resolveGlmInteractive({...o, cli:undefined}), /缺少 @zcode\/tui/);
+  await assert.rejects(resolveGlmInteractive({...o, configuredPath:desktop}), /缺少 @zcode\/tui/);
+  await mkdir(path.join(path.dirname(desktop), 'node_modules/@zcode/tui'), {recursive:true});
+  assert.equal((await resolveGlmInteractive(o)).source, '自动发现');
+});
