@@ -0,0 +1,299 @@
+/**
+ * 变异验证装置（代码双审 r1 CODEX-06 ≡ GLM-06 ≡ AGY-03）。
+ *
+ * ## 为什么要有它
+ *
+ * M9 第 3 步的变异验证**第一批全部作废**，两次失败形态见
+ * `doc/05_testing/REPORT_2026-09-18_m9_claude_admission.md` §5.1：
+ *
+ *   1. 备份按 `basename` 命名，而 `adapters/claude.ts` 与 `probes/claude.ts`
+ *      **同名**——后者覆盖前者，恢复时把探针内容写进了适配器；
+ *   2. 此后构建一直失败，而失败被 `>/dev/null 2>&1` **吞掉**，
+ *      于是每一条变异跑的都是**陈旧产物**；
+ *   3. 第二份备份又是在改过文件**之后**才建的，**把变异版当成了干净基线**。
+ *
+ * 当时补的三条对策是**人工步骤**，而这批失败的本质恰恰是
+ * 「脚本静默地没做我以为它做的事」——本仓纪律 12 的原话是
+ * **「靠记性的纪律要换成不依赖记性的机制」**。所以它们必须是装置的默认行为。
+ *
+ * ## 五道闸，缺一不可
+ *
+ * | 闸 | 防的是 |
+ * | :--- | :--- |
+ * | 备份按**全路径**命名（且单射） | 同名文件互相覆盖（失败 1） |
+ * | 构建失败**非零退出并打印**，**包括收尾那次** | 跑陈旧产物（失败 2） |
+ * | 前置**工作树干净** + **基线全绿** | 坏基线下「条条都红」被误读成「条条咬住」（失败 3） |
+ * | 变异后断言**被测产物确实变了** | 变异 no-op（replace 没匹配上）而我以为它生效了 |
+ * | 每条跑完**恢复件与基线逐字节比对** | 恢复本身失败（写半截、路径再错） |
+ * | 开跑前断言 **cases ⊆ targets** | 规格写漏 ⇒ 变异留在工作树上（恢复面够不到） |
+ *
+ * 第四道是 codex 建议的形态：**用指纹证明身份**，本仓 `TRIVIUM_STUB_CRITIC` 桩有先例。
+ * 没有它，一条 `replace` 悄悄没匹配上就会产出「变异了、没红」的假阴性。
+ *
+ * ## r2 补的四处（代码双审 r2：AGY-01 ≡ CODEX-04、AGY-02 ≡ GLM-06 ≡ CODEX-05、GLM-05、CODEX-06）
+ *
+ * 上一版**自己就有两条「声称强于事实」**，正是它要防的那个形状：
+ *
+ * 1. 闸 4 写「断言**产物**确实变了」，实现比的是**源文件**哈希。两者不等价：
+ *    文件没进 build 图、产物被缓存、构建静默降级时，源文件变了而产物没变，
+ *    这道闸照样判「变异生效」，随后「没红」会被归因成「守卫无效」——
+ *    而真因是变异没进被测产物。**现改为比对被测产物**。
+ * 2. 闸 2 写「绝不吞」，而 `finally` 的收尾重建是 `.catch(() => {})`：失败被静默吞掉，
+ *    且此时若全部 case 已咬住就**退 0，dist 停在陈旧产物上**——失败 2 的复现通道，
+ *    只是挪到了收尾。**现改为打印 + 置 dirty 标志 + 非零退出**。
+ *
+ * 另有一个**不设防的入口**（三侧全中）：`case.file ∉ spec.targets` 时，
+ * 变异照写、恢复时 ENOENT、而 `finally` 只遍历 `targets` ⇒ **变异留在工作树里**。
+ * 「残留变异版被当成下一轮干净基线」恰是本装置要防的第二类失败——
+ * **它在自己的入口上复现了自己要防的东西**。现加闸 6 拦在任何写盘之前。
+ *
+ * 还有一处：闸 3 只验「**测得出的**坏基线」。工作树若残留一个测不出来的变异
+ * （恰是那些判「没红」的），闸 3 照样放行。报告 §5.3 第 3 条纪律（「建基线前先确认
+ * 工作树干净」）此前**没有进装置**，现补成 `git status --porcelain` 前置检查。
+ *
+ * ## 用法
+ *
+ *   node scripts/mutation-check.mjs <规格文件.json>
+ *
+ * 规格文件形如：
+ *   { "targets": ["src/a.ts"], "suites": ["dist/test/test/unit/x.test.js"],
+ *     "cases": [{ "id": "M1", "desc": "…", "file": "src/a.ts",
+ *                 "find": "原文", "replace": "变异", "expect": "dist/…/y.test.js" }] }
+ *
+ * 每条 case 的 `expect` 是**期望变红的套件**（省略则用全部 `suites`）。
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+
+const run = promisify(execFile);
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+/**
+ * 备份键：**全路径**扁平化，不用 basename（失败 1 就出在这里）。
+ *
+ * **必须单射**（代码双审 r2 CODEX-05）：上一版把 `/` 直接换成 `_`，于是
+ * `a/b_c.ts` 与 `a_b/c.ts` 同键——恢复会把一份文件的内容写进另一份，
+ * 而闸 5 的哈希比对随后才抛错，那时 `finally` 已经写进去了。
+ * 先转义已有的 `_` 再换分隔符，映射即单射。
+ */
+const backupKey = (rel) => rel.replace(/_/g, '__').replace(/[\\/]/g, '_S_');
+
+async function sha(file) {
+  return createHash('sha256').update(await fs.readFile(file)).digest('hex');
+}
+
+/**
+ * 源文件 → **被测产物**路径（`src/a.ts` → `dist/test/src/a.js`）。
+ *
+ * 闸 4 要比的是它，不是源文件（代码双审 r2 AGY-01 ≡ CODEX-04）：
+ * 源文件变了而产物没变的情形是真实存在的（文件没进 build 图、产物被缓存、
+ * 构建静默降级），那时这道闸会判「变异生效」，而随后的「没红」会被归因成
+ * 「守卫无效」——真因却是变异压根没进被测产物。
+ */
+function artifactOf(rel) {
+  return path.join('dist/test', rel.replace(/\.ts$/, '.js'));
+}
+
+/**
+ * 上次运行有没有异常退出（闸 3 的前半，代码双审 r2 CODEX-06）。
+ *
+ * ## 为什么不是 `git status --porcelain`
+ *
+ * CODEX-06 的建议字面是「对 targets 做 `git status --porcelain`，非空即拒」。
+ * **照字面实现会误伤到不可用**：本装置的典型使用场景就是**一批尚未提交的改动**
+ * （M9 第 3 步全程 19 个文件 M/??），那样它永远拒跑。实测确认过——
+ * 第一版就是这么写的，第一次跑就拦住了自己。
+ *
+ * 它真正要防的是「**本装置上次异常退出留下的残留**」被当成干净基线，
+ * 而那与「有没有未提交改动」是两回事。所以判据换成一个**装置自己的哨兵**：
+ * 开跑时落一个标记，正常结束（含 `finally` 恢复完成）时删掉。
+ * 下次开跑发现它还在 ⇒ 上次没善终 ⇒ 工作树可能带着变异 ⇒ 拒绝。
+ *
+ * 这比 git 判据更精确：它只对本装置的失败形态说话，不管人的提交习惯。
+ */
+const SENTINEL = path.join(ROOT, '.mutation-check-running');
+
+async function staleRun() {
+  try {
+    return await fs.readFile(SENTINEL, 'utf8');
+  } catch {
+    return null;
+  }
+}
+
+async function build() {
+  // **绝不吞错**：构建失败要带着 stderr 抛出来（失败 2 就出在这里）
+  try {
+    await run('node', [path.join(ROOT, 'scripts/build.mjs'), '--with-tests'], { cwd: ROOT });
+  } catch (e) {
+    throw new Error(`构建失败，变异未生效——本次结果不可信：\n${e.stderr ?? e.message}`);
+  }
+}
+
+/** 跑一组套件，返回失败数（`node --test` 失败时退出码非 0，这里只数 fail 行） */
+async function runSuites(suites) {
+  let out = '';
+  try {
+    const r = await run('node', ['--test', ...suites], { cwd: ROOT, maxBuffer: 64 * 1024 * 1024 });
+    out = r.stdout;
+  } catch (e) {
+    out = (e.stdout ?? '') + (e.stderr ?? '');
+  }
+  const m = /^ℹ fail (\d+)$/m.exec(out);
+  if (!m) throw new Error(`读不出测试结果（套件路径写错了？）：\n${out.slice(-600)}`);
+  return Number(m[1]);
+}
+
+async function main() {
+  const specPath = process.argv[2];
+  if (!specPath) {
+    console.error('用法：node scripts/mutation-check.mjs <规格文件.json>');
+    process.exit(64);
+  }
+  const spec = JSON.parse(await fs.readFile(specPath, 'utf8'));
+  const bak = await fs.mkdtemp(path.join(os.tmpdir(), 'trivium-mut-'));
+
+  const results = [];
+  /** 收尾重建失败时置位——绝不静默吞（GLM-05） */
+  let dirtyExit = false;
+  try {
+    /*
+     * ── 闸 6：`cases ⊆ targets`，拦在**任何写盘之前** ──
+     *
+     * 不校验的话：变异照写 → 恢复时备份不存在抛 ENOENT → `finally` 只遍历 targets
+     * ⇒ **变异留在工作树里**，而错误信息是裸 ENOENT、不提「树已脏」。
+     * 「残留变异版被当成下一轮干净基线」恰是本装置要防的第二类失败——
+     * 规格写错是本装置的第一类用户输入，这个入口此前不设防（三侧全中）。
+     */
+    const missing = [...new Set(spec.cases.map((c) => c.file))].filter(
+      (f) => !spec.targets.includes(f),
+    );
+    if (missing.length > 0) {
+      throw new Error(
+        `规格错误：这些 case 的 file 不在 targets 里，恢复面够不到它们：\n  ${missing.join('\n  ')}\n` +
+          '  （在任何写盘之前拦下——否则变异会留在工作树上）',
+      );
+    }
+
+    // ── 闸 1：备份按全路径命名 ──
+    for (const rel of spec.targets) {
+      await fs.copyFile(path.join(ROOT, rel), path.join(bak, backupKey(rel)));
+    }
+    const baseHash = {};
+    const baseArt = {};
+    for (const rel of spec.targets) baseHash[rel] = await sha(path.join(ROOT, rel));
+
+    // ── 闸 3 前半：上次运行必须善终过（此前只是报告里的一条人工纪律，CODEX-06）──
+    const stale = await staleRun();
+    if (stale) {
+      throw new Error(
+        `上一次运行没有善终（哨兵还在）：\n  ${stale.trim()}\n` +
+          '  工作树可能带着上次的变异——基线全绿只能验出「**测得出的**」坏基线，\n' +
+          '  而一个测不出来的残留（恰是那些判「没红」的）会让本轮所有结论\n' +
+          '  都相对被污染过的基线算出，备份还会把污染一路带着。\n' +
+          `  确认工作树无误后删掉 ${path.relative(ROOT, SENTINEL)} 再来。`,
+      );
+    }
+    await fs.writeFile(SENTINEL, `started_at=${new Date().toISOString()}\nspec=${specPath}\n`, 'utf8');
+
+    // ── 闸 3 后半：基线全绿 ──
+    await build();
+    const baseFail = await runSuites(spec.suites);
+    if (baseFail !== 0) {
+      throw new Error(
+        `基线不是全绿（fail=${baseFail}）——拒绝开跑。\n` +
+          '  坏基线下每条变异都会「红」，而那与「变异被咬住」不是一回事：\n' +
+          '  M9 第 3 步第二次事故正是这个形态。先把基线修绿再来。',
+      );
+    }
+    // 基线产物哈希要在**构建之后**取（闸 4 拿它作比较基准）
+    for (const rel of spec.targets) {
+      baseArt[rel] = await sha(path.join(ROOT, artifactOf(rel))).catch(() => null);
+    }
+    console.error(`✓ 工作树干净、基线全绿（${spec.suites.length} 个套件）`);
+
+    for (const c of spec.cases) {
+      const abs = path.join(ROOT, c.file);
+      const before = await fs.readFile(abs, 'utf8');
+      if (!before.includes(c.find)) {
+        results.push({ id: c.id, desc: c.desc, verdict: '✖ 变异未命中（find 串对不上，本条无效）' });
+        continue;
+      }
+      await fs.writeFile(abs, before.replace(c.find, c.replace), 'utf8');
+
+      // ── 闸 4：断言**被测产物**确实变了 ──
+      await build();
+      const art = path.join(ROOT, artifactOf(c.file));
+      const nowArt = await sha(art).catch(() => null);
+      if (nowArt === null) {
+        results.push({ id: c.id, desc: c.desc, verdict: `✖ 找不到被测产物 ${artifactOf(c.file)}——无法证明变异进了产物` });
+      } else if (nowArt === baseArt[c.file]) {
+        results.push({
+          id: c.id,
+          desc: c.desc,
+          verdict: '✖ **产物哈希未变**——变异没进被测产物（no-op / 未进 build 图 / 构建降级）',
+        });
+      } else {
+        const fail = await runSuites(c.expect ? [c.expect] : spec.suites);
+        results.push({
+          id: c.id,
+          desc: c.desc,
+          verdict: fail > 0 ? `✓ 咬住（fail=${fail}）` : '✖ **没红**——该守卫对这条变异无效',
+          fail,
+        });
+      }
+
+      // ── 闸 5：恢复并逐字节比对 ──
+      await fs.copyFile(path.join(bak, backupKey(c.file)), abs);
+      if ((await sha(abs)) !== baseHash[c.file]) {
+        throw new Error(`恢复 ${c.file} 后哈希与基线不符——工作树已脏，停下来人工处理`);
+      }
+      console.error(`  ${c.id} ${results.at(-1).verdict}`);
+    }
+  } finally {
+    /*
+     * 原子清理：异常/中断退出时也把文件恢复回去（AGY-03）。
+     * **恢复失败要说出来**——上一版是 `.catch(() => {})`，于是中途异常时工作树
+     * 可能带着变异退出，而外层打印的是原始错误、不提树已脏（GLM-05）。
+     */
+    for (const rel of spec.targets) {
+      try {
+        await fs.copyFile(path.join(bak, backupKey(rel)), path.join(ROOT, rel));
+      } catch (e) {
+        dirtyExit = true;
+        console.error(`✖ 恢复 ${rel} 失败：${e.message}——**工作树可能已脏，下一轮基线不可信**`);
+      }
+    }
+    await fs.rm(bak, { recursive: true, force: true });
+    /*
+     * 收尾重建同样**不吞**：上一版是 `.catch(() => {})`，于是全部 case 咬住时
+     * 会退 0 而 dist 停在陈旧产物上——下一个人直接 `node --test dist/…`
+     * 跑的又是旧产物，正是闸 2 声称「绝不」放过的失败 2，只是挪到了收尾。
+     */
+    try {
+      await build();
+    } catch (e) {
+      dirtyExit = true;
+      console.error(`✖ 收尾重建失败：${e.message}——**dist 停在陈旧产物上**`);
+    }
+    /*
+     * **哨兵只在善终时删**：恢复或重建出过错就留着它，
+     * 下次开跑会被闸 3 前半拦下并说明原因。
+     */
+    if (!dirtyExit) await fs.rm(SENTINEL, { force: true });
+  }
+
+  const bad = results.filter((r) => r.verdict.startsWith('✖'));
+  console.log(JSON.stringify({ 总数: results.length, 咬住: results.length - bad.length, 逐条: results }, null, 2));
+  if (bad.length > 0 || dirtyExit) process.exit(1);
+}
+
+main().catch((e) => {
+  console.error(e.stack ?? String(e));
+  process.exit(1);
+});
diff --git a/src/trivium/adapters/claude-trace.ts b/src/trivium/adapters/claude-trace.ts
new file mode 100644
index 0000000..5462cae
--- /dev/null
+++ b/src/trivium/adapters/claude-trace.ts
@@ -0,0 +1,310 @@
+/**
+ * Claude Code 的 `stream-json` 轨迹解析（M9 第 3 步）。
+ *
+ * ## 为什么住在 `adapters/` 而不是 `probes/`
+ *
+ * 原先 `parseClaudeEvents` 与 `ClaudeTrace` 住在 `probes/claude.ts`，而适配层
+ * **不得 import `probes/`**（`registry-parity` 第 5 条）。三家先例的方向都是
+ * **探针反向 import 适配层**（`probes/agy.ts` ← `adapters/agy-events.ts`、
+ * `probes/zcode.ts` ← `adapters/zcode-trace.ts`、codex 同构），本文件照此搬家。
+ * 一处事实一个来源，不出现两份解析器。
+ *
+ * ## 为什么只有解析器搬过来，两个只读常量留在探针侧
+ *
+ * `READONLY_INVARIANTS` 与 `READONLY_TOOLS` **必须留在 `probes/claude.ts`**。
+ * 把它们搬进 `adapters/` 会让 `registry-parity` 第 6 条的**两条腿同时响亮打红**：
+ * 主扫命中黑名单 token，正向防空转腿发现 token 已不在 `probes/` 出现。
+ *
+ * **理由是「会当场红」，不是「会静默绿」**——计划原稿写的是后者，被计划双审
+ * GLM-04 逐条验过打回（两条腿都是响亮失败，不是静默通过）。结论不变，机理写准。
+ *
+ * ## 本文件里的裸工具名是允许的，但只在本文件族
+ *
+ * 下面的 `CLAUDE_READ_TOOLS` 等常量里有裸 `'Read'` / `'Grep'` / `'Glob'`。
+ * `registry-parity` 第 6 条的黑名单锁的是**全形** `'Read,Grep,Glob'`（逗号连写），
+ * 而「分解形加强判据」的论域是 **全部适配器文件 − `-trace` / `-events` 分类文件族**
+ * ——本文件属于豁免的那一族。
+ *
+ * 分工的道理：分解形要咬的是「argv 构造处把只读工具名拆开写」这一种规避，
+ * 而 trace 文件族按职责就要出现裸工具名做事件分类
+ * （`zcode-trace.ts` 的 `ZCODE_READ_TOOLS` 是现成先例）。
+ *
+ * > **措辞改准（代码双审 r2 AGY-03 ≡ GLM-07 ≡ CODEX-07）**：上一版这里写的是
+ * > 「只对 `adapters/<cli>.ts` 精确匹配生效」，那是 **r1 修复之前**的论域，
+ * > 而 r1 的 CODEX-05 ≡ AGY-01 ≡ GLM-04 正是要求把它从「单个主文件」**扩到全域**
+ * > （codex 家配方无逗号项 ⇒ 分解形集合为空 ⇒ 跨厂商文件整段 no-op）。
+ * > 照旧文本去「对齐实现」，最省事的动作就是把论域收窄回去——
+ * > **那会直接削掉 r1 刚补齐的跨厂商能力**，正是 EV-39 自己担心的事。
+ * > 权威措辞以设计 v1.3.26 为准。
+ *
+ * 另注：本文件**不需要** `LITERAL_ALLOWLIST` 条目——那是 Agent id 字面量扫描
+ * （防的是硬编码 `'claude'` 这类身份串），**与第 6 条黑名单是两回事**，
+ * 只要本文件不出现带引号的 `'claude'` 即可（同 `codex-trace.ts`）。
+ */
+
+/** 一次 headless 调用解析出来的轨迹 */
+export interface ClaudeTrace {
+  /** `system/init` 回读的生效配置 */
+  init: { model: string | null; tools: string[]; permissionMode: string | null } | null;
+  /** 全部 `tool_use`：工具名 + 参数 + id（id 用于与 tool_result 配对） */
+  toolUses: { name: string; input: Record<string, unknown>; id: string | null }[];
+  /** 出错的 `tool_result` 文本（白名单外工具走这条路，不进 permission_denials） */
+  toolErrors: string[];
+  /** 收到 `is_error` 结果的那些 `tool_use_id`——判据要配对，不能只数错误条数 */
+  erroredToolUseIds: Set<string>;
+  /** `result` 事件里的权限拒绝记录（路径级 deny 走这条路） */
+  permissionDenials: { tool_name: string; tool_input: Record<string, unknown> }[];
+  finalText: string | null;
+  sessionId: string | null;
+  costUsd: number | null;
+  /**
+   * 跑完了没有。
+   *
+   * 判据是「有 `result` 事件**且它不是错误形态**」——错误路径的 result
+   * （预算掐断、max_turns 一类）不算跑完（审查意见 GLM-05）。
+   *
+   * 初版只看「存在 type === 'result'」，忽略事件自带的 `is_error` / `subtype`，
+   * 而注释却写着「与另两家同口径」——codex 的 `traceCompleted` 要求
+   * 「有最终回复」，错误运行拿不到回复即未完成。两边并不同口径，
+   * 后果是错误路径被塌缩成「测了，答案是读不到文件」的确定否定。
+   *
+   * 判据取**保守形态**：不是 success 就按未得出结论处理。
+   * 不枚举已知的错误 subtype——那些取值我没有实测样本（见 M6 第 3 步报告边界）。
+   */
+  completed: boolean;
+  /**
+   * 成功解析出的事件条数。
+   *
+   * 立此字段是为了让 `judgeVerboseBinding` **复用本解析器的口径**，
+   * 而不是在它自己那边再写一份「什么算一条事件」（代码双审 CODEX-07）——
+   * 两处各存一份判据，日后事件行格式一变就会分叉，
+   * 正是本轮在 `path_deny` 上刚消掉的同一形态。
+   *
+   * 口径即下方循环的口径：`{` 开头且 `JSON.parse` 成功的行。坏行不计。
+   */
+  eventCount: number;
+}
+
+/**
+ * 解析 `--output-format stream-json` 的 JSONL。
+ *
+ * 坏行跳过而不是抛：真实输出里混过非 JSON 的提示行。
+ */
+export function parseClaudeEvents(jsonl: string): ClaudeTrace {
+  let init: ClaudeTrace['init'] = null;
+  const toolUses: ClaudeTrace['toolUses'] = [];
+  const toolErrors: string[] = [];
+  const erroredToolUseIds = new Set<string>();
+  let permissionDenials: ClaudeTrace['permissionDenials'] = [];
+  let finalText: string | null = null;
+  let sessionId: string | null = null;
+  let costUsd: number | null = null;
+  let completed = false;
+  let eventCount = 0;
+
+  for (const line of jsonl.split('\n')) {
+    const t = line.trim();
+    if (!t.startsWith('{')) continue;
+    let o: Record<string, unknown>;
+    try {
+      o = JSON.parse(t) as Record<string, unknown>;
+    } catch {
+      continue;
+    }
+    eventCount += 1;
+    if (typeof o['session_id'] === 'string') sessionId = o['session_id'];
+
+    if (o['type'] === 'system' && o['subtype'] === 'init') {
+      init = {
+        model: typeof o['model'] === 'string' ? o['model'] : null,
+        tools: Array.isArray(o['tools']) ? (o['tools'] as string[]) : [],
+        permissionMode: typeof o['permissionMode'] === 'string' ? o['permissionMode'] : null,
+      };
+    }
+
+    const message = o['message'] as { content?: unknown } | undefined;
+    const content = message?.content;
+    if (Array.isArray(content)) {
+      for (const raw of content) {
+        const b = raw as Record<string, unknown>;
+        if (b['type'] === 'tool_use' && typeof b['name'] === 'string') {
+          toolUses.push({
+            name: b['name'],
+            input: (b['input'] as Record<string, unknown> | undefined) ?? {},
+            id: typeof b['id'] === 'string' ? b['id'] : null,
+          });
+        }
+        if (b['type'] === 'tool_result' && b['is_error'] === true) {
+          toolErrors.push(typeof b['content'] === 'string' ? b['content'] : JSON.stringify(b['content']));
+          if (typeof b['tool_use_id'] === 'string') erroredToolUseIds.add(b['tool_use_id']);
+        }
+      }
+    }
+
+    if (o['type'] === 'result') {
+      /*
+       * 保守形态：`is_error` 为真、或 `subtype` 存在且不是 success，一律不算跑完。
+       * 错误 result 的具体取值没有实测样本，所以按「不是 success 就存疑」判，
+       * 而不是枚举已知错误类型——枚举漏一个就退回旧行为。
+       */
+      const sub = typeof o['subtype'] === 'string' ? o['subtype'] : null;
+      completed = o['is_error'] !== true && (sub === null || sub === 'success');
+      if (typeof o['result'] === 'string') finalText = o['result'];
+      if (typeof o['total_cost_usd'] === 'number') costUsd = o['total_cost_usd'];
+      if (Array.isArray(o['permission_denials'])) {
+        permissionDenials = o['permission_denials'] as ClaudeTrace['permissionDenials'];
+      }
+    }
+  }
+
+  return {
+    init,
+    toolUses,
+    toolErrors,
+    erroredToolUseIds,
+    permissionDenials,
+    finalText,
+    sessionId,
+    costUsd,
+    completed,
+    eventCount,
+  };
+}
+
+// ─────────────────────── 工具面分类与路径提取（M9 第 3 步新增） ───────────────────────
+
+/**
+ * 只读工具面里的读类工具。
+ *
+ * **这不是安全不变量的副本**：安全不变量（哪些工具被允许）由探针实测挣来、
+ * 经 `probe.readonly_flags` 原样透传，适配层不得字面重建。本集合回答的是
+ * 另一个问题——**轨迹里这次调用该归到哪一类计数**，是事后核验的分类表。
+ *
+ * 两者今天取值重合，而**来源与失效方式不同**：探针那份被清空时该侧判不可用；
+ * 本集合是解析器的分类依据，与该侧可不可用无关。
+ */
+export const CLAUDE_READ_TOOLS = new Set(['Read', 'Grep', 'Glob']);
+
+/**
+ * 读类工具里**必然带路径**的那一档（设计 §10.1.1 第②层的覆盖率分母）。
+ *
+ * **只有 `Read`，与 agy 侧的四个不同**——这不是口径不统一，是厂商契约的差异：
+ * 本侧 `Grep` / `Glob` 的路径参数是**可选**的（不传即从当前工作目录搜），
+ * 把它们计进分母会让降级档位变成**稳态噪声**，淹掉真信号。
+ *
+ * **与 `zcode-trace.ts` 的 `ZCODE_MUST_HAVE_PATH` 同形且同因**（那一侧的注释
+ * 把理由写过一遍）。两家分母相同、与 agy 不同这件事本身要写明，
+ * 否则下一个人会以为其中一侧漏配了。
+ */
+export const CLAUDE_MUST_HAVE_PATH = new Set(['Read']);
+
+/**
+ * 各工具的参数里，路径可能叫这几个名字。**逐键的证据等级不同，如实标注**：
+ *
+ * | 键 | 证据 |
+ * | :--- | :--- |
+ * | `file_path` | **本侧实测样本证过**：`test/fixtures/claude-events/*.jsonl` 里 `Read` 与 `Write` 的 `tool_use.input` 都用它 |
+ * | `path` | **本侧无实测样本**。旁证是同族衍生 CLI（`zcode-trace.ts` 的 `ZCODE_PATH_KEYS` 含它，M0 实测），工具面同源 |
+ * | `notebook_path` | **本侧无实测样本**，同上旁证；宽收无代价（键不存在就取不到） |
+ *
+ * ## 为什么明知无样本也要收 `path`
+ *
+ * 设计 §3.7 对 M9 写死了一条：「CLI 层的路径拦截**不完整**，事后轨迹核验仍是
+ * 必需项，**且必须覆盖 `Grep` 的 `path` 参数**」——`permissions.deny` 对 `Grep`
+ * 实测**不生效**，那条通道的唯一兜底就是这里。收不到就等于那条兜底不存在。
+ *
+ * 而 v1.3.12 教训七记过同一形态的实账：措施 a 对 agy 的 grep 通道**全盲**，
+ * 因为 `PATH_KEYS` 不含它的搜索目录参数名，实测 15 次 grep 提出 **0** 条路径。
+ * 修法就是把那个键名加进去。宽收的代价是 0，漏收的代价是一条兜底静默失效。
+ *
+ * ## 待取证（M9 第 3 步 EV-43 复验时办）
+ *
+ * EV-43 的 `path_deny` 那格**必跑 Grep 臂**，届时把真实事件流落一份进
+ * `test/fixtures/claude-events/`，本表的第二、三行即可从旁证升为实测。
+ * **不靠记性**：`claude-trace.test.ts` 有一条契约用例扫全部夹具样本，
+ * 凡值呈路径形态的 `tool_use.input` 键都必须在本表里，键名不对**当场红**。
+ */
+export const CLAUDE_PATH_KEYS = ['file_path', 'path', 'notebook_path'];
+
+/** 从一次 `tool_use` 的参数里提取路径；取不到返回 null（如 Grep 只给了 pattern） */
+export function extractClaudePath(input: Record<string, unknown>): string | null {
+  for (const k of CLAUDE_PATH_KEYS) {
+    const v = input[k];
+    if (typeof v === 'string' && v.length > 0) return v;
+  }
+  return null;
+}
+
+/**
+ * 成功执行的 `tool_use`——即**没有**收到 `is_error` 结果的那些。
+ *
+ * 读取证据必须按这个口径算，不能拿全集：**被 deny 挡住的 `Read` 不算读到了东西**，
+ * 不排掉会让路径级 deny 真正生效时反而抬高证据计数（方向正好相反）。
+ * 与 `agy-events.ts` 的同名手法同构。
+ */
+export function successfulToolUses(trace: ClaudeTrace): ClaudeTrace['toolUses'] {
+  return trace.toolUses.filter((u) => u.id === null || !trace.erroredToolUseIds.has(u.id));
+}
+
+/** 成功读取到的项目路径（去重，保持首次出现顺序） */
+export function readPaths(trace: ClaudeTrace): string[] {
+  const out = new Set<string>();
+  for (const u of successfulToolUses(trace)) {
+    if (!CLAUDE_READ_TOOLS.has(u.name)) continue;
+    const p = extractClaudePath(u.input);
+    if (p) out.add(p);
+  }
+  return [...out];
+}
+
+/**
+ * 路径提取的覆盖率（设计 §10.1.1 第②层）。
+ *
+ * 分母只含 `CLAUDE_MUST_HAVE_PATH`。两者不等即**提取器已相对厂商参数名退化**——
+ * 厂商改了参数名而 `CLAUDE_PATH_KEYS` 没跟上时，这一格是唯一会说话的地方。
+ *
+ * 口径与 agy / zcode 两家同构：`total` 是必带路径的调用数，
+ * `withPath` 是其中真提到了路径的。**两个计数都要无条件填进 `CriticResult`**，
+ * 算不出写 `null` 也不要省略键——`zcode.ts` 那边记过，省略键会让
+ * `verification.path` 档位恒为 `ok`，等于拿 ok 填「不知道」。
+ */
+export function pathCoverage(trace: ClaudeTrace): { total: number; withPath: number } {
+  let total = 0;
+  let withPath = 0;
+  for (const u of successfulToolUses(trace)) {
+    if (!CLAUDE_MUST_HAVE_PATH.has(u.name)) continue;
+    total += 1;
+    if (extractClaudePath(u.input)) withPath += 1;
+  }
+  return { total, withPath };
+}
+
+/**
+ * 按读类工具分别计数。
+ *
+ * **不产出 `run_command`**：该侧的只读工具面里**没有命令工具**（Bash 不在其中），
+ * 给一个不存在的概念记 0 与「跑了 0 条命令」长得一样，而两者含义不同。
+ * 这与 agy 不同——那边 `run_command` 是真实存在的失守信号。
+ */
+export function countTools(trace: ClaudeTrace): { read: number; grep: number; glob: number } {
+  let read = 0;
+  let grep = 0;
+  let glob = 0;
+  for (const u of successfulToolUses(trace)) {
+    if (u.name === 'Read') read += 1;
+    else if (u.name === 'Grep') grep += 1;
+    else if (u.name === 'Glob') glob += 1;
+  }
+  return { read, grep, glob };
+}
+
+/**
+ * 最终回复文本。
+ *
+ * **带 `--json-schema` 时它是一个 JSON 字符串、要再 parse 一次**
+ * （`types.ts` 的 `json_schema_ok` 字段实测结论）。本函数只取原文，
+ * 解析交给调用方——审查结论的 schema 校验在 `parse.ts` 那一层，不在这里。
+ */
+export function finalReviewText(trace: ClaudeTrace): string | null {
+  return trace.finalText;
+}
