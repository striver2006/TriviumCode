+           */
+          degradations,
+        },
+        null,
+        2,
+      ),
+      'utf8',
+    );
+
+    return buildClaudeResult(trace, out, { stdout: stdoutPath, trace: tracePath }, probe, readonlyTools, deny);
+  },
+};
