+  }
+  if (p.strict_mcp_config_applied !== true) {
+    throw new Error(
+      `strict_mcp_config_applied=${p.strict_mcp_config_applied}，MCP 硬前置未确认在场。\n` +
+        '  不确认就拉起，用户已连接的 MCP 写工具会进入会话工具面（且成本约 24 倍）。',
