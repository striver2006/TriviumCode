+    await fs.writeFile(
+      tracePath,
+      JSON.stringify(
+        {
+          sessionId: trace.sessionId,
+          init: trace.init,
+          toolUses: trace.toolUses,
+          toolErrors: trace.toolErrors,
+          permissionDenials: trace.permissionDenials,
+          eventCount: trace.eventCount,
