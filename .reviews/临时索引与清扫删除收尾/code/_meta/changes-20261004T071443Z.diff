+const CREATED: string[] = [];
+after(async () => {
+  for (const d of CREATED) {
+    await unlockAll(d);
+    await fs.rm(d, { recursive: true, force: true, maxRetries: 3 }).catch((e: unknown) => {
+      console.warn(`temp-index-cleanup：私有根没删掉，请手工删除 ${d}（${(e as NodeJS.ErrnoException).code ?? String(e)}）`);
+    });
+  }
