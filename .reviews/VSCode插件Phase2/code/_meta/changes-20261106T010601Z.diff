@@ -0,0 +1,278 @@
+/**
+ * location 归一与行号校验（FR-6b 前置，r2 计划 D2′）。
+ *
+ * 归一：分号多文件位置拆分；单位置行号部分支持逗号多区间（真实工件实测
+ * `cockpit.ts:418-424,524-530,533-546`，AGY-02）；剥引号/`./` 前缀；绝对路径
+ * 截取工作区相对段；统一 path.resolve 后 containment 判定防 `..` 逃逸（CLAUDE-07）。
+ *
+ * 行号校验：行号有效性由**文件一致性判据**承担（静态 git blob 比对在 Hub 层、
+ * 动态 hash 重校验在 Hub 层，此处只接收结果）；锚文本（反引号片段）仅在
+ * **确认失配**（越界/文件已变）后作重定位启发式，比对空白归一化（AGY-03）；
+ * 多处命中判歧义降文件级（CLAUDE-08）；无行号/非法行号 → 文件级「未给行号」。
+ *
+ * 纯函数模块：不 import vscode，readFile 由调用方注入。
+ */
+import path from 'node:path';
+
+/** 单文件的逗号多区间（1 起始，含端点） */
+export interface LineRange {
+  start: number;
+  end: number;
+}
+
+/** 归一后的单个文件位置 */
+export interface FileAnchor {
+  relPath: string;
+  /** 主锚点在前；无行号为空数组 */
+  ranges: LineRange[];
+}
+
+export type NormalizedLocation =
+  | { kind: 'file'; anchors: FileAnchor[] }
+  | { kind: 'doc'; text: string }
+  | { kind: 'outside'; text: string };
+
+/** 文件级一致性结论（静态/动态判据的输出，resolveAnchor 的输入） */
+export interface FileConsistency {
+  state: 'unknown' | 'consistent' | 'mismatch' | 'edited';
+  note: string | null;
+}
+
+export const CONSISTENCY_UNKNOWN: FileConsistency = { state: 'unknown', note: null };
+
+/** 单个锚点的解析结果 */
+export interface AnchorResolution {
+  relPath: string;
+  /** 原始行号（无则 null） */
+  raw: LineRange | null;
+  level: 'line' | 'file';
+  /** 最终采用的行区间（level=file 时为 null） */
+  line: LineRange | null;
+  drift: 'nearby' | 'out-of-range' | 'line-lost' | 'multi-hit' | null;
+  /** UI 标注（如「未给行号」） */
+  label: string | null;
+}
+
+/** 一个 finding 的全部锚点解析结果（主锚点在前） */
+export interface LocationResolution {
+  kind: 'file' | 'doc' | 'outside' | 'missing-file';
+  /** kind=file：文件存在时的锚点；kind=missing-file：未解析的 relPath */
+  anchors: AnchorResolution[];
+  /** missing-file 时指向未能打开的相对路径 */
+  missingRelPath: string | null;
+  consistency: FileConsistency;
+}
+
+// ── 归一 ───────────────────────────────────────────────────────────────────
+
+/** 行号部分：`88` / `23-29` / `418-424,524-530,533` → 区间列表；不匹配/含 0 或负数返回 null（CLAUDE-09/AGY-02） */
+export function parseRanges(part: string): LineRange[] | null {
+  if (!/^[1-9]\d*(?:-[1-9]\d*)?(?:,[1-9]\d*(?:-[1-9]\d*)?)*$/.test(part)) return null;
+  const out: LineRange[] = [];
+  for (const seg of part.split(',')) {
+    const [a, b] = seg.split('-');
+    const start = Number(a);
+    const end = b === undefined ? start : Number(b);
+    out.push({ start: Math.min(start, end), end: Math.max(start, end) });
+  }
+  return out;
+}
+
+function stripQuotes(s: string): string {
+  const t = s.trim();
+  if (t.length >= 2 && ((t.startsWith("'") && t.endsWith("'")) || (t.startsWith('"') && t.endsWith('"')))) {
+    return t.slice(1, -1);
+  }
+  return t;
+}
+
+/**
+ * 单段位置 → {relPath, ranges} 或 null（非文件形态）。
+ * relPath 已过 containment 判定；越界由调用方标 outside。
+ */
+function normalizeSegment(seg: string, workspaceRoot: string): { relPath: string | null; ranges: LineRange[] | null; doc: boolean } {
+  let s = stripQuotes(seg.trim());
+  if (s.length === 0) return { relPath: null, ranges: null, doc: true };
+  while (s.startsWith('./')) s = s.slice(2);
+
+  // 拆 path:lines（找最后一个冒号，其后是合法行号形态才算）
+  let relPath = s;
+  let ranges: LineRange[] | null = null;
+  const colon = s.lastIndexOf(':');
+  if (colon > 0) {
+    const parsed = parseRanges(s.slice(colon + 1).trim());
+    if (parsed !== null) {
+      relPath = s.slice(0, colon);
+      ranges = parsed;
+    } else if (/^:\S*$/.test(s.slice(colon)) && /[-\d]/.test(s.slice(colon + 1))) {
+      // 非法行号尾巴（如 `:-1`、`:0`）：剥离后按无行号处理（CLAUDE-09/AGY-02）
+      relPath = s.slice(0, colon);
+    }
+  }
+  relPath = stripQuotes(relPath.trim());
+
+  // 绝对路径 → 工作区相对段（不含工作区则越界）
+  if (path.isAbsolute(relPath)) {
+    const norm = path.resolve(relPath);
+    const root = path.resolve(workspaceRoot) + path.sep;
+    if (!(norm + path.sep).startsWith(root)) {
+      return { relPath: null, ranges: null, doc: false }; // 调用方按 outside 处理
+    }
+    relPath = norm.slice(root.length);
+  } else {
+    // 相对路径统一 resolve 后 containment（防 ../ 逃逸，CLAUDE-07；符号链接不解析——登记边界）
+    const resolved = path.resolve(workspaceRoot, relPath);
+    const root = path.resolve(workspaceRoot) + path.sep;
+    if (!(resolved + path.sep).startsWith(root)) {
+      return { relPath: null, ranges: null, doc: false };
+    }
+    relPath = resolved.slice(root.length);
+  }
+
+  // 非文件形态判定（如 plan §3.2、设计 §16.2）：含空格 → doc；扩展名须字母开头
+  // （排除 §3.2 的 .2 这类数字尾）；裸词（无斜杠无点，如 README）试文件——
+  // missing-file 兜底标注比「文档引用」更有信息量
+  if (/\s/.test(relPath) && ranges === null) {
+    return { relPath: null, ranges: null, doc: true };
+  }
+  const hasSlash = relPath.includes('/');
+  const letterExt = /\.[A-Za-z][A-Za-z0-9_-]*$/.test(relPath);
+  const noDot = !relPath.includes('.');
+  if (!hasSlash && !letterExt && !noDot && ranges === null) {
+    return { relPath: null, ranges: null, doc: true }; // 如 v1.2（版本号引用）
+  }
+  return { relPath, ranges, doc: false };
+}
+
+/** location 归一入口：分号（中英文）拆多文件位置 */
+export function normalizeLocation(loc: string, workspaceRoot: string): NormalizedLocation {
+  const segs = loc.split(/[；;]/).map((s) => s.trim()).filter((s) => s.length > 0);
+  if (segs.length === 0) return { kind: 'doc', text: loc };
+  const anchors: FileAnchor[] = [];
+  for (const seg of segs) {
+    const r = normalizeSegment(seg, workspaceRoot);
+    if (r.doc) return { kind: 'doc', text: loc };
+    if (r.relPath === null) return { kind: 'outside', text: loc };
+    anchors.push({ relPath: r.relPath, ranges: r.ranges ?? [] });
+  }
+  return { kind: 'file', anchors };
+}
+
+// ── 锚文本提取（AGY-03：仅失配后的重定位启发式） ──────────────────────────
+
+const ANCHOR_MIN_LEN = 8;
+
+/** 反引号片段 ≥8 字符；排除路径形态（含 / 或以 . 开头的配置串）与纯数字 */
+export function extractAnchorTexts(problem: string, evidence: string): string[] {
+  const out: string[] = [];
+  for (const src of [problem, evidence]) {
+    for (const m of src.matchAll(/`([^`\n]{8,})`/g)) {
+      const t = m[1]!.trim();
+      if (t.length < ANCHOR_MIN_LEN) continue;
+      if (t.includes('/') || /^\d+([.\-_]\d+)*$/.test(t)) continue;
+      if (!out.includes(t)) out.push(t);
+    }
+  }
+  return out.slice(0, 4);
+}
+
+/** 空白归一化（`pool.length===1` 与 `pool.length === 1` 视为同一串，AGY-03） */
+function squash(s: string): string {
+  return s.replace(/\s+/g, '');
+}
+
+/** 在窗口内找唯一包含任一锚文本（空白归一化）的行；返回行号或 null（多命中 → -1） */
+function findUniqueAnchorLine(lines: string[], from: number, to: number, anchors: string[]): number | -1 | null {
+  if (anchors.length === 0) return null;
+  let hit: number | null = null;
+  for (let i = from; i <= to && i < lines.length; i++) {
+    const squashed = squash(lines[i] ?? '');
+    if (squashed.length === 0) continue;
+    if (anchors.some((a) => squashed.includes(squash(a)))) {
+      if (hit !== null) return -1; // 多处命中：歧义（CLAUDE-08）
+      hit = i;
+    }
+  }
+  return hit;
+}
+
+// ── 行号校验 ───────────────────────────────────────────────────────────────
+
+export interface ResolveOptions {
+  /** 读文件内容（默认按 fs 注入；测试可传内存映射或编辑器缓冲区） */
+  readFile: (relPath: string) => Promise<string | null>;
+  /** 文件一致性结论（静态 git blob 比对 / 动态 hash 重校验的输出；缺省 unknown） */
+  consistency?: (relPath: string) => FileConsistency;
+  /** 失配重定位用的锚文本（调用方从 finding 语境提取；缺省无锚可用） */
+  anchorTexts?: string[];
+}
+
+const NEARBY_WINDOW = 20;
+
+/**
+ * 解析一个 finding 的全部锚点。
+ * 规则（r2 计划 D2′）：
+ * - 文件读不到 → missing-file（只进意见列表，不建 thread/诊断）；
+ * - 无行号/非法 → 文件级「未给行号」（区别于漂移）；
+ * - 行号界内 → 行级（一致性标注由 consistency 携带，不在此判漂移）；
+ * - 行号越界 → 锚文本邻近搜索：唯一命中 → 行级 nearby；多命中 → 文件级 multi-hit；
+ *   无锚/未命中 → 文件级 out-of-range（找不到锚时）/line-lost（有锚没搜到）。
+ */
+export async function resolveLocation(loc: string, workspaceRoot: string, opts: ResolveOptions): Promise<LocationResolution> {
+  const norm = normalizeLocation(loc, workspaceRoot);
+  if (norm.kind !== 'file') {
+    return { kind: norm.kind, anchors: [], missingRelPath: null, consistency: CONSISTENCY_UNKNOWN };
+  }
+  // 以主锚点文件为一致性载体；读不到主文件 → missing-file
+  const primary = norm.anchors[0]!;
+  const primaryText = await opts.readFile(primary.relPath);
+  if (primaryText === null) {
+    return { kind: 'missing-file', anchors: [], missingRelPath: primary.relPath, consistency: CONSISTENCY_UNKNOWN };
+  }
+  const consistency = opts.consistency?.(primary.relPath) ?? CONSISTENCY_UNKNOWN;
+  const lines = primaryText.split('\n');
+  const lineCount = lines.length;
+
+  const anchors: AnchorResolution[] = [];
+  for (let i = 0; i < norm.anchors.length; i++) {
+    const a = norm.anchors[i]!;
+    const raw = a.ranges.length > 0 ? a.ranges[0]! : null;
+    if (i > 0) {
+      // 次级锚点：只保留归一结果（正文可引用），不做行号校验（不套用主文件行数）
+      anchors.push({ relPath: a.relPath, raw, level: 'file', line: null, drift: null, label: `次级位置${raw ? ` L${raw.start}${raw.end !== raw.start ? `-${raw.end}` : ''}` : ''}` });
+      continue;
+    }
+    if (raw === null || raw.start < 1) {
+      anchors.push({ relPath: a.relPath, raw: null, level: 'file', line: null, drift: null, label: '未给行号' });
+      continue;
+    }
+    // 同文件逗号多区间的次级区间（AGY-02/CLAUDE-08）：界内 → 行级标注；越界 → 文件级标注
+    for (const extra of a.ranges.slice(1)) {
+      if (extra.start >= 1 && extra.start <= lineCount) {
+        anchors.push({ relPath: a.relPath, raw: extra, level: 'line', line: { start: extra.start, end: Math.min(extra.end, lineCount) }, drift: null, label: `次级区间 L${extra.start}${extra.end !== extra.start ? `-${extra.end}` : ''}` });
+      } else {
+        anchors.push({ relPath: a.relPath, raw: extra, level: 'file', line: null, drift: null, label: `次级区间 L${extra.start} 越界，未挂行` });
+      }
+    }
+    if (raw.start > lineCount) {
+      // 越界：邻近搜索（失配重定位，AGY-03 启发式）
+      const anchorTexts = opts.anchorTexts ?? [];
+      const from = Math.max(0, Math.min(raw.start - 1, lineCount - 1) - NEARBY_WINDOW);
+      const to = Math.min(lineCount - 1, raw.end - 1 + NEARBY_WINDOW);
+      const hit = findUniqueAnchorLine(lines, from, to, anchorTexts);
+      if (hit === null || hit === -1) {
+        anchors.push({
+          relPath: a.relPath, raw, level: 'file', line: null,
+          drift: hit === -1 ? 'multi-hit' : anchorTexts.length > 0 ? 'line-lost' : 'out-of-range',
+          label: hit === -1 ? '多处命中，降为文件级' : anchorTexts.length > 0 ? '行号越界且锚文本未命中，降为文件级' : '行号越界（超出文件行数），降为文件级',
+        });
+      } else {
+        anchors.push({ relPath: a.relPath, raw, level: 'line', line: { start: hit + 1, end: hit + 1 }, drift: 'nearby', label: `原 L${raw.start}，按锚文本邻近命中 L${hit + 1}` });
+      }
+      continue;
+    }
+    // 界内：信任行号（有效性由一致性判据承担）
+    anchors.push({ relPath: a.relPath, raw, level: 'line', line: { start: raw.start, end: Math.min(raw.end, lineCount) }, drift: null, label: null });
+  }
+  return { kind: 'file', anchors, missingRelPath: null, consistency };
+}
diff --git a/extension/src/reviews/metaWatch.ts b/extension/src/reviews/metaWatch.ts
new file mode 100644
index 00000000..9467e067
--- /dev/null
+++ b/extension/src/reviews/metaWatch.ts
@@ -0,0 +1,77 @@
+/**
+ * `_meta/` 目录监视（r2 计划 D4′/D7′：CODEX-03/AGY-01 服务级持有）。
+ *
+ * 监听 `.reviews/<主题>/<阶段>/_meta/` 下 review-*.json 与 changes-*.diff 的
+ * 落盘/变更（侧完成即归档，CLAUDE-06 第一批），事件触发全量 rescan（幂等）。
+ *
+ * 用 node `fs.watch`（目录级，吃原子替换 tmp+rename）而非 vscode FileSystemWatcher：
+ * 归档根可能不在 VS Code workspace 内（多根/子目录场景），workspace 外路径的
+ * vscode watcher 事件不可靠——第一批 RunWatch 已实测踩坑（交付说明平台事实 3）。
+ * 生命周期归 AnnotationHub（随 scope 启停）——独立于驾驶舱面板。
+ */
+import * as vscode from 'vscode';
+import path from 'node:path';
+import { watch, type FSWatcher } from 'node:fs';
+
+export interface MetaFile {
+  absPath: string;
+  name: string;
+}
+
+export class MetaWatch implements vscode.Disposable {
+  private watcher: FSWatcher | null = null;
+  private readonly listeners = new Set<(files: MetaFile[]) => void>();
+  private disposed = false;
+
+  constructor(
+    private readonly metaDir: string,
+    private readonly listDir: (p: string) => Promise<string[]> = defaultListDir,
+  ) {
+    this.mount();
+    void this.rescan();
+  }
+
+  /** 目录级监听；目录被重建（原子替换整目录的场景）时重挂 */
+  private mount(): void {
+    try {
+      this.watcher = watch(this.metaDir, { persistent: false }, () => void this.rescan());
+    } catch {
+      // 目录尚不存在：AnnotationsHub 在 scope 建立时会先 ingest（读到空），
+      // 目录由编排器创建后无事件——由 Hub 的 setActiveRun/ingest 补扫兜底
+      this.watcher = null;
+    }
+  }
+
+  async rescan(): Promise<void> {
+    if (this.disposed) return;
+    let names: string[];
+    try {
+      names = await this.listDir(this.metaDir);
+    } catch {
+      return;
+    }
+    // 挂载失败的目录此刻可能已建：补挂
+    if (!this.watcher) this.mount();
+    const files = names
+      .filter((n) => /^review-.+\.json$/.test(n) || /^changes-.*\.diff$/.test(n))
+      .sort()
+      .map((name) => ({ absPath: path.join(this.metaDir, name), name }));
+    for (const l of this.listeners) l(files);
+  }
+
+  onChange(listener: (files: MetaFile[]) => void): void {
+    this.listeners.add(listener);
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    this.watcher?.close();
+    this.watcher = null;
+    this.listeners.clear();
+  }
+}
+
+async function defaultListDir(p: string): Promise<string[]> {
+  const { promises: fs } = await import('node:fs');
+  return fs.readdir(p);
+}
diff --git a/extension/src/reviews/reviewParse.ts b/extension/src/reviews/reviewParse.ts
new file mode 100644
index 00000000..9c55b4b5
--- /dev/null
+++ b/extension/src/reviews/reviewParse.ts
@@ -0,0 +1,168 @@
+/**
+ * review.v2 审查正本解析（FR-6a 数据面，r2 计划 D1′）。
+ *
+ * 消费 `.reviews/<主题>/<阶段>/_meta/review-<critic>-<runId>.json`：
+ * - 文件名解析出 critic/runId（不匹配命名模式 → unrecognized，不出意见）；
+ * - 逐文件降级：JSON 坏 → parse-error；schema 非 v2 → unsupported-schema（携带实际串）；
+ * - finding 级容错：单条缺必填字段/枚举外值 → 跳过并计数（不整份丢弃）；
+ * - 全部状态进 ReviewFileStatus，供驾驶舱与历史树共同消费（CLAUDE-06）。
+ *
+ * 纯函数模块：不 import vscode，readFile 由调用方注入。
+ */
+import { checkSchema } from '../env/versionCheck';
+
+/** review.v2 契约的 severity 四档 */
+export type FindingSeverity = 'blocker' | 'major' | 'minor' | 'nit';
+/** review.v2 契约的 verdict 三档 */
+export type ReviewVerdict = 'pass' | 'pass-after-changes' | 'reject';
+
+export interface ReviewFinding {
+  id: string;
+  severity: FindingSeverity;
+  layer: string;
+  kind: string;
+  location: string;
+  problem: string;
+  evidence: string;
+  suggestion: string;
+  confidence: string;
+}
+
+/** 逐文件状态（CLAUDE-06：贯穿驾驶舱与历史树的降级可见性） */
+export interface ReviewFileStatus {
+  critic: string;
+  runId: string;
+  state: 'ok' | 'partial-skipped' | 'parse-error' | 'unsupported-schema' | 'unrecognized';
+  /** 实际读到的 schema 串（parse-error 时为 null） */
+  actualSchema: string | null;
+  /** 被跳过的 finding 条数（仅 partial-skipped） */
+  skippedCount: number;
+  /** 可读的降级原因（UI 直接展示） */
+  notice: string | null;
+}
+
+export interface ParsedReview {
+  status: ReviewFileStatus;
+  verdict: ReviewVerdict | null;
+  summary: string | null;
+  findings: ReviewFinding[];
+  agreed: string[];
+  notCovered: string[];
+  consulted: string[];
+}
+
+const SEVERITIES: readonly string[] = ['blocker', 'major', 'minor', 'nit'];
+/** review.v2 契约的 layer/kind/confidence 枚举（CLAUDE-10：表外值同样计入跳过） */
+const LAYERS: readonly string[] = ['requirement', 'plan', 'code', 'rca'];
+const KINDS: readonly string[] = ['correctness', 'security', 'concurrency', 'contract', 'test-gap', 'maintainability', 'scope-drift', 'performance'];
+const CONFIDENCES: readonly string[] = ['high', 'medium', 'low'];
+const VERDICTS: readonly string[] = ['pass', 'pass-after-changes', 'reject'];
+
+/** `review-<critic>-<runId>.json` 文件名解析；不匹配返回 null */
+export function parseReviewFileName(name: string): { critic: string; runId: string } | null {
+  const m = /^review-([A-Za-z0-9_]+)-(\d{8}T\d{6}Z)\.json$/.exec(name);
+  return m ? { critic: m[1]!, runId: m[2]! } : null;
+}
+
+function isNonEmptyString(v: unknown): v is string {
+  return typeof v === 'string' && v.length > 0;
+}
+
+function statusOf(critic: string, runId: string, state: ReviewFileStatus['state'], actualSchema: string | null, skippedCount: number, notice: string | null): ParsedReview {
+  return { status: { critic, runId, state, actualSchema, skippedCount, notice }, verdict: null, summary: null, findings: [], agreed: [], notCovered: [], consulted: [] };
+}
+
+/**
+ * 解析一份审查正本。任何降级路径都不抛异常：坏输入返回带状态的空意见。
+ */
+export function parseReviewFile(fileName: string, text: string): ParsedReview {
+  const ident = parseReviewFileName(fileName);
+  if (!ident) {
+    return statusOf('', '', 'unrecognized', null, 0, `文件名不匹配 review-<审查者>-<runId>.json：${fileName}`);
+  }
+  const { critic, runId } = ident;
+
+  let obj: unknown;
+  try {
+    obj = JSON.parse(text) as unknown;
+  } catch (e) {
+    return statusOf(critic, runId, 'parse-error', null, 0, `JSON 解析失败：${e instanceof Error ? e.message : String(e)}`);
+  }
+  if (typeof obj !== 'object' || obj === null || Array.isArray(obj)) {
+    return statusOf(critic, runId, 'parse-error', null, 0, '根元素不是对象');
+  }
+  const root = obj as Record<string, unknown>;
+  const actualSchema = isNonEmptyString(root['schema']) ? root['schema'] : null;
+
+  const verdict = checkSchema(actualSchema, 'review');
+  if (verdict.kind !== 'ok') {
+    return statusOf(critic, runId, 'unsupported-schema', actualSchema, 0, `该侧工件版本不支持（${verdict.reason}），未展示意见`);
+  }
+
+  const findingsRaw = Array.isArray(root['findings']) ? root['findings'] : [];
+  const findings: ReviewFinding[] = [];
+  let skipped = 0;
+  for (const item of findingsRaw) {
+    if (typeof item !== 'object' || item === null) {
+      skipped++;
+      continue;
+    }
+    const f = item as Record<string, unknown>;
+    const required: Array<keyof ReviewFinding> = ['id', 'severity', 'layer', 'kind', 'location', 'problem', 'evidence', 'suggestion', 'confidence'];
+    const missing = required.filter((k) => !isNonEmptyString(f[k]));
+    if (missing.length > 0) {
+      skipped++;
+      continue;
+    }
+    // 枚举校验：severity/layer/kind/confidence 表外值跳过（review.v2 契约，CLAUDE-10）
+    if (
+      !SEVERITIES.includes(f['severity'] as string) ||
+      !LAYERS.includes(f['layer'] as string) ||
+      !KINDS.includes(f['kind'] as string) ||
+      !CONFIDENCES.includes(f['confidence'] as string)
+    ) {
+      skipped++;
+      continue;
+    }
+    findings.push({
+      id: f['id'] as string,
+      severity: f['severity'] as FindingSeverity,
+      layer: f['layer'] as string,
+      kind: f['kind'] as string,
+      location: f['location'] as string,
+      problem: f['problem'] as string,
+      evidence: f['evidence'] as string,
+      suggestion: f['suggestion'] as string,
+      confidence: String(f['confidence']),
+    });
+  }
+
+  const out = statusOf(critic, runId, skipped > 0 ? 'partial-skipped' : 'ok', actualSchema, skipped, skipped > 0 ? `${skipped} 条意见缺必填字段或枚举外值，已跳过` : null);
+  out.findings = findings;
+  out.verdict = VERDICTS.includes(root['verdict'] as string) ? (root['verdict'] as ReviewVerdict) : null;
+  out.summary = isNonEmptyString(root['summary']) ? root['summary'] : null;
+  out.agreed = Array.isArray(root['agreed']) ? root['agreed'].filter(isNonEmptyString) : [];
+  out.notCovered = Array.isArray(root['not_covered']) ? root['not_covered'].filter(isNonEmptyString) : [];
+  out.consulted = Array.isArray(root['consulted']) ? root['consulted'].filter(isNonEmptyString) : [];
+  return out;
+}
+
+/** severity → 中文标签（UI 徽标用） */
+export function severityLabel(s: FindingSeverity): string {
+  return { blocker: '阻断', major: '重要', minor: '次要', nit: '微瑕' }[s];
+}
+
+/** verdict → 中文标签 */
+export function verdictLabel(v: ReviewVerdict | null): string {
+  if (v === 'pass') return '通过';
+  if (v === 'pass-after-changes') return '修改后通过';
+  if (v === 'reject') return '不通过';
+  return '未知';
+}
+
+/** 一组解析件的 severity 计数（findingsSummary / 历史树统计用） */
+export function countSeverities(reviews: ParsedReview[]): Record<FindingSeverity, number> {
+  const out: Record<FindingSeverity, number> = { blocker: 0, major: 0, minor: 0, nit: 0 };
+  for (const r of reviews) for (const f of r.findings) out[f.severity]++;
+  return out;
+}
diff --git a/extension/test/integration/annotations.test.ts b/extension/test/integration/annotations.test.ts
new file mode 100644
index 00000000..f77b3d5e
--- /dev/null
+++ b/extension/test/integration/annotations.test.ts
@@ -0,0 +1,239 @@
+/**
+ * 批注宿主集成测试（r2 计划 D9′：FR-6b/6c 核心断言）。
+ *
+ * 真实 VS Code 宿主 + Phase 2 夹具（源文件 + _meta 三侧 review JSON +
+ * changes.diff + git 冻结基线）。Comments 断言走 threadsSnapshot 可观测面
+ * （VS Code 无公开枚举 API，事实 20）；诊断走 languages.getDiagnostics。
+ */
+import * as assert from 'node:assert/strict';
+import * as vscode from 'vscode';
+import path from 'node:path';
+import { AnnotationHub, resetHubGitApiCacheForTest } from '../../src/reviews/annotationHub';
+import { buildPhase2Fixture, waitFor, type Phase2Fixture } from './fixtureLib';
+
+/**
+ * 伪 git API（测试环境 --disable-extensions 禁用内置 git 扩展）：
+ * toGitUri → `${fsPath}.baseline`（夹具留有基线快照文件，内容 = git 基线提交版）。
+ */
+const fakeGitApi = (): { toGitUri: (uri: vscode.Uri) => vscode.Uri } => ({
+  toGitUri: (uri) => vscode.Uri.file(`${uri.fsPath}.baseline`),
+});
+
+function reviewOf(critic: string, findings: Array<Record<string, string>>): string {
+  return JSON.stringify({ schema: 'trivium.review.v2', verdict: 'pass', summary: 's', findings: findings.map((f, i) => ({
+    id: f.id ?? `${critic}-${i}`, severity: f.severity, layer: 'code', kind: 'correctness',
+    location: f.location, problem: f.problem, evidence: f.evidence, suggestion: 's', confidence: 'high',
+  })) }, null, 2);
+}
+
+suite('批注宿主（FR-6b/6c）', function () {
+  this.timeout(60_000);
+  let fx: Phase2Fixture;
+  let hub: AnnotationHub;
+
+  suiteSetup(async () => {
+    fx = await buildPhase2Fixture();
+  });
+  setup(async () => {
+    resetHubGitApiCacheForTest(fakeGitApi());
+    hub = new AnnotationHub(fx.root);
+    await hub.setScope('DemoTopic', 'code');
+    await waitFor(() => hub.threadsSnapshot().length > 0);
+  });
+  teardown(() => {
+    hub.dispose();
+    resetHubGitApiCacheForTest(null);
+  });
+
+  test('装配：三侧同层线程 + 分层不覆盖 + 区间贯通（CLAUDE-05）', () => {
+    const threads = hub.threadsSnapshot();
+    // sample.ts: C-01(2-4) C-02(3) G-01(3) G-02(nearby→3) X-01(2-3) → 行 2 与行 3 两线程
+    const sampleThreads = threads.filter((t) => t.relPath === 'src/sample.ts');
+    assert.ok(sampleThreads.length >= 2, `sample.ts 线程数：${sampleThreads.length}`);
+    const line3 = sampleThreads.find((t) => t.startLine === 3 && t.endLine === 3);
+    assert.ok(line3, '行 3 线程存在（C-02/G-01/G-02-nearby 合并）');
+    const critics = line3!.comments.map((c) => c.critic).sort();
+    assert.deepEqual(critics, ['claude', 'gemini', 'gemini'], '同 thread 多侧多 comment 分层');
+    const line2 = sampleThreads.find((t) => t.startLine === 2);
+    assert.ok(line2, '行 2 线程存在（C-01 区间与 X-01 主锚点）');
+    assert.equal(line2!.endLine, 4, 'C-01 的 2-4 区间贯通到线程 range');
+    assert.match(line2!.label, /claude|codex/);
+  });
+
+  test('诊断：severity 四档映射 + range 与线程同源（FR-6c）', () => {
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'sample.ts'));
+    const diags = vscode.languages.getDiagnostics(uri);
+    const byCode = new Map(diags.map((d) => [String(d.code), d]));
+    // 六条建对象意见：C-01/02/03、G-01/02、X-01（C-04/X-02/X-03 走 listOnly）
+    for (const id of ['C-01', 'C-02', 'C-03', 'G-01', 'G-02', 'X-01']) {
+      assert.ok(byCode.get(id), `诊断 ${id} 存在`);
+    }
+    assert.equal(byCode.get('C-01')!.severity, vscode.DiagnosticSeverity.Error, 'blocker→Error');
+    assert.equal(byCode.get('C-02')!.severity, vscode.DiagnosticSeverity.Error, 'major→Error');
+    assert.equal(byCode.get('G-01')!.severity, vscode.DiagnosticSeverity.Warning, 'minor→Warning');
+    assert.equal(byCode.get('X-01')!.severity, vscode.DiagnosticSeverity.Information, 'nit→Information');
+    // range 同源：C-01 诊断区间 = 2-4
+    assert.equal(byCode.get('C-01')!.range.start.line, 1);
+    assert.equal(byCode.get('C-01')!.range.end.line, 3);
+    assert.equal(byCode.get('C-01')!.source, 'TriviumCode 审查');
+  });
+
+  test('漂移显式：越界无锚→文件级 out-of-range；越界有锚→nearby（AGY-03/CLAUDE-08）', () => {
+    const threads = hub.threadsSnapshot();
+    const fileLevel = threads.find((t) => t.relPath === 'src/sample.ts' && t.startLine === 1 && t.label.includes('文件级'));
+    assert.ok(fileLevel, 'C-03 越界无锚 → 文件级线程（首行）');
+    assert.match(fileLevel!.label, /文件级/);
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'sample.ts'));
+    const diags = vscode.languages.getDiagnostics(uri);
+    const c03 = diags.find((d) => d.code === 'C-03');
+    assert.ok(c03, 'C-03 诊断存在');
+    assert.match(c03!.message, /行号越界/, '诊断显式标注漂移');
+    // G-02 越界有锚 → nearby 重定位到行 3
+    const g02 = diags.find((d) => d.code === 'G-02');
+    assert.ok(g02);
+    assert.equal(g02!.range.start.line, 2, 'G-02 nearby 重定位到 L3');
+    assert.match(g02!.message, /邻近|原 L9999|漂移/);
+  });
+
+  test('listOnly：doc / missing-file / outside 不建线程与诊断（CLAUDE-06 展示面在列表）', () => {
+    const threads = hub.threadsSnapshot();
+    assert.ok(!threads.some((t) => t.relPath.includes('gone-missing')));
+    assert.ok(!threads.some((t) => t.relPath === 'outside.ts'));
+    const findings = hub.findingsOfFocusRun();
+    assert.ok(findings.some((f) => f.id === 'C-04' && f.level === 'doc'));
+    assert.ok(findings.some((f) => f.id === 'X-02' && f.level === 'missing'));
+    assert.ok(findings.some((f) => f.id === 'X-03' && f.level === 'outside'));
+    // 八条建对象意见（C-01/02/03、G-01/02、X-01、X-04 stale、X-05 drifting），三条 listOnly 不进诊断
+    assert.equal(hub.diagnosticsSnapshot().length, 8);
+  });
+
+  test('逐家开关：切换即全量重建（D3′）', async () => {
+    await hub.setEnabledCritics(new Set(['claude']));
+    await waitFor(() => hub.threadsSnapshot().every((t) => t.comments.every((c) => c.critic === 'claude')));
+    const threads = hub.threadsSnapshot();
+    assert.ok(threads.length > 0);
+    for (const t of threads) for (const c of t.comments) assert.equal(c.critic, 'claude');
+    // 空集合 = 全部
+    await hub.setEnabledCritics(new Set());
+    await waitFor(() => hub.threadsSnapshot().some((t) => t.comments.some((c) => c.critic === 'gemini')));
+  });
+
+  test('切换 scope 全清：无孤儿诊断（D4′）', async () => {
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'sample.ts'));
+    assert.ok(vscode.languages.getDiagnostics(uri).length > 0, '切换前有诊断');
+    await hub.setScope('DemoTopic', 'plan'); // 无 plan 归档 → 空装配
+    await waitFor(() => hub.threadsSnapshot().length === 0);
+    assert.equal(vscode.languages.getDiagnostics(uri).length, 0, '切换后诊断全清（无孤儿）');
+    // 回切 code 恢复
+    await hub.setScope('DemoTopic', 'code');
+    await waitFor(() => hub.threadsSnapshot().length > 0);
+  });
+
+  test('服务级 metaWatch：无面板也可消费侧完成落盘（CODEX-03/AGY-01）', async () => {
+    // 本测试从不创建驾驶舱面板——Hub 独立消费 _meta 落盘
+    const before = hub.threadsSnapshot().length;
+    await fx.writeMeta('review-claude-20261106T000009Z.json', JSON.stringify({
+      schema: 'trivium.review.v2', verdict: 'pass', summary: '新轮',
+      findings: [{ id: 'C2-01', severity: 'major', layer: 'code', kind: 'correctness', location: 'src/sample.ts:7', problem: '新意见', evidence: 'e', suggestion: 's', confidence: 'high' }],
+    }));
+    // 新 run 落盘 → 焦点自动切到最新 run（runId 字典序 20261106T000009Z > 000005Z）
+    await waitFor(() => hub.currentRunId === '20261106T000009Z');
+    await waitFor(() => hub.threadsSnapshot().some((t) => t.relPath === 'src/sample.ts' && t.startLine === 7));
+    assert.ok(before >= 0);
+  });
+
+  test('文件关闭→重开：线程恢复不重复（CLAUDE-03/CODEX-06 语义）', async () => {
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'sample.ts'));
+    const count = hub.threadsSnapshot().length;
+    const doc = await vscode.workspace.openTextDocument(uri);
+    await vscode.window.showTextDocument(doc, { preview: true });
+    await vscode.commands.executeCommand('workbench.action.closeActiveEditor');
+    await new Promise((r) => setTimeout(r, 300));
+    await vscode.window.showTextDocument(doc, { preview: true });
+    await new Promise((r) => setTimeout(r, 300));
+    assert.equal(hub.threadsSnapshot().length, count, '关闭重开线程数恒定（VS Code 线程随文档管理）');
+    assert.equal(vscode.languages.getDiagnostics(uri).length > 0, true, '诊断仍准确');
+    await vscode.commands.executeCommand('workbench.action.closeActiveEditor');
+  });
+
+  test('挂载后编辑 → 一致性重校验显式标注（CLAU-01/CODEX-02 动态判据）', async () => {
+    // 「服务级 metaWatch」用例已写入新轮工件——显式回放主 run 再校验
+    await hub.setActiveRun(fx.run2Id);
+    await waitFor(() => hub.findingsOfFocusRun().some((x) => x.id === 'C-01'));
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'sample.ts'));
+    const doc = await vscode.workspace.openTextDocument(uri);
+    const editor = await vscode.window.showTextDocument(doc, { preview: false });
+    // 编辑行 3 内容（行数不变——「无锚+整体改写+行数够」回归由 consistency 兜住）
+    await editor.edit((b) => {
+      const line = doc.lineAt(2);
+      b.replace(line.range, '  const size = 42;');
+    });
+    try {
+      await waitFor(() => {
+        const f = hub.findingsOfFocusRun().find((x) => x.id === 'C-01');
+        return f?.consistency === 'edited';
+      }, 20_000);
+      const diags = vscode.languages.getDiagnostics(uri);
+      assert.match(diags.find((d) => d.code === 'C-01')!.message, /文件已在批注挂载后被编辑|已编辑/, '诊断显式标注不静默');
+    } finally {
+      await vscode.commands.executeCommand('workbench.action.closeActiveEditor');
+    }
+  });
+
+  test('静态一致性（送审内容重建，CLAUDE-02）：首次挂载即见 consistent/mismatch（CLAUDE-03/CODEX-04）', async () => {
+    // 「服务级 metaWatch」用例已写入新轮工件——显式回放主 run（首次挂载语义）
+    await hub.setActiveRun(fx.run2Id);
+    await waitFor(() => hub.findingsOfFocusRun().some((x) => x.id === 'X-04'));
+    const findings = hub.findingsOfFocusRun();
+    // sample.ts：工作区 == 基线+补丁（送审时点内容）→ consistent
+    const c01 = findings.find((x) => x.id === 'C-01');
+    assert.equal(c01!.consistency, 'consistent', 'sample.ts 与送审版本一致');
+    // drifting.ts：同为送审时点内容 → consistent
+    const x05 = findings.find((x) => x.id === 'X-05');
+    assert.equal(x05!.consistency, 'consistent', 'drifting.ts 与送审版本一致');
+    // stale.ts：送审后工作区又改 → mismatch（诊断显式标注，不静默）
+    const x04 = findings.find((x) => x.id === 'X-04');
+    assert.equal(x04!.consistency, 'mismatch', 'stale.ts 送审后被编辑 → mismatch');
+    const uri = vscode.Uri.file(path.join(fx.root, 'src', 'stale.ts'));
+    const diag = vscode.languages.getDiagnostics(uri).find((d) => d.code === 'X-04');
+    assert.ok(diag, 'stale.ts 诊断存在');
+    assert.match(diag!.message, /与送审版本不一致/, '首次挂载诊断即带 mismatch 标注');
+  });
+
+  test('一致性缓存按 run 隔离（CODEX-06）：切轮回放不串用', async () => {
+    // 主 run：stale → mismatch；archive run（不同冻结内容）重新判定
+    await hub.setScope(fx.archiveTopic, 'code');
+    await waitFor(() => hub.findingsOfFocusRun().length > 0);
+    const ag = hub.findingsOfFocusRun().find((x) => x.id === 'AG2-01');
+    // ArchiveTopic 的 changes.diff 无 hunks（只有头部）→ sample.ts 无送审快照 → unknown（不是沿用主 run 结论）
+    assert.equal(ag!.consistency, 'unknown');
+    // 切回主 run：mismatch 结论仍正确（显式回放 run2——前序用例写入了更新的轮次）
+    await hub.setScope('DemoTopic', 'code');
+    await hub.setActiveRun(fx.run2Id);
+    await waitFor(() => hub.findingsOfFocusRun().some((x) => x.id === 'X-04'));
+    assert.equal(hub.findingsOfFocusRun().find((x) => x.id === 'X-04')!.consistency, 'mismatch');
+  });
+
+  test('摄取竞态（CODEX-02）：切换 scope 后旧摄取整次丢弃，不污染新 scope', async () => {
+    // 触发 DemoTopic 摄取（写新侧文件），不等完成立即切 ArchiveTopic
+    const p = fx.writeMeta('review-claude-20261106T000011Z.json', reviewOf('claude', [
+      { id: 'C3-01', severity: 'major', location: 'src/sample.ts:9', problem: '竞态意见', evidence: 'e', suggestion: 's', confidence: 'high' },
+    ]));
+    await hub.setScope(fx.archiveTopic, 'code'); // 同步段先完成（代次 +1），旧摄取恢复后即丢弃
+    await p;
+    await waitFor(() => hub.findingsOfFocusRun().length > 0, 20_000);
+    // ArchiveTopic 只有自己的 AG2-01（src/sample.ts:7），没有 DemoTopic 的 C3-01
+    const ids = hub.findingsOfFocusRun().map((f) => f.id);
+    assert.ok(!ids.includes('C3-01'), `旧 scope 意见未污染新 scope（实际：${ids.join(',')}）`);
+    assert.ok(ids.includes('AG2-01'));
+  });
+
+  test('dispose 失效在途装配（CODEX-03）：停用后不再创建任何对象', async () => {
+    const h2 = new AnnotationHub(fx.root);
+    const scopePromise = h2.setScope('DemoTopic', 'code'); // rebuild 在途
+    h2.dispose(); // 立即停用：在途代次全部失效
+    await scopePromise.catch(() => {});
+    await new Promise((r) => setTimeout(r, 300));
+    assert.equal(h2.threadsSnapshot().length, 0, '停用后无线程被创建');
+  });
+});
