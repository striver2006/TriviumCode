+    this.lastResolved = resolved;
+    this.buildNotice = built.totalSuppressed
+      ? `意见总量超过上限（trivium.reviews.maxTotalFindings=${maxTotalFindings()}），行内批注已折叠为仅 Problems`
+      : built.overflow.length > 0
+        ? `线程超上限仅进 Problems：${built.overflow.map((o) => `${o.file} 溢出 ${o.count} 条`).join('；')}`
+        : null;
+
+    // 全清旧线程与诊断（切换呈现策略：无残影）
+    for (const t of this.threads) t.dispose();
+    this.threads = [];
+    this.diagnostics.clear();
+    this.lastDiagnostics = built.diagnostics;
+
+    // 记录挂载文件 hash（动态重校验基线）——仅建了对象的文件
+    const mountedFiles = new Set<string>([...built.threads.map((t) => t.file), ...built.diagnostics.map((d) => d.file)]);
+    for (const rel of mountedFiles) {
+      const content = await readFile(rel);
+      if (content !== null) this.mountedHashes.set(rel, sha1(content));
+    }
+    if (stale()) return;
+
+    // 装配线程（同一文件的线程一次建好）
+    for (const tm of built.threads) {
+      const uri = vscode.Uri.file(path.join(this.workspaceRoot, tm.file));
+      const range = new vscode.Range(Math.max(0, tm.startLine - 1), 0, Math.max(0, tm.endLine - 1), 0);
+      const comments = tm.comments.map((c) => ({
+        body: new vscode.MarkdownString(c.body),
+        author: { name: c.critic },
+        mode: vscode.CommentMode.Preview,
+        contextValue: c.severity,
+      }));
+      const thread = this.controller.createCommentThread(uri, range, comments);
+      thread.label = tm.label;
+      thread.contextValue = tm.driftNotes.join('|');
+      thread.collapsibleState = vscode.CommentThreadCollapsibleState.Expanded;
+      this.threads.push(thread);
+    }
+
+    // 装配诊断（per file 聚合）
+    const byFile = new Map<string, vscode.Diagnostic[]>();
+    for (const dm of built.diagnostics) {
+      let list = byFile.get(dm.file);
+      if (!list) {
+        list = [];
+        byFile.set(dm.file, list);
+      }
+      const range = new vscode.Range(Math.max(0, dm.startLine - 1), 0, Math.max(0, dm.endLine - 1), 0);
+      const diag = new vscode.Diagnostic(range, dm.message, diagLevelOf(dm.level));
+      diag.source = 'TriviumCode 审查';
+      diag.code = dm.code;
+      list.push(diag);
+    }
+    for (const [file, list] of byFile) {
+      this.diagnostics.set(vscode.Uri.file(path.join(this.workspaceRoot, file)), list);
+    }
+
+    this.emitState();
+  }
+
+  /**
+   * 静态一致性比对（CLAUDE-02 修正语义 / CODEX-05 per-file 进度 / CODEX-06 缓存含 runId）：
+   * 重建**送审工作树内容**比对——base blob（base 字面 HEAD 时即冻结 head sha）应用该文件
+   * 补丁段 → 送审内容，与工作区文本归一化比较。变更集外/新增/无补丁段文件无送审快照，
+   * 诚实 unknown；plan 阶段（无 diff）整体 unknown（列表侧注明「未校验」）。
+   */
+  private async ensureConsistencyChecked(runId: string | null, files: Set<string>): Promise<void> {
+    if (!this.scope || runId === null || files.size === 0) return; // 不做任何整轮标记（CODEX-05）
+    const diff = this.diffsByRun.get(runId) ?? null;
+    const baseRef = diff ? resolveBaseRef(diff) : null;
+    if (!diff || !baseRef) return; // 无 diff / base 无法冻结（自定义 ref 字面量）→ 全部保持待检
+    const api = await gitApi();
+    if (!api) return;
+
+    for (const rel of files) {
+      const key = `${runId}:${rel}`; // CODEX-06：缓存身份含 run——切轮回放不串用
+      if (this.checkedFiles.has(key)) continue;
+      const member = diffMember(diff, rel);
+      const fileUri = vscode.Uri.file(path.join(this.workspaceRoot, rel));
+      try {
+        if (!member || member.added || member.deleted || member.hunks.length === 0) {
+          this.consistency.set(key, { state: 'unknown', note: member?.added ? '本轮新增文件，无送审前快照' : '不在变更集（无送审快照），未校验' });
+        } else {
+          const wsText = normalizeText(Buffer.from(await vscode.workspace.fs.readFile(fileUri)).toString('utf8'));
+          const baseText = normalizeText(Buffer.from(await vscode.workspace.fs.readFile(api.toGitUri(fileUri, baseRef))).toString('utf8'));
+          const sentText = normalizeText(applyHunks(baseText, member.hunks));
+          this.consistency.set(key, wsText === sentText
+            ? { state: 'consistent', note: null }
+            : { state: 'mismatch', note: `工作区文件与送审版本（${baseRef.slice(0, 8)} + 补丁）不一致` });
+        }
+      } catch {
+        this.consistency.set(key, { state: 'unknown', note: '基线对象不可读，未校验' });
+      }
+      this.checkedFiles.add(key); // 仅实际完成检查的文件记录（CODEX-05：迟到侧新文件可补检）
+    }
+  }
+
+  // ── 动态重校验（挂载后编辑） ─────────────────────────────────────────────
+
+  private async onDocChanged(doc: vscode.TextDocument): Promise<void> {
+    if (this.disposed || !this.scope) return;
+    const rel = path.relative(this.workspaceRoot, doc.uri.fsPath);
+    const mounted = this.mountedHashes.get(rel);
+    if (mounted === undefined) return;
+    const current = sha1(doc.getText());
+    if (current === mounted) return;
+    // 文件已编辑（CLAUDE-01/CODEX-02 动态判据）：edited 结论限定到当前回放轮（CODEX-06）
+    const runId = this.focusRunId;
+    if (runId !== null) this.consistency.set(`${runId}:${rel}`, { state: 'edited', note: '文件已在批注挂载后被编辑' });
+    this.mountedHashes.delete(rel); // 旧基线失效（rebuild 会以新内容重建基线）
+    await this.rebuild();
+  }
+
+  private emitState(): void {
+    const state: ScopeState = {
+      topic: this.scope?.topic ?? '',
+      stage: this.scope?.stage ?? '',
+      runId: this.focusRunId,
+      summaries: this.runIds().map((runId) => ({ runId, sides: findingsSummary([...(this.reviewsByRun.get(runId)?.values() ?? [])]) })),
+      threads: this.threads.length,
+      diagnostics: this.lastDiagnostics.length,
+      /** 超限提示（CLAUDE-11：总量折叠 / 单文件溢出，用户可见） */
+      notice: this.buildNotice,
+    };
+    for (const l of this.listeners) l(state);
+  }
+}
+
+// ── 工具 ───────────────────────────────────────────────────────────────────
+
+function sha1(text: string): string {
+  return createHash('sha1').update(text).digest('hex');
+}
+
+/** 文本归一化（换行差异不算不一致：autocrlf 场景） */
+function normalizeText(s: string): string {
+  return s.replace(/\r\n/g, '\n');
+}
+
+function diagLevelOf(level: DiagLevel): vscode.DiagnosticSeverity {
+  if (level === 'error') return vscode.DiagnosticSeverity.Error;
+  if (level === 'warning') return vscode.DiagnosticSeverity.Warning;
+  return vscode.DiagnosticSeverity.Information;
+}
+
+function maxThreadsPerFile(): number {
+  return vscode.workspace.getConfiguration('trivium.reviews').get<number>('maxThreadsPerFile', 200);
+}
+
+/** CLAUDE-07：总量上限同样读配置（package.json 已声明，缺省 2000） */
+function maxTotalFindings(): number {
+  return vscode.workspace.getConfiguration('trivium.reviews').get<number>('maxTotalFindings', 2000);
+}
+
+/** git 扩展软依赖（与 diffView 同源判定；此处独立缓存，测试各自复位） */
+let gitApiCache: GitApi | null | undefined;
+/** 测试注入口（测试环境 --disable-extensions 连内置 git 扩展一并禁用） */
+let gitApiOverride: GitApi | null | undefined;
+async function gitApi(): Promise<GitApi | null> {
+  if (gitApiOverride !== undefined) return gitApiOverride;
+  if (gitApiCache !== undefined) return gitApiCache;
+  try {
+    const ext = vscode.extensions.getExtension('vscode.git');
+    if (!ext) {
+      gitApiCache = null;
+      return null;
+    }
+    const exports = (await ext.activate()) as { getAPI?: (v: number) => GitApi };
+    gitApiCache = typeof exports.getAPI === 'function' ? exports.getAPI(1) : null;
+  } catch {
+    gitApiCache = null;
+  }
+  return gitApiCache;
+}
+
+/** 测试复位/注入（override 非 undefined 时恒定返回该值） */
+export function resetHubGitApiCacheForTest(override?: GitApi | null): void {
+  gitApiCache = undefined;
+  gitApiOverride = override;
+}
diff --git a/extension/src/reviews/annotationModel.ts b/extension/src/reviews/annotationModel.ts
new file mode 100644
index 00000000..40a5e78c
--- /dev/null
+++ b/extension/src/reviews/annotationModel.ts
@@ -0,0 +1,226 @@
+/**
+ * 批注装配模型（FR-6b/6c 的纯函数层，r2 计划 D3′）。
+ *
+ * 输入已解析锚点的 findings，输出线程/诊断描述模型——VS Code 对象
+ * （CommentThread/Diagnostic/Range）由 AnnotationHub 装配，保证 thread.range
+ * 与 diagnostic.range **同源**（CLAUDE-05：[start,end] 区间贯通，多行 location
+ * 不折叠）。漂移/降级统一「⚠」标签；severity 映射 blocker/major→Error、
+ * minor→Warning、nit→Information（FR-6c）。
+ *
+ * 纯函数模块：不 import vscode。
+ */
+import type { ParsedReview, ReviewFinding, FindingSeverity } from './reviewParse';
+import type { LocationResolution } from './locationResolve';
+
+/** severity → 诊断档位（FR-6c 映射；thread label 复用同一映射来源） */
+export type DiagLevel = 'error' | 'warning' | 'information';
+
+export function severityToDiagLevel(s: FindingSeverity): DiagLevel {
+  if (s === 'blocker' || s === 'major') return 'error';
+  if (s === 'minor') return 'warning';
+  return 'information';
+}
+
+/** 单条意见的解析结果（Hub 逐 finding 解析后进入本层） */
+export interface ResolvedFinding {
+  critic: string;
+  runId: string;
+  finding: ReviewFinding;
+  resolution: LocationResolution;
+}
+
+export interface CommentModel {
+  critic: string;
+  findingId: string;
+  severity: FindingSeverity;
+  /** markdown 正文（problem + 建议 + 证据截断 + 漂移标注） */
+  body: string;
+}
+
+export interface ThreadModel {
+  /** 工作区相对路径 */
+  file: string;
+  /** 主锚点区间（1 起始） */
+  startLine: number;
+  endLine: number;
+  label: string;
+  comments: CommentModel[];
+  /** 漂移/一致性标注（线程级聚合） */
+  driftNotes: string[];
+}
+
+export interface DiagnosticModel {
+  file: string;
+  startLine: number;
+  endLine: number;
+  level: DiagLevel;
+  message: string;
+  code: string;
+}
+
+export interface BuildResult {
+  threads: ThreadModel[];
+  diagnostics: DiagnosticModel[];
+  /** 单文件线程超限溢出（仅诊断，CLAUDE-04/D8′ 量级控制） */
+  overflow: Array<{ file: string; count: number }>;
+  /** 总量超限 → 线程整体折叠为仅诊断（CLAUDE-11：用户可见提示的依据） */
+  totalSuppressed: boolean;
+  /** 只进意见列表、不建 thread/诊断的 finding（doc/outside/missing-file） */
+  listOnly: Array<{ critic: string; findingId: string; reason: string }>;
+}
+
+export interface BuildOptions {
+  /** 逐家开关：null/空集合 = 全部启用 */
+  enabledCritics: Set<string> | null;
+  /** 单文件线程上限（缺省 200） */
+  maxThreadsPerFile: number;
+  /** scope 总量上限：超过则全部仅诊断（缺省 2000） */
+  maxTotalFindings: number;
+}
+
+const EVIDENCE_TRUNCATE = 500;
+
+/** finding 的漂移/一致性标注（列表、线程、诊断三处统一） */
+export function driftNotesOf(rf: ResolvedFinding): string[] {
+  const notes: string[] = [];
+  const primary = rf.resolution.anchors[0];
+  if (primary?.label) notes.push(primary.label);
+  if (primary?.drift) notes.push(`漂移：${primary.drift}`);
+  const c = rf.resolution.consistency;
+  if (c.state === 'mismatch') notes.push('⚠ 与送审版本不一致');
+  if (c.state === 'edited') notes.push('⚠ 文件已在批注挂载后被编辑');
+  return notes;
+}
+
+function commentBody(rf: ResolvedFinding, notes: string[]): string {
+  const f = rf.finding;
+  const parts: string[] = [];
+  if (notes.length > 0) parts.push(notes.join(' ｜ '));
+  parts.push(f.problem);
+  parts.push(`**建议**：${f.suggestion}`);
+  if (f.evidence.length > EVIDENCE_TRUNCATE) {
+    parts.push(`**证据**：${f.evidence.slice(0, EVIDENCE_TRUNCATE)}…（截断）`);
+  } else {
+    parts.push(`**证据**：${f.evidence}`);
+  }
+  parts.push(`（置信度 ${f.confidence}）`);
+  return parts.join('\n\n');
+}
+
+/**
+ * 装配线程与诊断模型。
+ *
+ * - thread 粒度 (file, 主锚点起始行)：同行多 finding → 同 thread 多 comment（分层）；
+ * - 文件级/漂移 → 线程挂文件首行、诊断 range 首行，均带 ⚠ 标注；
+ * - doc/outside/missing-file → listOnly（意见列表展示，不建 VS Code 对象）。
+ */
+export function buildAnnotationModels(findings: ResolvedFinding[], opts: BuildOptions): BuildResult {
+  const enabled = (critic: string): boolean => !opts.enabledCritics || opts.enabledCritics.size === 0 || opts.enabledCritics.has(critic);
+
+  const total = findings.filter((rf) => enabled(rf.critic));
+  const threadsOnlyDiagnostics = total.length > opts.maxTotalFindings;
+
+  // 按 (file, 起始行) 分组；文件级归到起始行 1
+  const byThread = new Map<string, { file: string; start: number; end: number; comments: CommentModel[]; notes: string[]; hasLine: boolean }>();
+  const diagnostics: DiagnosticModel[] = [];
+  const listOnly: BuildResult['listOnly'] = [];
+
+  for (const rf of total) {
+    const f = rf.finding;
+    const notes = driftNotesOf(rf);
+    const primary = rf.resolution.anchors[0];
+
+    if (rf.resolution.kind !== 'file' || !primary) {
+      const reason = rf.resolution.kind === 'doc' ? '非文件位置（文档引用）' : rf.resolution.kind === 'outside' ? '路径越界（工作区外）' : `文件缺失：${rf.resolution.missingRelPath}`;
+      listOnly.push({ critic: rf.critic, findingId: f.id, reason });
+      continue;
+    }
+
+    const line = primary.level === 'line' && primary.line ? primary.line : null;
+    const start = line ? line.start : 1;
+    const end = line ? line.end : 1;
+    const key = `${primary.relPath}#${start}`;
+    let slot = byThread.get(key);
+    if (!slot) {
+      slot = { file: primary.relPath, start, end, comments: [], notes: [], hasLine: line !== null };
+      byThread.set(key, slot);
+    }
+    slot.comments.push({ critic: rf.critic, findingId: f.id, severity: f.severity, body: commentBody(rf, notes) });
+    for (const n of notes) if (!slot.notes.includes(n)) slot.notes.push(n);
+    if (line && end > slot.end) slot.end = end;
+
+    // 诊断逐 finding 一条（与 thread 同源区间；文件级 range 首行）
+    const prefix = notes.length > 0 ? `${notes.join(' ｜ ')} ｜ ` : '';
+    diagnostics.push({
+      file: primary.relPath,
+      startLine: start,
+      endLine: end,
+      level: severityToDiagLevel(f.severity),
+      message: `${prefix}${f.id} · ${firstLine(f.problem)}`,
+      code: f.id,
+    });
+  }
+
+  // 单文件线程上限：超出部分仅诊断
+  const perFileCount = new Map<string, number>();
+  const threads: ThreadModel[] = [];
+  const overflow: BuildResult['overflow'] = [];
+  for (const slot of byThread.values()) {
+    const count = (perFileCount.get(slot.file) ?? 0) + 1;
+    perFileCount.set(slot.file, count);
+    if (count > opts.maxThreadsPerFile) {
+      const of = overflow.find((o) => o.file === slot.file);
+      if (of) of.count++;
+      else overflow.push({ file: slot.file, count: 1 });
+      continue;
+    }
+    threads.push(threadModelOf(slot));
+  }
+
+  return {
+    threads: threadsOnlyDiagnostics ? [] : threads,
+    diagnostics,
+    overflow,
+    totalSuppressed: threadsOnlyDiagnostics,
+    listOnly,
+  };
+}
+
+function threadModelOf(slot: { file: string; start: number; end: number; comments: CommentModel[]; notes: string[]; hasLine: boolean }): ThreadModel {
+  const sevCounts = new Map<string, number>();
+  for (const c of slot.comments) sevCounts.set(c.severity, (sevCounts.get(c.severity) ?? 0) + 1);
+  const sevPart = [...sevCounts.entries()].map(([s, n]) => `${s}×${n}`).join(' ');
+  const criticCounts = new Map<string, number>();
+  for (const c of slot.comments) criticCounts.set(c.critic, (criticCounts.get(c.critic) ?? 0) + 1);
+  const criticPart = [...criticCounts.entries()].map(([c, n]) => `${c} ${n} 条`).join(' ｜ ');
+  const label = `${slot.hasLine ? '' : '⚠ 文件级 ｜ '}[${sevPart}] ${criticPart}`;
+  return {
+    file: slot.file,
+    startLine: slot.start,
+    endLine: slot.end,
+    label,
+    comments: slot.comments,
+    driftNotes: slot.notes,
+  };
+}
+
+function firstLine(text: string): string {
+  const line = text.split('\n').find((l) => l.trim().length > 0) ?? '';
+  return line.length > 160 ? `${line.slice(0, 160)}…` : line;
+}
+
+/** 一组解析件的逐侧摘要（findingsSummary：驾驶舱 run 卡与历史树共用） */
+export function findingsSummary(reviews: ParsedReview[]): Array<{ critic: string; verdict: string | null; counts: Record<FindingSeverity, number>; state: string; notice: string | null }> {
+  return reviews.map((r) => ({
+    critic: r.status.critic,
+    verdict: r.verdict,
+    counts: {
+      blocker: r.findings.filter((f) => f.severity === 'blocker').length,
+      major: r.findings.filter((f) => f.severity === 'major').length,
+      minor: r.findings.filter((f) => f.severity === 'minor').length,
+      nit: r.findings.filter((f) => f.severity === 'nit').length,
+    },
+    state: r.status.state,
+    notice: r.status.notice,
+  }));
+}
diff --git a/extension/src/reviews/diffParse.ts b/extension/src/reviews/diffParse.ts
new file mode 100644
index 00000000..1f0de5a4
--- /dev/null
+++ b/extension/src/reviews/diffParse.ts
@@ -0,0 +1,182 @@
+/**
+ * changes-<runId>.diff 解析（FR-6d，r2 计划 D5′；纯函数，不 import vscode）。
+ *
+ * 流式行状态机：`#` 头部（run_id/base/head——**冻结身份在此**，CODEX-01/
+ * CLAUDE-02）、`diff --git a/… b/…`（及 `+++ b/…` 兜底）文件分界（AGY-04）、
+ * `@@ -a,b +c,d @@` hunk 归属与**正文行收集**（CLAUDE-02：静态一致性比对需要
+ * 「base blob + 补丁段 → 送审工作树内容」重建，正文行是必要输入）、
+ * `/dev/null` 判新增/删除（AGY-06；无 --git 头的简化 patch 用 pendingAdded，
+ * AGY-03）。
+ * 内存面：只保留文件分界与 hunk 头+正文（不建全仓全文模型，D8′）。
+ */
+
+/** changes.diff 解析结果 */
+export interface DiffHunk {
+  oldStart: number;
+  oldLines: number;
+  newStart: number;
+  newLines: number;
+  /** hunk 正文行（原样含前导 +/-/空格；`\` 行剔除） */
+  lines: string[];
+}
+
+export interface DiffFileInfo {
+  relPath: string;
+  /** `--- /dev/null` → 本轮新增（无基线） */
+  added: boolean;
+  /** `+++ /dev/null` → 本轮删除 */
+  deleted: boolean;
+  hunks: DiffHunk[];
+}
+
+export interface ParsedChangesDiff {
+  runId: string | null;
+  /** 字面 HEAD 或自定义 ref/sha（`resolveBaseRef` 消费，CLAUDE-05） */
+  base: string | null;
+  /** 补丁生成时的 HEAD 提交 sha（base 为字面 HEAD 时即被审 base 的冻结身份） */
+  head: string | null;
+  files: DiffFileInfo[];
+}
+
+/**
+ * 解析 changes.diff 全文。坏输入尽力返回已解析部分（不抛异常）。
+ */
+export function parseChangesDiff(text: string): ParsedChangesDiff {
+  const lines = text.split('\n');
+  const result: ParsedChangesDiff = { runId: null, base: null, head: null, files: [] };
+
+  // 头部字段（连续 # 注释段的 `# key: value` 形态）
+  for (const raw of lines) {
+    if (!raw.startsWith('#')) break;
+    const m = /^#\s*(\w+):\s*(.+)$/.exec(raw);
+    if (!m) continue;
+    const [, key, value] = m;
+    if (key === 'run_id') result.runId = value!.trim();
+    else if (key === 'base') result.base = value!.trim();
+    else if (key === 'head') result.head = value!.trim();
+  }
+
+  const byPath = new Map<string, DiffFileInfo>();
+  let current: DiffFileInfo | null = null;
+  let pendingAdded = false; // AGY-03：无 --git 头的简化 patch，--- /dev/null 先于 +++ 出现
+  let hunk: DiffHunk | null = null;
+  let oldCnt = 0;
+  let newCnt = 0;
+
+  for (const raw of lines) {
+    if (hunk !== null) {
+      // hunk 正文收集：按行首字符计数，两侧行数收满即结束
+      if ((raw.startsWith(' ') || raw.startsWith('+') || raw.startsWith('-')) && !(oldCnt >= hunk.oldLines && newCnt >= hunk.newLines)) {
+        if (raw.startsWith('\\')) continue; // `\ No newline at end of file`
+        hunk.lines.push(raw);
+        if (!raw.startsWith('+')) oldCnt++;
+        if (!raw.startsWith('-')) newCnt++;
+        continue;
+      }
+      hunk = null; // 收满或遇标记行：结束当前 hunk，继续按标记处理本行
+    }
+    // 文件分界（AGY-04）：diff --git a/x b/x 是权威分界；+++ b/x 兜底
+    let m = /^diff --git a\/(.+?) b\/(.+)$/.exec(raw);
+    if (m) {
+      current = ensureFile(byPath, result, m[2]!);
+      pendingAdded = false;
+      continue;
+    }
+    if (/^--- \/dev\/null/.test(raw)) {
+      if (current) current.added = true;
+      else pendingAdded = true; // AGY-03：简化 patch 的下一 +++ 行建文件时赋予
+      continue;
+    }
+    m = /^\+\+\+ (?:b\/)?(.+)$/.exec(raw);
+    if (m && m[1] !== '/dev/null') {
+      const relPath = m[1]!.replace(/\t.*$/, '');
+      current = byPath.get(relPath) ?? ensureFile(byPath, result, relPath);
+      if (pendingAdded) {
+        current.added = true;
+        pendingAdded = false;
+      }
+      continue;
+    }
+    if (/^\+\+\+ \/dev\/null/.test(raw) && current) {
+      current.deleted = true;
+      continue;
+    }
+    // hunk 头：@@ -a[,b] +c[,d] @@ —— 归属当前文件
+    const h = /^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/.exec(raw);
+    if (h && current) {
+      hunk = {
+        oldStart: Number(h[1]),
+        oldLines: h[2] === undefined ? 1 : Number(h[2]),
+        newStart: Number(h[3]),
+        newLines: h[4] === undefined ? 1 : Number(h[4]),
+        lines: [],
+      };
+      oldCnt = 0;
+      newCnt = 0;
+      current.hunks.push(hunk);
+    }
+  }
+  return result;
+}
+
+function ensureFile(byPath: Map<string, DiffFileInfo>, result: ParsedChangesDiff, relPath: string): DiffFileInfo {
+  let f = byPath.get(relPath);
+  if (!f) {
+    f = { relPath, added: false, deleted: false, hunks: [] };
+    byPath.set(relPath, f);
+    result.files.push(f);
+  }
+  return f;
+}
+
+/** 变更集成员判定：relPath 是否在该轮变更集内 */
+export function diffMember(diff: ParsedChangesDiff, relPath: string): DiffFileInfo | null {
+  return diff.files.find((f) => f.relPath === relPath) ?? null;
+}
+
+/**
+ * 被审 base 的**冻结提交身份**（CLAUDE-05）：
+ * - `base === 'HEAD'`（缺省）→ 补丁生成时的 HEAD 即被审 base，用冻结 head sha；
+ * - base 为 40 位 sha → 直接用；
+ * - 其它 ref 字面量（分支名等）→ 无法冻结（回放时 ref 可能已移动）→ null（降级明示）。
+ */
+export function resolveBaseRef(diff: ParsedChangesDiff): string | null {
+  if (!diff.base || !diff.head) return null;
+  if (diff.base === 'HEAD') return diff.head;
+  if (/^[0-9a-f]{40}$/.test(diff.base)) return diff.base;
+  return null;
+}
+
+/** 意见行是否位于被审变更的 head 侧区间内（辅助提示用，宽松判定） */
+export function lineInHunks(info: DiffFileInfo, startLine: number): boolean {
+  return info.hunks.some((h) => startLine >= h.newStart && startLine <= h.newStart + Math.max(h.newLines - 1, 0));
+}
+
+/**
+ * 把补丁段应用到 base 内容，重建**送审工作树内容**（CLAUDE-02：静态一致性
+ * 的正确基线是送审工作树，不是 base 提交也不是 head 提交）。
+ * hunks 须按文件内顺序（解析顺序即如此）；行尾统一 \n。
+ */
+export function applyHunks(baseContent: string, hunks: DiffHunk[]): string {
+  const base = baseContent.replace(/\r\n/g, '\n').split('\n');
+  const out: string[] = [];
+  let cursor = 0; // base 侧行游标（0 起）
+  for (const h of hunks) {
+    const startIdx = Math.max(0, h.oldStart - 1);
+    if (startIdx > cursor) out.push(...base.slice(cursor, startIdx));
+    cursor = startIdx;
+    for (const line of h.lines) {
+      if (line.startsWith('+')) {
+        out.push(line.slice(1));
+        // '+' 行不消耗 base 游标
+      } else if (line.startsWith('-')) {
+        cursor++; // '-' 行消耗一行 base，不产出
+      } else {
+        out.push(line.slice(1)); // context 行
+        cursor++;
+      }
+    }
+  }
+  if (cursor < base.length) out.push(...base.slice(cursor));
+  return out.join('\n');
+}
