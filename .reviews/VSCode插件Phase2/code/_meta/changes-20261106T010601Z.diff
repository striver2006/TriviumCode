+  await fs.writeFile(
+    path.join(archiveMetaDir, `review-gemini-${archiveRunId}.json`),
+    reviewDoc('gemini', 'pass', [findingOf('AG2-01', 'minor', 'src/sample.ts:7', '归档主题意见', '归档证据')]),
