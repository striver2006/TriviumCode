index 00000000..afe4f5f9
--- /dev/null
+++ b/test/helpers/entry-scan-home.ts
@@ -0,0 +1,29 @@
+/**
+ * 共享读取面检查（EV-240）的测试隔离：让 doctor / preflight 的那一次只读扫描读空夹具，不读真实家目录
+ * （M12 批次 5，计划双审 CODEX-01 / GLM-01）。
+ *
+ * 扫描的家目录只有一个来源（`entryScanEnv()`：注入口 → `TRIVIUM_ENTRY_SCAN_HOME` → `os.homedir()`），
+ * 所以隔离也只在一处做：
+ *
+ * - 经 `fixture.ts` 的 `cli()` 跑打包产物：`cli()` 缺省就把该变量指向本进程的空夹具；
+ * - 进程内直调 `runDoctor` / `runPreflight` 的测试文件：在文件顶部调一次 {@link isolateEntryScanHome}。
+ *
+ * `entry-scan-isolation` 的对账用例守这两条：直调却没调本函数的文件当场红。
+ */
+import { ENTRY_SCAN_HOME_ENV } from '../../src/trivium/entry-collisions.js';
+import { scratchDirSync } from './scratch.js';
+
+let empty: string | null = null;
+
+/** 本测试进程的空家目录夹具（惰性建一次，测试文件进程退出时随 `scratchDir` 登记删除） */
+export function emptyEntryScanHome(): string {
+  empty ??= scratchDirSync('trivium-escan-');
+  return empty;
+}
+
+/** 把本进程的扫描家目录钉到空夹具；返回夹具路径。进程内直调与本进程派生的子进程都继承它 */
+export function isolateEntryScanHome(): string {
+  const home = emptyEntryScanHome();
+  process.env[ENTRY_SCAN_HOME_ENV] = home;
+  return home;
+}
diff --git a/test/integration/handoff-dedupe.test.ts b/test/integration/handoff-dedupe.test.ts
new file mode 100644
index 00000000..5172e9e1
--- /dev/null
+++ b/test/integration/handoff-dedupe.test.ts
@@ -0,0 +1,59 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { bundleMissing, bundleSkipReason, cli, makeFixture } from '../helpers/fixture.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import { extractJsonCandidate } from '../../src/trivium/parse.js';
+import { repoId } from '../../src/trivium/review.js';
+import { RUN_DIR_FILES } from '../../src/trivium/run-files.js';
+import type { RunMeta } from '../../src/trivium/types.js';
+import type { StubConfig } from '../../src/trivium/adapters/stub.js';
+
+/*
+ * EV-236 A2（M12 批次 5；计划 r2 §4 I1）：交接文件里冻结补丁只存一份，worker 按引用还原后照常跑完。
+ * 只数快照结构里的正文份数（计划双审 CODEX-02：任务书节选在 400 行内就是全文，`brief_text` 本来各有一份，不在去重范围）。
+ */
+
+const TOPIC = '交接去重';
+const STUB: StubConfig = { gemini: { mode: 'ok' }, glm: { mode: 'ok' } };
+
+test('交接文件：各侧快照不带补丁正文、frozen_diff 恰一份且等于归档补丁；brief 与归档逐字相同；worker 照常收尾', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC, draft: false });
+  const codeDir = path.join(fx.archiveRoot, TOPIC, 'code');
+  await fs.writeFile(path.join(fx.root, 'src/a.ts'), 'export const a = 4242;\n', 'utf8');
+
+  const started = await cli(fx.root, ['review', '--start', '--stage', 'code', '--topic', TOPIC, '--focus', '看变更', '--json'], STUB);
+  assert.equal(started.code, EXIT.OK, `--start 失败：\n${started.stdout}\n${started.stderr}`);
+  const cand = extractJsonCandidate(started.stdout);
+  assert.ok(cand);
+  const runId = (JSON.parse(cand.json) as { run_id: string }).run_id;
+
+  // 先读交接文件：收尾的清扫会就地改写它（脱敏），在它之前取原样
+  const handoff = JSON.parse(await fs.readFile(path.join(fx.runRoot, repoId(fx.root), runId, RUN_DIR_FILES.request), 'utf8')) as {
+    snapshots: Record<string, { diffText: string | null; subjectSha256: string }>;
+    frozen_diff?: { sha256: string; text: string };
+    requests: Record<string, { brief_text: string; brief_path: string }>;
+  };
+
+  let exitCode: number = EXIT.STILL_RUNNING;
+  for (let i = 0; i < 12 && exitCode === EXIT.STILL_RUNNING; i++) {
+    exitCode = (await cli(fx.root, ['review', '--wait', runId, '--timeout', '20'], STUB, 60_000)).code ?? EXIT.FAIL;
+  }
+  assert.equal(exitCode, EXIT.OK, '双审应成功（worker 读回新格式交接文件）');
+  const meta = JSON.parse(await fs.readFile(path.join(codeDir, '_meta', `run-${runId}.json`), 'utf8')) as RunMeta;
+  assert.equal(meta.status, 'success');
+
+  const diff = await fs.readFile(path.join(codeDir, '_meta', `changes-${runId}.diff`), 'utf8');
+  assert.ok(handoff.frozen_diff, '新格式要带 frozen_diff');
+  assert.equal(handoff.frozen_diff.text, diff, '那一份就是送审的补丁原文');
+  assert.equal(handoff.frozen_diff.sha256, meta.snapshot.subject_sha256);
+  const sides = Object.keys(handoff.snapshots);
+  assert.equal(sides.length, 2);
+  for (const c of sides) {
+    assert.equal(handoff.snapshots[c]!.diffText, null, `${c} 侧快照不该再带一份正文`);
+    assert.equal(handoff.snapshots[c]!.subjectSha256, meta.snapshot.subject_sha256);
+    const onDisk = await fs.readFile(handoff.requests[c]!.brief_path, 'utf8');
+    assert.equal(handoff.requests[c]!.brief_text, onDisk, `${c} 侧交给审核者的任务书与归档逐字相同`);
+  }
+});
diff --git a/test/unit/doctor-shared-roots.test.ts b/test/unit/doctor-shared-roots.test.ts
new file mode 100644
index 00000000..ccb2d3a7
--- /dev/null
+++ b/test/unit/doctor-shared-roots.test.ts
@@ -0,0 +1,61 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { runDoctor } from '../../src/trivium/doctor.js';
+import { TRIVIUM_DIR, defaultConfig } from '../../src/trivium/config.js';
+import { AGENTS } from '../../src/trivium/agents/registry.js';
+import { SHARED_ROOT_EXIT_HINT, type EntryScanEnv } from '../../src/trivium/entry-collisions.js';
+import { scratchDir } from '../helpers/scratch.js';
+import { isolateEntryScanHome } from '../helpers/entry-scan-home.js';
+
+// 本文件每个用例都显式注入夹具家目录；进程级再钉一次，防止漏传时读到真实家目录
+isolateEntryScanHome();
+
+/*
+ * doctor 全量列出共享读取面里的同名入口（EV-240 方案 A，用户 D-11；计划 r2 §2.2 / §4 U5）：
+ * 只进 warnings、不进 blockers，与 --only 无关，扫描出错也只记一条告警。
+ */
+
+const SHARED_REL = AGENTS.find((a) => a.entrySkillExtraReadRoots.length > 0)!.entrySkillExtraReadRoots[0]!;
+
+async function doctorWith(se: EntryScanEnv) {
+  const root = await scratchDir('trivium-doc-shared-');
+  const triviumDir = path.join(root, TRIVIUM_DIR);
+  await fs.mkdir(triviumDir, { recursive: true });
+  return runDoctor({ config: defaultConfig(), projectRoot: root, triviumDir, only: 'env', skipModelCalls: true, entryScanEnv: se });
+}
+
+const isShared = (w: string): boolean => w.startsWith('共享读取面');
+
+test('U5 无同名入口 ⇒ 不出告警；有 ⇒ warnings 恰多一条、按路径归并、~ 折叠、带出口，blockers 不变', async () => {
+  const clean = await scratchDir('trivium-doc-home-');
+  const base = await doctorWith({ home: clean, env: {} });
+  assert.equal(base.warnings.filter(isShared).length, 0);
+
+  const dirty = await scratchDir('trivium-doc-home-');
+  const shared = path.join(dirty, SHARED_REL);
+  await fs.mkdir(path.join(shared, 'dual-run'), { recursive: true });
+  await fs.writeFile(path.join(shared, 'dual-run/SKILL.md'), '---\nname: dual-run\n---\n别家的\n');
+  await fs.mkdir(path.join(shared, 'dual-status'), { recursive: true });
+  await fs.writeFile(path.join(shared, 'dual-status/SKILL.md'), '---\nname: dual-status\n---\n./.trivium/bin/trivium\n');
+  const r = await doctorWith({ home: dirty, env: {} });
+  const hits = r.warnings.filter(isShared);
+  assert.equal(hits.length, 1, JSON.stringify(r.warnings));
+  assert.equal(r.warnings.length, base.warnings.length + 1, '只多这一条');
+  const w = hits[0]!;
+  assert.match(w, /^共享读取面里有 2 个同名入口/);
+  assert.ok(w.includes(`~/${SHARED_REL}/dual-run`) && w.includes(`~/${SHARED_REL}/dual-status`), w);
+  assert.ok(!w.includes(dirty), `不得露出夹具绝对路径：${w}`);
+  assert.ok(w.includes(SHARED_ROOT_EXIT_HINT), w);
+  assert.deepEqual(r.blockers, base.blockers, '告警不得进入阻断项');
+});
+
+test('U5 扫描出错 ⇒ 退化为一条告警，doctor 不失败、阻断不变', async () => {
+  const clean = await scratchDir('trivium-doc-home-');
+  const base = await doctorWith({ home: clean, env: {} });
+  // 家目录取值不是字符串：path.join 抛错，模拟扫描内部失败
+  const r = await doctorWith({ home: null as unknown as string, env: {} });
+  assert.ok(r.warnings.some((w) => w.startsWith('共享读取面检查没做成：')), JSON.stringify(r.warnings));
+  assert.deepEqual(r.blockers, base.blockers);
+});
diff --git a/test/unit/entry-collisions-bundles.test.ts b/test/unit/entry-collisions-bundles.test.ts
new file mode 100644
index 00000000..25ccec59
--- /dev/null
+++ b/test/unit/entry-collisions-bundles.test.ts
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { existsSync, promises as fs } from 'node:fs';
+import { planInstall } from '../../src/install.js';
+import { ENTRY_SKILL_NAMES } from '../../src/trivium/entry-collisions.js';
+import { REPO_ROOT } from '../helpers/fixture.js';
+import { scratchDir } from '../helpers/scratch.js';
+
+/*
+ * 两个打包产物用的是同一份实现，不是各抄一份（EV-240 方案 A，M12 批次 5；计划 r2 §2.4 / §4 U4）。
+ *
+ * 三条证据：①两份产物都带 esbuild 给共享模块打的模块标记；②安装器源码里不再有判定实现；
+ * ③`src/trivium/` 不反向依赖安装器（计划双审 AGY-04）。另对账编排器侧的入口名单。
+ */
+
+const MARK = '// src/trivium/entry-collisions.ts';
+const BUNDLES = ['dist/install.cjs', 'skills/dual-critic/scripts/trivium.cjs'];
+
+test('U4 两份打包产物都含共享模块（同一个源文件的模块标记）', { skip: BUNDLES.some((b) => !existsSync(path.join(REPO_ROOT, b))) && '先 npm run build' }, async () => {
+  for (const b of BUNDLES) {
+    const text = await fs.readFile(path.join(REPO_ROOT, b), 'utf8');
+    assert.ok(text.includes(MARK), `${b} 里找不到 ${MARK}`);
+    assert.equal(text.split('async function isOurEntry(').length - 1, 1, `${b} 里 isOurEntry 应恰有一份实现`);
+    assert.equal(text.split('async function scanEntryCollisions(').length - 1, 1, `${b} 里判定核心应恰有一份实现`);
+  }
+});
+
+test('U4 安装器源码里没有判定实现，只经共享模块调用', async () => {
+  const src = await fs.readFile(path.join(REPO_ROOT, 'src/install.ts'), 'utf8');
+  assert.ok(!/function\s+isOurEntry\s*\(/.test(src), 'install.ts 不得再定义 isOurEntry');
+  assert.ok(!src.includes("kind: ours ? 'foreign-entry' : 'third-party'"), 'install.ts 不得再有判定循环');
+  assert.ok(src.includes("from './trivium/entry-collisions.js'"), 'install.ts 要从共享模块取判定');
+});
+
+test('U4 src/trivium/ 不 import 安装器或入口渲染（编排器不反向依赖安装器）', async () => {
+  const offenders: string[] = [];
+  const walk = async (dir: string): Promise<void> => {
+    for (const e of await fs.readdir(dir, { withFileTypes: true })) {
+      const p = path.join(dir, e.name);
+      if (e.isDirectory()) await walk(p);
+      else if (e.name.endsWith('.ts')) {
+        const text = await fs.readFile(p, 'utf8');
+        if (/from\s+'(\.\.\/)+(install|entry-render)\.js'/.test(text)) offenders.push(path.relative(REPO_ROOT, p));
+      }
+    }
+  };
+  await walk(path.join(REPO_ROOT, 'src/trivium'));
+  assert.deepEqual(offenders, []);
+});
+
+test('U4 名单对账：ENTRY_SKILL_NAMES = 命令契约 name 全集 = 安装器给每一家算出的名单', async () => {
+  const dir = path.join(REPO_ROOT, 'skills-src/commands');
+  const contractNames: string[] = [];
+  for (const f of await fs.readdir(dir)) {
+    if (!f.endsWith('.contract.md')) continue;
+    const m = /^---\nname: (\S+)\n/.exec(await fs.readFile(path.join(dir, f), 'utf8'));
+    assert.ok(m, `${f} 的 front-matter 首键应为 name`);
+    contractNames.push(m[1]!);
+  }
+  const expected = [...ENTRY_SKILL_NAMES].sort();
+  assert.deepEqual([...contractNames].sort(), expected, '改了命令要同步 entry-collisions.ts 的 ENTRY_SKILL_NAMES');
+
+  const home = await scratchDir('trivium-ecol-plan-');
+  const plan = await planInstall(REPO_ROOT, { home, env: {} });
+  assert.ok(plan.targets.length > 0);
+  for (const t of plan.targets) {
+    assert.deepEqual(t.sources.map((s) => s.name).sort(), expected, `${t.agent} 的安装名单与编排器侧不一致`);
+  }
+});
diff --git a/test/unit/entry-collisions.test.ts b/test/unit/entry-collisions.test.ts
new file mode 100644
index 00000000..a1af33ac
--- /dev/null
+++ b/test/unit/entry-collisions.test.ts
@@ -0,0 +1,135 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import {
+  ENTRY_PROBLEM_LABELS, ENTRY_SKILL_NAMES, SHARED_ROOT_EXIT_HINT, describeSharedRootProblems, entryScanEnv,
+  ENTRY_SCAN_HOME_ENV, isOurEntry, scanEntryCollisions, sharedReadRootTargets, summarizeSharedRootProblems,
+} from '../../src/trivium/entry-collisions.js';
+import { AGENTS, agentById, entrySkillRootOf } from '../../src/trivium/agents/registry.js';
+import { displayHomePath } from '../../src/trivium/util/fsx.js';
+import { scratchDir } from '../helpers/scratch.js';
+
+/*
+ * 读取面同名入口检测的共享实现（EV-240 方案 A，M12 批次 5；计划 r2 §2.1 / §4 U1、U2）。
+ * 家目录一律是 `scratchDir` 的夹具，不读真实家目录。
+ */
+
+const ourSkill = (name: string): string =>
+  `---\nname: ${name}\ndescription: x\n---\n\n跑 \`./.trivium/bin/trivium review --start …\`\n`;
+
+async function plant(dir: string, md: string | null): Promise<void> {
+  await fs.mkdir(dir, { recursive: true });
+  if (md !== null) await fs.writeFile(path.join(dir, 'SKILL.md'), md);
+}
+
+test('U1 isOurEntry：名字对得上且调用 wrapper 才判真；名字不符、缺 wrapper、读不到都判假', async () => {
+  const home = await scratchDir('trivium-ecol-');
+  const d = path.join(home, 'x');
+  await plant(path.join(d, 'ok'), ourSkill('dual-run'));
+  await plant(path.join(d, 'wrong-name'), ourSkill('dual-status'));
+  await plant(path.join(d, 'no-wrapper'), '---\nname: dual-run\n---\n别人的\n');
+  await plant(path.join(d, 'no-md'), null);
+  assert.equal(await isOurEntry(path.join(d, 'ok'), 'dual-run'), true);
+  assert.equal(await isOurEntry(path.join(d, 'wrong-name'), 'dual-run'), false);
+  assert.equal(await isOurEntry(path.join(d, 'no-wrapper'), 'dual-run'), false);
+  assert.equal(await isOurEntry(path.join(d, 'no-md'), 'dual-run'), false);
+});
+
+test('U1 scanEntryCollisions：三类判定与次序（残留在前、再按名单 × 读取根），安装根里的自家同名放行', async () => {
+  const home = await scratchDir('trivium-ecol-');
+  const install = path.join(home, 'inst');
+  const shared = path.join(home, 'shared');
+  await plant(path.join(install, 'dual-critic'), null); // 残留
+  await plant(path.join(install, 'dual-run'), ourSkill('dual-run')); // 安装根里的自家：放行
+  await plant(path.join(install, 'dual-status'), '---\nname: dual-status\n---\n'); // 安装根里的别家：third-party
+  await plant(path.join(shared, 'dual-run'), ourSkill('dual-run')); // 共享根里的自家：foreign-entry
+  await plant(path.join(shared, 'dual-approve'), '---\nname: dual-approve\n---\n'); // 共享根里的别家：third-party
+
+  const problems = await scanEntryCollisions([{
+    agent: 'codex', skillsRoot: install, readRoots: [install, shared],
+    names: ['dual-approve', 'dual-run', 'dual-status'], residueNames: ['dual-critic', 'entry'],
+  }]);
+  assert.deepEqual(problems, [
+    { agent: 'codex', kind: 'residue', path: path.join(install, 'dual-critic') },
+    { agent: 'codex', kind: 'third-party', path: path.join(shared, 'dual-approve') },
+    { agent: 'codex', kind: 'foreign-entry', path: path.join(shared, 'dual-run') },
+    { agent: 'codex', kind: 'third-party', path: path.join(install, 'dual-status') },
+  ]);
+
+  // 不查残留的目标（安装器的 top 布局、共享读取面）：同一个家里的残留不报
+  const noResidue = await scanEntryCollisions([{
+    agent: 'codex', skillsRoot: install, readRoots: [install], names: [], residueNames: [],
+  }]);
+  assert.deepEqual(noResidue, []);
+});
+
+test('U2 sharedReadRootTargets：只出登记了额外读取根的家，读取根只含额外根，不查残留；CODEX_HOME 不影响共享根', async () => {
+  const home = await scratchDir('trivium-ecol-');
+  const codexHome = await scratchDir('trivium-ecol-ch-');
+  const targets = sharedReadRootTargets(AGENTS, { home, env: { CODEX_HOME: codexHome } });
+  const withExtra = AGENTS.filter((a) => a.entrySkillExtraReadRoots.length > 0).map((a) => a.id);
+  assert.ok(withExtra.length > 0, '注册表里至少有一家登记了额外读取根');
+  assert.deepEqual(targets.map((t) => t.agent), withExtra);
+  for (const t of targets) {
+    const a = agentById(t.agent)!;
+    assert.deepEqual(t.readRoots, a.entrySkillExtraReadRoots.map((r) => path.join(home, r)));
+    assert.equal(t.skillsRoot, entrySkillRootOf(a, home, { CODEX_HOME: codexHome }).skillsRoot);
+    assert.ok(!t.readRoots.includes(t.skillsRoot), '安装根不在扫描面里');
+    assert.deepEqual(t.residueNames, []);
+    assert.deepEqual(t.names, ENTRY_SKILL_NAMES);
+  }
+  // 共享根里的 dual-critic 拷贝不判（与安装器口径一致，计划 r2 T-3 / §7）
+  for (const r of new Set(targets.flatMap((t) => t.readRoots))) await plant(path.join(r, 'dual-critic'), null);
+  assert.deepEqual(await scanEntryCollisions(targets), []);
+});
+
+test('U2 渲染：按路径归并、~ 折叠到扫描所用的家目录、带出口；preflight 一行；无问题返回 null', async () => {
+  const home = await scratchDir('trivium-ecol-');
+  const targets = sharedReadRootTargets(AGENTS, { home, env: {} });
+  const root = targets[0]!.readRoots[0]!;
+  await plant(path.join(root, 'dual-run'), ourSkill('dual-run'));
+  await plant(path.join(root, 'dual-status'), '---\nname: dual-status\n---\n');
+  const problems = await scanEntryCollisions(targets);
+  // 共享根被几家读到，同一个目录就报几次
+  assert.equal(problems.length, 2 * targets.length);
+
+  const text = describeSharedRootProblems(problems, home)!;
+  const rel = displayHomePath(root, home);
+  assert.ok(rel.startsWith('~/'), rel);
+  assert.ok(!text.includes(home), `不得露出夹具的绝对路径：${text}`);
+  assert.match(text, /^共享读取面里有 2 个同名入口/);
+  assert.ok(text.includes(`· ${rel}/dual-run  ${ENTRY_PROBLEM_LABELS['foreign-entry']}`), text);
+  assert.ok(text.includes(`· ${rel}/dual-status  ${ENTRY_PROBLEM_LABELS['third-party']}`), text);
+  for (const t of targets) assert.ok(text.includes(agentById(t.agent)!.display), text);
+  assert.ok(text.endsWith(SHARED_ROOT_EXIT_HINT), text);
+
+  const line = summarizeSharedRootProblems(problems, home)!;
+  assert.ok(!line.includes('\n'), '预检只给一行');
+  assert.ok(line.startsWith('⚠️ 共享读取面 ~/'), line);
+  assert.ok(line.includes('2 个同名入口'), line);
+  assert.ok(!line.includes(home), line);
+
+  assert.equal(describeSharedRootProblems([], home), null);
+  assert.equal(summarizeSharedRootProblems([], home), null);
+});
+
+test('U2 entryScanEnv：注入口优先，其次环境变量，最后 os.homedir()', () => {
+  const saved = process.env[ENTRY_SCAN_HOME_ENV];
+  try {
+    process.env[ENTRY_SCAN_HOME_ENV] = '/from-env';
+    assert.equal(entryScanEnv({ home: '/inject', env: {} }).home, '/inject');
+    assert.equal(entryScanEnv().home, '/from-env');
+    process.env[ENTRY_SCAN_HOME_ENV] = '';
+    assert.notEqual(entryScanEnv().home, '', '空值不算设置');
+  } finally {
+    if (saved === undefined) delete process.env[ENTRY_SCAN_HOME_ENV];
+    else process.env[ENTRY_SCAN_HOME_ENV] = saved;
+  }
+});
+
+test('U2 displayHomePath：不传 home 时行为同原来；传 home 时按它折叠', () => {
+  assert.equal(displayHomePath('/a/b/c', '/a'), '~/b/c');
+  assert.equal(displayHomePath('/x/y', '/a'), '/x/y');
+  assert.equal(displayHomePath('/a', '/a'), '/a', '家目录本身不折叠（原行为）');
+});
diff --git a/test/unit/entry-scan-isolation.test.ts b/test/unit/entry-scan-isolation.test.ts
new file mode 100644
index 00000000..5095b33c
--- /dev/null
+++ b/test/unit/entry-scan-isolation.test.ts
@@ -0,0 +1,86 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { runDoctor } from '../../src/trivium/doctor.js';
+import { TRIVIUM_DIR, defaultConfig } from '../../src/trivium/config.js';
+import { AGENTS } from '../../src/trivium/agents/registry.js';
+import { ENTRY_SCAN_HOME_ENV } from '../../src/trivium/entry-collisions.js';
+import { REPO_ROOT } from '../helpers/fixture.js';
+import { scratchDir } from '../helpers/scratch.js';
+import { isolateEntryScanHome } from '../helpers/entry-scan-home.js';
+
+isolateEntryScanHome();
+
+/*
+ * 测试不读真实家目录的共享读取面（EV-240，M12 批次 5；计划双审 CODEX-01 / GLM-01，计划 r2 §4 U8、U9）。
+ *
+ * doctor 的扫描与 `--only` 无关、preflight 的扫描排在多数只告警项之后，凡能跑到 `runDoctor` / `runPreflight`
+ * 的旧用例都会顺带扫一次。隔离靠单一来源（`entryScanEnv()`）+ 两个测试侧入口，本文件守住两件事：
+ * U8 名单对账——没走隔离的调用方当场红；U9 读源证明——设了变量，读的就是变量指的那个目录。
+ */
+
+async function listTestFiles(dir: string): Promise<string[]> {
+  const out: string[] = [];
+  for (const e of await fs.readdir(dir, { withFileTypes: true })) {
+    const p = path.join(dir, e.name);
+    if (e.isDirectory()) out.push(...(await listTestFiles(p)));
+    else if (e.name.endsWith('.test.ts')) out.push(p);
+  }
+  return out;
+}
+
+/**
+ * 不经 `cli()`、自己 spawn 打包产物跑 doctor / preflight 的文件，逐个登记理由。新出现的未登记即红。
+ * （提到命令名但不真正执行它的，例如只校验参数形态的启动器用例，也登记在这里。）
+ */
+const SPAWN_REVIEWED: Readonly<Record<string, string>> = {
+  'test/integration/selftest.test.ts': '`doctor --selftest` 走 selftestCommand，不进 runDoctor，跑不到扫描',
+  'test/integration/stub-agent-kit.test.ts': 'cliIn 显式设 HOME 为夹具家目录，os.homedir() 即夹具',
+  'test/unit/agent-access-task-launch.test.ts': '只校验静默启动器的参数形态，产品 spawn 计数断言为 0',
+  'test/unit/agent-access-recovery.test.ts': '只把 preflight 写进 argv 交给形态校验器，不执行',
+  'test/integration/access-v3.test.ts': '自己 spawn 的只有 gate hook-pre-commit；preflight 都经 cli()',
+};
+
+test('U8 对账：直调 runDoctor / runPreflight 的测试文件都调了 isolateEntryScanHome()；cli() 缺省设隔离变量', async () => {
+  const files = await listTestFiles(path.join(REPO_ROOT, 'test'));
+  const missing: string[] = [];
+  const unreviewedSpawn: string[] = [];
+  for (const f of files) {
+    const rel = path.relative(REPO_ROOT, f).split(path.sep).join('/');
+    const text = await fs.readFile(f, 'utf8');
+    if (/\brun(Doctor|Preflight)\s*\(/.test(text) && !text.includes('isolateEntryScanHome()')) missing.push(rel);
+    const spawnsBundle = /\[\s*(BUNDLE|k\.bundle)\s*,/.test(text) || /spawnSync\(/.test(text);
+    if (spawnsBundle && /'(doctor|preflight)'/.test(text) && !(rel in SPAWN_REVIEWED)) unreviewedSpawn.push(rel);
+  }
+  assert.deepEqual(missing, [], '这些文件直调了 doctor / preflight 却没钉扫描家目录');
+  assert.deepEqual(unreviewedSpawn, [], '这些文件自己 spawn 了 doctor / preflight：要么改走 cli()，要么登记理由');
+
+  const fixture = await fs.readFile(path.join(REPO_ROOT, 'test/helpers/fixture.ts'), 'utf8');
+  assert.match(fixture, /\[ENTRY_SCAN_HOME_ENV\]: emptyEntryScanHome\(\)/, 'cli() 的缺省环境要把扫描家目录钉到空夹具');
+});
+
+test('U9 读源证明：变量指向摆了同名入口的夹具 ⇒ 告警里的路径落在夹具里；指向空夹具 ⇒ 无告警', async () => {
+  const saved = process.env[ENTRY_SCAN_HOME_ENV];
+  const root = await scratchDir('trivium-escan-proj-');
+  const triviumDir = path.join(root, TRIVIUM_DIR);
+  await fs.mkdir(triviumDir, { recursive: true });
+  const dirty = await scratchDir('trivium-escan-dirty-');
+  const rel = AGENTS.find((a) => a.entrySkillExtraReadRoots.length > 0)!.entrySkillExtraReadRoots[0]!;
+  await fs.mkdir(path.join(dirty, rel, 'dual-approve'), { recursive: true });
+  await fs.writeFile(path.join(dirty, rel, 'dual-approve/SKILL.md'), '---\nname: dual-approve\n---\n');
+  try {
+    process.env[ENTRY_SCAN_HOME_ENV] = dirty;
+    const hit = await runDoctor({ config: defaultConfig(), projectRoot: root, triviumDir, only: 'env', skipModelCalls: true });
+    const w = hit.warnings.find((x) => x.startsWith('共享读取面'));
+    assert.ok(w, '变量指向的夹具里有同名入口，必须报');
+    assert.ok(w.includes(`~/${rel}/dual-approve`), w);
+
+    process.env[ENTRY_SCAN_HOME_ENV] = await scratchDir('trivium-escan-clean-');
+    const none = await runDoctor({ config: defaultConfig(), projectRoot: root, triviumDir, only: 'env', skipModelCalls: true });
+    assert.equal(none.warnings.some((x) => x.startsWith('共享读取面')), false);
+  } finally {
+    if (saved === undefined) delete process.env[ENTRY_SCAN_HOME_ENV];
+    else process.env[ENTRY_SCAN_HOME_ENV] = saved;
+  }
+});
diff --git a/test/unit/handoff-pack.test.ts b/test/unit/handoff-pack.test.ts
new file mode 100644
index 00000000..7af8af1f
--- /dev/null
+++ b/test/unit/handoff-pack.test.ts
@@ -0,0 +1,103 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { packSnapshots, unpackSnapshots } from '../../src/trivium/run-protocol.js';
+import { EXIT, exitCodeOf } from '../../src/trivium/exit-codes.js';
+import { sha256 } from '../../src/trivium/util/fsx.js';
+import type { Snapshot } from '../../src/trivium/freeze.js';
+import type { CriticId } from '../../src/trivium/types.js';
+
+/*
+ * 交接文件里的冻结补丁只存一份（EV-236 A2，M12 批次 5；计划 r2 §3 / §4 U7）。
+ * 往返后与去重前逐字段相等；旧格式原样读出；新格式坏了一律受控 envError（计划双审 AGY-02 / AGY-03）。
+ */
+
+const DIFF = 'diff --git a/x.ts b/x.ts\n+SENTINEL_DIFF_LINE_8d1c\n'.repeat(3);
+const SIDES: CriticId[] = ['codex', 'glm', 'gemini'];
+
+function snap(diffText: string | null, over: Partial<Snapshot> = {}): Snapshot {
+  return {
+    gitHead: 'a'.repeat(40), treeHash: 'b'.repeat(40), dirty: true,
+    subjectSha256: diffText === null ? 'c'.repeat(64) : sha256(diffText),
+    subjectPath: '/p/.reviews/T/code/_meta/changes-1.diff', denyPaths: ['.env'], diffText, takenAt: 't', ...over,
+  };
+}
+
+const codeSnaps = (): Record<string, Snapshot> => Object.fromEntries(SIDES.map((c) => [c, snap(DIFF)]));
+const count = (hay: string, needle: string): number => hay.split(needle).length - 1;
+
+function assertEnvError(fn: () => unknown, re: RegExp): void {
+  assert.throws(fn, (e: unknown) => {
+    assert.equal(exitCodeOf(e), EXIT.ENV);
+    assert.match((e as Error).message, re);
+    return true;
+  });
+}
+
+test('U7 code 阶段三侧：落盘后快照里正文零份、frozen_diff 一份；往返与原对象逐字段相等；入参不被改', () => {
+  const original = codeSnaps();
+  const before = structuredClone(original);
+  const packed = packSnapshots(original);
+  assert.deepEqual(original, before, 'pack 不得改入参：--start 同进程后面看到的仍是原对象');
+  assert.ok(packed.frozen_diff);
+  assert.equal(packed.frozen_diff.sha256, sha256(DIFF));
+  const onDisk = JSON.parse(JSON.stringify({ stage: 'code', snapshots: packed.snapshots, frozen_diff: packed.frozen_diff }));
+  assert.equal(count(JSON.stringify(onDisk.snapshots), 'SENTINEL_DIFF_LINE_8d1c'), 0);
+  assert.equal(count(JSON.stringify(onDisk), 'SENTINEL_DIFF_LINE_8d1c'), 3, '只剩 frozen_diff 那一份（正文里本就重复 3 行）');
+  for (const c of SIDES) assert.equal(onDisk.snapshots[c].diffText, null);
+  assert.deepEqual(unpackSnapshots(onDisk, 'R'), before);
+});
+
+test('U7 plan 阶段（各侧 diffText 为 null）与空快照：原样，不出 frozen_diff', () => {
+  const plan = Object.fromEntries(SIDES.map((c) => [c, snap(null)]));
+  const p = packSnapshots(plan);
+  assert.equal(p.frozen_diff, undefined);
+  assert.equal(p.snapshots, plan);
+  assert.deepEqual(unpackSnapshots({ stage: 'plan', snapshots: plan }, 'R'), plan);
+  const empty = packSnapshots({});
+  assert.equal(empty.frozen_diff, undefined, '空快照不得提取（AGY-03）');
+});
+
+test('U7 各侧正文不一致（防御）：不收，原样写', () => {
+  const s = codeSnaps();
+  s['glm'] = snap(DIFF + 'x');
+  const p = packSnapshots(s);
+  assert.equal(p.frozen_diff, undefined);
+  assert.equal(p.snapshots, s);
+});
+
+test('U7 旧格式（各侧各带正文、无 frozen_diff）原样读出', () => {
+  const old = codeSnaps();
+  assert.equal(unpackSnapshots({ stage: 'code', snapshots: old }, 'R'), old);
+});
+
+test('U7 新格式被改坏：各种篡改一律 envError，指名运行', () => {
+  const good = () => {
+    const p = packSnapshots(codeSnaps());
+    return JSON.parse(JSON.stringify({ stage: 'code', snapshots: p.snapshots, frozen_diff: p.frozen_diff }));
+  };
+  let h = good();
+  h.frozen_diff.text += 'tampered';
+  assertEnvError(() => unpackSnapshots(h, 'R1'), /运行 R1 的交接文件已损坏：冻结补丁的正文与它的 sha256 对不上/);
+
+  h = good();
+  h.snapshots.glm.diffText = DIFF;
+  assertEnvError(() => unpackSnapshots(h, 'R'), /glm 侧快照既带补丁正文/);
+
+  h = good();
+  h.snapshots.gemini.subjectSha256 = 'f'.repeat(64);
+  assertEnvError(() => unpackSnapshots(h, 'R'), /gemini 侧快照的被审对象哈希与冻结补丁对不上/);
+
+  for (const bad of [null, 'text', 42, { text: 1, sha256: 'x' }, { text: 'x' }]) {
+    h = good();
+    h.frozen_diff = bad;
+    assertEnvError(() => unpackSnapshots(h, 'R'), /冻结补丁的形态不对/);
+  }
+
+  h = good();
+  h.stage = 'plan';
+  assertEnvError(() => unpackSnapshots(h, 'R'), /plan 阶段不该带冻结补丁/);
+
+  h = good();
+  delete h.frozen_diff;
+  assertEnvError(() => unpackSnapshots(h, 'R'), /code 阶段有一侧快照没有补丁正文/);
+});
