+  await fs.mkdir(path.join(temp,'.qoder'));
+  for(const name of ['settings.json','settings.local.json'])await fs.writeFile(path.join(temp,'.qoder',name),JSON.stringify({model:{name:'trivium-project-invalid'}}));
