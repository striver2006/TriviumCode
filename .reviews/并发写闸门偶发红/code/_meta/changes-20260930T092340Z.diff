+# 构建树（并发写闸门偶发红，EV-153，计划 r2 §5.1）
+
+四棵树，都在会话 scratchpad（临时目录，会话结束可能被清）；搭法可复现，不需要网络：
+
+```sh
+SP=〈scratchpad〉
+git archive 〈提交〉 | tar -x -C $SP/〈目录〉
+ln -s 〈仓库〉/node_modules $SP/〈目录〉/node_modules
+(cd $SP/〈目录〉 && node scripts/build.mjs --tests-only)
+```
+
+| 树 | 来源 | `src/trivium/lock.ts` sha256 前 16 位 | `dist/test/src/trivium/lock.js` sha256 前 16 位 | 用途 |
+| :-- | :-- | :-- | :-- | :-- |
+| 旧 `old-3e38d29` | `git archive 3e38d29`（EV-173 修复之前，用户指定） | `93eb307d927f3887` | `62c105b8323c258b` | §2.1 A1 / A2 / B1 / C1、repeat-old-plan、移植验收、跨进程验收 |
+| 改前 `pre-7c6959e` | `git archive 7c6959e`（本主题起点） | `a4d98c4e11d41f2d` | `b4e78aaf0ace8c8d` | 移植验收、跨进程验收（§2.1 的「新」读数取自仓库工作树，那时与本树同码） |
+| 原型 `proto-f2` | `git archive HEAD`（= 7c6959e）后只改 D1 一行，diff 见 `proto-f2.diff` | `cb549455801adcb3` | `ed7d41e4fa230c0f` | §2.1 P1 / P2 |
+| 改后 | 仓库工作树（D1 + 注释 / JSDoc） | `af25a20af0618456` | `8c9d5a213ed967d2` | 编码阶段全部改后读数 |
+
+移植验收（`acceptance.mjs`）把改后的 `test/unit/lock.test.ts`、`test/unit/state.test.ts`、`test/helpers/ps-stub.ts` 拷进旧树与改前树后重新 `--tests-only`，拷入前后的 sha256 记在 `acceptance-readout.json` 的 `ported[]`；`lock.js` 不受拷入影响（上表哈希取自拷入之后）。
diff --git a/test/helpers/ps-stub.ts b/test/helpers/ps-stub.ts
new file mode 100644
index 00000000..e6b0c731
--- /dev/null
+++ b/test/helpers/ps-stub.ts
@@ -0,0 +1,64 @@
+/**
+ * 让 `/bin/ps` 派生失败的桩（EV-153，并发写闸门偶发红计划 r2 §3 D3）。
+ *
+ * `util/exec.ts` 以具名导入取 `spawn`（ESM 绑定），只改 `child_process.spawn` 属性不够：要 `syncBuiltinESMExports()` 把改动同步进
+ * 已实例化的具名绑定。**还原时同样要再同步一次**，否则具名绑定仍指向桩、泄漏到同文件的后续用例（计划双审 AGY-02）。
+ *
+ * 被拦的调用改派生一个不存在的可执行文件：`run()` 收到 'error' 以 `code: null` 收尾，`processStartTime` 得 null——与满载下
+ * 派生失败（EAGAIN 等）同一结局。形态按 `processStartTime` 的取法区分：规范化形态带 `env.TZ === 'UTC0'`，缺省形态不带。
+ *
+ * 桩是否真的生效要由调用方自证（`psStubWorks`）：桩在某个 Node 版本上不透传时，依赖它的用例会空转成绿（计划双审 CODEX-02）。
+ */
+import cp from 'node:child_process';
+import { syncBuiltinESMExports } from 'node:module';
+import { processStartTime } from '../../src/trivium/util/exec.js';
+
+export type PsForm = 'canonical' | 'legacy' | 'both';
+
+export interface PsStub {
+  /** 被拦下的 `ps` 次数 */
+  readonly blocked: number;
+  /** 复原原 `spawn` 并重新同步具名绑定；可重复调用 */
+  restore: () => void;
+}
+
+export function stubPsFailure(which: PsForm): PsStub {
+  const orig = cp.spawn;
+  const state = { blocked: 0, restored: false };
+  const stub = function (this: unknown, bin: string, args?: readonly string[], opts?: cp.SpawnOptions) {
+    if (bin === '/bin/ps') {
+      const canonical = (opts?.env as NodeJS.ProcessEnv | undefined)?.TZ === 'UTC0';
+      if (which === 'both' || (which === 'canonical') === canonical) {
+        state.blocked++;
+        return orig.call(this, '/nonexistent/trivium-test-ps', args ?? [], opts ?? {});
+      }
+    }
+    return (orig as (...a: unknown[]) => cp.ChildProcess).call(this, bin, args, opts);
+  } as typeof cp.spawn;
+  cp.spawn = stub;
+  syncBuiltinESMExports();
+  return {
+    get blocked() {
+      return state.blocked;
+    },
+    restore: () => {
+      if (state.restored) return;
+      state.restored = true;
+      cp.spawn = orig;
+      syncBuiltinESMExports();
+    },
+  };
+}
+
+/**
+ * 桩自证：装桩后以对应形态取一次本进程的启动时刻，应得 null。取到值说明桩没透传到 `exec.ts` 的具名绑定——
+ * 返回可读的原因，调用方据此判红，而不是让用例在桩失效时空转绿。
+ */
+export async function psStubWorks(which: PsForm): Promise<string | null> {
+  const forms = which === 'both' ? ['canonical', 'legacy'] as const : [which];
+  for (const f of forms) {
+    const t = await processStartTime(process.pid, f === 'canonical' ? { canonical: true } : {});
+    if (t !== null) return `桩未生效：${f} 形态仍取到启动时刻「${t}」（Node ${process.version} 未把 spawn 的改动同步进具名导入）`;
+  }
+  return null;
+}
