+process.stdin.resume();
+process.stdin.on('end', () => {
+  process.stdout.write(JSON.stringify({ type: 'system', subtype: 'init', model: 'claude-sonnet-5', session_id: 'S1', tools: ['Read'] }) + '\\n');
