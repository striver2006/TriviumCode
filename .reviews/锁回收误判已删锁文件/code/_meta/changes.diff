+      phase = 'A';
+      const a = await acquireLock(opts('R-A'));
+      release();
+      const bResult = await b;
+      const c = await acquireLock(opts('R-C')).then(() => 'C 拿到了', (e: { code?: number }) => e.code);
+      return { a, bResult, c };
