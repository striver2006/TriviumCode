+// ── U3 汇总判据 ──
+
+const fail = (name: string, recalibrate?: CheckResult['recalibrate']): CheckResult => ({ name, ok: false, detail: '', exitCode: EXIT.ENV, ...(recalibrate ? { recalibrate } : {}) });
