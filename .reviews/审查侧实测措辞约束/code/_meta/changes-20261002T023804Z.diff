index 00000000..8a0280e0
--- /dev/null
+++ b/test/integration/brief-command-execution.test.ts
@@ -0,0 +1,62 @@
+/**
+ * 任务书第 7 节的接线（EV-95，审查侧实测措辞约束计划 r2 §3.1 ②）。
+ *
+ * 单测直调 `renderBrief` 并手工传 `commandExecution`，验的是渲染；这里走真实打包 CLI 子进程 + 桩（零配额），
+ * 验 `prepareRun` 把**适配器的声明**递进渲染：硬编码一个取值、改按 `capability.traceShape` 推导、两侧串值，
+ * 都会在第二次运行（解耦组合）里红。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { bundleMissing, bundleSkipReason, cli, makeFixture } from '../helpers/fixture.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import type { StubConfig } from '../../src/trivium/adapters/stub.js';
+
+const skip = bundleMissing && bundleSkipReason;
+
+const NONE_MARK = '**你这一侧没有执行命令的能力**';
+const SHELL_MARK = '你这一侧可以执行只读命令。';
+
+/** 跑一次同步 review，返回两侧落盘任务书的第 7 节 */
+async function section7ByCritic(topic: string, stub: StubConfig): Promise<Record<string, string>> {
+  const fx = await makeFixture({ topic });
+  const r = await cli(fx.root, ['review', '--stage', 'plan', '--topic', topic, '--focus', 'x'], stub);
+  assert.equal(r.code, EXIT.OK, `${r.stdout}\n${r.stderr}`);
+  const metaDir = path.join(fx.stageDir, '_meta');
+  const out: Record<string, string> = {};
+  for (const critic of Object.keys(stub)) {
+    const files = (await fs.readdir(metaDir)).filter((f) => f.startsWith(`brief-${critic}-`) && f.endsWith('.md'));
+    assert.equal(files.length, 1, `${critic} 侧应恰有一份任务书：${files.join('、')}`);
+    const text = await fs.readFile(path.join(metaDir, files[0]!), 'utf8');
+    const s = text.indexOf('## 7. 反谄媚约束');
+    const e = text.indexOf('## 8. ', s);
+    assert.ok(s >= 0 && e > s, `${critic} 侧任务书段落结构变了`);
+    out[critic] = text.slice(s, e);
+  }
+  return out;
+}
+
+function expect(s7: string, want: 'none' | 'readonly-shell', label: string): void {
+  const [yes, no] = want === 'none' ? [NONE_MARK, SHELL_MARK] : [SHELL_MARK, NONE_MARK];
+  assert.ok(s7.includes(yes), `${label}：应为 ${want} 说法\n${s7}`);
+  assert.ok(!s7.includes(no), `${label}：不应出现另一种说法\n${s7}`);
+}
+
+test('桩缺省：command_trace 一侧拿到只读 shell 说法、ok 一侧拿到不能执行命令说法', { skip }, async () => {
+  const s7 = await section7ByCritic('第七节接线缺省', {
+    gemini: { mode: 'command_trace' },
+    glm: { mode: 'ok' },
+  });
+  expect(s7['gemini']!, 'readonly-shell', 'gemini（command_trace）');
+  expect(s7['glm']!, 'none', 'glm（ok）');
+});
+
+test('解耦组合：渲染跟适配器的 commandExecution 走，不跟轨迹形状', { skip }, async () => {
+  const s7 = await section7ByCritic('第七节接线解耦', {
+    gemini: { mode: 'ok', commandExecution: 'readonly-shell' },
+    glm: { mode: 'command_trace', commandExecution: 'none' },
+  });
+  expect(s7['gemini']!, 'readonly-shell', 'gemini（tool-trace + readonly-shell）');
+  expect(s7['glm']!, 'none', 'glm（command-trace + none）');
+});
diff --git a/test/unit/brief-command-execution.test.ts b/test/unit/brief-command-execution.test.ts
new file mode 100644
index 00000000..4d4d0bcc
--- /dev/null
+++ b/test/unit/brief-command-execution.test.ts
@@ -0,0 +1,122 @@
+/**
+ * 任务书第 7 节按该侧命令执行能力二选一（EV-95，审查侧实测措辞约束计划 r2 §3.1 ①）。
+ *
+ * 特征句在本文件**字面写出**，不从 `brief.ts` 导入——导入常量的话，改了文案用例照绿。
+ * 四家真实适配器取各自模块导出的适配器对象（不是手写取值），桩取两种形态与两格解耦组合。
+ * 接线（`prepareRun` 把适配器声明递进来）由 `test/integration/brief-command-execution.test.ts` 守。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderBrief, type BriefInput } from '../../src/trivium/brief.js';
+import { defaultConfig } from '../../src/trivium/config.js';
+import { agyAdapter } from '../../src/trivium/adapters/agy.js';
+import { claudeAdapter } from '../../src/trivium/adapters/claude.js';
+import { codexAdapter } from '../../src/trivium/adapters/codex.js';
+import { zcodeAdapter } from '../../src/trivium/adapters/zcode.js';
+import { makeStubAdapter } from '../../src/trivium/adapters/stub.js';
+import type { CommandExecution, CriticAdapter } from '../../src/trivium/adapters/base.js';
+import type { Snapshot } from '../../src/trivium/freeze.js';
+
+const SNAP: Snapshot = {
+  gitHead: null, treeHash: 't', dirty: false, subjectSha256: 's',
+  subjectPath: '/proj/.reviews/T/plan/2026-10-02-T-claude.md', denyPaths: ['.env'], diffText: null, takenAt: 'x',
+};
+
+function brief(adapter: CriticAdapter): string {
+  const input: BriefInput = {
+    cfg: defaultConfig(), critic: adapter.critic, stage: 'plan', topic: 'T', runId: 'R', projectRoot: '/proj', snapshot: SNAP,
+    promptHint: '请独立复测那条退出码断言', subjectExcerpt: '# 计划', mustRead: ['CLAUDE.md'], suggestedRead: [], ownHistory: [],
+    schemaPath: '/s/review.v1.json', lenses: {}, taskGoal: null, minToolCalls: 5, minProjectReads: 3,
+    commandExecution: adapter.commandExecution,
+  };
+  return renderBrief(input);
+}
+
+function section7(b: string): string {
+  const start = b.indexOf('## 7. 反谄媚约束');
+  const end = b.indexOf('## 8. ', start);
+  assert.ok(start >= 0 && end > start, '第 7 节应存在且在第 8 节之前');
+  return b.slice(start, end);
+}
+
+/** 两种说法各自的特征句（字面）。`none` 两条、`readonly-shell` 一条 */
+const NONE_MARKS = [
+  '**你这一侧没有执行命令的能力**，只能读文件与检索。',
+  '不要用「实测」「复测」「直调」「跑了」「执行结果」一类说法描述你的判断',
+  '需要运行才能确认的结论写明是推理，并在 `not_covered` 里列出没能验证的部分',
+  '第 2 节的焦点若要求实测或复测而你做不到，如实说明后照常交付结论，**不要停下来等放行**。',
+];
+const SHELL_MARKS = [
+  '你这一侧可以执行只读命令。',
+  '凡写「实测」「复测」的判断，`evidence` 里写出你本轮实际执行的命令；没执行、靠推理得出的写明是推理。',
+];
+
+/** 既有五条（逐字、按序） */
+const BASE_LINES = [
+  '- **不要为了显得有用而编造问题。** 没问题就说没问题。',
+  '- 不确定的判断标 `confidence: low`，不要用确定的语气写不确定的结论。',
+  '- **必须**填写 `not_covered`，如实暴露你这次没覆盖的范围。',
+  '- 在 `agreed` 里写出你认为正确的部分——只挑刺的审查是低质量的审查。',
+  '- 不要给出大段可粘贴的补丁。你是审查员，不是第二作者；指出方向即可。',
+];
+
+function assertVariant(s7: string, want: CommandExecution, label: string): void {
+  const [mine, other] = want === 'none' ? [NONE_MARKS, SHELL_MARKS] : [SHELL_MARKS, NONE_MARKS];
+  for (const m of mine) assert.ok(s7.includes(m), `${label}：第 7 节应含「${m}」\n${s7}`);
+  for (const m of other) assert.ok(!s7.includes(m), `${label}：第 7 节不应含另一种说法的「${m}」\n${s7}`);
+  // 「第 2 节」而不是「第 2 段」：任务书正文自称各段为「节」
+  assert.ok(!s7.includes('第 2 段'), `${label}：称呼应为「第 2 节」`);
+}
+
+test('四家真实适配器：第 7 节恰好是各自声明的那一种说法（codex 只读 shell，其余三家不能执行命令）', () => {
+  const cases: [CriticAdapter, CommandExecution][] = [
+    [codexAdapter, 'readonly-shell'],
+    [agyAdapter, 'none'],
+    [zcodeAdapter, 'none'],
+    [claudeAdapter, 'none'],
+  ];
+  for (const [a, want] of cases) {
+    assert.equal(a.commandExecution, want, `${a.critic} 的声明`);
+    assertVariant(section7(brief(a)), want, a.critic);
+  }
+});
+
+test('桩的两种形态：command_trace 缺省为只读 shell，其余缺省为不能执行命令', () => {
+  assertVariant(section7(brief(makeStubAdapter('gemini', { mode: 'command_trace' }))), 'readonly-shell', '桩 command_trace');
+  assertVariant(section7(brief(makeStubAdapter('glm', { mode: 'ok' }))), 'none', '桩 ok');
+});
+
+test('解耦两格：渲染跟的是 commandExecution，不是轨迹形状', () => {
+  const toolShell = makeStubAdapter('gemini', { mode: 'ok', commandExecution: 'readonly-shell' });
+  assert.equal(toolShell.capability.traceShape, 'tool-trace');
+  assertVariant(section7(brief(toolShell)), 'readonly-shell', 'tool-trace + readonly-shell');
+
+  const cmdNone = makeStubAdapter('glm', { mode: 'command_trace', commandExecution: 'none' });
+  assert.equal(cmdNone.capability.traceShape, 'command-trace');
+  assertVariant(section7(brief(cmdNone)), 'none', 'command-trace + none');
+});
+
+test('既有五条逐字仍在且顺序不变；新增条目插在 not_covered 那条之后、agreed 那条之前', () => {
+  for (const ce of ['none', 'readonly-shell'] as const) {
+    const s7 = section7(brief(makeStubAdapter('glm', { mode: 'ok', commandExecution: ce })));
+    const lines = s7.split('\n').filter((l) => l.startsWith('- '));
+    const pos = BASE_LINES.map((b) => lines.indexOf(b));
+    assert.ok(pos.every((p) => p >= 0), `${ce}：既有五条应逐字仍在\n${s7}`);
+    assert.deepEqual([...pos].sort((a, b) => a - b), pos, `${ce}：既有五条顺序不变`);
+    const added = lines.length - BASE_LINES.length;
+    assert.equal(added, ce === 'none' ? 2 : 1, `${ce}：新增条目数`);
+    // not_covered 那条（第 3 条）与 agreed 那条（第 4 条）之间恰好夹着新增条目
+    assert.equal(pos[3]! - pos[2]!, added + 1, `${ce}：新增条目应紧跟 not_covered 那条`);
+  }
+});
+
+test('两种说法下第 7 节之外的全文逐字相同；八个标题恰好八个', () => {
+  const a = brief(makeStubAdapter('glm', { mode: 'ok', commandExecution: 'none' }));
+  const b = brief(makeStubAdapter('glm', { mode: 'ok', commandExecution: 'readonly-shell' }));
+  const strip = (t: string) => t.replace(section7(t), '');
+  assert.notEqual(a, b);
+  assert.equal(strip(a), strip(b));
+  for (const t of [a, b]) {
+    assert.equal((t.match(/^## \d\. /gm) ?? []).length, 8, '段落数是契约');
+  }
+});
diff --git a/test/unit/command-execution-parity.test.ts b/test/unit/command-execution-parity.test.ts
new file mode 100644
index 00000000..a6e00761
--- /dev/null
+++ b/test/unit/command-execution-parity.test.ts
@@ -0,0 +1,142 @@
+/**
+ * 适配器的命令执行能力声明 ↔ 各家工具面事实源（EV-95，审查侧实测措辞约束计划 r2 §3.1 ③）。
+ *
+ * 从事实源**推出**每家能不能执行命令，再与适配器上的 `commandExecution` 比对——一边改了另一边不跟就红。
+ * 声明错了的代价是任务书第 7 节对审查员说错话：对能跑命令的一侧说「你没有执行能力」，
+ * 它就会把真跑过的结果写成推理；反过来就是 EV-79 那种推理冒充实测。
+ *
+ * 工具名一律过**已分类表**：出现表里没有的工具名即红，逼加工具的人回来判它能不能执行命令。
+ * 误红的出口是往表里登记一行，不是放宽判据。
+ *
+ * 边界：agy 侧对账的是仓库里的 `trivium-critic.md`；运行期生效的是安装器拷进用户 HOME 的副本，
+ * 两者漂移不在本用例论域（EV-187）。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { existsSync, readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { agyAdapter } from '../../src/trivium/adapters/agy.js';
+import { claudeAdapter } from '../../src/trivium/adapters/claude.js';
+import { codexAdapter } from '../../src/trivium/adapters/codex.js';
+import { zcodeAdapter, ZCODE_READONLY_DENYLIST } from '../../src/trivium/adapters/zcode.js';
+import { realAdapters } from '../../src/trivium/adapters/index.js';
+import { READONLY_INVARIANTS } from '../../src/trivium/probes/claude.js';
+import { CODEX_READONLY_INVARIANTS } from '../../src/trivium/probes/codex.js';
+import type { CommandExecution, CriticAdapter } from '../../src/trivium/adapters/base.js';
+
+/** 运行时在 dist/test/test/unit/，源码在 test/unit/，所以向上找 package.json */
+const REPO_ROOT = (() => {
+  let dir = path.dirname(fileURLToPath(import.meta.url));
+  for (let i = 0; i < 8; i++) {
+    if (existsSync(path.join(dir, 'package.json'))) return dir;
+    dir = path.dirname(dir);
+  }
+  throw new Error('未能定位仓库根');
+})();
+
+/** 工具名 → 能否执行命令。只登记见过并判过的名字 */
+type ToolTable = Readonly<Record<string, boolean>>;
+
+const CLAUDE_TOOLS: ToolTable = { Read: false, Grep: false, Glob: false, Bash: true };
+const AGY_TOOLS: ToolTable = {
+  view_file: false, grep_search: false, find_by_name: false, list_dir: false, finish: false,
+  run_command: true,
+};
+
+/** 按已分类表推出能力：有一个能执行命令的工具 ⇒ readonly-shell；出现未分类的工具名 ⇒ 抛 */
+function classify(tools: readonly string[], table: ToolTable, where: string): CommandExecution {
+  const unknown = tools.filter((t) => !(t in table));
+  if (unknown.length > 0) {
+    throw new Error(`${where} 出现未分类的工具：${unknown.join('、')}——先判它能不能执行命令，再登记进本用例的工具表`);
+  }
+  return tools.some((t) => table[t]) ? 'readonly-shell' : 'none';
+}
+
+/** 从 agent 定义文本的 front-matter 取 `tools:` 列表（纯函数，负例喂内存里改过的文本，不碰仓库文件） */
+function agyToolsFromDefinition(text: string): string[] {
+  const m = /^---\n([\s\S]*?)\n---/.exec(text);
+  assert.ok(m, 'agent 定义缺 front-matter');
+  const lines = m[1]!.split('\n');
+  const at = lines.findIndex((l) => /^tools:\s*$/.test(l));
+  assert.ok(at >= 0, 'front-matter 缺 tools: 列表');
+  const out: string[] = [];
+  for (const l of lines.slice(at + 1)) {
+    const item = /^\s+-\s+(\S+)\s*$/.exec(l);
+    if (!item) break;
+    out.push(item[1]!);
+  }
+  assert.ok(out.length > 0, 'tools: 列表为空');
+  return out;
+}
+
+/** zcode 是禁用名单（与另两家的白名单方向相反）：`Bash` 被禁 ⇒ 不能执行命令 */
+function zcodeFact(denylist: string): CommandExecution {
+  return denylist.split(',').map((s) => s.trim()).includes('Bash') ? 'none' : 'readonly-shell';
+}
+
+const AGY_DEFINITION_PATH =path.join(REPO_ROOT, 'skills/dual-critic/agents/trivium-critic.md');
+
+/** 每家的事实源推导。多出一家没登记，最后一格会红 */
+const FACTS: Record<string, { adapter: CriticAdapter; fact: () => CommandExecution; source: string }> = {
+  glm: {
+    adapter: zcodeAdapter,
+    source: 'ZCODE_READONLY_DENYLIST',
+    fact: () => zcodeFact(ZCODE_READONLY_DENYLIST),
+  },
+  claude: {
+    adapter: claudeAdapter,
+    source: 'probes/claude.ts READONLY_INVARIANTS 的 --tools 白名单',
+    fact: () => {
+      const at = READONLY_INVARIANTS.indexOf('--tools');
+      assert.ok(at >= 0 && at + 1 < READONLY_INVARIANTS.length, 'READONLY_INVARIANTS 里找不到 --tools 及其取值');
+      return classify(READONLY_INVARIANTS[at + 1]!.split(','), CLAUDE_TOOLS, 'claude 工具白名单');
+    },
+  },
+  gemini: {
+    adapter: agyAdapter,
+    source: 'skills/dual-critic/agents/trivium-critic.md 的 tools:',
+    fact: () => classify(agyToolsFromDefinition(readFileSync(AGY_DEFINITION_PATH, 'utf8')), AGY_TOOLS, 'trivium-critic.md'),
+  },
+  codex: {
+    adapter: codexAdapter,
+    source: 'probes/codex.ts CODEX_READONLY_INVARIANTS',
+    fact: () => {
+      // 只认恰好这一种沙箱参数：别的取值（workspace-write / danger-full-access）不再是「只读 shell」，要有人重新判
+      assert.deepEqual([...CODEX_READONLY_INVARIANTS], ['-s', 'read-only'], 'codex 沙箱参数变了，先重新判它的命令执行能力');
+      return 'readonly-shell';
+    },
+  },
+};
+
+for (const [id, f] of Object.entries(FACTS)) {
+  test(`${id}：适配器声明与事实源（${f.source}）一致`, () => {
+    assert.equal(f.adapter.critic, id, '登记表的键与适配器的侧名对不上');
+    assert.equal(f.adapter.commandExecution, f.fact(), `${id} 声明 ${f.adapter.commandExecution}，事实源推出的不一样`);
+  });
+}
+
+test('接线表里的每一家都在本用例登记了事实源（下一家接入时不会悄悄漏对账）', () => {
+  const wired = Object.keys(realAdapters()).sort();
+  assert.deepEqual(wired, Object.keys(FACTS).sort());
+});
+
+test('负例：agent 定义里加一行 run_command ⇒ 推出 readonly-shell，与 agy 的声明不符', () => {
+  const text = readFileSync(AGY_DEFINITION_PATH, 'utf8').replace(/^tools:\n/m, 'tools:\n  - run_command\n');
+  const derived = classify(agyToolsFromDefinition(text), AGY_TOOLS, '改过的定义');
+  assert.equal(derived, 'readonly-shell');
+  assert.notEqual(derived, agyAdapter.commandExecution);
+});
+
+test('负例：出现未分类的工具名 ⇒ 抛「未分类」，不静默当成不能执行', () => {
+  const text = readFileSync(AGY_DEFINITION_PATH, 'utf8').replace(/^tools:\n/m, 'tools:\n  - shell_exec\n');
+  assert.throws(() => classify(agyToolsFromDefinition(text), AGY_TOOLS, '改过的定义'), /未分类的工具：shell_exec/);
+  assert.throws(() => classify(['Read', 'LS'], CLAUDE_TOOLS, 'claude'), /未分类的工具：LS/);
+});
+
+test('负例：名单里去掉 Bash 的 zcode、白名单里加上 Bash 的 claude 都推出 readonly-shell', () => {
+  const noBash = ZCODE_READONLY_DENYLIST.split(',').filter((t) => t !== 'Bash').join(',');
+  assert.equal(zcodeFact(noBash), 'readonly-shell');
+  assert.notEqual(zcodeFact(noBash), zcodeAdapter.commandExecution);
+  assert.equal(classify(['Read', 'Grep', 'Glob', 'Bash'], CLAUDE_TOOLS, 'claude'), 'readonly-shell');
+});
