+  assert.equal(judgeRuntimeSelection(arm(FIRST), roArm(FIRST)).value, 'reorder_ineffective');
+  assert.equal(judgeRuntimeSelection(arm(REQ), roArm(FIRST)).value, null, '⑤ 冲突不收录');
