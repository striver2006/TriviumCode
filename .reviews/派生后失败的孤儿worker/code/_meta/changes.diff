+  if (await o.isGone()) return { gone: true, escalated: false };
+  send(pid, 'SIGTERM');
+  if (await waitGone(o.graceMs)) return { gone: true, escalated: false };
+
+  o.onEscalate?.();
+  send(pid, 'SIGKILL');
+  if (o.killWaitMs <= 0) return { gone: await o.isGone(), escalated: true };
+  return { gone: await waitGone(o.killWaitMs), escalated: true };
