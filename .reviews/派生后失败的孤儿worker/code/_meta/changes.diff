+export interface TerminateOptions {
+  /** 「确认已退出」的判据，由调用方给（父进程用子进程句柄；别的进程用 pid + 启动时刻） */
+  isGone: () => boolean | Promise<boolean>;
+  /** SIGTERM 之后至多等多久再升级 SIGKILL */
+  graceMs: number;
+  /** SIGKILL 之后至多等多久确认退出；0 = 不等 */
+  killWaitMs: number;
+  /** 轮询间隔，缺省 250 ms */
+  pollMs?: number;
+  /** 升级到 SIGKILL 之前回调一次（`cancelRun` 用它打那行 warn） */
+  onEscalate?: () => void;
