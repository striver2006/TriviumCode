+    assert.deepEqual(r.malformed, ['glm']);
+    assert.equal(groupMemberCount(live.pgid), 2, '活着的那组没被碰');
+    const adm = await cliGroupsConfirmedGone(s);
+    assert.equal(adm.gone, false, '准入侧：形状坏与判不了都不可抹');
+  } finally {
+    cleanup();
+  }
