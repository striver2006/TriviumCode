+    replace: `      // c 格（EV-154）：worker 在本次取消之前已退出（被强杀、崩溃）\n      cliOutcome = ${NEVER} ? await terminateRecordedCliGroups(await readStatus(runDir)) : { groups: [], malformed: [] };\n`,
