+      { vendorProfile: 'qwen', model: 'qwen3.8-flash', effort: null });
+    process.env['OPENAI_API_KEY'] = 'fixture-before';
+    const before = await auth.fingerprint();
+    process.env['OPENAI_API_KEY'] = 'fixture-after';
