+/** 不入本格的各格：直接把 status.json 摆成给定形状（不经 waitRun），看 --cancel 不发信号、什么都不写 */
+async function notThisCell(runId: string, shape: (s: RunStatus, pid: number) => void) {
+  const ctx = await fakeCtx();
+  const { pid, runDir } = await seedRun(ctx, runId);
