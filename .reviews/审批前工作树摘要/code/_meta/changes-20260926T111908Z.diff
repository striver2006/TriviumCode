index 0000000..3f5cb04
--- /dev/null
+++ b/src/trivium/worktree-summary.ts
@@ -0,0 +1,215 @@
+/**
+ * 审批时的工作树改动摘要（EV-132 候选 ② 折中版；计划 `.reviews/审批前工作树摘要/plan/` r2）。
+ *
+ * ## 它是什么、不是什么
+ *
+ * 闸门期（等人工审批时）改业务文件，审批前复核看不见——它只核裁决与本轮审查工件，不看工作树
+ * （M10b 第 4 步 3-4 实测：闸门期在终端改 `NOTES.md`，`approve` 仍退 0）。用户定的折中是：
+ * **审批时把「自审查收尾以来工作树变了什么」打印出来，由审批人自己判断**。
+ *
+ * 所以这里**只告知**：不改退出码、不改闸门迁移、不进任何判定。调用点（`cli.ts` 三个出口）
+ * 各包一层隔离块，这里自身也不抛错——任何失败都转成 `available: false` 加四种原因之一。
+ *
+ * ## 基线
+ *
+ * 取 `run.json.snapshot.after_tree_hash`：审查收尾复算漂移时的工作树 tree（`review.ts` 同一处落盘）。
+ * 当前树用同一个 `workTreeHash` 算，于是两边同法、结果只取决于工作树内容——**闸门期提交过的改动同样列出**
+ * （相对 HEAD 的 `git status` 看不见它们，这是没选它的理由）。字段缺席时不回落到送审快照 `tree_hash`。
+ *
+ * ## 盲区（如实写进每次摘要的范围行，不说「未发现越界」）
+ *
+ * - 被 `.gitignore` 忽略的文件看不见（`add -A` 不收它们）；
+ * - 改了又改回的文件，tree 相同，不会列出；
+ * - 基线是 `write-tree` 写出的不可达对象，可能被 git 清理——取不到时如实报原因 2，**绝不报「无改动」**。
+ *   为此比对用 `diffTreesNameStatus`（失败即抛），不用 `diffTrees`（失败返回 `[]`）。
+ */
+import { entryCommandOf } from './agents/registry.js';
+import { diffExcludePrefixes } from './code-stage.js';
+import { diffTreesNameStatus, treeExists, workTreeHash } from './util/git.js';
+
+/** 摘要总预算（计划双审 CODEX-02）：超出即落原因 4，审批照常 */
+export const SUMMARY_BUDGET_MS = 20_000;
+/** JSON 里 `files` 的条数上限（CODEX-04）；全量走照抄命令 */
+export const SUMMARY_JSON_LIMIT = 200;
+/** 人读列出的条数上限 */
+export const SUMMARY_TEXT_LIMIT = 20;
+/**
+ * 测试专用：覆盖摘要总预算（毫秒，正整数）。与 `TRIVIUM_STUB_CRITIC` 同一种注入惯例；
+ * 缺席或不合法时用 {@link SUMMARY_BUDGET_MS}。它只能把预算改小改大，不能让摘要影响审批。
+ */
+export const SUMMARY_BUDGET_ENV = 'TRIVIUM_TEST_SUMMARY_BUDGET_MS';
+
+/** 取本次生效的预算：环境变量为正整数时用它，否则用缺省 */
+export function summaryBudgetMs(env: NodeJS.ProcessEnv = process.env): number {
+  const raw = env[SUMMARY_BUDGET_ENV];
+  if (raw && /^\d+$/.test(raw) && Number(raw) > 0) return Number(raw);
+  return SUMMARY_BUDGET_MS;
+}
+
+/** 四种不可用原因（计划 r2 §2.5），逐字区分，都不与「无改动」同形 */
+export const REASON_NO_BASELINE = '本轮没有审查收尾时的工作树基线，无法比对。';
+export const REASON_BASELINE_GONE = '基线对象已不在对象库（可能被 git 清理）。';
+export const REASON_GIT_FAILED_PREFIX = 'git 调用失败：';
+export function reasonTimeout(budgetMs: number): string {
+  return `工作树摘要超时（超过 ${Math.round(budgetMs / 1000)} 秒）。`;
+}
+
+export interface WorkTreeSummary {
+  available: boolean;
+  /** 四种原因之一；available 为 true 时为 null */
+  reason: string | null;
+  run_id: string;
+  baseline: 'review_end';
+  baseline_tree: string | null;
+  current_tree: string | null;
+  /** 排除后的变更总数 */
+  total: number;
+  /** `files` 是否被 {@link SUMMARY_JSON_LIMIT} 截断 */
+  truncated: boolean;
+  /** 按路径排序，最多 {@link SUMMARY_JSON_LIMIT} 条 */
+  files: Array<{ status: string; path: string }>;
+  /** 比对时排除的路径前缀（`diffExcludePrefixes` 的结果） */
+  excluded_prefixes: string[];
+}
+
+export interface SummarizeInput {
+  projectRoot: string;
+  /** 归档根的项目相对路径（如 `.reviews`） */
+  archiveRootRel: string;
+  /** 本出口复核所用的 run id：approve 为闸门项 run_id，停点为最新一次运行 */
+  runId: string;
+  /** `run.json.snapshot.after_tree_hash`；缺席传 undefined */
+  afterTreeHash: string | undefined;
+  /** 总预算毫秒，缺省 {@link SUMMARY_BUDGET_MS} */
+  budgetMs?: number;
+}
+
+function isTimeout(e: unknown): boolean {
+  return typeof e === 'object' && e !== null && (e as { timedOut?: unknown }).timedOut === true;
+}
+
+function firstLine(e: unknown): string {
+  const msg = e instanceof Error ? e.message : String(e);
+  return msg.trim().split('\n')[0] ?? '';
+}
+
+/** 算摘要。**不抛错**：任何失败都转成 `available: false` 加原因 */
+export async function summarizeWorkTree(i: SummarizeInput): Promise<WorkTreeSummary> {
+  const budgetMs = i.budgetMs ?? SUMMARY_BUDGET_MS;
+  const excluded = diffExcludePrefixes(i.archiveRootRel);
+  const base: WorkTreeSummary = {
+    available: false,
+    reason: null,
+    run_id: i.runId,
+    baseline: 'review_end',
+    baseline_tree: i.afterTreeHash ?? null,
+    current_tree: null,
+    total: 0,
+    truncated: false,
+    files: [],
+    excluded_prefixes: excluded,
+  };
+  if (!i.afterTreeHash) return { ...base, reason: REASON_NO_BASELINE };
+
+  const started = Date.now();
+  // 每一步的 git 超时取剩余预算；预算已耗尽时给 1 ms，让那一步当场超时而不是不限时
+  const remaining = (): number => Math.max(1, budgetMs - (Date.now() - started));
+  try {
+    if (!(await treeExists(i.projectRoot, i.afterTreeHash, { timeoutMs: remaining() }))) {
+      return { ...base, reason: REASON_BASELINE_GONE };
+    }
+    const current = await workTreeHash(i.projectRoot, { timeoutMs: remaining() });
+    if (current === i.afterTreeHash) return { ...base, available: true, current_tree: current };
+
+    const isOwn = (f: string): boolean => excluded.some((p) => f === p || f.startsWith(`${p}/`));
+    const changed = (await diffTreesNameStatus(i.projectRoot, i.afterTreeHash, current, { timeoutMs: remaining() }))
+      .filter((c) => !isOwn(c.path))
+      .sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));
+    return {
+      ...base,
+      available: true,
+      current_tree: current,
+      total: changed.length,
+      truncated: changed.length > SUMMARY_JSON_LIMIT,
+      files: changed.slice(0, SUMMARY_JSON_LIMIT),
+    };
+  } catch (e) {
+    if (isTimeout(e)) return { ...base, reason: reasonTimeout(budgetMs) };
+    return { ...base, reason: `${REASON_GIT_FAILED_PREFIX}${firstLine(e)}` };
+  }
+}
+
+/** 调用点隔离块捕获到的异常（如 `readRunMeta` 抛错）也转成同一形态，原因 3 */
+export function unavailableSummary(runId: string, archiveRootRel: string, e: unknown): WorkTreeSummary {
+  return {
+    available: false,
+    reason: `${REASON_GIT_FAILED_PREFIX}${firstLine(e)}`,
+    run_id: runId,
+    baseline: 'review_end',
+    baseline_tree: null,
+    current_tree: null,
+    total: 0,
+    truncated: false,
+    files: [],
+    excluded_prefixes: diffExcludePrefixes(archiveRootRel),
+  };
+}
+
+export interface RenderOptions {
+  /** approval：`approve` 通过时；hold：闸门停点 */
+  exit: 'approval' | 'hold';
+  /** 当轮 Driver：abandon 的调用写法按它取（计划双审 AGY-01） */
+  driver: string | null;
+  topic: string;
+  limit?: number;
+}
+
+/** 照抄命令里的单引号参数：路径里若有单引号，写成 '\'' */
+function shQuote(s: string): string {
+  return `'${s.replace(/'/g, `'\\''`)}'`;
+}
+
+/** 超出人读上限时给出的完整列表命令，与摘要同口径（排除前缀、quotePath）——计划双审 CODEX-07 */
+export function fullListCommand(s: WorkTreeSummary): string {
+  const excludes = s.excluded_prefixes.map((p) => shQuote(`:(exclude)${p}`)).join(' ');
+  return `git -c core.quotePath=false diff-tree -r --name-status ${s.baseline_tree} ${s.current_tree} -- . ${excludes}`;
+}
+
+/**
+ * 渲染人读摘要。不可用时返回的整段以「⚠️」起头，由调用点走 `warn`（stderr）；其余走 `say`。
+ * 返回 `{ text, warning }`，调用点据 `warning` 选输出通道。
+ */
+export function renderWorkTreeSummary(s: WorkTreeSummary, opts: RenderOptions): { text: string; warning: boolean } {
+  if (!s.available) {
+    const tail = opts.exit === 'approval' ? '这不影响审批' : '这不影响停点';
+    return { text: `工作树改动摘要取不到：${s.reason ?? '原因未知。'}${tail}；请自行 git status 核对。`, warning: true };
+  }
+  // 范围行里列归档根与 .trivium/（.git 不是工作树内容，不列）；归档根在前
+  const own = [
+    ...s.excluded_prefixes.filter((p) => p !== '.git' && p !== '.trivium'),
+    ...s.excluded_prefixes.filter((p) => p === '.trivium'),
+  ].map((p) => `${p}/`).join(' 与 ');
+  if (s.total === 0) {
+    return {
+      text: `工作树改动摘要：自审查收尾（run ${s.run_id}）以来，未被 .gitignore 忽略的文件无改动（不含 ${own}）。`,
+      warning: false,
+    };
+  }
+  const scope = `未被 .gitignore 忽略的文件，不含 ${own}`;
+  const limit = opts.limit ?? SUMMARY_TEXT_LIMIT;
+  const shown = s.files.slice(0, limit);
+  const lines = [
+    `工作树改动摘要（只告知，不影响审批结论）：自审查收尾（run ${s.run_id}）以来，${s.total} 个文件有变化`,
+    ...shown.map((f) => `  ${f.status.padEnd(2)} ${f.path}`),
+  ];
+  if (s.total > shown.length) {
+    lines.push(`  ……另有 ${s.total - shown.length} 个，完整列表：${fullListCommand(s)}`);
+  }
+  lines.push(`  （比对范围：${scope}；闸门期提交过的改动同样列出）`);
+  lines.push(
+    opts.exit === 'approval'
+      ? `  若这些改动不该发生：请自行 git diff 核对，必要时 ${entryCommandOf(opts.driver, 'dual-abandon')} --topic ${opts.topic} 作废本轮后重跑。`
+      : '  审批时会再列出一次。',
+  );
+  return { text: lines.join('\n'), warning: false };
+}
diff --git a/test/unit/worktree-summary.test.ts b/test/unit/worktree-summary.test.ts
new file mode 100644
index 0000000..1abde2d
--- /dev/null
+++ b/test/unit/worktree-summary.test.ts
@@ -0,0 +1,241 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import os from 'node:os';
+import { promises as fs } from 'node:fs';
+import {
+  diffTrees, diffTreesNameStatus, initFixtureRepo, parseNameStatusZ, treeExists, workTreeHash,
+} from '../../src/trivium/util/git.js';
+import { run } from '../../src/trivium/util/exec.js';
+import { entryCommandOf } from '../../src/trivium/agents/registry.js';
+import {
+  REASON_BASELINE_GONE, REASON_GIT_FAILED_PREFIX, REASON_NO_BASELINE, SUMMARY_BUDGET_ENV, SUMMARY_BUDGET_MS,
+  SUMMARY_JSON_LIMIT, fullListCommand, reasonTimeout, renderWorkTreeSummary, summarizeWorkTree, summaryBudgetMs,
+  type WorkTreeSummary,
+} from '../../src/trivium/worktree-summary.js';
+
+/**
+ * 审批时的工作树改动摘要（EV-132 候选 ② 折中版；计划 `.reviews/审批前工作树摘要/plan/` r2 §3.1）。
+ *
+ * 这一族要守的是两条边界：
+ *   ① 「比不了」绝不能长得像「无改动」——基线被清、git 出错、超时，都要落成 `available: false` 加原因；
+ *   ② 摘要口径与漂移复算同法（`workTreeHash`），只取决于工作树内容，闸门期提交过的改动同样列出。
+ *
+ * 每条用例一个独立夹具目录（计划双审 CODEX-09）：gc 用例会清掉对象库里的不可达对象，不能与别的用例共享。
+ */
+
+async function repo(): Promise<string> {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'trivium-wts-'));
+  await fs.writeFile(path.join(dir, 'a.ts'), 'export const a = 1;\n');
+  await fs.writeFile(path.join(dir, 'b.ts'), 'export const b = 1;\n');
+  await fs.writeFile(path.join(dir, '.gitignore'), 'ignored.log\n');
+  await initFixtureRepo(dir);
+  return dir;
+}
+
+async function summarize(dir: string, afterTreeHash: string | undefined, budgetMs?: number): Promise<WorkTreeSummary> {
+  return summarizeWorkTree({
+    projectRoot: dir, archiveRootRel: '.reviews', runId: 'RUN1', afterTreeHash,
+    ...(budgetMs !== undefined ? { budgetMs } : {}),
+  });
+}
+
+const git = (dir: string, args: string[]) =>
+  run('git', ['-c', 'user.email=t@t', '-c', 'user.name=t', ...args], { cwd: dir, timeoutMs: 60_000 });
+
+test('1：基线之后没有改动 ⇒ available、total 0，渲染出「无改动」一行', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  const s = await summarize(dir, base);
+  assert.equal(s.available, true);
+  assert.equal(s.total, 0);
+  assert.equal(s.reason, null);
+  const r = renderWorkTreeSummary(s, { exit: 'approval', driver: null, topic: 'T' });
+  assert.equal(r.warning, false);
+  assert.match(r.text, /自审查收尾（run RUN1）以来，未被 \.gitignore 忽略的文件无改动（不含 \.reviews\/ 与 \.trivium\/）。/);
+});
+
+test('2：修改 / 新建未跟踪 / 删除 ⇒ M / A / D 三行，按路径排序', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  await fs.writeFile(path.join(dir, 'a.ts'), 'export const a = 2;\n');
+  await fs.writeFile(path.join(dir, 'new.ts'), 'x\n');
+  await fs.rm(path.join(dir, 'b.ts'));
+  const s = await summarize(dir, base);
+  assert.equal(s.available, true);
+  assert.deepEqual(s.files, [
+    { status: 'M', path: 'a.ts' },
+    { status: 'D', path: 'b.ts' },
+    { status: 'A', path: 'new.ts' },
+  ]);
+  const r = renderWorkTreeSummary(s, { exit: 'approval', driver: null, topic: 'T' });
+  assert.match(r.text, /只告知，不影响审批结论/);
+  assert.match(r.text, /3 个文件有变化/);
+  assert.match(r.text, /\n {2}M {2}a\.ts\n {2}D {2}b\.ts\n {2}A {2}new\.ts\n/);
+  assert.match(r.text, /比对范围：未被 \.gitignore 忽略的文件，不含 \.reviews\/ 与 \.trivium\/；闸门期提交过的改动同样列出/);
+});
+
+test('3：被 .gitignore 忽略的文件、归档根、.trivium/ 下的改动都不出现', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  await fs.writeFile(path.join(dir, 'ignored.log'), 'noise\n');
+  await fs.mkdir(path.join(dir, '.reviews/topic/plan'), { recursive: true });
+  await fs.writeFile(path.join(dir, '.reviews/topic/plan/x.md'), 'd\n');
+  await fs.mkdir(path.join(dir, '.trivium'), { recursive: true });
+  await fs.writeFile(path.join(dir, '.trivium/scratch.json'), '{}\n');
+  await fs.writeFile(path.join(dir, 'a.ts'), 'export const a = 3;\n');
+  const s = await summarize(dir, base);
+  assert.deepEqual(s.files.map((f) => f.path), ['a.ts']);
+  assert.equal(s.total, 1);
+});
+
+test('4：闸门期提交过的改动同样列出——基线与当前都按工作树内容算，不相对 HEAD', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  await fs.writeFile(path.join(dir, 'a.ts'), 'export const a = 4;\n');
+  await git(dir, ['add', 'a.ts']);
+  await git(dir, ['commit', '-q', '-m', 'during gate', '--no-verify']);
+  const st = await git(dir, ['status', '--porcelain']);
+  assert.equal(st.stdout.trim(), '', '前提：提交后 git status 干净');
+  const s = await summarize(dir, base);
+  assert.deepEqual(s.files, [{ status: 'M', path: 'a.ts' }]);
+});
+
+test('5：路径含空格、双引号、中文 ⇒ 原样（-z 成对解析，不加引号）', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  const names = ['有 空格.ts', 'quote"d.ts', '中文/文件.ts'];
+  await fs.mkdir(path.join(dir, '中文'), { recursive: true });
+  for (const n of names) await fs.writeFile(path.join(dir, n), 'x\n');
+  const s = await summarize(dir, base);
+  assert.deepEqual(s.files.map((f) => f.path).sort(), [...names].sort());
+});
+
+test('6：人读上限 20 条、超出给同口径的照抄命令；JSON 上限 200 条，带 total 与 truncated', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  await fs.mkdir(path.join(dir, 'many'), { recursive: true });
+  for (let i = 0; i < 21; i++) await fs.writeFile(path.join(dir, `many/f${String(i).padStart(3, '0')}.ts`), `${i}\n`);
+  const s21 = await summarize(dir, base);
+  assert.equal(s21.total, 21);
+  assert.equal(s21.truncated, false);
+  const r = renderWorkTreeSummary(s21, { exit: 'approval', driver: null, topic: 'T' });
+  const listed = r.text.split('\n').filter((l) => /^ {2}A {2}many\//.test(l));
+  assert.equal(listed.length, 20, '人读恰好列 20 条');
+  assert.match(r.text, /……另有 1 个，完整列表：git -c core\.quotePath=false diff-tree -r --name-status \S+ \S+ -- \. /);
+  // 照抄命令与摘要同口径（计划双审 CODEX-07）：带排除前缀
+  const cmd = fullListCommand(s21);
+  assert.match(cmd, /':\(exclude\)\.reviews'/);
+  assert.match(cmd, /':\(exclude\)\.trivium'/);
+
+  for (let i = 21; i < 205; i++) await fs.writeFile(path.join(dir, `many/f${String(i).padStart(3, '0')}.ts`), `${i}\n`);
+  const s205 = await summarize(dir, base);
+  assert.equal(s205.total, 205);
+  assert.equal(s205.files.length, SUMMARY_JSON_LIMIT);
+  assert.equal(s205.truncated, true);
+});
+
+test('照抄命令真能跑，且列出的条数与摘要 total 相同', async () => {
+  const dir = await repo();
+  const base = await workTreeHash(dir);
+  await fs.writeFile(path.join(dir, 'a.ts'), 'changed\n');
+  await fs.mkdir(path.join(dir, '.reviews'), { recursive: true });
+  await fs.writeFile(path.join(dir, '.reviews/x.md'), 'd\n');
+  const s = await summarize(dir, base);
+  const r = await run('/bin/sh', ['-c', fullListCommand(s)], { cwd: dir, timeoutMs: 60_000 });
+  assert.equal(r.code, 0, r.stderr);
+  assert.equal(r.stdout.trim().split('\n').filter(Boolean).length, s.total);
+});
