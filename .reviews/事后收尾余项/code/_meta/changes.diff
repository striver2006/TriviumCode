+  const pids: number[] = [];
+  for (const line of ps.stdout.split('\n')) {
+    const m = /review --worker (\S+)/.exec(line);
+    if (m && ids.has(m[1]!)) {
+      const pid = Number.parseInt(line.trim(), 10);
+      if (pid > 0) {
+        pids.push(pid);
+        killProcessTree(pid, 'SIGKILL');
+      }
+    }
+  }
+  return pids;
+}
