+      startCode: s.r.code, startMsg: tail(s.r, 3),
+      ...snap,
+      runDirFiles: rid ? runDirs[rid] ?? null : null,
+      statusJson,
+      orphanPid: orphan, orphanAlive: orphan ? alive(orphan) : null,
