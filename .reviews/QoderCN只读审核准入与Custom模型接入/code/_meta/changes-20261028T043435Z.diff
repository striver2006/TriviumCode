+  }
+}catch(error){evidence.error={stage,type:error.name,message:['prepare','source'].includes(stage)?'原生准备失败，原文不输出以免含凭据':safe(error.message)};process.exitCode=1;}
+finally{
+  runtime?.observeTempDirs(null);
+  const checked=await compareSnapshots(snapshots,f=>fs.readFile(path.join(root,f)),hash);
+  evidence.sources_unchanged=checked.unchanged;evidence.source_checks=checked.files;
+  if(checked.unchanged!==true)process.exitCode=1;
+  const rootsCheck=await checkAbsence(created,p=>fs.stat(p));
