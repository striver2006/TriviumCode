index 00000000..d2ed689b
--- /dev/null
+++ b/src/trivium/adapters/qoder-cn-trace.ts
@@ -0,0 +1,94 @@
+/** Qoder 1.1.80 stream-json实测事件；调用、结果和权限决策分别配对。 */
+import path from 'node:path';
+
+type ObjectValue=Record<string,unknown>;
+const object=(v:unknown):ObjectValue|null=>v!==null&&typeof v==='object'&&!Array.isArray(v)?v as ObjectValue:null;
+const text=(v:unknown):string|null=>typeof v==='string'&&v.length?v:null;
+export const QODER_READING_TOOLS=['Read','Grep','Glob'] as const;
+export const QODER_EXECUTION_TOOLS=['Write','Edit','Bash','Agent','Task','WebFetch','WebSearch','mcp__*'] as const;
+export interface QoderToolCall {id:string;name:string;input:ObjectValue;result:{is_error:boolean;content:unknown}|null;channel:string|null;}
+export interface QoderTrace {
+  init:{cwd:string|null;tools:string[];model:string|null;permission_mode:string|null}|null;
+  calls:QoderToolCall[];
+  decisions:{id:string;reason:string|null;kind:string|null}[];
+  errors:string[];
+  completed:boolean;
+  terminal_count:number;
+  raw_result:unknown;
+  session_id:string|null;
+}
+
+export function parseQoderTrace(stdout:string):QoderTrace {
+  const trace:QoderTrace={init:null,calls:[],decisions:[],errors:[],completed:false,terminal_count:0,raw_result:null,session_id:null};
+  const ids=new Map<string,QoderToolCall>();
+  for(const line of stdout.split(/\r?\n/).filter(x=>x.trim())){
+    let e:ObjectValue|null;try{e=object(JSON.parse(line));}catch{trace.errors.push('原生事件不是完整JSON');continue;}
+    if(!e){trace.errors.push('原生事件形状未知');continue;}
+    trace.session_id=text(e['session_id'])??trace.session_id;
+    if(e['type']==='system'){
+      if(e['subtype']==='init'){
+        if(trace.init)trace.errors.push('重复init');
+        trace.init={cwd:text(e['cwd']),tools:Array.isArray(e['tools'])?e['tools'].filter((x):x is string=>typeof x==='string'):[],model:text(e['model']),permission_mode:text(e['permissionMode'])};
+      }
+      if(e['subtype']==='permission_denied'){
+        const id=text(e['tool_use_id']);if(!id)trace.errors.push('权限事件缺调用ID');else trace.decisions.push({id,reason:text(e['decision_reason_type']),kind:text(e['tool_denial_kind'])});
+      }
+    }else if(e['type']==='assistant'||e['type']==='user'){
+      const blocks=object(e['message'])?.['content'];if(!Array.isArray(blocks))continue;
+      for(const block of blocks){
+        const b=object(block);if(!b)continue;
+        if(b['type']==='tool_use'){
+          const id=text(b['id']),name=text(b['name']),input=object(b['input']);
+          if(!id||!name||!input){trace.errors.push('工具调用缺ID/名称/参数');continue;}
+          if(ids.has(id)){trace.errors.push('重复工具调用ID');continue;}
+          if(trace.terminal_count)trace.errors.push('终态之后仍有工具调用');
+          const call:QoderToolCall={id,name,input,result:null,channel:null};ids.set(id,call);trace.calls.push(call);
+        }
+        if(b['type']==='tool_result'){
+          if(trace.terminal_count)trace.errors.push('终态之后仍有工具结果');
+          const id=text(b['tool_use_id']),call=id?ids.get(id):null;
+          if(!call||call.result){trace.errors.push('工具结果悬空、先于调用或重复');continue;}
+          if(b['is_error']!==undefined&&typeof b['is_error']!=='boolean')trace.errors.push('工具错误状态无效');
+          call.result={is_error:b['is_error']===true,content:b['content']};
+        }
+      }
+    }else if(e['type']==='result'){
+      trace.terminal_count++;trace.raw_result=e;trace.completed=e['subtype']==='success'&&e['is_error']!==true;
+    }else if(e['type']!=='stream_event')trace.errors.push('未知事件类型');
+  }
+  if(!trace.init)trace.errors.push('缺init');
+  if(trace.terminal_count!==1)trace.errors.push('缺少唯一终态');
+  for(const call of trace.calls){
+    if(!call.result){trace.errors.push(`工具调用缺结果：${call.id}`);continue;}
+    if(!call.result.is_error)continue;
+    const decisions=trace.decisions.filter(d=>d.id===call.id),reasons=new Set(decisions.map(d=>d.reason));
+    if(decisions.length===1&&reasons.has('rule'))call.channel='permission-rule';
+    else if(decisions.length===1&&reasons.has('mode'))call.channel='permission-mode';
+    else if(decisions.length)call.channel='unknown';
+    else if(typeof call.result.content==='string'&&/^Error: Tool "[^"]+" (?:not found|is not available)\.?$/.test(call.result.content))call.channel='tool-unavailable';
+    else call.channel='unknown';
+  }
+  for(const d of trace.decisions)if(!ids.get(d.id)?.result?.is_error)trace.errors.push('权限事件没有对应失败结果');
+  return trace;
+}
+
+const target=(input:ObjectValue):string|null=>text(input['file_path'])??text(input['path']);
+export function qoderTraceEvidence(trace:QoderTrace,fallbackRoot:string){
+  const root=trace.init?.cwd??fallbackRoot;
+  const absolute=(p:string)=>path.isAbsolute(p)?path.normalize(p):path.resolve(root,p);
+  const reads=trace.calls.filter(c=>c.name==='Read'&&c.result&&!c.result.is_error).flatMap(c=>{const p=target(c.input);return p?[absolute(p)]:[];});
+  const searchHits:string[]=[];
+  for(const c of trace.calls.filter(c=>c.name==='Grep'&&c.result&&!c.result.is_error&&c.input['output_mode']==='content')){
+    if(typeof c.result!.content!=='string')continue;
+    for(const line of c.result!.content.split(/\r?\n/)){
+      const hit=/^([^:\n]+\.[A-Za-z0-9_-]+):\d+:/.exec(line);if(hit?.[1])searchHits.push(absolute(hit[1]));
+    }
+  }
+  const pathCalls=trace.calls.filter(c=>['Read','Grep','Glob'].includes(c.name));
+  return {tool_calls:{read:trace.calls.filter(c=>c.name==='Read').length,grep:trace.calls.filter(c=>c.name==='Grep').length,glob:trace.calls.filter(c=>c.name==='Glob').length,
+    run_command:trace.calls.filter(c=>c.name==='Bash').length},read_paths:[...new Set(reads)],search_hit_paths:[...new Set(searchHits)],
+    path_bearing_reads:pathCalls.length,path_bearing_reads_with_path:pathCalls.filter(c=>target(c.input)!==null).length,
+    // 与既有适配器同口径：白名单外尝试无论成功或拒绝均是生产只读失守信号。
+    write_events:trace.calls.filter(c=>!['Read','Grep','Glob'].includes(c.name)).map(c=>`${c.name}(${target(c.input)??c.id})`),
+    command_texts:trace.calls.filter(c=>c.name==='Bash').flatMap(c=>typeof c.input['command']==='string'?[c.input['command']]:[])};
+}
diff --git a/src/trivium/admission.ts b/src/trivium/admission.ts
new file mode 100644
index 00000000..bf565f98
--- /dev/null
+++ b/src/trivium/admission.ts
@@ -0,0 +1,84 @@
+/** 项目级组合准入。宿主可改全部文件，本模块不声称抗宿主篡改。 */
+import { readFileSync, realpathSync, lstatSync, promises as fs } from 'node:fs';
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import type { AdmissionRecord, AdmissionReference, AdmissionEvidenceRef, CriticRequest } from './types.js';
+import { agentById } from './agents/registry.js';
+import { validateAdmission } from './schemas.js';
+import { withGlobalLock } from './lock.js';
+import { writeAtomic } from './util/fsx.js';
+
+function canonical(value:unknown):unknown {
+  if(Array.isArray(value))return value.map(canonical);
+  if(value&&typeof value==='object')return Object.fromEntries(Object.entries(value).sort(([a],[b])=>a.localeCompare(b)).map(([k,v])=>[k,canonical(v)]));
+  return value;
+}
+export const admissionHash=(value:unknown)=>createHash('sha256').update(JSON.stringify(canonical(value))).digest('hex');
+const bytesHash=(value:Buffer)=>createHash('sha256').update(value).digest('hex');
+export type AdmissionRequest=Pick<CriticRequest,'critic'|'project_root'|'model'|'native_model'>;
+export function admissionRouteBinding(req:AdmissionRequest):string {
+  const f=req.native_model?.facts;
+  return admissionHash({agent:req.critic,model:req.model,platform:process.platform,arch:process.arch,
+    native:f?{entrypoint:f.entrypoint,cli_sha256:f.cli_sha256,cli_version:f.cli_version,platform:f.platform,route_kind:f.route_kind??'official',route_descriptor:f.route_descriptor??null,
+      configuration_sha256:f.configuration_sha256,invocation_args:f.invocation_args}:null});
+}
+export type LoadedAdmissionEvidence={ref:AdmissionEvidenceRef;data:unknown};
+export type AdmissionVerifier=(check:string,evidence:readonly LoadedAdmissionEvidence[],record:AdmissionRecord)=>string[];
+
+function readLedger(root:string):{schema:'trivium.admission.v1';records:AdmissionRecord[]} {
+  try{
+    const file=path.join(root,'.trivium/admission.local.json');if(realpathSync(file)!==file||!lstatSync(file).isFile()||lstatSync(file).isSymbolicLink())throw new Error();
+    const data=JSON.parse(readFileSync(file,'utf8'));
+    if(validateAdmission(data).length)throw new Error();
+    return data as {schema:'trivium.admission.v1';records:AdmissionRecord[]};
+  }catch{throw new Error('本项目准入台账缺失或无效，拒绝；请完成真实验收');}
+}
+
+/** 只校验冻结记录，不回落其它记录；厂商验证器必须复核原生证据含义。 */
+export function requireAdmission(req:AdmissionRequest,ttlDays:number,verify:AdmissionVerifier,frozen?:AdmissionReference,now=Date.now()):{reference:AdmissionReference;record:AdmissionRecord} {
+  const root=realpathSync(req.project_root),ledger=readLedger(root),binding=admissionRouteBinding(req);
+  const candidates=ledger.records.filter(r=>r.agent===req.critic&&r.project_root===root&&r.binding_sha256===binding);
+  if(candidates.length!==1)throw new Error('当前平台/模型/隔离配方无唯一合格准入');
+  const record=candidates[0]!,reference={record_id:record.record_id,record_sha256:admissionHash(record)};
+  if(frozen&&(frozen.record_id!==reference.record_id||frozen.record_sha256!==reference.record_sha256))throw new Error('准入记录自冻结后已变化，拒绝重选');
+  verifyAdmissionRecord(req,record,ttlDays,verify,now);
+  return {reference,record};
+}
+
+/** 生成前与消费时使用同一验证器；不必先把候选记录写成可用台账。 */
+export function verifyAdmissionRecord(req:AdmissionRequest,record:AdmissionRecord,ttlDays:number,verify:AdmissionVerifier,now=Date.now()):void {
+  const root=realpathSync(req.project_root);
+  if(validateAdmission({schema:'trivium.admission.v1',records:[record]}).length||record.agent!==req.critic||record.project_root!==root||record.binding_sha256!==admissionRouteBinding(req))throw new Error('准入候选形状/身份/项目/路线不符');
+  const tested=Date.parse(record.tested_at),expires=Date.parse(record.expires_at);
+  if(!Number.isFinite(tested)||!Number.isFinite(expires)||tested>now||expires<=now||expires<=tested||expires>tested+ttlDays*86400000)throw new Error('准入证据过期、时间无效或超出TTL，请重验');
+  const required=agentById(req.critic)?.admissionChecks;
+  if(!required?.length)throw new Error('注册表未定义该侧的准入必需项');
+  for(const check of required){
+    const item=record.checks[check];
+    if(item?.state!=='pass'||!item.evidence.length)throw new Error(`准入必需项未通过：${check}`);
+    const evidence=item.evidence.map(ref=>{
+      try{
+        if(path.isAbsolute(ref.path)||ref.path.split(/[\\/]/).some(p=>p==='..'||p===''))throw new Error();
+        const file=path.resolve(root,ref.path);
+        if(realpathSync(file)!==file||!file.startsWith(root+path.sep)||!lstatSync(file).isFile())throw new Error();
+        const bytes=readFileSync(file);if(bytesHash(bytes)!==ref.sha256)throw new Error();
+        return {ref,data:JSON.parse(bytes.toString()) as unknown};
+      }catch{throw new Error(`准入证据缺失、路径不安全、损坏或hash变化：${check}`);}
+    });
+    const failures=verify(check,evidence,record);if(failures.length)throw new Error(`准入原生证据不满足${check}：${failures.join('；')}`);
+  }
+}
+
+/** 同组合覆盖，持项目全局锁原子替换；生成器仍须先验证全部真实证据。 */
+export async function storeAdmission(projectRoot:string,record:AdmissionRecord):Promise<void>{
+  const root=await fs.realpath(projectRoot),dir=path.join(root,'.trivium');
+  if(record.project_root!==root)throw new Error('准入项目绑定不一致');
+  await withGlobalLock({triviumDir:dir,heartbeatStaleMs:120000},async()=>{
+    let ledger:{schema:'trivium.admission.v1';records:AdmissionRecord[]}={schema:'trivium.admission.v1',records:[]};
+    try {await fs.lstat(path.join(dir,'admission.local.json'));ledger=readLedger(root);}catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}
+    const records=ledger.records.filter(r=>!(r.agent===record.agent&&r.binding_sha256===record.binding_sha256&&r.project_root===root));
+    const next={schema:'trivium.admission.v1' as const,records:[...records,record]};
+    if(validateAdmission(next).length)throw new Error('准入台账形状/身份不合法');
+    const file=path.join(dir,'admission.local.json');await writeAtomic(file,JSON.stringify(next,null,2)+'\n');await fs.chmod(file,0o600);
+  });
+}
diff --git a/src/trivium/util/credential-lease.ts b/src/trivium/util/credential-lease.ts
new file mode 100644
index 00000000..77cb4e97
--- /dev/null
+++ b/src/trivium/util/credential-lease.ts
@@ -0,0 +1,91 @@
+/** 私有凭据根的独占租约；信号/强杀不依赖被杀进程finally回收。 */
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { promises as fs, writeFileSync, renameSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+import { isAgentId, type AgentId } from '../agents/registry.js';
+import { processStartTime, processMatchesRecord, processGroupMemberCount, trackedTrees } from './exec.js';
+
+interface Lease {
+  schema:'trivium.credential-lease.v1';id:string;agent:AgentId;directory:string;parent:string;
+  owner_pid:number;owner_start:string;side_dir:string|null;groups:{pgid:number;started_at:string|null}[];
+}
+interface ActiveLease {file:string;record:Lease;}
+const scope=new AsyncLocalStorage<{sideDir:string|null;root?:string}>();
+const active=new Map<string,ActiveLease>();
+const leaseRoot=()=>scope.getStore()?.root??path.join(os.homedir(),'.trivium/credential-leases');
+const marker='.trivium-credential-lease';
+function persist(lease:ActiveLease):void {
+  const tmp=lease.file+'.tmp-'+randomBytes(6).toString('hex');
+  writeFileSync(tmp,JSON.stringify(lease.record),{mode:0o600,flag:'wx'});renameSync(tmp,lease.file);
+}
+
+export function withCredentialLeaseScope<T>(sideDir:string|null,fn:()=>Promise<T>,root?:string):Promise<T>{return scope.run({sideDir,root},fn);}
+
+export async function registerCredentialLease(home:string,agent:AgentId):Promise<ActiveLease>{
+  const directory=await fs.realpath(home),parent=await fs.realpath(os.tmpdir()),owner=await processStartTime(process.pid,{canonical:true});
+  if(path.dirname(directory)!==parent||!owner)throw new Error('私有凭据根/进程身份不可核实，拒绝复制');
+  const root=leaseRoot();await fs.mkdir(root,{recursive:true,mode:0o700});
+  const id=randomBytes(16).toString('hex'),file=path.join(root,id+'.json');
+  const record:Lease={schema:'trivium.credential-lease.v1',id,agent,directory,parent,owner_pid:process.pid,owner_start:owner,side_dir:scope.getStore()?.sideDir??null,groups:[]};
+  await fs.writeFile(path.join(directory,marker),JSON.stringify({id,owner_pid:record.owner_pid,owner_start:owner}),{flag:'wx',mode:0o600});
+  await fs.writeFile(file,JSON.stringify(record),{flag:'wx',mode:0o600});
+  const lease={file,record};active.set(directory,lease);return lease;
+}
+
+/** 新组PID在同一JS轮次同步记入已有租约；lstart取到后原子替换。秘密永不进入台账。 */
+export async function trackCredentialRun<T>(home:string,run:()=>Promise<T>):Promise<T>{
+  let canonical:string;try{canonical=await fs.realpath(home);}catch{return run();}
+  const lease=active.get(canonical);if(!lease)return run();
+  const before=new Set(trackedTrees().map(t=>t.pgid)),pending=run();
+  const groups=trackedTrees().filter(t=>!before.has(t.pgid));
+  try {
+    for(const g of groups)lease.record.groups.push({pgid:g.pgid,started_at:g.startedAt});
+    persist(lease);
+    for(const g of lease.record.groups)if(g.started_at===null)g.started_at=await processStartTime(g.pgid,{canonical:true});
+    persist(lease);
+  }catch{
+    // 派生已发生，必须等待原有超时/终止链，不制造无人监督的Promise。
+    await pending;throw new Error('凭据派生租约记录失败，不能确认安全回收');
+  }
+  return pending;
+}
+
+export async function releaseCredentialLease(lease:ActiveLease):Promise<void>{
+  try {await fs.lstat(lease.record.directory);throw new Error('私有凭据目录仍存在');}
+  catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}
+  await fs.rm(lease.file,{force:true});active.delete(lease.record.directory);
+}
+
+/** 复用现有scrub四处挂载。此函数不杀进程，未核实全部退出就保留租约并报错。 */
+export async function reapCredentialLeases(agent:AgentId,sideDir:string|null,cleanup:(home:string)=>Promise<void>,root=leaseRoot()):Promise<{deleted:string[];errors:string[]}> {
+  const result:{deleted:string[];errors:string[]}={deleted:[],errors:[]};
+  let names:string[];try{names=await fs.readdir(root);}catch(e){if((e as NodeJS.ErrnoException).code==='ENOENT')return result;throw e;}
+  for(const name of names.filter(n=>/^[a-f0-9]{32}\.json$/.test(n))){
+    const file=path.join(root,name);let l:Lease;
+    try {
+      const st=await fs.lstat(file);if(!st.isFile()||st.isSymbolicLink())throw new Error();l=JSON.parse(await fs.readFile(file,'utf8')) as Lease;
+      if(l.schema!=='trivium.credential-lease.v1'||!isAgentId(l.agent)||l.id+'.json'!==name||!Number.isInteger(l.owner_pid)||typeof l.owner_start!=='string'||!Array.isArray(l.groups))throw new Error();
+    }catch{result.errors.push('凭据租约损坏或身份不可核实');continue;}
+    if(l.agent!==agent||l.side_dir!==sideDir)continue;
+    try {
+      const owner=await processMatchesRecord(l.owner_pid,{canonical:l.owner_start,legacy:null});
+      if(owner.identity==='unverifiable'||(owner.sameProcess&&l.owner_pid!==process.pid))throw new Error('凭据所有者仍在或身份无法核实');
+      for(const group of l.groups){
+        if(!Number.isInteger(group.pgid)||group.pgid<=0)throw new Error('凭据进程组记录无效');
+        const count=await processGroupMemberCount(group.pgid);if(count===null||count>0)throw new Error('凭据进程组尚未确认全部退出');
+      }
+      const parent=await fs.realpath(os.tmpdir());if(l.parent!==parent||path.dirname(l.directory)!==parent)throw new Error('凭据目录边界不符');
+      try{
+        const st=await fs.lstat(l.directory);if(!st.isDirectory()||st.isSymbolicLink()||await fs.realpath(l.directory)!==l.directory)throw new Error('凭据根不是原私有目录');
+        const m=JSON.parse(await fs.readFile(path.join(l.directory,marker),'utf8')) as {id?:unknown;owner_pid?:unknown;owner_start?:unknown};
+        if(m.id!==l.id||m.owner_pid!==l.owner_pid||m.owner_start!==l.owner_start)throw new Error('凭据目录私有标记不符');
+        await cleanup(l.directory);
+      }catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}
+      try{await fs.lstat(l.directory);throw new Error('凭据根清理未完成');}catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}
+      await fs.rm(file);result.deleted.push(l.id);active.delete(l.directory);
+    }catch(e){result.errors.push((e as Error).message);}
+  }
+  return result;
+}
diff --git a/test/integration/credential-lease.test.ts b/test/integration/credential-lease.test.ts
new file mode 100644
index 00000000..00f4ab7e
--- /dev/null
+++ b/test/integration/credential-lease.test.ts
@@ -0,0 +1,38 @@
+/** 真实Node进程验证通用回收协议；不冒充厂商CLI的生命周期准入。 */
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {promises as fs} from 'node:fs';
+import path from 'node:path';
+import {spawn} from 'node:child_process';
+import {build} from 'esbuild';
+import {reapCredentialLeases} from '../../src/trivium/util/credential-lease.js';
+import {processGroupMemberCount} from '../../src/trivium/util/exec.js';
+import {AGENTS} from '../../src/trivium/agents/registry.js';
+import {REPO_ROOT} from '../helpers/fixture.js';
+import {scratchDir} from '../helpers/scratch.js';
+const agent=AGENTS.find(a=>a.admissionChecks?.length)!.id;
+const skip=process.platform==='win32';
+
+test('两进程强杀后租约仍在，活CLI组阻止删除，退出后按私有标记回收',{skip,timeout:30000},async()=>{
+  const root=await fs.realpath(await scratchDir('trivium-lease-test-')),leases=path.join(root,'leases'),home=await fs.realpath(await scratchDir('trivium-lease-home-'));
+  const bundle=path.join(root,'actor.cjs');let pgid:number|undefined;
+  const contents=`import {withCredentialLeaseScope,registerCredentialLease,trackCredentialRun} from './src/trivium/util/credential-lease.ts';import {run,trackedTrees} from './src/trivium/util/exec.ts';import {promises as fs} from 'node:fs';
+    withCredentialLeaseScope('fixture-side',async()=>{await registerCredentialLease(${JSON.stringify(home)},${JSON.stringify(agent)});await fs.writeFile(${JSON.stringify(path.join(home,'fake-auth'))},'FIXTURE_ONLY',{mode:384});const p=trackCredentialRun(${JSON.stringify(home)},()=>run(process.execPath,['-e','setInterval(()=>{},1000)'],{killTree:true,timeoutMs:60000}));setTimeout(()=>console.log(JSON.stringify({pgid:trackedTrees()[0]?.pgid})),200);await p;},${JSON.stringify(leases)});`;
+  await build({stdin:{contents,resolveDir:REPO_ROOT},bundle:true,platform:'node',format:'cjs',outfile:bundle,logLevel:'silent'});
+  const actor=spawn(process.execPath,[bundle],{stdio:['ignore','pipe','pipe'],windowsHide:true});let stderr='';actor.stderr.on('data',d=>{stderr+=String(d);});
+  try{
+    const ready=await new Promise<{pgid:number}>((resolve,reject)=>{let out='';const timer=setTimeout(()=>reject(Error('actor readiness timeout '+stderr)),5000);actor.stdout.on('data',d=>{out+=String(d);if(out.includes('\n')){clearTimeout(timer);try{resolve(JSON.parse(out.trim()));}catch(e){reject(e);}}});actor.on('error',reject);});
+    pgid=ready.pgid;assert.ok(pgid>0);
+    const dead=new Promise<void>(resolve=>actor.once('exit',()=>resolve()));actor.kill('SIGKILL');await dead;
+    const manifests=await fs.readdir(leases);assert.equal(manifests.length,1);
+    const manifest=JSON.parse(await fs.readFile(path.join(leases,manifests[0]!),'utf8'));assert.equal(manifest.groups[0].pgid,pgid);assert.ok(manifest.groups[0].started_at);assert.doesNotMatch(JSON.stringify(manifest),/FIXTURE_ONLY/);
+    const cleanup=(p:string)=>fs.rm(p,{recursive:true,force:true});
+    const blocked=await reapCredentialLeases(agent,'fixture-side',cleanup,leases);assert.equal(blocked.deleted.length,0);assert.match(blocked.errors.join(),/尚未确认全部退出/);assert.equal(await fs.readFile(path.join(home,'fake-auth'),'utf8'),'FIXTURE_ONLY');
+    process.kill(-pgid,'SIGTERM');for(let i=0;i<100&&await processGroupMemberCount(pgid)!==0;i++)await new Promise(r=>setTimeout(r,20));
+    assert.equal(await processGroupMemberCount(pgid),0);
+    // 标记不符时不能删，即使所有进程已退出。
+    const marker=path.join(home,'.trivium-credential-lease'),original=await fs.readFile(marker);await fs.writeFile(marker,'{}');
+    assert.match((await reapCredentialLeases(agent,'fixture-side',cleanup,leases)).errors.join(),/标记不符/);await fs.writeFile(marker,original);
+    const reaped=await reapCredentialLeases(agent,'fixture-side',cleanup,leases);assert.deepEqual(reaped.errors,[]);assert.equal(reaped.deleted.length,1);assert.equal((await fs.readdir(leases)).length,0);await assert.rejects(fs.lstat(home),{code:'ENOENT'});
+  }finally{actor.kill('SIGKILL');if(pgid)try{process.kill(-pgid,'SIGKILL');}catch{}await fs.rm(home,{recursive:true,force:true});await fs.rm(root,{recursive:true,force:true});}
+});
diff --git a/test/unit/admission.test.ts b/test/unit/admission.test.ts
new file mode 100644
index 00000000..05efaa9b
--- /dev/null
+++ b/test/unit/admission.test.ts
@@ -0,0 +1,40 @@
+/** 台账引擎契约使用合成证据验证器；这些测试不构成任何native准入。 */
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {promises as fs} from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {AGENTS} from '../../src/trivium/agents/registry.js';
+import {admissionHash,admissionRouteBinding,requireAdmission,storeAdmission,type AdmissionRequest} from '../../src/trivium/admission.js';
+import {validateAdmission} from '../../src/trivium/schemas.js';
+import {scratchDir} from '../helpers/scratch.js';
+import type {AdmissionRecord} from '../../src/trivium/types.js';
+const agent=AGENTS.find(a=>a.admissionChecks?.length)!;
+
+test('准入台账纯形状+身份追加校验，拒绝未知身份',()=>{
+  assert.ok(validateAdmission({schema:'wrong',records:[{agent:'unregistered-fixture'}]}).length>=2);
+});
+test('项目级台账冻结/hash/TTL/必需项/证据边界均拒绝失配，完整契约可读回',async()=>{
+  const root=await fs.realpath(await scratchDir('trivium-admission-'));
+  try{
+    await fs.mkdir(path.join(root,'.trivium'));
+    const raw=JSON.stringify({synthetic_engine_fixture:true}),file=path.join(root,'proof.json');await fs.writeFile(file,raw);
+    const sha256=createHash('sha256').update(raw).digest('hex');
+    const req:AdmissionRequest={critic:agent.id,project_root:root,model:'fixture-model'};
+    const record:AdmissionRecord={record_id:'fixture-first',agent:agent.id,project_root:root,binding_sha256:admissionRouteBinding(req),tested_at:new Date(Date.now()-1000).toISOString(),expires_at:new Date(Date.now()+60000).toISOString(),
+      checks:Object.fromEntries(agent.admissionChecks!.map(check=>[check,{state:'pass' as const,evidence:[{path:'proof.json',sha256,case_id:check}]}]))};
+    const verify=(_check:string,items:readonly {data:unknown}[])=>items.every(x=>(x.data as {synthetic_engine_fixture?:unknown}).synthetic_engine_fixture===true)?[]:['synthetic fixture mismatch'];
+    assert.throws(()=>requireAdmission(req,1,verify),/缺失/);
+    await storeAdmission(root,record);const frozen=requireAdmission(req,1,verify).reference;
+    assert.equal(frozen.record_sha256,admissionHash(record));
+    assert.throws(()=>requireAdmission({...req,model:'other'},1,verify),/无唯一/);
+    await storeAdmission(root,{...record,record_id:'fixture-replaced'});
+    assert.throws(()=>requireAdmission(req,1,verify,frozen),/变化/);
+    await storeAdmission(root,{...record,expires_at:new Date(Date.now()-1).toISOString()});assert.throws(()=>requireAdmission(req,1,verify),/过期/);
+    const missing=structuredClone(record);delete missing.checks[agent.admissionChecks![0]!];await storeAdmission(root,missing);assert.throws(()=>requireAdmission(req,1,verify),/必需项/);
+    await storeAdmission(root,record);await fs.writeFile(file,'changed');assert.throws(()=>requireAdmission(req,1,verify),/hash变化/);
+    await fs.writeFile(file,raw);
+    const escape=structuredClone(record);escape.checks[agent.admissionChecks![0]!]!.evidence[0]!.path='../proof.json';await storeAdmission(root,escape);assert.throws(()=>requireAdmission(req,1,verify),/路径不安全/);
+    await storeAdmission(root,record);await fs.rm(file);await fs.symlink(path.join(root,'.trivium/admission.local.json'),file);assert.throws(()=>requireAdmission(req,1,verify),/路径不安全/);
+  }finally{await fs.rm(root,{recursive:true,force:true});}
+});
diff --git a/test/unit/qoder-cn-custom.test.ts b/test/unit/qoder-cn-custom.test.ts
new file mode 100644
index 00000000..2c1ad80c
--- /dev/null
+++ b/test/unit/qoder-cn-custom.test.ts
@@ -0,0 +1,57 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {defaultConfig} from '../../src/trivium/config.js';
+import {QoderModelMonitor,qoderHash,qoderModelRequest,normalizeQoderSelection,validateQoderFacts} from '../../src/trivium/adapters/qoder-cn-model.js';
+import {QoderSecretGuard,extractQoderCodec} from '../../src/trivium/adapters/qoder-cn-custom.js';
+import {qoderCnAdapter} from '../../src/trivium/adapters/qoder-cn.js';
+import {resolveConfiguredTier} from '../../src/trivium/model-routing.js';
+import {checkModelSlugs} from '../../src/trivium/preflight.js';
+import type {NativeModelFacts,NativeRouteDescriptor} from '../../src/trivium/types.js';
+
+const hash='a'.repeat(64);
+const descriptor:NativeRouteDescriptor={selector:'custom:provider/Exact',native_key:'provider/Exact',display_name:'Custom display',provider_id:'provider',model_id:'Exact',source_ref:'/fixture/.models/id/customs',declaration_sha256:hash,credential_source_sha256:hash,authentication_sha256:hash,recipe_sha256:hash,codec:{source_sha256:hash,wasm_sha256:hash,recipe:'fixture'}};
+const custom:NativeModelFacts={binding_version:2,route_kind:'custom',route_descriptor:descriptor,model:descriptor.selector,source:'native-config',observed_user_model:null,models:[descriptor.selector],route_labels:['Auto','Fast'],catalog_sha256:qoderHash(JSON.stringify({models:[descriptor.selector],routeLabels:['Auto','Fast']})),catalog_raw_sha256:hash,configuration_sha256:hash,entrypoint:'/fixture/bin',cli_sha256:hash,cli_version:'fixture/0.0.0',platform:process.platform,prepared_at:new Date().toISOString(),default_verified:true,invocation_args:['--tools','']};
+const official:NativeModelFacts={...custom,binding_version:undefined,route_kind:undefined,route_descriptor:undefined,model:'Exact',source:'catalog-default',models:['Exact'],catalog_sha256:qoderHash(JSON.stringify({models:['Exact'],routeLabels:['Auto','Fast']}))};
+
+test('官方/Custom同名通过完整选择消歧，未知Custom不能借通用短名目录放行',()=>{
+  const cfg=defaultConfig();cfg.probe.cli['qoderclicn']={...cfg.probe.cli['qoderclicn']!,native_default:official,native_routes:[custom]};
+  assert.equal(normalizeQoderSelection('official:exact',[official,custom]),'Exact');
+  assert.equal(normalizeQoderSelection('provider/Exact',[official,custom]),descriptor.selector);
+  assert.equal(qoderCnAdapter.nativeModelFor!(cfg,'custom:provider/Exact','cli').requested,descriptor.selector);
+  assert.equal(checkModelSlugs(cfg,'plan',{'qoder-cn':'custom:unknown/Exact'},['qoder-cn']).ok,false);
+  assert.equal(checkModelSlugs(cfg,'plan',{'qoder-cn':'custom:provider/Exact'},['qoder-cn']).ok,true);
+  assert.equal(checkModelSlugs(cfg,'plan',{'qoder-cn':'official:Exact'},['qoder-cn']).ok,true);
+  assert.throws(()=>normalizeQoderSelection('custom:../Exact',[custom]));
+  assert.throws(()=>normalizeQoderSelection(descriptor.selector,[custom,structuredClone(custom)]));
+  const request=qoderModelRequest(custom,'provider/Exact','cli');assert.equal(request.override,'provider/Exact');assert.equal(request.facts.route_descriptor!.provider_id,'provider');
+  assert.throws(()=>validateQoderFacts({...custom,route_descriptor:{...descriptor,provider_id:'other'}}));
+});
+
+test('Custom必要回读只作路线一致性，不把显示名/计费key提升为底层身份',()=>{
+  const monitor=new QoderModelMonitor(descriptor.selector,['Auto','Fast'],[],descriptor);
+  monitor.line(JSON.stringify({type:'system',subtype:'init',model:descriptor.display_name}));
+  monitor.line(JSON.stringify({type:'assistant',message:{model:descriptor.display_name,content:[{text:'I am another model'}]}}));
+  monitor.line(JSON.stringify({type:'result',subtype:'success',is_error:false,result:'OK',modelUsage:{[descriptor.native_key]:{}}}));
+  assert.deepEqual(monitor.finish(),{label:descriptor.display_name,effective:null,source:'unverified'});
+  for(const missing of ['init','usage']){
+    const m=new QoderModelMonitor(descriptor.selector,['Auto','Fast'],[],descriptor);
+    m.line(JSON.stringify({type:missing==='init'?'assistant':'system',subtype:'init',model:descriptor.display_name,message:{model:descriptor.display_name}}));
+    m.line(JSON.stringify({type:'result',subtype:'success',is_error:false,modelUsage:missing==='usage'?{}:{[descriptor.native_key]:{}}}));
+    assert.throws(()=>m.finish(),/必要/);
+  }
+  monitor.line(JSON.stringify({type:'system',subtype:'init',model:'Auto'}));assert.throws(()=>monitor.finish(),/变化|回退/);
+});
+
+test('codec未知布局拒绝；生产秘密护栏覆盖JSON转义和非正文落盘出口',()=>{
+  assert.throws(()=>extractQoderCodec(Buffer.from('unknown')),/布局/);
+  const guard=new QoderSecretGuard();guard.addCredential('{"region":"cn","access_token":"test_key_fixture_token"}');
+  guard.add('test_key_"escaped\nvalue');
+  const safe=guard.scrub(JSON.stringify({labels:['test_key_fixture_token'],fail_reason:'test_key_"escaped\nvalue',raw_response_text:'cn'}));
+  assert.equal(safe.includes('test_key_'),false);assert.equal(guard.leaked,true);assert.equal(JSON.parse(safe).raw_response_text,'cn');
+});
+
+
+test('三档显式Custom配置与单次官方覆盖独立，未配置不继承全局Custom默认',()=>{
+  const cfg=defaultConfig();cfg.probe.cli['qoderclicn']={...cfg.probe.cli['qoderclicn']!,native_default:official,native_routes:[custom]};
+  for(const name of ['default','flash','pro']){cfg.active_profile=name;cfg.profiles[name]??={};cfg.profiles[name]!['qoder-cn']={code:descriptor.selector};const routed=resolveConfiguredTier(cfg,'qoder-cn','code');assert.equal(routed.model,descriptor.selector);assert.equal(qoderCnAdapter.nativeModelFor!(cfg,routed.model!,'cell').requested,descriptor.selector);assert.equal(resolveConfiguredTier(cfg,'qoder-cn','code',{model:'official:Exact'}).model,'official:Exact');delete cfg.profiles[name]!['qoder-cn'];assert.equal(resolveConfiguredTier(cfg,'qoder-cn','code').model,'Exact');}
+});
diff --git a/test/unit/qoder-cn-trace.test.ts b/test/unit/qoder-cn-trace.test.ts
new file mode 100644
index 00000000..4c106f52
--- /dev/null
+++ b/test/unit/qoder-cn-trace.test.ts
@@ -0,0 +1,35 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {promises as fs} from 'node:fs';
+import path from 'node:path';
+import {REPO_ROOT} from '../helpers/fixture.js';
+import {parseQoderTrace,qoderTraceEvidence} from '../../src/trivium/adapters/qoder-cn-trace.js';
+const init={type:'system',subtype:'init',cwd:'/fixture',model:'Exact',tools:['Read','Grep','Glob']};
+const call=(id:string,name:string,input:object)=>({type:'assistant',message:{content:[{type:'tool_use',id,name,input}]}});
+const result=(id:string,is_error:boolean,content:string)=>({type:'user',message:{content:[{type:'tool_result',tool_use_id:id,is_error,content}]}});
+const terminal={type:'result',subtype:'success',is_error:false,result:'OK'};
+const json=(items:unknown[])=>items.map(x=>JSON.stringify(x)).join('\n');
+test('实际调用结果按ID配对，成功读路径与搜索命中分开，拒绝操作不记成功读取',()=>{
+  const trace=parseQoderTrace(json([init,call('read','Read',{file_path:'a.ts'}),result('read',false,'content'),call('grep','Grep',{path:'.',output_mode:'content'}),result('grep',false,'b.ts:3:text'),call('deny','Read',{file_path:'secret'}),{type:'system',subtype:'permission_denied',tool_use_id:'deny',decision_reason_type:'rule'},result('deny',true,'denied'),terminal]));
+  assert.deepEqual(trace.errors,[]);assert.equal(trace.completed,true);assert.equal(trace.calls[2]!.channel,'permission-rule');
+  const evidence=qoderTraceEvidence(trace,'/unused');assert.deepEqual(evidence.read_paths,['/fixture/a.ts']);assert.deepEqual(evidence.search_hit_paths,['/fixture/b.ts']);assert.equal(evidence.tool_calls.read,2);
+});
+test('规则/mode/工具分发拒绝独立，生产对白名单外尝试仍报告写事件',()=>{
+  const trace=parseQoderTrace(json([init,call('mode','Write',{file_path:'/fixture/a'}),{type:'system',subtype:'permission_denied',tool_use_id:'mode',decision_reason_type:'mode'},result('mode',true,'needs approval'),call('missing','Bash',{command:'echo test'}),result('missing',true,'Error: Tool "Bash" not found.'),terminal]));
+  assert.equal(trace.calls[0]!.channel,'permission-mode');assert.equal(trace.calls[1]!.channel,'tool-unavailable');
+  const evidence=qoderTraceEvidence(trace,'/fixture');assert.equal(evidence.write_events.length,2);assert.deepEqual(evidence.command_texts,['echo test']);
+});
+test('重复/悬空/缺结果/终态后调用或结果/坏JSON均不能构成完整轨迹',()=>{
+  for(const items of [[init,call('a','Read',{}),terminal],[init,result('a',false,'x'),terminal],[init,call('a','Read',{}),call('a','Read',{}),result('a',false,'x'),terminal],[init,terminal,call('a','Read',{}),result('a',false,'x')],[init,call('a','Read',{}),terminal,result('a',false,'x')],[init,terminal,terminal]])assert.ok(parseQoderTrace(json(items)).errors.length);
+  assert.ok(parseQoderTrace('{bad').errors.length);
+});
+test('原生1.1.80原件回放：最小工具三种真实成功调用与独立诊断rule拒绝可解析',async()=>{
+  const dir=path.join(REPO_ROOT,'doc/05_testing/evidence/qoder-cn-admission-20261028');
+  const minimal=JSON.parse(await fs.readFile(path.join(dir,'readonly-2026-10-28T06-20-59-945Z-c0545e.json'),'utf8')).cases.find((c:{arm:string})=>c.arm==='matrix-readonly');
+  const trace=parseQoderTrace(minimal.stdout);assert.deepEqual(trace.errors,[]);assert.equal(trace.completed,true);assert.deepEqual([...trace.init!.tools].sort(),['Glob','Grep','Read']);
+  for(const name of ['Read','Grep','Glob'])assert.ok(trace.calls.some(c=>c.name===name&&c.result&&!c.result.is_error));
+  const scoped=JSON.parse(await fs.readFile(path.join(dir,'readonly-2026-10-28T05-55-07-328Z-55c44a.json'),'utf8')).cases.find((c:{arm:string})=>c.arm==='deny-visible');
+  const denied=parseQoderTrace(scoped.stdout);assert.deepEqual(denied.errors,[]);for(const name of ['Write','Bash'])assert.ok(denied.calls.some(c=>c.name===name&&c.channel==='permission-rule'));
+  // 不把不同配方的历史拒绝推成当前最小面准入。
+  assert.equal(trace.calls.some(c=>c.channel==='permission-rule'),false);
+});
