index 00000000..ceab8f42
--- /dev/null
+++ b/scripts/acceptance/kimi-qoder-cn/qoder-custom.mjs
@@ -0,0 +1,96 @@
+/** 原生 Custom 最小加载取证；不是生产准入，不复制其它模型凭据。 */
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import {pathToFileURL} from 'node:url';
+import {build} from 'esbuild';
+import {collectCredentialValues,secretGuard} from './qoder-secrets.mjs';
+
+const model=process.argv[2];
+if(!model || !/^[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+$/.test(model))throw Error('须提供原生 provider/modelID，不预设通用默认');
+const repo=path.resolve(import.meta.dirname,'../../..');
+const root=path.join(os.homedir(),'.qoder-cn');
+const bin=path.join(os.homedir(),'.local/bin/qoderclicn');
+const hash=x=>crypto.createHash('sha256').update(x).digest('hex');
+const temp=await fs.mkdtemp(path.join(os.tmpdir(),'trivium-cn-custom-'));
+await fs.chmod(temp,0o700);
+const evidence={at:new Date().toISOString(),platform:process.platform,requested:model,admission:false,windows:'未测',cases:[]};
+evidence.script_sha256=hash(await fs.readFile(import.meta.filename));
+evidence.secret_guard_sha256=hash(await fs.readFile(path.join(import.meta.dirname,'qoder-secrets.mjs')));
+evidence.rerun={executable:process.execPath,args:[import.meta.filename,model]};
+const secrets=[];const created=new Set();let runtime,selected,native,machine,account,stage='prepare';
+const guard=secretGuard(secrets,s=>runtime?.redactSecrets(s).content??s);
+const safe=s=>guard.scrub(s);
+const files=['settings.json','.auth/user','.auth/machine_id','.models/default'];
+const snapshots=new Map();
+try{
+  for(const file of files){const bytes=await fs.readFile(path.join(root,file));snapshots.set(file,hash(bytes));if(file.startsWith('.auth/'))collectCredentialValues(bytes.toString(),secrets);}
+  evidence.credential_scan_scope='Custom明文parameters及复制认证字节；native内部解密认证字段未取得';
+  const bytes=await fs.readFile(bin);evidence.cli_sha256=hash(bytes);
+  const executionBin=path.join(temp,'qoder-native');await fs.writeFile(executionBin,bytes,{mode:0o700,flag:'wx'});
+  // 使用当前安装 CLI 自带的原生编解码器；不输出、不归档源码与明文。
+  const marker=bytes.indexOf('n.model_cache_decrypt(',110000000);
+  const start=bytes.lastIndexOf('\0// @bun @bytecode\n',marker),end=bytes.indexOf(0,marker);
+  if(marker<0||start<0||end<0)throw Error('当前CLI原生编解码边界未知');
+  const source=bytes.subarray(start+1,end).toString();
+  let wasm;
+  for(const match of bytes.subarray(110000000).toString().matchAll(/AGFzbQ[A-Za-z0-9+/=]+/g)){
+    const candidate=Buffer.from(match[0],'base64');
+    if(WebAssembly.Module.exports(new WebAssembly.Module(candidate)).some(x=>x.name==='model_cache_decrypt')){if(wasm)throw Error('原生编解码器不唯一');wasm=candidate;}
+  }
+  if(!wasm)throw Error('当前CLI缺少可核实原生编解码器');
+  evidence.codec={source_sha256:hash(source),wasm_sha256:hash(wasm),public_api:false};
+  await fs.writeFile(path.join(temp,'native.mjs'),source,{mode:0o600,flag:'wx'});
+  native=await import(pathToFileURL(path.join(temp,'native.mjs')).href);await native.default({module_or_path:wasm});
+  stage='source';account=JSON.parse(await fs.readFile(path.join(root,'.models/default'),'utf8'));
+  if(typeof account.uid!=='string'||!/^[-a-zA-Z0-9_:]+$/.test(account.uid))throw Error('原生账号目录不可核实');
+  machine=(await fs.readFile(path.join(root,'.auth/machine_id'),'utf8')).trim();
+  const file=path.join('.models',account.uid,'customs');files.push(file);snapshots.set(file,hash(await fs.readFile(path.join(root,file))));
+  const records=JSON.parse(native.model_cache_decrypt(await fs.readFile(path.join(root,file),'utf8'),machine));
+  if(!Array.isArray(records))throw Error('原生Custom记录不是数组');
+  for(const record of records)for(const v of Object.values(record.parameters??{}))if(typeof v==='string'&&v)secrets.push(v);
+  const matches=records.filter(x=>x.key===model);if(matches.length!==1)throw Error('所选Custom不存在或不唯一');
+  const picked=matches[0];
+  if(Object.keys(picked.parameters??{}).some(k=>k!=='api_key')||typeof picked.parameters?.api_key!=='string'||!picked.parameters.api_key)throw Error('当前原生参数形状未核实');
+  selected=Object.fromEntries(['key','display_name','provider','model','type','url','format','is_vl','is_reasoning','max_input_tokens','available_context_windows','default_context_window','efforts','supports_disabled','default_effort'].filter(k=>picked[k]!==undefined).map(k=>[k,picked[k]]));
+  selected.parameters={api_key:picked.parameters.api_key};
+  account=Object.fromEntries(['key','uid','scene','updatedAt'].filter(k=>account[k]!==undefined).map(k=>[k,account[k]]));
+  evidence.declaration={key:selected.key,provider:selected.provider,model:selected.model,display_name:selected.display_name,format:selected.format,parameter_keys:Object.keys(selected.parameters??{}),source:'native-encrypted-customs',total_source_records:records.length,selected_records:1};
+  await build({stdin:{contents:`export {withQoderHome} from './src/trivium/adapters/qoder-cn-native.ts';export {run} from './src/trivium/util/exec.ts';export {redactSecrets} from './src/trivium/secrets.ts';export {observeTempDirs} from './src/trivium/util/fsx.ts';`,resolveDir:repo},bundle:true,platform:'node',format:'cjs',outfile:path.join(temp,'runtime.cjs'),logLevel:'silent'});
+  runtime=(await import(pathToFileURL(path.join(temp,'runtime.cjs')).href)).default;
+  runtime.observeTempDirs({created:async p=>created.add(p),removed:async()=>{}});
+  const common=['--setting-sources','user','--tools','','--strict-mcp-config','--mcp-config','{"mcpServers":{}}','--no-session-persistence','--output-format','stream-json'];
+  for(const arm of ['positive','missing-config','invalid-key']){
+    stage=arm;
+    const result=await runtime.withQoderHome(async(home,config,env)=>{
+      if(arm!=='missing-config'){
+        await fs.mkdir(path.join(config,'.models',account.uid),{recursive:true,mode:0o700});
+        const record=structuredClone(selected);if(arm==='invalid-key')record.parameters={api_key:'test_key_invalid_fixture'};
+        await fs.writeFile(path.join(config,'.models',account.uid,'customs'),native.model_cache_encrypt(JSON.stringify([record]),machine),{mode:0o600,flag:'wx'});
+        await fs.writeFile(path.join(config,'.models/default'),JSON.stringify(account),{mode:0o600,flag:'wx'});
+      }
+      const v=await runtime.run(executionBin,['--version'],{cwd:home,env,timeoutMs:15000,killTree:true});evidence.cli_version=v.stdout.trim();
+      let catalog=null;if(arm==='positive')catalog=await runtime.run(executionBin,['--config-dir',config,'--setting-sources','user','--list-models'],{cwd:home,env,timeoutMs:90000,killTree:true});
+      const out=await runtime.run(executionBin,['--config-dir',config,...common,'--model',model,'-p','Reply OK only.'],{cwd:home,env,timeoutMs:90000,killTree:true});
+      return {catalog,out};
+    });
+    const serialize=r=>r?{code:r.code,signal:r.signal,timedOut:r.timedOut,spawned:r.spawned,durationMs:r.durationMs,stdout:safe(r.stdout),stderr:safe(r.stderr)}:null;
+    evidence.cases.push({arm,catalog:serialize(result.catalog),out:serialize(result.out),known_secret_found:guard.leaked});
+    if(guard.leaked)process.exitCode=1;
+    console.log(JSON.stringify({arm,exit_code:result.out.code,timed_out:result.out.timedOut,known_secret_found:guard.leaked}));
+  }
+}catch(error){evidence.error={stage,type:error.name,message:['prepare','source'].includes(stage)?'原生准备失败，原文不输出以免含凭据':safe(error.message)};process.exitCode=1;}
+finally{
+  runtime?.observeTempDirs(null);
+  evidence.sources_unchanged=(await Promise.all(files.map(async f=>snapshots.get(f)===hash(await fs.readFile(path.join(root,f)))))).every(Boolean);
+  evidence.temporary_roots_removed=(await Promise.all([...created].map(p=>fs.stat(p).then(()=>false,()=>true)))).every(Boolean);
+  await fs.rm(temp,{recursive:true,force:true});
+  evidence.script_root_removed=await fs.stat(temp).then(()=>false,()=>true);
+  const output=path.join(repo,'doc/05_testing/evidence/qoder-cn-admission-20261028');await fs.mkdir(output,{recursive:true});
+  const file=path.join(output,`custom-${new Date().toISOString().replace(/[:.]/g,'-')}-${crypto.randomBytes(3).toString('hex')}.json`);
+  safe(JSON.stringify(evidence));evidence.known_secret_found=guard.leaked;
+  await fs.writeFile(file,safe(JSON.stringify(evidence,null,2)).split(os.homedir()).join('~')+'\n',{mode:0o600,flag:'wx'});
+  process.exitCode=guard.exitCode(process.exitCode??0);
+  console.log(JSON.stringify({file,error:evidence.error,known_secret_found:guard.leaked,sources_unchanged:evidence.sources_unchanged,temporary_roots_removed:evidence.temporary_roots_removed}));
+}
diff --git a/scripts/acceptance/kimi-qoder-cn/qoder-index.mjs b/scripts/acceptance/kimi-qoder-cn/qoder-index.mjs
