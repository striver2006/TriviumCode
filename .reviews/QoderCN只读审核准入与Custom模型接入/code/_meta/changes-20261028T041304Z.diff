--- /dev/null
+++ b/scripts/acceptance/kimi-qoder-cn/qoder-secrets.mjs
@@ -0,0 +1,24 @@
+/** 采集器内存护栏；不回显秘密。native内部解密字段未取得时必须单列范围。 */
+export function collectCredentialValues(text,values){
+  if(text)values.push(text.trim());
+  const collect=v=>{if(typeof v==='string'&&v)values.push(v);else if(v&&typeof v==='object')Object.values(v).forEach(collect);};
+  try{collect(JSON.parse(text));}catch{/* 不透明源只保护原始复制字节，不猜明文。 */}
+}
+
+export function secretGuard(values,redact=s=>s){
+  let leaked=false;
+  return {
+    scrub(input){
+      let text=String(input);
+      for(const value of values){
+        if(typeof value!=='string'||!value)continue;
+        for(const variant of new Set([value,JSON.stringify(value).slice(1,-1)])){
+          if(text.includes(variant)){leaked=true;text=text.split(variant).join('[REDACTED]');}
+        }
+      }
+      return redact(text);
+    },
+    get leaked(){return leaked;},
+    exitCode(current=0){return leaked?1:current;},
+  };
+}
