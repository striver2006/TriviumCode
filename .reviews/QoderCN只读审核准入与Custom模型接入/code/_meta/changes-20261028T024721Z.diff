+  account=Object.fromEntries(['key','uid','scene','updatedAt'].filter(k=>account[k]!==undefined).map(k=>[k,account[k]]));
+  evidence.declaration={key:selected.key,provider:selected.provider,model:selected.model,display_name:selected.display_name,format:selected.format,parameter_keys:Object.keys(selected.parameters??{}),source:'native-encrypted-customs',total_source_records:records.length,selected_records:1};
+  await build({stdin:{contents:`export {withQoderHome} from './src/trivium/adapters/qoder-cn-native.ts';export {run} from './src/trivium/util/exec.ts';export {redactSecrets} from './src/trivium/secrets.ts';export {observeTempDirs} from './src/trivium/util/fsx.ts';`,resolveDir:repo},bundle:true,platform:'node',format:'cjs',outfile:path.join(temp,'runtime.cjs'),logLevel:'silent'});
+  runtime=(await import(pathToFileURL(path.join(temp,'runtime.cjs')).href)).default;
+  runtime.observeTempDirs({created:async p=>created.add(p),removed:async()=>{}});
+  const common=['--setting-sources','user','--tools','','--strict-mcp-config','--mcp-config','{"mcpServers":{}}','--no-session-persistence','--output-format','stream-json'];
+  for(const arm of ['positive','missing-config','invalid-key']){
+    stage=arm;
+    const result=await runtime.withQoderHome(async(home,config,env)=>{
+      if(arm!=='missing-config'){
+        await fs.mkdir(path.join(config,'.models',account.uid),{recursive:true,mode:0o700});
+        const record=structuredClone(selected);if(arm==='invalid-key')record.parameters={api_key:'test_key_invalid_fixture'};
+        await fs.writeFile(path.join(config,'.models',account.uid,'customs'),native.model_cache_encrypt(JSON.stringify([record]),machine),{mode:0o600,flag:'wx'});
+        await fs.writeFile(path.join(config,'.models/default'),JSON.stringify(account),{mode:0o600,flag:'wx'});
+      }
+      const v=await runtime.run(executionBin,['--version'],{cwd:home,env,timeoutMs:15000,killTree:true});evidence.cli_version=v.stdout.trim();
+      let catalog=null;if(arm==='positive')catalog=await runtime.run(executionBin,['--config-dir',config,'--setting-sources','user','--list-models'],{cwd:home,env,timeoutMs:90000,killTree:true});
+      const out=await runtime.run(executionBin,['--config-dir',config,...common,'--model',model,'-p','Reply OK only.'],{cwd:home,env,timeoutMs:90000,killTree:true});
+      return {catalog,out};
+    });
+    const serialize=r=>r?{code:r.code,signal:r.signal,timedOut:r.timedOut,spawned:r.spawned,durationMs:r.durationMs,stdout:safe(r.stdout),stderr:safe(r.stderr)}:null;
+    evidence.cases.push({arm,catalog:serialize(result.catalog),out:serialize(result.out),known_secret_found:secrets.some(x=>result.out.stdout.includes(x)||result.out.stderr.includes(x))});
+    console.log(JSON.stringify({arm,exit_code:result.out.code,timed_out:result.out.timedOut}));
+  }
+}catch(error){evidence.error={stage,type:error.name,message:['prepare','source'].includes(stage)?'原生准备失败，原文不输出以免含凭据':safe(error.message)};process.exitCode=1;}
+finally{
+  runtime?.observeTempDirs(null);
+  evidence.sources_unchanged=(await Promise.all(files.map(async f=>snapshots.get(f)===hash(await fs.readFile(path.join(root,f)))))).every(Boolean);
+  evidence.temporary_roots_removed=(await Promise.all([...created].map(p=>fs.stat(p).then(()=>false,()=>true)))).every(Boolean);
+  await fs.rm(temp,{recursive:true,force:true});
+  evidence.script_root_removed=await fs.stat(temp).then(()=>false,()=>true);
+  const output=path.join(repo,'doc/05_testing/evidence/qoder-cn-admission-20261028');await fs.mkdir(output,{recursive:true});
+  const file=path.join(output,`custom-${new Date().toISOString().replace(/[:.]/g,'-')}-${crypto.randomBytes(3).toString('hex')}.json`);
+  await fs.writeFile(file,safe(JSON.stringify(evidence,null,2)).split(os.homedir()).join('~')+'\n',{mode:0o600,flag:'wx'});
+  console.log(JSON.stringify({file,error:evidence.error,sources_unchanged:evidence.sources_unchanged,temporary_roots_removed:evidence.temporary_roots_removed}));
+}
