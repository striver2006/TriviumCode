+const bin=path.join(os.homedir(),'.local/bin/qoderclicn');
+const hash=x=>crypto.createHash('sha256').update(x).digest('hex');
+const temp=await fs.mkdtemp(path.join(os.tmpdir(),'trivium-cn-custom-'));
+await fs.chmod(temp,0o700);
+const evidence={at:new Date().toISOString(),platform:process.platform,requested:model,admission:false,windows:'未测',cases:[]};
+evidence.script_sha256=hash(await fs.readFile(import.meta.filename));
+evidence.rerun={executable:process.execPath,args:[import.meta.filename,model]};
+const secrets=[];const created=new Set();let runtime,selected,native,machine,account,stage='prepare';
+const safe=s=>{let out=String(s);for(const secret of secrets)if(secret)out=out.split(secret).join('[REDACTED]');return runtime?.redactSecrets(out).content??out;};
+const files=['settings.json','.auth/user','.auth/machine_id','.models/default'];
+const snapshots=new Map();
+try{
+  for(const file of files)snapshots.set(file,hash(await fs.readFile(path.join(root,file))));
+  const bytes=await fs.readFile(bin);evidence.cli_sha256=hash(bytes);
+  const executionBin=path.join(temp,'qoder-native');await fs.writeFile(executionBin,bytes,{mode:0o700,flag:'wx'});
+  // 使用当前安装 CLI 自带的原生编解码器；不输出、不归档源码与明文。
+  const marker=bytes.indexOf('n.model_cache_decrypt(',110000000);
+  const start=bytes.lastIndexOf('\0// @bun @bytecode\n',marker),end=bytes.indexOf(0,marker);
+  if(marker<0||start<0||end<0)throw Error('当前CLI原生编解码边界未知');
+  const source=bytes.subarray(start+1,end).toString();
+  let wasm;
+  for(const match of bytes.subarray(110000000).toString().matchAll(/AGFzbQ[A-Za-z0-9+/=]+/g)){
+    const candidate=Buffer.from(match[0],'base64');
+    if(WebAssembly.Module.exports(new WebAssembly.Module(candidate)).some(x=>x.name==='model_cache_decrypt')){if(wasm)throw Error('原生编解码器不唯一');wasm=candidate;}
+  }
+  if(!wasm)throw Error('当前CLI缺少可核实原生编解码器');
+  evidence.codec={source_sha256:hash(source),wasm_sha256:hash(wasm),public_api:false};
+  await fs.writeFile(path.join(temp,'native.mjs'),source,{mode:0o600,flag:'wx'});
+  native=await import(pathToFileURL(path.join(temp,'native.mjs')).href);await native.default({module_or_path:wasm});
+  stage='source';account=JSON.parse(await fs.readFile(path.join(root,'.models/default'),'utf8'));
+  if(typeof account.uid!=='string'||!/^[-a-zA-Z0-9_:]+$/.test(account.uid))throw Error('原生账号目录不可核实');
+  machine=(await fs.readFile(path.join(root,'.auth/machine_id'),'utf8')).trim();
+  const file=path.join('.models',account.uid,'customs');files.push(file);snapshots.set(file,hash(await fs.readFile(path.join(root,file))));
+  const records=JSON.parse(native.model_cache_decrypt(await fs.readFile(path.join(root,file),'utf8'),machine));
+  if(!Array.isArray(records))throw Error('原生Custom记录不是数组');
