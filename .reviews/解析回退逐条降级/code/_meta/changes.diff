+test('R5′〔回归〕合格与降级都为 0 ⇒ 仍说「未发现问题」', () => {
+  const md = renderReviewDoc(input({ review: { ...REVIEW, findings: [] }, degradedFindings: [] }));
+  assert.match(md, /未发现问题/);
+});
