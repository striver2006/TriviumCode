diff --git a/doc/05_testing/evidence/parse-degrade-20261001/show-fallback.mjs b/doc/05_testing/evidence/parse-degrade-20261001/show-fallback.mjs
new file mode 100644
index 00000000..d4d5971c
--- /dev/null
+++ b/doc/05_testing/evidence/parse-degrade-20261001/show-fallback.mjs
@@ -0,0 +1,18 @@
+import fs from 'node:fs';
+const j = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
+for (const r of j.rows) {
+  if (!r.predicted.outcome.startsWith('fallback')) continue;
+  console.log('\n==', r.file, r.predicted.outcome, JSON.stringify(r.predicted.errors));
+  for (const c of r.candidates) console.log('   cand', JSON.stringify({ ...c, findings: c.findings?.length }));
+}
+console.log('\n== extra/missing-location findings');
+for (const r of j.rows) for (const c of r.candidates) for (const f of c.findings ?? []) {
+  if (f.extra.length || f.missing.includes('location')) console.log(r.file, f.id, JSON.stringify(f));
+}
+console.log('\n== enum values');
+const vals = {};
+for (const r of j.rows) for (const c of r.candidates.slice(0, 1)) for (const f of c.findings ?? []) for (const e of f.errors) {
+  const m = /^\/(\w+) must be equal to one of the allowed values/.exec(e);
+  if (m) (vals[m[1]] ??= new Set()).add(r.side);
+}
+console.log(JSON.stringify(Object.fromEntries(Object.entries(vals).map(([k, v]) => [k, [...v]]))));
diff --git a/doc/05_testing/evidence/parse-degrade-20261001/show-gate.mjs b/doc/05_testing/evidence/parse-degrade-20261001/show-gate.mjs
new file mode 100644
index 00000000..4c870b43
--- /dev/null
+++ b/doc/05_testing/evidence/parse-degrade-20261001/show-gate.mjs
@@ -0,0 +1,13 @@
+import fs from 'node:fs';
+const j = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
+const seen = new Set();
+for (const r of j.rows) {
+  const k = r.file.split('/_meta')[0] + ' ' + r.run;
+  const line = [r.side, r.predicted.outcome, `q${r.predicted.qualified ?? '-'}d${r.predicted.degraded ?? '-'}`,
+    (r.predicted.strippedEcho ?? []).join(','), `esc${r.predicted.escapesRepaired ?? 0}`, JSON.stringify(r.parser.cause ?? r.parser.ok)].join(' ');
+  if (!seen.has(k)) {
+    seen.add(k);
+    console.log(`\n${r.gate.ok ?? r.gate.error} ${k} ${JSON.stringify(r.gate.failures?.map((f) => f.code + ':' + f.ids.slice(0, 5).join(',')))}`);
+  }
+  console.log('   ' + line);
+}
