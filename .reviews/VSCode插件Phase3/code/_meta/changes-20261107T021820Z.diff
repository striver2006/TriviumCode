diff --git a/extension/src/approval/gateAreaModel.ts b/extension/src/approval/gateAreaModel.ts
new file mode 100644
index 00000000..697c8cb4
--- /dev/null
+++ b/extension/src/approval/gateAreaModel.ts
@@ -0,0 +1,103 @@
+/**
+ * 闸门区模型（FR-9，计划 r2 §D2；纯函数）。
+ *
+ * 感知：StateWatch 快照里 awaiting_approval / review_done_awaiting_disposition 的闸门。
+ * 计票：gate --check --json 的 round_verdict **原样消费**（编排器从本轮 review-*.json
+ * 派生、run.v3 同字段——与历史树 verdict 同一事实源，不构成第二份计票）。
+ * round_verdict 为 null（bug 阶段/旧运行/无轮次链）时如实降级，不从其它字段补算（CLAUDE-12）。
+ * warnings 一等展示（CLAUDE-10）：与 failures 分区、逐条 code+message，不静默丢弃。
+ */
+import type { GateCheckOutput, GateWarningItem, RoundVerdict } from '../cli/commands';
+
+export type GateAreaMode = 'raf' | 'aa';
+
+export interface VoteBlock {
+  sides: Array<{ critic: string; verdict: string }>;
+  counts: { pass: number; 'pass-after-changes': number; reject: number };
+  outcome: string;
+  roundLine: string | null;
+}
+
+export interface GateCardModel {
+  key: string;
+  topic: string;
+  stage: string;
+  state: string;
+  runId: string;
+  since: string | null;
+  rerunIndex: number | null;
+  mode: GateAreaMode;
+  /** 计票（null = 无计票信息，UI 降级文案） */
+  vote: VoteBlock | null;
+  /** gate --check 退 2 时的缺口摘要（aa 态异常：如裁决被外部改动） */
+  failureSummary: Array<{ code: string; message: string }>;
+  warnings: GateWarningItem[];
+  /** 拒绝理由（UI 输入态镜像，空 = 未填；必填校验在前端） */
+  rejectReason: string;
+}
+
+/** StateWatch 快照 → 闸门区卡（不含 gate --check 结果：那由宿主异步补齐经 mergeGateCheck 合入） */
+export function gateCardsOf(
+  gates: Array<{ key: string; topic: string; stage: string; state: string; runId: string; since: string | null; rerunIndex: number | null }>,
+): Array<Omit<GateCardModel, 'vote' | 'failureSummary' | 'warnings' | 'rejectReason'>> {
+  const out: Array<Omit<GateCardModel, 'vote' | 'failureSummary' | 'warnings' | 'rejectReason'>> = [];
+  for (const g of gates) {
+    if (g.state !== 'awaiting_approval' && g.state !== 'review_done_awaiting_disposition') continue;
+    if (!g.runId) continue;
+    out.push({
+      key: g.key,
+      topic: g.topic,
+      stage: g.stage,
+      state: g.state,
+      runId: g.runId,
+      since: g.since,
+      rerunIndex: g.rerunIndex,
+      mode: g.state === 'awaiting_approval' ? 'aa' : 'raf',
+    });
+  }
+  out.sort((a, b) => (b.since ?? '').localeCompare(a.since ?? ''));
+  return out;
+}
+
+/** gate --check 输出 → 卡片合并片段（aa 态应退 0；退 2 时如实展示缺口并引导裁决台） */
+export function mergeGateCheck(check: GateCheckOutput | null): Pick<GateCardModel, 'vote' | 'failureSummary' | 'warnings'> {
+  if (!check) {
+    return { vote: null, failureSummary: [{ code: 'unavailable', message: 'gate --check 调用失败（读不到输出）：可点刷新重试。' }], warnings: [] };
+  }
+  return {
+    vote: voteBlockOf(check.round_verdict, check.round_line),
+    failureSummary: check.ok ? [] : check.failures.map((f) => ({ code: f.code, message: f.message })),
+    warnings: check.warnings ?? [],
+  };
+}
+
+export function voteBlockOf(rv: RoundVerdict | null, roundLine: string | null): VoteBlock | null {
+  if (!rv) return null;
+  return {
+    sides: Object.entries(rv.sides ?? {}).map(([critic, verdict]) => ({ critic, verdict })),
+    counts: {
+      pass: rv.counts?.pass ?? 0,
+      'pass-after-changes': rv.counts?.['pass-after-changes'] ?? 0,
+      reject: rv.counts?.reject ?? 0,
+    },
+    outcome: rv.outcome ?? '',
+    roundLine,
+  };
+}
+
+/** 计票 verdict → 中文标签（reviewParse.verdictLabel 同文案，展示层复用口径） */
+export function verdictText(v: string): string {
+  const map: Record<string, string> = {
+    pass: '通过',
+    'pass-after-changes': '修改后通过',
+    reject: '不通过',
+    'approve-with-nits': '带微瑕通过',
+    'request-changes': '要求修改',
+  };
+  return map[v] ?? v;
+}
+
+/** 无计票形态的降级文案（不从其它字段补算） */
+export function noVoteNote(): string {
+  return '无计票信息（旧运行或 bug 阶段）：以各侧审查正文为准。';
+}
diff --git a/extension/src/approval/lampModel.ts b/extension/src/approval/lampModel.ts
new file mode 100644
index 00000000..58810d0f
--- /dev/null
+++ b/extension/src/approval/lampModel.ts
@@ -0,0 +1,52 @@
+/**
+ * 状态栏三色灯模型（FR-10，计划 r2 §D4；纯函数）。
+ *
+ * 🔴 审查中锁闭：任一闸门 running，或 state.json 存在但解析失败（unreadable——
+ *     CLAUDE-02：损坏不能当「无闸门」静默绿灯，按锁闭保守处理）；
+ * 🟡 闸门等待：无 running 但存在 review_done_awaiting_disposition / awaiting_approval；
+ * 🟢 自由编辑：其余（无活跃闸门；approved/rejected/abandoned 终态经 RunEnded 回落）。
+ */
+export type LampColor = 'green' | 'yellow' | 'red';
+
+export interface LampInput {
+  /** 活跃闸门（ACTIVE_GATE_STATES 过滤后的 state 集合） */
+  activeStates: string[];
+  /** state.json 存在但解析失败（与「文件不存在」严格区分） */
+  unreadable: boolean;
+}
+
+export interface LampState {
+  color: LampColor;
+  label: string;
+  tooltip: string;
+}
+
+export function lampOf(input: LampInput): LampState {
+  if (input.unreadable) {
+    return {
+      color: 'red',
+      label: 'Trivium ⚠ 状态不可读',
+      tooltip: 'state.json 存在但解析失败：无法确认是否审查中，按锁闭保守处理（保存将受警示）。请排查 .trivium/state.json。',
+    };
+  }
+  if (input.activeStates.includes('running')) {
+    return {
+      color: 'red',
+      label: 'Trivium 🔴 审查中',
+      tooltip: '双审进行中：保存业务文件可能造成快照漂移、整轮作废（编辑与保存时会有警示）。',
+    };
+  }
+  if (input.activeStates.length > 0) {
+    return {
+      color: 'yellow',
+      label: 'Trivium 🟡 闸门等待',
+      tooltip: '等待裁决或人工审批：驾驶舱的闸门区可处理；此期间保存业务文件会有警示。',
+    };
+  }
+  return { color: 'green', label: 'Trivium 🟢 自由编辑', tooltip: '无活跃双审闸门。' };
+}
+
+/** 灯色 → 保存防护的拦截等级（green 放行；yellow/red 走警示路径） */
+export function guardLevelOf(color: LampColor): 'free' | 'guarded' {
+  return color === 'green' ? 'free' : 'guarded';
+}
diff --git a/extension/src/approval/worktreeSummary.ts b/extension/src/approval/worktreeSummary.ts
new file mode 100644
index 00000000..86e6de39
--- /dev/null
+++ b/extension/src/approval/worktreeSummary.ts
@@ -0,0 +1,80 @@
+/**
+ * 提示性工作树摘要（FR-9，计划 r2 §D3；纯函数 + 注入 runner）。
+ *
+ * 数据源：只读 `git status --porcelain=v1 -z --untracked-files=all`（提示性口径，
+ * **相对 HEAD**——看不见闸门期已提交的改动；权威口径是批准时 approve --json 输出的
+ * worktree_summary，基线为审查收尾 tree）。
+ * 展示过滤：按编排器 diffExcludePrefixes 同语义剔除 `.reviews/`、`.trivium/`、`.git/`
+ * 前缀（AGY-05：审查工件落盘不该被当成业务改动误报）。
+ * 纯只读查询：无锁、无索引写（编排器摘要的 write-tree/临时索引机制**不**在插件侧模仿）。
+ */
+export interface WorktreeHint {
+  available: boolean;
+  reason: string | null;
+  total: number;
+  files: Array<{ status: string; path: string }>;
+}
+
+/** 编排器系统保留前缀（worktree-summary.ts diffExcludePrefixes 的展示层等价集） */
+export const EXCLUDED_PREFIXES = ['.reviews/', '.trivium/', '.git/'];
+
+/** porcelain=v1 -z 输出解析（NUL 分隔；重命名条目是 `XY new\0old` 双段） */
+export function parsePorcelainZ(raw: string): Array<{ status: string; path: string }> {
+  const out: Array<{ status: string; path: string }> = [];
+  const segs = raw.split('\0');
+  for (let i = 0; i < segs.length; i++) {
+    const seg = segs[i] ?? '';
+    if (seg === '') continue;
+    const xy = seg.slice(0, 2);
+    const p = seg.slice(3);
+    if (p === '') continue;
+    out.push({ status: xy, path: p });
+    if (xy[0] === 'R' || xy[0] === 'C') i += 1; // 跳过原路径段
+  }
+  return out;
+}
+
+/** 前缀过滤（含目录自身形态，如 `.reviews` 无斜杠时也视为前缀匹配） */
+export function filterExcluded(entries: Array<{ status: string; path: string }>, prefixes: string[] = EXCLUDED_PREFIXES): Array<{ status: string; path: string }> {
+  return entries.filter((e) => {
+    for (const p of prefixes) {
+      const bare = p.endsWith('/') ? p.slice(0, -1) : p;
+      if (e.path === bare || e.path.startsWith(p)) return false;
+    }
+    return true;
+  });
+}
+
+/** 状态码 → 中文标签（展示层；AGY-05：' M'（未暂存修改）首位是空格，须看 y 位） */
+export function statusText(xy: string): string {
+  const map: Record<string, string> = { M: '修改', A: '新增', D: '删除', R: '重命名', C: '复制', '?': '未跟踪', '!': '忽略', U: '冲突' };
+  if (xy.startsWith('??')) return '未跟踪';
+  if (xy.startsWith('!!')) return '忽略';
+  const x = xy[0] ?? '?';
+  const y = xy[1] ?? '';
+  return map[x] ?? map[y] ?? xy;
+}
+
+/** 注入的 git runner（spawn 'git' …的宿主侧包装；测试注入桩） */
+export type GitRunner = (args: string[], timeoutMs: number) => Promise<{ code: number | null; stdout: string; stderr: string }>;
+
+export async function summarizeWorktreeHint(run: GitRunner, limit = 50): Promise<WorktreeHint> {
+  let r: { code: number | null; stdout: string; stderr: string };
+  try {
+    r = await run(['status', '--porcelain=v1', '-z', '--untracked-files=all'], 5_000);
+  } catch (e) {
+    return { available: false, reason: `git 调用失败：${e instanceof Error ? e.message : String(e)}`, total: 0, files: [] };
+  }
+  if (r.code !== 0) {
+    return { available: false, reason: `git status 退出码 ${r.code}（非 git 仓库或 git 不可用）`, total: 0, files: [] };
+  }
+  const files = filterExcluded(parsePorcelainZ(r.stdout)).sort((a, b) => a.path.localeCompare(b.path));
+  return { available: true, reason: null, total: files.length, files: files.slice(0, limit) };
+}
+
+/** 权威摘要（approve 输出的 worktree_summary 单阶段条目）→ 展示行集 */
+export function authoritativeFiles(s: { available: boolean; reason: string | null; total: number; truncated: boolean; files: Array<{ status: string; path: string }> } | undefined | null): { kind: 'ok'; total: number; truncated: boolean; files: Array<{ status: string; path: string }> } | { kind: 'unavailable'; reason: string } | null {
+  if (!s) return null;
+  if (!s.available) return { kind: 'unavailable', reason: s.reason ?? '编排器未能计算摘要（如实呈现，不伪造空清单）' };
+  return { kind: 'ok', total: s.total, truncated: s.truncated, files: s.files ?? [] };
+}
diff --git a/extension/src/disposition/dispositionDraft.ts b/extension/src/disposition/dispositionDraft.ts
new file mode 100644
index 00000000..542c133a
--- /dev/null
+++ b/extension/src/disposition/dispositionDraft.ts
@@ -0,0 +1,337 @@
+/**
+ * disposition 草稿生成与落盘（FR-8，计划 r2 §D1；纯函数 + 注入 fs）。
+ *
+ * 契约对齐（skills/dual-critic/schema/disposition.v1.json + src/trivium/disposition.ts）：
+ * - front-matter 七必填字段，经 yaml 库序列化（代码审 r1 CLAUDE-10：`[abc]` 类合法
+ *   主题名裸插值会被 YAML 解析成数组，自由字符串必须走可靠序列化）；
+ * - kind：plan/bug→revised、code→response；表头六列：code「修改计划」/ plan·bug「落点」；
+ * - 落盘：起草 `wx` 独占创建（EEXIST 不抬升——编排器的重试语义不在插件重复）；修复
+ *   走**原文手术**（代码审 r1 CLAUDE-04/CODEX-08：只替换被修复行、追加新增行、剔除
+ *   删除行，front-matter 与表外正文原样保留，不整份重写审计件），写回前比对载入时
+ *   内容 hash（防并发覆盖）。
+ *
+ * 本模块不复制闸门校验逻辑——正确性由编排器 `gate --check` 兜底。
+ */
+import { createHash } from 'node:crypto';
+import YAML from 'yaml';
+import type { Verdict, ParsedDocRow } from './gateGapModel';
+
+export type DispositionKind = 'revised' | 'response';
+
+/** 注入的文件系统面 */
+export interface DraftFs {
+  readFile(p: string): Promise<string>;
+  /** 独占创建（'wx'）；返回 null 表示已存在（EEXIST），不抛错 */
+  createExclusive(p: string, text: string): Promise<boolean>;
+  /** 原子替换写回（tmp+rename 同目录） */
+  replaceExclusive(p: string, text: string): Promise<void>;
+}
+
+export interface DraftRow {
+  id: string;
+  critic: string | null;
+  severity: string | null;
+  verdict: Verdict;
+  reason: string;
+  action: string | null;
+}
+
+/** 阶段 → kind（naming.ts dispositionKindForStage 同映射） */
+export function dispositionKindForStage(stage: string): DispositionKind {
+  return stage === 'code' ? 'response' : 'revised';
+}
+
+/** `<本地日期 YYYY-MM-DD>-<主题>[-rN(rerun>1)]-<kind>-<driver>.md`（本地时区，对齐 naming.ts localDate） */
+export function draftFileName(args: { topic: string; rerunIndex: number | null; stage: string; driver: string; now?: Date }): string {
+  const d = args.now ?? new Date();
+  const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+  const bump = args.rerunIndex !== null && args.rerunIndex > 1 ? `-r${args.rerunIndex}` : '';
+  return `${date}-${args.topic}${bump}-${dispositionKindForStage(args.stage)}-${args.driver}.md`;
+}
+
+/** 单元格安全化：`|` 破坏列切分、换行破坏行结构（disposition.ts 按 | 切列、按行切行） */
+export function safeCell(text: string): string {
+  return text.replace(/\|/g, '｜').replace(/\r?\n/g, ' ').trim();
+}
+
+/** 归一化用户裁决词（「采纳/同意」→「接受」等；与 normalizeDisposal 同义集的展示层归一） */
+export function normalizeVerdict(text: string): Verdict | null {
+  const t = text.replace(/[。.、]/g, '').trim();
+  if (/^(接受|采纳|同意|accept)/i.test(t)) return '接受';
+  if (/^(驳回|不接受|拒绝|否决|reject)/i.test(t)) return '驳回';
+  if (/^(暂缓|搁置|推迟|defer)/i.test(t)) return '暂缓';
+  return null;
+}
+
+// ── front-matter 与表格渲染 ─────────────────────────────────────────────
+
+/** front-matter 七字段 → yaml 文本（`---` 包裹；字段序对齐真实件） */
+export function renderFrontMatter(input: { topic: string; stage: string; runId: string; driver: string; addresses: string[] }): string {
+  const doc = new YAML.Document({
+    schema: 'trivium.disposition.v1',
+    topic: input.topic,
+    stage: input.stage,
+    role: input.driver,
+    kind: dispositionKindForStage(input.stage),
+    run_id: input.runId,
+    addresses: input.addresses,
+  });
+  // 强制保持插入序（yaml 缓存键序可能重排 map）；列表项两空格缩进对齐真实件
+  return doc.toString({ lineWidth: 0, indentSeq: true }).trimEnd();
+}
+
+export interface RenderInput {
+  topic: string;
+  stage: string;
+  runId: string;
+  driver: string;
+  addresses: string[];
+  rows: DraftRow[];
+  /** 起草模式无只读行（全量新建）；修复模式只读行以原文行保留（见 renderRepaired） */
+  titleNote: string;
+}
+
+/** 生成完整裁决件文本（起草模式：front-matter + 表格全新生成） */
+export function renderDisposition(input: RenderInput): string {
+  const fm = renderFrontMatter(input);
+  const header = actionHeader(input.stage);
+  const align = '| :--- | :--- | :--- | :--- | :--- | :--- |';
+  const rows = input.rows.map(rowLine);
+  return [
+    '---',
+    fm,
+    '---',
+    '',
+    `# ${input.titleNote}（Driver：${input.driver}）`,
+    '',
+    `共 ${rows.length} 条：接受 ${count(rows, '接受')} ｜ 驳回 ${count(rows, '驳回')} ｜ 暂缓 ${count(rows, '暂缓')}。`,
+    '',
+    header,
+    align,
+    ...rows,
+    '',
+  ].join('\n');
+}
+
+function actionHeader(stage: string): string {
+  const last = stage === 'code' ? '修改计划' : '落点';
+  return `| 意见编号 | 来源 | 严重度 | 裁决 | 理由 | ${last} |`;
+}
+
+function count(rowTexts: string[], v: Verdict): number {
+  return rowTexts.filter((l) => l.includes(`| ${v} |`)).length;
+}
+
+function rowLine(r: { id: string; critic?: string | null; severity?: string | null; verdict: Verdict; reason: string; action: string | null }): string {
+  return `| ${safeCell(r.id)} | ${safeCell(r.critic ?? '—')} | ${safeCell(r.severity ?? '—')} | ${r.verdict} | ${safeCell(r.reason)} | ${safeCell(r.action ?? '—')} |`;
+}
+
+// ── 现有裁决件解析（修复模式预填 + 原文手术定位） ─────────────────────────
+
+export interface ParsedDisposition {
+  frontMatter: Record<string, string | string[]>;
+  rows: ParsedDocRow[];
+  /** 原文手术面（无表格时 null） */
+  surgery: {
+    lines: string[];
+    /** 表头行 index */
+    headerLine: number;
+    /** 表格末行 index（追加新行的落点） */
+    lastRowLine: number;
+    /** id → 行 index（被修复行/删除行定位） */
+    rowLineOf: Map<string, number>;
+  } | null;
+}
+
+/**
+ * 解析现有裁决件：front-matter（yaml）+ 裁决表数据行（含行定位，供原文手术）。
+ * 表头行识别：以 `|` 开头、能认全 意见编号/裁决/理由 三列（同义词集对齐 disposition.ts）。
+ * 任何坏形态都返回部分结果而非抛错——修复入口的正确性由 gate --check 兜底。
+ */
+export function parseDispositionDoc(text: string): ParsedDisposition {
+  const fm: Record<string, string | string[]> = {};
+  const fmMatch = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
+  if (fmMatch) {
+    try {
+      const parsed = YAML.parse(fmMatch[1]!) as Record<string, unknown> | null;
+      if (parsed && typeof parsed === 'object') {
+        for (const [k, v] of Object.entries(parsed)) {
+          if (Array.isArray(v)) fm[k] = v.map(String);
+          else fm[k] = v === null || v === undefined ? '' : String(v);
+        }
+      }
+    } catch {
+      // 坏 front-matter：保持空 map，结构修复路径重建
+    }
+  }
+  const lines = text.split(/\r?\n/);
+  const header = findHeader(lines);
+  const rows: ParsedDocRow[] = [];
+  if (!header) return { frontMatter: fm, rows, surgery: null };
+  const idRe = /^[A-Z][A-Z0-9]{1,15}-(?:r\d+-)?(?:F)?\d+$/i;
+  const rowLineOf = new Map<string, number>();
+  let lastRowLine = header.line;
+  for (let i = header.line + 1; i < lines.length; i++) {
+    const line = lines[i]!;
+    if (!line.trim().startsWith('|')) continue;
+    const cols = line.split('|').slice(1, -1).map((c) => c.trim());
+    if (cols.length < header.cols.length) continue;
+    const id = cols[header.idAt] ?? '';
+    if (!idRe.test(id)) continue;
+    const verdict = normalizeVerdict(cols[header.verdictAt] ?? '');
+    rows.push({
+      id,
+      verdict,
+      reason: unescapeCell(cols[header.reasonAt] ?? ''),
+      action: header.actionAt !== null ? unescapeCell(cols[header.actionAt] ?? '') || null : null,
+    });
+    if (!rowLineOf.has(id)) rowLineOf.set(id, i);
+    lastRowLine = i;
+  }
+  return {
+    frontMatter: fm,
+    rows,
+    surgery: { lines, headerLine: header.line, lastRowLine, rowLineOf },
+  };
+}
+
+const ALIAS_ID = ['意见编号', '编号', 'id'];
+const ALIAS_VERDICT = ['裁决', '处置', '结论', 'disposal'];
+const ALIAS_REASON = ['理由', '原因', 'reason'];
+
+function normalizeCellKey(cell: string): string {
+  return cell.replace(/[\s\u3000]/g, '').replace(/：/g, ':').toLowerCase();
+}
+
+/** 找表头行并返回三列下标（含行号与对齐行号）；找不到返回 null */
+function findHeader(lines: string[]): { line: number; cols: string[]; idAt: number; verdictAt: number; reasonAt: number; actionAt: number | null } | null {
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i]!;
+    if (!line.trim().startsWith('|')) continue;
+    const cols = line.split('|').slice(1, -1).map((c) => c.trim());
+    if (cols.length < 3) continue;
+    const normed = cols.map(normalizeCellKey);
+    const idAt = normed.findIndex((c) => ALIAS_ID.includes(c));
+    const verdictAt = normed.findIndex((c) => ALIAS_VERDICT.includes(c));
+    const reasonAt = normed.findIndex((c) => ALIAS_REASON.includes(c));
+    if (idAt < 0 || verdictAt < 0 || reasonAt < 0) continue;
+    const actionAt = normed.findIndex((c) => ['落点', '落地点', '修改点', '修改计划', '计划', '动作', 'action'].includes(c));
+    return { line: i, cols, idAt, verdictAt, reasonAt, actionAt: actionAt >= 0 ? actionAt : null };
+  }
+  return null;
+}
+
+function unescapeCell(s: string): string {
+  return s === '—' ? '' : s;
+}
+
+// ── 原文手术（修复模式渲染） ─────────────────────────────────────────────
+
+export interface SurgeryOps {
+  /** 被修复行的新行文本（id → 新行） */
+  replaceLines: Map<string, string>;
+  /** 删除行编号（unknown_findings 等） */
+  removeIds: Set<string>;
+  /** 追加的新行文本（missing_findings 新增行） */
+  appendLines: string[];
+  /** front-matter 需重建时给新值（bad_front_matter）；null = 保留原 front-matter 原文 */
+  newFrontMatter: string | null;
+  /** 表头需重建（unparsable_table） */
+  newHeaderLines: string[] | null;
+}
+
+/**
+ * 原文手术：基于既有件全文做行级 patch——front-matter 与表外正文原样保留
+ * （CLAUDE-04/CODEX-08：不整份重写审计件）。
+ */
+export function renderRepaired(parsed: ParsedDisposition, ops: SurgeryOps): string {
+  const lines = [...parsed.surgery!.lines];
+  // 1) 行替换与删除
+  for (const [id, newLine] of ops.replaceLines) {
+    const at = parsed.surgery!.rowLineOf.get(id);
+    if (at !== undefined) lines[at] = newLine;
+  }
+  const removeAt = new Set<number>();
+  for (const id of ops.removeIds) {
+    const at = parsed.surgery!.rowLineOf.get(id);
+    if (at !== undefined) removeAt.add(at);
+  }
+  // 2) 追加新行（finishRepair 内按表格末行锚定插入）
+  const appended = ops.appendLines.length > 0 ? [...ops.appendLines] : [];
+  // 3) 表头重建（unparsable）：替换表头与对齐行
+  let out: string[];
+  if (ops.newHeaderLines) {
+    const head = parsed.surgery!.headerLine;
+    out = [...lines.slice(0, head), ...ops.newHeaderLines, ...lines.slice(head + 2).filter((_, idx) => !removeAt.has(head + 2 + idx))];
+    // 重新插回追加行：追加落点在「过滤后仍保持表格区末尾」——简化为附到文件尾前
+    return finishRepair(out, appended, ops);
+  }
+  out = lines.filter((_, idx) => !removeAt.has(idx));
+  return finishRepair(out, appended, ops);
+}
+
+function finishRepair(out: string[], appended: string[], ops: SurgeryOps): string {
+  let text = out.join('\n');
+  // 4) 追加行：插到表格末行后（按最后一个数据行锚定）
+  if (appended.length > 0) {
+    const lines2 = text.split('\n');
+    let lastTable = -1;
+    const idRe = /^\|\s*[A-Z][A-Z0-9]{1,15}-(?:r\d+-)?(?:F)?\d+\s*\|/i;
+    for (let i = 0; i < lines2.length; i++) {
+      if (idRe.test(lines2[i]!.trim()) || (lines2[i] ?? '').trim().startsWith('| :---')) lastTable = i;
+    }
+    lines2.splice(lastTable + 1, 0, ...appended);
+    text = lines2.join('\n');
+  }
+  // 5) front-matter 重建（bad_front_matter）：替换首对 --- 之间内容
+  if (ops.newFrontMatter !== null) {
+    text = text.replace(/^---\r?\n[\s\S]*?\r?\n---/, `---\n${ops.newFrontMatter}\n---`);
+  }
+  return text;
+}
+
+// ── 落盘 ─────────────────────────────────────────────────────────────────
+
+export type SaveOutcome =
+  | { ok: true; path: string; mode: 'create' | 'replace' }
+  | { ok: false; error: 'exists'; path: string; hint: string }
+  | { ok: false; error: 'conflict'; path: string; hint: string }
+  | { ok: false; error: 'io'; path: string; hint: string };
+
+/**
+ * 起草：独占创建（EEXIST 不抬升 -rN——编排器的重试语义不在插件重复；如实转修复提示）。
+ * 修复：写回前比对载入时内容 hash 与当前盘上内容，不一致拒写（防并发覆盖）。
+ */
+export async function saveDraft(
+  fs: DraftFs,
+  absPath: string,
+  text: string,
+  mode: { kind: 'create' } | { kind: 'replace'; loadedText: string },
+): Promise<SaveOutcome> {
+  try {
+    if (mode.kind === 'create') {
+      const created = await fs.createExclusive(absPath, text);
+      if (!created) {
+        return { ok: false, error: 'exists', path: absPath, hint: '文件已存在：可能是上一份草稿或手工件，请在裁决台以修复模式读取它。' };
+      }
+      return { ok: true, path: absPath, mode: 'create' };
+    }
+    let current = '';
+    try {
+      current = await fs.readFile(absPath);
+    } catch {
+      return { ok: false, error: 'io', path: absPath, hint: '目标文件读不出，无法做并发冲突比对。' };
+    }
+    if (sha1(current) !== sha1(mode.loadedText)) {
+      return { ok: false, error: 'conflict', path: absPath, hint: '文件在载入后已被外部修改：请重新拉取缺口再生成，避免覆盖他人改动。' };
+    }
+    await fs.replaceExclusive(absPath, text);
+    return { ok: true, path: absPath, mode: 'replace' };
+  } catch (e) {
+    return { ok: false, error: 'io', path: absPath, hint: `落盘失败：${e instanceof Error ? e.message : String(e)}` };
+  }
+}
+
+function sha1(s: string): string {
+  return createHash('sha1').update(s, 'utf8').digest('hex');
+}
