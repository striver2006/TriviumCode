+/**
+ * gate 缺口 → 裁决台 UI 模型（FR-8，计划 r2 §D1；纯函数，不依赖 vscode）。
+ *
+ * 两形态（CLAUDE-07/CODEX-02：missing_disposition 提前返回时 fallback_ids 恒空、
+ * 无 missing_findings，首写与修复必须分别建表）：
+ * - 起草（draft）：disposition 为 null。待裁集 = structured_ids ∪ degraded_ids ∪
+ *   fallback 期望集（由 runMeta 从 .fallback-items.md 读出，**不是** check.fallback_ids）。
+ * - 修复（repair）：disposition 非 null。新增行 = missing_findings.ids；
+ *   修复行 = empty_reason ∪ defer_not_allowed ∪ missing_action ∪ unknown_findings（删行）
+ *   ∪ joint_blocker_rejected（hard 策略下的 failure）的 ids——这些行已在裁决表里，预填现有内容；
+ *   只读行 = 期望集 − 新增 − 修复。
+ */
+import type { GateCheckOutput, GateWarningItem } from '../cli/commands';
+import { criticOfId, isFallbackId, type RunMetaInfo } from './runMeta';
+
+export type Verdict = '接受' | '驳回' | '暂缓';
+
+/** 表单一行（新增或修复；渲染与草稿生成共用） */
+export interface GapItem {
+  id: string;
+  critic: string | null;
+  origin: 'structured' | 'degraded' | 'fallback';
+  severity: string | null;
+  /** 结构化行的接受项落点必填（missing_action 契约）；fallback 行可选（checkRow 第二参数） */
+  requireAction: boolean;
+  /** defer_not_allowed 命中 → 禁选暂缓 */
+  deferAllowed: boolean;
+  /** unknown_findings 命中 → 该行应从裁决表删除（代码审 r1 CLAUDE-02/AGY-01/CODEX-06） */
+  removeable: boolean;
+  /** 该行当前的失败原因（修复行有值：如「理由为空」） */
+  problemNote: string | null;
+  /** 修复行预填的现有内容（draft 形态为 null） */
+  existing: { verdict: Verdict; reason: string; action: string } | null;
+}
+
+/** 修复形态下已合法、保留原文的行 */
+export interface ReadonlyRow {
+  id: string;
+  verdict: Verdict;
+  reason: string;
+  action: string | null;
+}
+
+export interface StructuralGap {
+  code: string;
+  message: string;
+}
+
+export interface PlanGap {
+  code: string;
+  message: string;
+  ids: string[];
+}
+
+export interface GapModel {
+  form: 'draft' | 'repair';
+  dispositionPath: string | null;
+  topic: string;
+  stage: string;
+  runId: string;
+  rerunIndex: number | null;
+  driver: { driver: string; source: string } | null;
+  addresses: string[];
+  items: GapItem[];
+  readonlyRows: ReadonlyRow[];
+  structural: StructuralGap[];
+  planGaps: PlanGap[];
+  warnings: GateWarningItem[];
+  roundLine: string | null;
+  nextAction: string | null;
+}
+
+export interface ParsedDocRow {
+  id: string;
+  verdict: Verdict | null;
+  reason: string;
+  action: string | null;
+}
+
+export interface BuildGapInput {
+  check: GateCheckOutput;
+  topic: string;
+  stage: string;
+  meta: RunMetaInfo | null;
+  /** runMeta.allFallbackIds 的产出（首写形态的 fallback 期望集） */
+  fallbackExpected: string[];
+  driver: { driver: string; source: string } | null;
+  addresses: string[];
+  /** 修复形态：现有裁决件的解析行（dispositionDraft.parseDispositionDoc.rows） */
+  existingRows: ParsedDocRow[];
+}
+
+/** 各逐条类 failure code 的中文化说明（展示层，不改判语义） */
+const FIX_NOTE: Record<string, string> = {
+  empty_reason: '理由为空或被判空洞，需补写非空理由',
+  defer_not_allowed: '该编号不允许暂缓（本轮策略），请改选接受/驳回',
+  missing_action: '接受项缺少落点（修改计划）',
+  unknown_findings: '编号不在本轮期望集，应从裁决表删除该行',
+  joint_blocker_rejected: '两家共同提出的 blocker 被驳回（hard 策略），需复议或改判',
+};
+
+function verdictOf(v: string | null | undefined): Verdict | null {
+  if (v === '接受' || v === '驳回' || v === '暂缓') return v;
+  return null;
+}
+
+/** 一个编号的归属集合（新/修/只读）判定用中间结构 */
+interface FixIds {
+  newIds: Set<string>;
+  fixIds: Map<string, string[]>; // id → 命中的 failure codes
+}
+
+function collectFixIds(check: GateCheckOutput): FixIds {
+  const fixIds = new Map<string, string[]>();
+  const newIds = new Set<string>();
+  for (const f of check.failures) {
+    if (!f.ids) continue;
+    for (const id of f.ids) {
+      if (f.code === 'missing_findings') {
+        newIds.add(id);
+        continue;
+      }
+      if (!(f.code in FIX_NOTE)) continue;
+      const list = fixIds.get(id) ?? [];
+      list.push(f.code);
+      fixIds.set(id, list);
+    }
+  }
+  return { newIds, fixIds };
+}
+
+function itemOf(
+  id: string,
+  origin: GapItem['origin'],
+  fixCodes: string[],
+  existingRows: ParsedDocRow[],
+): GapItem {
+  const existing = existingRows.find((r) => r.id === id);
+  const verdict = existing?.verdict ?? null;
+  return {
+    id,
+    critic: criticOfId(id),
+    origin,
+    severity: null, // 展示层从批注数据面取（cockpit 组装时回填）
+    requireAction: !isFallbackId(id),
+    deferAllowed: !fixCodes.includes('defer_not_allowed'),
+    removeable: fixCodes.includes('unknown_findings'),
+    problemNote: fixCodes.length > 0 ? fixCodes.map((c) => FIX_NOTE[c] ?? c).join('；') : null,
+    existing:
+      verdict !== null
+        ? { verdict, reason: existing?.reason ?? '', action: existing?.action ?? '' }
+        : null,
+  };
+}
+
+export function buildGapModel(input: BuildGapInput): GapModel {
+  const { check, existingRows } = input;
+  const isRepair = check.disposition !== null;
+  const { newIds, fixIds } = collectFixIds(check);
+  const planGaps: PlanGap[] = [];
+  const structural: StructuralGap[] = [];
+
+  for (const f of check.failures) {
+    if (f.code === 'missing_next_plan' || f.code === 'next_plan_missing_ids') {
+      planGaps.push({ code: f.code, message: f.message, ids: f.ids ?? [] });
+    } else if (!f.ids && !['missing_findings'].includes(f.code) && !(f.code in FIX_NOTE)) {
+      // 无 ids 的整卡类（missing_disposition/bad_front_matter/unparsable_table/missing_review_json/task_unreadable/readonly_breach…）
+      structural.push({ code: f.code, message: f.message });
+    }
+  }
+
+  const items: GapItem[] = [];
+  const readonlyRows: ReadonlyRow[] = [];
+
+  if (!isRepair) {
+    // 起草形态：全部期望编号进表单（structured ∪ degraded ∪ fallback 期望集）
+    const seen = new Set<string>();
+    for (const id of check.structured_ids) {
+      if (seen.has(id)) continue;
+      seen.add(id);
+      items.push(itemOf(id, 'structured', [], existingRows));
+    }
+    for (const id of check.degraded_ids) {
+      if (seen.has(id)) continue;
+      seen.add(id);
+      items.push(itemOf(id, 'degraded', [], existingRows));
+    }
+    for (const id of input.fallbackExpected) {
+      if (seen.has(id)) continue;
+      seen.add(id);
+      items.push(itemOf(id, 'fallback', [], existingRows));
+    }
+  } else {
+    // 修复形态：新增 + 修复进表单；其余已裁行只读保留
+    const editable = new Set<string>([...newIds, ...fixIds.keys()]);
+    const expected = new Set([...check.structured_ids, ...check.degraded_ids, ...input.fallbackExpected, ...check.fallback_ids]);
+    // 期望集之外已在表里的行 = unknown_findings（可编辑删行）——fixIds 已含
+    for (const id of newIds) {
+      items.push(itemOf(id, criticOfId(id) ? 'structured' : 'structured', fixIds.get(id) ?? [], existingRows));
+    }
+    for (const [id, codes] of fixIds) {
+      if (newIds.has(id)) continue;
+      items.push(itemOf(id, 'structured', codes, existingRows));
+    }
+    for (const r of existingRows) {
+      if (editable.has(r.id)) continue;
+      if (!expected.has(r.id) && r.verdict === null) continue; // 解析不出的行不冒充合法
+      const v = verdictOf(r.verdict);
+      if (v === null) continue;
+      readonlyRows.push({ id: r.id, verdict: v, reason: r.reason, action: r.action });
+    }
+  }
+
+  items.sort((a, b) => a.id.localeCompare(b.id));
+
+  // 文件名轮次的第一事实源是 gate 输出的 rerun_index（与校验所用轮次同源，
+  // cli.ts:1674-1685）；run 元数据仅作后备（代码审 r1 CLAUDE-11：旧运行 review_loop
+  // 为 null、meta 缺失时不能丢 -rN 中缀——否则第二轮撞首轮文件名）
+  const rerunIndex = (typeof check.rerun_index === 'number' && check.rerun_index > 0 ? check.rerun_index : null) ?? input.meta?.rerunIndex ?? null;
+
+  return {
+    form: isRepair ? 'repair' : 'draft',
+    dispositionPath: check.disposition,
+    topic: input.topic,
+    stage: input.stage,
+    runId: check.run_id,
+    rerunIndex,
+    driver: input.driver,
+    addresses: input.addresses,
+    items,
+    readonlyRows,
+    structural,
+    planGaps,
+    warnings: check.warnings,
+    roundLine: check.round_line,
+    nextAction: check.next_action,
+  };
+}
diff --git a/extension/src/disposition/runMeta.ts b/extension/src/disposition/runMeta.ts
new file mode 100644
index 00000000..d119d89a
--- /dev/null
+++ b/extension/src/disposition/runMeta.ts
@@ -0,0 +1,178 @@
+/**
+ * `_meta/` 运行元数据只读解析（FR-8 数据源，计划 r2 §D1/§D6）。
+ *
+ * 三件事（全部只读派生，正确性由编排器 `gate --check` 兜底）：
+ * - 当轮 Driver id 定位链：`run-<runId>.json`.driver（run 权威）→ task.json
+ *   drivers[stage]（阶段认领声明，受限 fallback）→ 闸门 gates[].driver（仅展示比对，不采信）；
+ * - addresses 期望集：从 `run-<runId>.json`.artifacts[] 派生（对齐 gate.ts expectedReviewDocs
+ *   的判据：阶段根、非裁决件、后缀属有效侧；**不做日期拼名**——跨零点与撞名抬升会改实际落盘名）；
+ * - fallback 期望编号：`review-<critic>-<runId>.fallback-items.md` 每行 `- <前缀>-F<n>: …`
+ *   （missing_disposition 提前返回时 gate 的 fallback_ids 恒空，不能用）。
+ */
+import path from 'node:path';
+
+/** 注入的文件系统面（与 runHistory.FsApi 同形） */
+export interface RunMetaFs {
+  readFile(p: string): Promise<string>;
+}
+
+export interface RunMetaInfo {
+  runId: string;
+  driver: string | null;
+  rerunIndex: number | null;
+  criticsSelected: string[];
+  /** 逐侧运行状态（critics.<c>.status）；缺省空对象 */
+  criticStatus: Record<string, string>;
+  /** artifacts[] 的登记路径（`<主题>/<阶段>/<文件名>` 或含 `_meta/` 前缀） */
+  artifacts: string[];
+}
+
+interface RunMetaJson {
+  driver?: string;
+  rerun_index?: number;
+  critics_selected?: string[];
+  critics?: Record<string, { status?: string }>;
+  artifacts?: Array<{ path?: string } | string>;
+}
+
+/** 意见编号前缀 → critic agent id（注册表派生规则的插件侧只读映射；未知前缀返回 null） */
+const PREFIX_TO_CRITIC: Record<string, string> = {
+  CLAUDE: 'claude',
+  CODEX: 'codex',
+  AGY: 'gemini',
+  GLM: 'glm',
+};
+
+/** `<前缀>[-rN]-NN` / `<前缀>-F<n>` → 前缀段 */
+export function criticOfId(id: string): string | null {
+  const m = /^([A-Z][A-Z0-9]{1,15})-(?:r\d+-)?(?:F)?\d+/i.exec(id.trim());
+  return m ? (PREFIX_TO_CRITIC[m[1]!.toUpperCase()] ?? null) : null;
+}
+
+/** fallback 编号（`<前缀>-F<n>`）判定——行级落点要求的例外类（checkRow 第二参数） */
+export function isFallbackId(id: string): boolean {
+  return /-F\d+$/i.test(id.trim());
+}
+
+/** 读 `_meta/run-<runId>.json`；读不出/坏 JSON 返回 null（调用方明示降级，不猜） */
+export async function readRunMeta(fs: RunMetaFs, metaDir: string, runId: string): Promise<RunMetaInfo | null> {
+  let raw: string;
+  try {
+    raw = await fs.readFile(path.join(metaDir, `run-${runId}.json`));
+  } catch {
+    return null;
+  }
+  let obj: RunMetaJson;
+  try {
+    obj = JSON.parse(raw) as RunMetaJson;
+  } catch {
+    return null;
+  }
+  const criticStatus: Record<string, string> = {};
+  for (const [c, v] of Object.entries(obj.critics ?? {})) {
+    if (typeof v?.status === 'string') criticStatus[c] = v.status;
+  }
+  return {
+    runId,
+    driver: typeof obj.driver === 'string' && obj.driver.length > 0 ? obj.driver : null,
+    rerunIndex: typeof obj.rerun_index === 'number' ? obj.rerun_index : null,
+    criticsSelected: Array.isArray(obj.critics_selected) ? obj.critics_selected.filter((c) => typeof c === 'string') : [],
+    criticStatus,
+    artifacts: (obj.artifacts ?? [])
+      .map((a) => (typeof a === 'string' ? a : typeof a?.path === 'string' ? a.path : null))
+      .filter((p): p is string => p !== null),
+  };
+}
+
+/**
+ * addresses 期望集（对齐 gate.ts expectedReviewDocs 的只读派生，非校验复制）：
+ * 有效侧 = critics_selected 里 critics.<c>.status ∈ {ok, parse_fallback}；
+ * 条目筛选 = 相对路径位于 `<主题>/<阶段>/` 根（排除 `_meta/` 子目录）、文件名不是裁决件
+ * （`-(rN-)?(revised|response)-<后缀>.md`）、后缀属于有效侧 agent id。
+ */
+export function expectedAddresses(meta: RunMetaInfo, topic: string, stage: string): string[] {
+  const selected = meta.criticsSelected.length > 0 ? meta.criticsSelected : [];
+  const effective = new Set(selected.filter((c) => {
+    const s = meta.criticStatus[c];
+    return s === 'ok' || s === 'parse_fallback';
+  }));
+  const stageRel = `${topic}/${stage}`;
+  const out: string[] = [];
+  for (const a of meta.artifacts) {
+    const rel = a.split(path.sep).join('/');
+    const dir = rel.slice(0, rel.lastIndexOf('/'));
+    if (dir !== stageRel) continue;
+    const base = rel.slice(rel.lastIndexOf('/') + 1);
+    if (!base.endsWith('.md')) continue;
+    // 裁决件：`-revised-` / `-response-`（可带 -rN 抬升）不进 addresses
+    if (/-(?:r\d+-)?(?:revised|response)-[^/]+\.md$/.test(base)) continue;
+    // 后缀（最后一个 `-` 段去掉 .md）须属有效侧
+    const m = /^[\s\S]*-([A-Za-z0-9]+)\.md$/.exec(base);
+    if (!m || !effective.has(m[1]!)) continue;
+    if (!out.includes(base)) out.push(base);
+  }
+  return out;
+}
+
+/** 解析 `.fallback-items.md`（每行 `- <前缀>-F<n>: …`）；文件缺失/坏行返回空集 */
+export async function readFallbackIds(fs: RunMetaFs, metaDir: string, critic: string, runId: string): Promise<string[]> {
+  let raw: string;
+  try {
+    raw = await fs.readFile(path.join(metaDir, `review-${critic}-${runId}.fallback-items.md`));
+  } catch {
+    return [];
+  }
+  const ids: string[] = [];
+  for (const line of raw.split('\n')) {
+    const m = /^\s*-\s+([A-Z][A-Z0-9]{1,15}-(?:r\d+-)?F\d+)\s*:/.exec(line);
+    if (m && !ids.includes(m[1]!)) ids.push(m[1]!);
+  }
+  return ids;
+}
+
+/** 全部有效侧的 fallback 期望编号并集 */
+export async function allFallbackIds(fs: RunMetaFs, meta: RunMetaInfo, metaDir: string): Promise<string[]> {
+  const out: string[] = [];
+  for (const c of meta.criticsSelected) {
+    if (meta.criticStatus[c] === 'ok') continue; // 非 fallback 侧无清单
+    for (const id of await readFallbackIds(fs, metaDir, c, meta.runId)) {
+      if (!out.includes(id)) out.push(id);
+    }
+  }
+  return out;
+}
+
+/** task.json 的 drivers 段（受限 fallback 源：阶段认领声明，非逐 run 身份） */
+export async function readClaimedDriver(fs: RunMetaFs, reviewsRoot: string, topic: string, stage: string): Promise<string | null> {
+  let raw: string;
+  try {
+    raw = await fs.readFile(path.join(reviewsRoot, topic, 'task.json'));
+  } catch {
+    return null;
+  }
+  try {
+    const obj = JSON.parse(raw) as { drivers?: Record<string, { driver?: string }> };
+    const d = obj.drivers?.[stage]?.driver;
+    return typeof d === 'string' && d.length > 0 ? d : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * 当轮 Driver id 定位链（计划 r2 §D6）：run 元数据 → 阶段认领声明。
+ * 闸门项 driver **不进链**（state.ts 只在 awaiting_approval 迁移时写入，raf 阶段沿用旧值）。
+ * 返回带来源标注，供 UI 展示核对；两级都缺返回 null（调用方禁用草稿生成，不猜）。
+ */
+export async function resolveDriverId(
+  fs: RunMetaFs,
+  meta: RunMetaInfo | null,
+  reviewsRoot: string,
+  topic: string,
+  stage: string,
+): Promise<{ driver: string; source: 'run-meta' | 'stage-claim' } | null> {
+  if (meta?.driver) return { driver: meta.driver, source: 'run-meta' };
+  const claimed = await readClaimedDriver(fs, reviewsRoot, topic, stage);
+  if (claimed) return { driver: claimed, source: 'stage-claim' };
+  return null;
+}
diff --git a/extension/src/guard/saveGuard.ts b/extension/src/guard/saveGuard.ts
new file mode 100644
index 00000000..c88c4df0
--- /dev/null
+++ b/extension/src/guard/saveGuard.ts
@@ -0,0 +1,229 @@
+/**
+ * 保存防护与三色灯（FR-10，计划 r2 §D4；服务级，onStartupFinished 激活即装配）。
+ *
+ * ## API 边界（决定一切形态，交付说明如实声明）
+ * VS Code **没有**取消保存的 API；`onWillSaveTextDocument` 的 waitUntil 共享 1.5 秒
+ * 预算、超时保存照常继续、监听器三次失常被停用（@types/vscode index.d.ts:14533-14546）。
+ * 因此本插件承诺「事前预警 + 事中警示 + 事后一键恢复」，**不承诺阻止写盘**：
+ *
+ * 1. 编辑期预警（事前）：锁态≠绿（含 unreadable）且业务文件被修改时弹 modal（每文档
+ *    会话内一次，去重）——不在保存事件内，无时间预算约束；
+ * 2. 保存瞬间警示（事中）：will-save 命中违规保存时，**同步经 e.waitUntil 挂起保存**
+ *    直到磁盘快照读取完成（代码审 r1 CLAUDE-01/AGY-02/CODEX-01：快照必须先于落盘，
+ *    否则基线失真或恢复提示不出现）；快照为原始字节 Buffer + 原 mode（CODEX-02/03：
+ *    不经 UTF-8 文本往返、恢复不清执行位）；随后发非阻塞 toast；
+ * 3. 保存后一键恢复（事后）：保存完成即弹带「恢复」按钮的警告；点击 → 按字节原子写回
+ *    + 恢复原 mode + `workbench.action.files.revert` 重载盘上内容（AGY-03：revert 清
+ *    除 dirty，autoSave 下不会死循环保存；不用 applyEdit——它会置 dirty）。
+ *    快照读取失败/超时则放弃该次恢复（不发布错误基线，CODEX-01）。
+ *
+ * reason 分流（AGY-01）：Manual/AfterDelay/FocusOut 一律走 2+3 段（自动保存不轰炸）；
+ * modal 只出现在第 1 段。
+ *
+ * 放行规则（顺序短路）：scheme≠file；不在工作区根下；relPath 以 `.reviews/`、
+ * `.trivium/`（编排器写入区）、`.vscode/`（VS Code 设置文件——任务书硬约束；其下
+ * 受跟踪文件的改动仍会被编排器快照捕获，属用户显式自担）开头；灯=绿。
+ */
+import * as vscode from 'vscode';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { lampOf, guardLevelOf, type LampState } from '../approval/lampModel';
+import type { StateWatch } from '../monitor/stateWatch';
+
+interface Snapshot0 {
+  /** 保存前磁盘内容的原始字节（CODEX-02：非 UTF-8 文件不做文本往返） */
+  bytes: Buffer;
+  /** 保存前文件 mode（CODEX-03：恢复不清执行位） */
+  mode: number | null;
+  savedAt: number;
+}
+
+export class SaveGuard implements vscode.Disposable {
+  private readonly lamp: vscode.StatusBarItem;
+  private readonly disposables: vscode.Disposable[] = [];
+  /** 编辑期预警去重（文档 uri → 已警示） */
+  private readonly warnedDocs = new Set<string>();
+  /** 待恢复快照（uri → 保存前磁盘内容；每文档只留最近一次） */
+  private readonly snapshots = new Map<string, Snapshot0>();
+  private current: LampState = lampOf({ activeStates: [], unreadable: false });
+  private lastSnapshotRaw = { activeStates: [] as string[], unreadable: false };
+  private disposed = false;
+  /** 测试可观测面 */
+  toastLog: string[] = [];
+  /** 测试可观测面：waitUntil 是否被调用（CLAUDE-01 竞态回归） */
+  waitUntilCalls = 0;
+
+  constructor(
+    private readonly workspaceRoot: string,
+    stateWatch: StateWatch,
+    private readonly enabled: () => boolean = () => vscode.workspace.getConfiguration('trivium.guard').get<boolean>('saveGuard', true),
+    /** 测试注入：静默 UI（不弹 modal/toast，只记 toastLog）——集成测试避免无头环境挂起 */
+    private readonly silentUi = false,
+  ) {
+    this.lamp = vscode.window.createStatusBarItem(vscode.StatusBarAlignment.Left, 100);
+    this.lamp.command = 'trivium.openCockpit';
+    this.disposables.push(
+      this.lamp,
+      stateWatch.onChange((snap) => {
+        this.lastSnapshotRaw = {
+          activeStates: snap.active.map((g) => g.state),
+          unreadable: snap.unreadable,
+        };
+        this.updateLamp();
+      }),
+      vscode.workspace.onDidChangeTextDocument((e) => this.onDocChanged(e.document)),
+      vscode.workspace.onWillSaveTextDocument((e) => {
+        // CLAUDE-01/AGY-02/CODEX-01：同步注册 waitUntil——快照读取先于 VS Code 落盘；
+        // 读取失败/超时由 onWillSave 内部消化（放弃恢复，不阻断保存）
+        this.waitUntilCalls += 1;
+        e.waitUntil(this.onWillSave(e.document));
+      }),
+      vscode.workspace.onDidSaveTextDocument((doc) => void this.onDidSave(doc)),
+    );
+    this.updateLamp();
+  }
+
+  /** 当前灯态（测试可观测面） */
+  get lampState(): LampState {
+    return this.current;
+  }
+
+  /** 待恢复快照数（测试可观测面） */
+  get pendingSnapshots(): number {
+    return this.snapshots.size;
+  }
+
+  /** 保存目标是否受防护（测试入口；对 closed 文档同样可判） */
+  isProtected(uri: vscode.Uri): boolean {
+    if (!this.enabled()) return false;
+    if (guardLevelOf(this.current.color) === 'free') return false;
+    if (uri.scheme !== 'file') return false;
+    const rel = path.relative(this.workspaceRoot, uri.fsPath);
+    if (!rel || rel.startsWith('..') || path.isAbsolute(rel)) return false; // 工作区外
+    const norm = rel.split(path.sep).join('/');
+    if (norm.startsWith('.reviews/') || norm.startsWith('.trivium/') || norm.startsWith('.vscode/')) return false;
+    return true;
+  }
+
+  private updateLamp(): void {
+    this.current = lampOf(this.lastSnapshotRaw);
+    this.lamp.text = this.current.label;
+    this.lamp.tooltip = this.current.tooltip;
+    this.lamp.backgroundColor =
+      this.current.color === 'red'
+        ? new vscode.ThemeColor('statusBarItem.errorBackground')
+        : this.current.color === 'yellow'
+          ? new vscode.ThemeColor('statusBarItem.warningBackground')
+          : undefined;
+    this.lamp.show();
+  }
+
+  // ── 第 1 段：编辑期预警（modal；每文档一次） ─────────────────────────────
+
+  private onDocChanged(doc: vscode.TextDocument): void {
+    if (doc.uri.scheme !== 'file') return;
+    if (this.warnedDocs.has(doc.uri.toString())) return;
+    if (!this.isProtected(doc.uri)) return;
+    this.warnedDocs.add(doc.uri.toString());
+    const rel = path.relative(this.workspaceRoot, doc.uri.fsPath);
+    const msg = `编辑期预警：审查期间修改业务文件 ${rel}（保存时可能造成快照漂移、整轮作废）。`;
+    this.toastLog.push(msg);
+    if (this.silentUi) return;
+    void vscode.window
+      .showWarningMessage(
+        `审查期间修改业务文件 ${rel}：保存时可能造成快照漂移、整轮作废（状态栏红灯/黄灯提示中）。`,
+        { modal: true, detail: '如需修改请等本轮审查结束；关闭本提示不会解除警示，保存时仍会有警告与一键恢复。' },
+      )
+      .then(() => undefined);
+  }
+
+  // ── 第 2 段：保存瞬间警示（经 waitUntil 挂起保存直到快照完成） ───────────
+
+  private async onWillSave(doc: vscode.TextDocument): Promise<void> {
+    if (!this.isProtected(doc.uri)) return;
+    try {
+      // 此刻盘上即保存前内容（保存被 waitUntil 挂起）；字节快照 + mode 一并留存
+      const [bytes, st] = await Promise.all([fs.readFile(doc.uri.fsPath), fs.stat(doc.uri.fsPath)]);
+      if (this.disposed) return;
+      this.snapshots.set(doc.uri.toString(), { bytes, mode: st.mode, savedAt: Date.now() });
+    } catch {
+      // 新文件等读不出：无基线可恢复——放弃恢复但保留警示（CODEX-01：不发布错误基线）
+      this.snapshots.delete(doc.uri.toString());
+    }
+    if (this.disposed) return;
+    const rel = path.relative(this.workspaceRoot, doc.uri.fsPath);
+    const msg = `⚠ 已保存到${this.current.color === 'red' ? '审查中' : '闸门期'}的业务文件：${rel}（可一键恢复到保存前）`;
+    this.toastLog.push(msg);
+    if (!this.silentUi) void vscode.window.showWarningMessage(msg);
+  }
+
+  // ── 第 3 段：保存后一键恢复（显式点击；字节写回 + revert） ────────────────
+
+  private async onDidSave(doc: vscode.TextDocument): Promise<void> {
+    const snap = this.snapshots.get(doc.uri.toString());
+    if (!snap) return;
+    if (this.silentUi) {
+      // 测试形态：不弹选择框，等 restoreForTest 显式触发恢复
+      return;
+    }
+    const rel = path.relative(this.workspaceRoot, doc.uri.fsPath);
+    const pick = await vscode.window.showWarningMessage(
+      `业务文件 ${rel} 已在${this.current.color === 'red' ? '审查中' : '闸门期'}被保存（可能造成快照漂移、整轮作废）。`,
+      { modal: false },
+      '恢复到保存前',
+    );
+    if (this.disposed) return;
+    if (pick === '恢复到保存前') {
+      await this.restore(doc, snap);
+    } else {
+      // 用户显式保留：清快照（下次保存再记），toast 已提示后果
+      this.snapshots.delete(doc.uri.toString());
+      const keep = `已保留 ${rel} 的保存（用户选择）：漂移后果由编排器跑后复算判定。`;
+      this.toastLog.push(keep);
+      void vscode.window.showInformationMessage(keep);
+    }
+  }
+
+  /** 测试入口：直接执行恢复（绕过弹窗） */
+  async restoreForTest(doc: vscode.TextDocument): Promise<boolean> {
+    const snap = this.snapshots.get(doc.uri.toString());
+    if (!snap) return false;
+    await this.restore(doc, snap);
+    return true;
+  }
+
+  private async restore(doc: vscode.TextDocument, snap: Snapshot0): Promise<void> {
+    const abs = doc.uri.fsPath;
+    // 按字节原子写回（tmp+rename 同目录；不做文本编码往返——CODEX-02）
+    const tmp = `${abs}.trivium-restore-${Date.now()}`;
+    await fs.writeFile(tmp, snap.bytes);
+    if (snap.mode !== null) {
+      try {
+        await fs.chmod(tmp, snap.mode); // CODEX-03：恢复执行位等原权限
+      } catch {
+        /* chmod 失败不阻断写回（如实保留默认权限） */
+      }
+    }
+    await fs.rename(tmp, abs);
+    this.snapshots.delete(doc.uri.toString());
+    // AGY-03：revert 重载盘上内容并清除 dirty——不用 applyEdit（它会置 dirty，
+    // autoSave 下引发死循环保存）。revert 作用于活动编辑器：先把该文档带上前台。
+    try {
+      await vscode.window.showTextDocument(doc.uri, { preview: true, preserveFocus: false });
+      await vscode.commands.executeCommand('workbench.action.files.revert');
+    } catch {
+      /* revert 不适用（文档已关闭等）：磁盘已恢复，编辑器按 VS Code 自身机制重载 */
+    }
+    const done = `已恢复 ${path.relative(this.workspaceRoot, abs)} 到保存前内容（按字节原样，含原权限）。`;
+    this.toastLog.push(done);
+    if (!this.silentUi) void vscode.window.showInformationMessage(done);
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    for (const d of this.disposables) d.dispose();
+    this.disposables.length = 0;
+    this.snapshots.clear();
+    this.warnedDocs.clear();
+  }
+}
diff --git a/extension/src/presets/presetModel.ts b/extension/src/presets/presetModel.ts
new file mode 100644
index 00000000..ef5e5922
--- /dev/null
+++ b/extension/src/presets/presetModel.ts
@@ -0,0 +1,121 @@
+/**
+ * 装配预设模型（FR-11，计划 r2 §D5；纯函数）。
+ *
+ * 分层（AGY-06）：只存装配参数（任务书 FR-11 原文的「Driver/审查者/入口/轮次/高级项」）；
+ * **topic/body 不进 preset**（会话瞬态，加载不得冲刷用户正在起草的输入）；
+ * ctxPaths 属高级项但工作区绑定——跨工作区加载时由调用方校验存在性并标注失效。
+ * 存储双作用域：globalState（用户级）/ workspaceState（工作区级 memento，不落
+ * `.vscode/settings.json`——那会进编排器审查快照，与保存防护自相矛盾，CLAUDE-03）。
+ */
+export interface LaunchPreset {
+  /** 模型版本（将来演进留迁移点） */
+  v: 1;
+  name: string;
+  scope: 'global' | 'workspace';
+  createdAt: string;
+  updatedAt: string;
+  driver: string;
+  critics: string[];
+  /** 入口 A/B/C/D */
+  entry: string;
+  maxRounds?: number;
+  profile?: string;
+  extraFlags: string;
+  ctxPaths?: string[];
+}
+
+/** 未知字段剔除 + 类型防御；坏条目返回 null（读取容错，不抛错） */
+export function sanitizePreset(raw: unknown, scope: LaunchPreset['scope']): LaunchPreset | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const r = raw as Record<string, unknown>;
+  if (typeof r['name'] !== 'string' || r['name'].trim() === '') return null;
+  if (typeof r['driver'] !== 'string' || r['driver'] === '') return null;
+  if (!Array.isArray(r['critics']) || !r['critics'].every((c) => typeof c === 'string')) return null;
+  if (typeof r['entry'] !== 'string' || !['A', 'B', 'C', 'D'].includes(r['entry'])) return null;
+  const out: LaunchPreset = {
+    v: 1,
+    name: r['name'].trim(),
+    scope,
+    createdAt: typeof r['createdAt'] === 'string' ? r['createdAt'] : new Date().toISOString(),
+    updatedAt: typeof r['updatedAt'] === 'string' ? r['updatedAt'] : new Date().toISOString(),
+    driver: r['driver'],
+    critics: r['critics'] as string[],
+    entry: r['entry'],
+    extraFlags: typeof r['extraFlags'] === 'string' ? r['extraFlags'] : '',
+  };
+  if (typeof r['maxRounds'] === 'number' && Number.isFinite(r['maxRounds'])) out.maxRounds = r['maxRounds'];
+  if (typeof r['profile'] === 'string' && r['profile'] !== '') out.profile = r['profile'];
+  if (Array.isArray(r['ctxPaths']) && r['ctxPaths'].every((p) => typeof p === 'string')) out.ctxPaths = r['ctxPaths'] as string[];
+  return out;
+}
+
+/** 装配参数（cockpit FormState 的子集）→ preset */
+export function presetFromAssembly(name: string, scope: LaunchPreset['scope'], a: {
+  driver: string;
+  critics: string[];
+  entry: string;
+  maxRounds?: number;
+  profile?: string;
+  extraFlags: string;
+  ctxPaths?: string[];
+  now?: Date;
+}): LaunchPreset {
+  const now = (a.now ?? new Date()).toISOString();
+  return {
+    v: 1,
+    name: name.trim(),
+    scope,
+    createdAt: now,
+    updatedAt: now,
+    driver: a.driver,
+    critics: [...a.critics],
+    entry: a.entry,
+    maxRounds: a.maxRounds,
+    profile: a.profile,
+    extraFlags: a.extraFlags,
+    ctxPaths: a.ctxPaths ? [...a.ctxPaths] : undefined,
+  };
+}
+
+/**
+ * preset → 表单回填字段（装配参数集；**不含** topic/body——UI 只把本对象写进对应
+ * 表单控件，正文与主题输入框保持用户现状）。
+ */
+export interface AssemblyFields {
+  driver: string;
+  critics: string[];
+  entry: string;
+  maxRounds?: number;
+  profile?: string;
+  extraFlags: string;
+  ctxPaths: string[];
+}
+
+export function assemblyOf(p: LaunchPreset): AssemblyFields {
+  return {
+    driver: p.driver,
+    critics: [...p.critics],
+    entry: p.entry,
+    maxRounds: p.maxRounds,
+    profile: p.profile,
+    extraFlags: p.extraFlags,
+    ctxPaths: p.ctxPaths ? [...p.ctxPaths] : [],
+  };
+}
+
+/** 跨工作区加载时校验 ctxPaths 存在性（exists 注入）；失效项标注跳过 */
+export async function filterStaleCtxPaths(
+  exists: (p: string) => Promise<boolean>,
+  paths: string[],
+  workspaceRoot: string,
+): Promise<{ keep: string[]; stale: string[] }> {
+  const keep: string[] = [];
+  const stale: string[] = [];
+  for (const p of paths) {
+    // 相对路径按工作区根解释；绝对路径直接判定
+    const abs = p.startsWith('/') ? p : `${workspaceRoot}/${p}`;
+    if (await exists(abs)) keep.push(p);
+    else stale.push(p);
+  }
+  return { keep, stale };
+}
diff --git a/extension/src/presets/presetStore.ts b/extension/src/presets/presetStore.ts
new file mode 100644
index 00000000..5cac8109
--- /dev/null
+++ b/extension/src/presets/presetStore.ts
@@ -0,0 +1,82 @@
+/**
+ * 预设存储（FR-11，计划 r2 §D5；注入 storage，可单测）。
+ *
+ * 双作用域：workspace（`context.workspaceState`，工作区级 memento——不写
+ * `.vscode/settings.json`，避免落入编排器审查快照）与 global（`context.globalState`）。
+ * 读取合并展示：同名时 workspace 优先并标注来源；坏条目剔除并计数（不阻断）。
+ */
+import { sanitizePreset, type LaunchPreset } from './presetModel';
+
+/** VS Code memento 的最小注入面（globalState/workspaceState 同形；update 返回 Thenable） */
+export interface KVStore {
+  get<T>(key: string): Promise<T | undefined> | T | undefined;
+  update(key: string, value: unknown): Promise<void> | Thenable<void>;
+}
+
+const KEY = 'trivium.presets';
+const SOFT_LIMIT = 50;
+
+export class PresetStore {
+  constructor(
+    private readonly global: KVStore,
+    private readonly workspace: KVStore,
+  ) {}
+
+  private async readScope(store: KVStore, scope: LaunchPreset['scope']): Promise<{ presets: LaunchPreset[]; dropped: number }> {
+    const raw = await store.get<unknown[]>(KEY);
+    if (!Array.isArray(raw)) return { presets: [], dropped: 0 };
+    const presets: LaunchPreset[] = [];
+    let dropped = 0;
+    for (const item of raw) {
+      const p = sanitizePreset(item, scope);
+      if (p) presets.push(p);
+      else dropped += 1;
+    }
+    return { presets, dropped };
+  }
+
+  private async writeScope(store: KVStore, presets: LaunchPreset[]): Promise<void> {
+    await store.update(KEY, presets);
+  }
+
+  /** 两作用域合并列表（workspace 同名优先，标注 source 已在 scope 字段） */
+  async list(): Promise<LaunchPreset[]> {
+    const g = await this.readScope(this.global, 'global');
+    const w = await this.readScope(this.workspace, 'workspace');
+    const map = new Map<string, LaunchPreset>();
+    for (const p of g.presets) map.set(p.name, p);
+    for (const p of w.presets) map.set(p.name, p); // workspace 覆盖同名 global
+    return [...map.values()].sort((a, b) => a.name.localeCompare(b.name));
+  }
+
+  /** 保存/更新（按 name+scope 去重替换）；超软上限返回 false 并带提示 */
+  async save(preset: LaunchPreset): Promise<{ ok: boolean; hint?: string }> {
+    const store = preset.scope === 'global' ? this.global : this.workspace;
+    const { presets } = await this.readScope(store, preset.scope);
+    const idx = presets.findIndex((p) => p.name === preset.name);
+    if (idx >= 0) {
+      presets[idx] = { ...preset, createdAt: presets[idx]!.createdAt };
+    } else {
+      if (presets.length >= SOFT_LIMIT) {
+        return { ok: false, hint: `该作用域预设已达 ${SOFT_LIMIT} 条软上限：请先删除不用的预设。` };
+      }
+      presets.push(preset);
+    }
+    await this.writeScope(store, presets);
+    return { ok: true };
+  }
+
+  async remove(name: string, scope: LaunchPreset['scope']): Promise<boolean> {
+    const store = scope === 'global' ? this.global : this.workspace;
+    const { presets } = await this.readScope(store, scope);
+    const next = presets.filter((p) => p.name !== name);
+    if (next.length === presets.length) return false;
+    await this.writeScope(store, next);
+    return true;
+  }
+
+  async get(name: string, scope: LaunchPreset['scope']): Promise<LaunchPreset | null> {
+    const { presets } = await this.readScope(scope === 'global' ? this.global : this.workspace, scope);
+    return presets.find((p) => p.name === name) ?? null;
+  }
+}
