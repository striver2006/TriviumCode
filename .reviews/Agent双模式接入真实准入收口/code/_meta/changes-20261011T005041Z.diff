+let stdout = '', stderr = '';
+child.stdout.on('data', b => { stdout += b; }); child.stderr.on('data', b => { stderr += b; });
+child.once('error', e => { stderr += `launcher:${e.code ?? 'unknown'}\n`; });
+const [code, signal] = await new Promise(resolve => child.once('close', (...result) => resolve(result)));
