+test('quiet-v8本地launcher自身错误也脱敏，缺证据child0/2/64边界不变', async () => {
+  const w = await world();
+  const { scanSecrets } = await import('../../src/trivium/secrets.js');
+  // 只替换独立夹具内的launcher；合成值经断言检查，测试日志不输出原值。
+  const synthetic = 'sk-' + 'Z'.repeat(48);
