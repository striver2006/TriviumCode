+  `已连续 ${n} 次阻断收工仍未完成裁决，本次放行以避免死循环。\n` +
+  `  ${label} 的裁决仍未齐备，请手工处理。`;
+const OLD_COMMIT = (list: string): string =>
+  `以下阶段的审查意见尚未逐条裁决，提交被拦下：${list}\n` +
+  '  请先补齐裁决件并通过 `trivium gate --stage <阶段> --check`。\n' +
+  '  如需关闭该拦截，可在 .trivium/config.yaml 设 gate.block_commit: false。';
