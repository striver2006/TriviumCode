+{
+  "targets": [
+    "src/trivium/review.ts",
+    "src/trivium/state.ts"
+  ],
+  "suites": [
+    "dist/test/test/unit/state.test.js",
+    "dist/test/test/integration/no-artifacts.test.js",
+    "dist/test/test/integration/code-stage.test.js",
+    "dist/test/test/integration/gate-loop.test.js"
+  ],
+  "cases": [
+    {
+      "id": "M1",
+      "desc": "置闸门挪回 registerRun 之后（原位置）⇒ B1（被拦时已写下 brief、骨架、登记、运行目录）",
