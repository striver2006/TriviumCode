+test('探针臂：只读参数透传到 argv，且宿主的 ZCODE_API_KEY / ZCODE_BASE_URL 进不了子进程（AGY-02 / 子项 03）', async () => {
+  const L = await legacyLayout();
+  const log = path.join(L.root, 'calls.jsonl');
+  process.env['FAKE_ZCODE_LOG'] = log;
