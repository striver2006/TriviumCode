+): { qualified: string; providerKey: string; modelId: string } | { qualified: null; reason: string } {
+  const providers = cfg.provider ?? {};
+  const cut = model.lastIndexOf('/');
+  if (cut >= 0) {
+    const providerKey = model.slice(0, cut).trim();
+    const modelId = model.slice(cut + 1).trim();
+    if (!providerKey || !modelId) return { qualified: null, reason: `模型 ${JSON.stringify(model)} 切不出两个非空段` };
+    const models = providers[providerKey]?.models ?? {};
+    if (!(providerKey in providers)) {
+      return {
+        qualified: null,
+        reason: `cli/config.json 里没有 provider ${JSON.stringify(providerKey)}（有：${Object.keys(providers).join(', ') || '无'}）`,
+      };
+    }
+    if (!(modelId in models)) {
+      return {
+        qualified: null,
+        reason: `provider ${JSON.stringify(providerKey)} 的 models 里没有 ${JSON.stringify(modelId)}（有：${Object.keys(models).join(', ') || '无'}）`,
+      };
+    }
+    return { qualified: `${providerKey}/${modelId}`, providerKey, modelId };
+  }
+  const owners = Object.entries(providers)
+    .filter(([, p]) => p?.models !== undefined && model in (p.models ?? {}))
+    .map(([k]) => k);
+  if (owners.length === 1) return { qualified: `${owners[0]}/${model}`, providerKey: owners[0]!, modelId: model };
+  return {
+    qualified: null,
+    reason:
+      owners.length === 0
+        ? `cli/config.json 里没有任何 provider 提供模型 ${JSON.stringify(model)}`
+        : `模型 ${JSON.stringify(model)} 在多个 provider 下都有（${owners.join(', ')}），请写成 <provider>/<model>`,
+  };
