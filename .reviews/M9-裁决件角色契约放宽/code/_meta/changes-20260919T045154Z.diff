+        if (!parsed || parsed.kind === null) continue; // 只收裁决件（revised / response）
+        scanned++;
+        const md = await fs.readFile(path.join(dir, f), 'utf8');
+        const fm = parseDisposition(md).frontMatter;
+        if (!fm) {
+          bad.push(`${topic}/${stage}/${f}：front-matter 解析不出`);
+          continue;
+        }
+        const problems = validateDispositionFrontMatter(fm);
+        if (problems.length > 0) bad.push(`${topic}/${stage}/${f}：${problems.join('；')}`);
+        if (fm.role !== parsed.role) {
+          bad.push(`${topic}/${stage}/${f}：文件名后缀是 ${parsed.role}、front-matter 的 role 是 ${String(fm.role)}`);
+        }
+      }
+    }
+  }
+
+  assert.ok(scanned > 0, `.reviews 下一份裁决件都没扫到（${topics.length} 个主题）——本条失去语料`);
+  assert.deepEqual(
+    bad, [],
+    '下列历史裁决件按当前契约不再合法。\n' +
+      '  归档是不可变工件：契约演进不得让老主题的闸门读不回自己的留痕。\n' +
+      '  若是身份校验判的，先确认注册表里是不是摘掉/改名了某一家；\n' +
+      '  若是后缀与 role 不符，那份件的作者身份本身就是矛盾的，要查它是怎么落盘的。\n' +
+      `  ${bad.join('\n  ')}`,
+  );
+});
diff --git a/test/contract/disposition-role-assets.test.ts b/test/contract/disposition-role-assets.test.ts
new file mode 100644
index 0000000..79f1198
--- /dev/null
+++ b/test/contract/disposition-role-assets.test.ts
@@ -0,0 +1,226 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { REPO_ROOT } from '../helpers/fixture.js';
+import { DEFAULT_DRIVER } from '../../src/trivium/agents/registry.js';
+
+/**
+ * 资产契约：**指挥 Driver 产出裁决件的那些祈使句，不得把角色名写死。**
+ *
+ * ## 这条判据在防什么
+ *
+ * `skills/` 下的 SKILL.md 与模板是**祈使句**——它们在指挥 Driver 用什么文件名、
+ * 往 `role` 里填什么。EV-66 放宽 schema 之后，非缺省 Driver 终于写得出合法裁决件了，
+ * 但只要这些文本还写着 `-revised-claude.md` / `role: claude`，它就会**照着旧文本写**，
+ * 产出一份闸门定位不到的件（`missing_disposition`）。
+ *
+ * 这个漏的症状是**无声的**：改漏一处，全量测试照样绿——因为没有任何机器判据在看资产面
+ * （`registry-parity` 的论域只有 `src/trivium`，其注释也自认「散文/文案形态不覆盖」）。
+ * 只有真换一个 Driver 跑一遍才会撞上，而那要到 M9 第 6 步。
+ *
+ * ## 这条判据自己会不会是假证明
+ *
+ * 会——如果照着一份**人工清单**建论域。计划原稿里那份「实测 6 处」的清单，实测是
+ * 9 个文件 17 行；按它建判据，判据出生就带着同一个漏（计划双审 CODEX-F01 第 3/4 条、
+ * GLM-02、AGY-03 三侧共同指出）。本仓已经有一条活着的同形假证明可对照：
+ * `promise-landing.test.ts` 靠文件名字面 `-response-claude.md` 找裁决件，
+ * 非缺省 Driver 的产出一律扫不到，而它明写不断言命中数，于是论域清空、用例照常全绿。
+ *
+ * 所以这条判据按四个维度写，缺一条就会退化成假证明：
+ *
+ *   1. **论域自动扩展**：`skills/` 下全部 `.md` / `.template` 递归收，不用文件清单。
+ *      新加一份 SKILL.md 自动进论域。
+ *   2. **字面从注册表派生**：扫的是 `DEFAULT_DRIVER`，不是硬编码的 `'claude'`——
+ *      否则这个扫描器自己就成了第二事实源（纪律 7 要治的正是这个）。
+ *   3. **命中下限**：论域文件数有下限断言。发现式写错、目录改名、glob 失配，
+ *      都会让扫描零命中而用例照常绿（本仓记过四次这个形状）。
+ *   4. **正向 + 变异**：不只查「旧字面不复发」，还查「新指引确实在」（正向），
+ *      并且自测「注入一条违例时判据真的会报」（变异）。
+ *
+ * ## 它证不到什么（如实标注，别当验收替代品）
+ *
+ * 只证「**旧的角色名字面不复发**」。证不到「新指引语义正确」——
+ * 把文本改成「填缺省 Driver 的角色名」这种语义错误，它一个字都抓不到，
+ * 因为那里面没有任何角色名字面。那一格只能靠第 6 步真换 Driver 跑一遍。
+ */
+
+const SKILLS_ROOT = path.join(REPO_ROOT, 'skills');
+
+/**
+ * 论域**不含原稿命名面**，这是有意的边界，不是漏。
+ *
+ * `plan.md.template:5`、`rca.md.template:5`、`templates/README.md:7,8`、
+ * `dual-run/SKILL.md:53` 这几处写的是裸后缀 `-claude.md`（计划/根因**原稿**），
+ * 下面的 pattern 只匹配 `-revised-` / `-response-` 与 `role:` 取值，天然收不到它们。
+ *
+ * 为什么不把判据扩到裸后缀：原稿不参与闸门的裁决件定位，非缺省 Driver 照抄不会
+ * 当场失败；那一面归 EV-55 族（命名与 Hook 保护集恒取缺省 Driver），触发时点是
+ * M9 第 6 步验收，已单独登记。扩过去只会让这条判据同时背上两件事，
+ * 还要配一份长豁免清单——而豁免清单本身就是论域漏空的主要来源。
+ *
+ * **第一版确实写了 6 条豁免覆盖那几处，当场被下方「豁免仍然被需要」的守卫判红**：
+ * 判据根本匹配不到它们，豁免无物可挡，是彻头彻尾的空头支票。
+ * 正确处置是删条目、把边界写在这里，而不是扩判据面把用例修绿。
+ *
+ * 清单当前为空。再加条目前先确认：那一行真的会被下面的 pattern 命中吗？
+ */
+const EXEMPTIONS: readonly { file: string; line: number; why: string }[] = [];
+
+/** 递归收 `skills/` 下的 Markdown 与模板，返回相对 `skills/` 的路径 */
+async function collectAssets(dir: string, base = ''): Promise<string[]> {
+  const out: string[] = [];
+  for (const e of await fs.readdir(dir, { withFileTypes: true })) {
+    const rel = base ? `${base}/${e.name}` : e.name;
+    if (e.isDirectory()) {
+      out.push(...(await collectAssets(path.join(dir, e.name), rel)));
+    } else if (e.name.endsWith('.md') || e.name.endsWith('.template')) {
+      out.push(rel);
+    }
+  }
+  return out;
+}
+
+/**
+ * 角色名写死的形态。**字面由注册表派生**，不写 `'claude'`。
+ *
+ * 三种形态分别对应三处会真的害到人的地方：裁决件后缀（闸门定位不到）、
+ * front-matter 取值（作者身份判红）、以及裸后缀（两者的来源）。
+ */
+function hardcodedRolePatterns(): RegExp[] {
+  const d = DEFAULT_DRIVER;
+  return [
+    new RegExp(`-(?:revised|response)-${d}\\.md`),
+    new RegExp(`role:\\s*${d}\\b`),
+  ];
+}
+
+const isExempt = (file: string, line: number): boolean =>
+  EXEMPTIONS.some((e) => e.file === file && e.line === line);
+
+test('资产契约：指挥产出裁决件的祈使句不得写死角色名', async () => {
+  const files = await collectAssets(SKILLS_ROOT);
+  const patterns = hardcodedRolePatterns();
+
+  /*
+   * 论域下限。数字取得比实际宽松——它防的是「glob 失配、目录改名、发现式写错」
+   * 这种论域塌成空集的形态，不是用来精确记账的（那会让每加一份文档都要改这里）。
+   */
+  assert.ok(
+    files.length >= 8,
+    `skills/ 下只收到 ${files.length} 份资产，论域塌了——本条判据会在空论域上全绿`,
+  );
+
+  const hits: string[] = [];
+  const usedExemptions = new Set<string>();
+  for (const rel of files) {
+    const src = await fs.readFile(path.join(SKILLS_ROOT, rel), 'utf8');
+    src.split('\n').forEach((text, i) => {
+      const lineNo = i + 1;
+      if (!patterns.some((p) => p.test(text))) return;
+      if (isExempt(rel, lineNo)) {
+        usedExemptions.add(`${rel}:${lineNo}`);
+        return;
+      }
+      hits.push(`${rel}:${lineNo}  ${text.trim()}`);
+    });
+  }
+
+  assert.deepEqual(
+    hits, [],
+    '下列资产面文本把裁决件的角色名写死了。\n' +
+      '  它们是**祈使句**——非缺省 Driver 会照着写，产出一份闸门定位不到的裁决件\n' +
+      '  （missing_disposition），而全量测试照样绿，只有真换 Driver 跑一遍才撞得上。\n' +
+      '  改法：后缀写 `<当轮 Driver>`，模板的 front-matter 用 {{ROLE}} 占位符。\n' +
+      '  确实不该改的（如原稿命名面），加进 EXEMPTIONS 并写明理由。\n' +
+      `  ${hits.join('\n  ')}`,
+  );
+
+  /*
+   * 豁免也要被守着：没被用到的豁免就是空头支票。
+   * 与 `registry-parity` 的「不得留过期条目」同一条纪律——少了它，
+   * EXEMPTIONS 可以随便变长而无人察觉，论域就此一点点漏空。
+   */
+  const stale = EXEMPTIONS.filter((e) => !usedExemptions.has(`${e.file}:${e.line}`))
+    .map((e) => `${e.file}:${e.line}`);
+  assert.deepEqual(
+    stale, [],
+    '这些豁免条目一次都没挡下命中——多半是那一行已经改掉或移位了，条目应当删除或改准：\n  ' +
+      stale.join('\n  '),
+  );
+
+  for (const e of EXEMPTIONS) {
+    assert.ok(e.why.trim().length >= 6, `豁免 ${e.file}:${e.line} 没写明理由`);
+  }
+});
+
+/*
+ * 正向那一半：只查「旧字面不复发」是不够的（计划双审 AGY-03）。
+ *
+ * 占位符写错、或者有人把整句指引删掉，消极扫描照样全绿——因为它只会看到
+ * 「没有 claude 字面」。所以还要查**新指引确实在**。
+ */
+test('资产契约：裁决件模板必须留出角色占位符，SKILL 必须指明当轮 Driver', async () => {
+  const mustHavePlaceholder = [
+    'dual-critic/templates/disposition.md.template',
+    'dual-critic/templates/response.md.template',
+  ];
+  for (const rel of mustHavePlaceholder) {
+    const src = await fs.readFile(path.join(SKILLS_ROOT, rel), 'utf8');
+    assert.match(
+      src, /^role:\s*\{\{ROLE\}\}\s*$/m,
+      `${rel} 的 front-matter 没有 role 占位符——Driver 照抄时不知道该填什么，` +
+        '而消极扫描看不出这件事（那里确实没有写死的角色名）',
+    );
+  }
+
+  const mustMentionDriver = [
+    'dual-review-plan/SKILL.md',
+    'dual-review-bug/SKILL.md',
+    'dual-review-code/SKILL.md',
+    'dual-run/SKILL.md',
+  ];
+  for (const rel of mustMentionDriver) {
+    const src = await fs.readFile(path.join(SKILLS_ROOT, rel), 'utf8');
+    assert.match(
+      src, /-(?:revised|response)-<当轮 Driver>\.md/,
+      `${rel} 没有告诉 Driver 裁决件的后缀取自己的 Agent id——` +
+        '删掉写死的 claude 只完成一半，指引缺位时 Driver 只能猜',
+    );
+  }
+});
+
+/*
+ * 变异自测：判据自己得会报。
+ *
+ * 这条用例存在的理由与 `registry-parity` 那个坏正则的教训同源——那次剥离器把
+ * 真硬编码吞了，于是一个本该受监控的文件脱离了监控，而用例全绿。
+ * 判据的正则写坏、或者匹配形态漂移，这里会当场现形。
+ */
+test('资产契约：判据自测——注入一条写死的角色名，必须被抓住', () => {
+  const patterns = hardcodedRolePatterns();
+  const violations = [
+    '依 `trivium.disposition.v1` 写出 `…-revised-claude.md`：',
+    'role: claude',
+    '| [`response.md.template`](./x) | `code/<日期>-<主题>-response-claude.md` 应答件 |',
+  ];
+  for (const v of violations) {
+    assert.ok(
+      patterns.some((p) => p.test(v)),
+      `判据漏掉了这条违例，它已经不是有效判据了：${v}`,
+    );
+  }
+
+  /* 反向：正确写法不得被误伤，否则判据会逼出一份膨胀的豁免清单 */
+  const legit = [
+    '依 `trivium.disposition.v1` 写出 `…-revised-<当轮 Driver>.md`：',
+    'role: {{ROLE}}',
+    '本目录的模板只对应 **Driver 自己产出**的工件，不含审查文档。',
+  ];
+  for (const l of legit) {
+    assert.ok(
+      !patterns.some((p) => p.test(l)),
+      `判据误伤了正确写法，会逼出多余的豁免：${l}`,
+    );
+  }
+});
