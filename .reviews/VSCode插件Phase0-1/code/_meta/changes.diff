diff --git a/extension/src/cli/commands.ts b/extension/src/cli/commands.ts
new file mode 100644
index 00000000..abfa49f5
--- /dev/null
+++ b/extension/src/cli/commands.ts
@@ -0,0 +1,147 @@
+/**
+ * CLI 子命令的类型化封装（仅覆盖插件需要的最小面）。
+ *
+ * 参数一律以数组透传给 wrapper（shell:false），不存在 shell 注入面。
+ */
+import type { TriviumCli } from './triviumCli';
+
+// ── 输出形状（只声明插件消费的字段；多余字段忽略） ──────────────────────────
+
+export interface TopicResolveOutput {
+  ok: boolean;
+  topic: string;
+  topic_inferred: boolean;
+  task_goal: string | null;
+  prompt_hint: string | null;
+  critics: string[];
+  max_rounds: { plan: number | null; code: number | null } | null;
+  notes: string[] | null;
+  driver: string;
+}
+
+export interface TopicClaimOutput {
+  ok: boolean;
+  topic: string;
+  stage: string;
+  driver: string;
+  outcome: string;
+}
+
+export interface PreflightOutput {
+  ok: boolean;
+  checks: { name: string; ok: boolean; warn: boolean; detail: string }[] | null;
+  warnings: { name: string; detail: string }[] | null;
+  exit_code: number;
+}
+
+export interface ReviewStatusOutput {
+  ok: boolean;
+  run_id: string;
+  /** 根上的 phase（CLI 实际把完整状态放嵌套 status 内，两处都读，防御式双取） */
+  phase: string | null;
+  message: string | null;
+  sides: Record<string, { state: string; model: string | null; attempt: number | null }> | null;
+  artifacts: string[] | null;
+  /** 嵌套 status 对象（--status 的权威形状：phase/artifacts/sides 在这里面） */
+  status: {
+    phase?: string;
+    artifacts?: string[];
+    sides?: Record<string, { state?: string; model?: string; attempt?: number }>;
+    message?: string;
+  } | null;
+}
+
+export interface DoctorOutput {
+  ok: boolean;
+  blockers: unknown[] | null;
+  warnings: unknown[] | null;
+}
+
+export interface VersionOutput {
+  version: string;
+}
+
+// ── 命令封装 ──────────────────────────────────────────────────────────────
+
+export class TriviumCommands {
+  constructor(private readonly cli: TriviumCli) {}
+
+  async version(): Promise<string | null> {
+    const r = await this.cli.run(['--version'], 15_000);
+    return r.code === 0 ? r.stdout.trim() : null;
+  }
+
+  /**
+   * topic resolve：正文是**单个 argv 项**（数组透传即天然安全，无需引号）。
+   * `--` 之后 CLI 按 argv 逐 token 解析。
+   */
+  async topicResolve(args: {
+    stage: string;
+    body: string;
+    flags: string[];
+  }): Promise<{ code: number | null; out: TopicResolveOutput | null; stderr: string; stdout: string }> {
+    const r = await this.cli.runJson<TopicResolveOutput>([
+      'topic',
+      'resolve',
+      '--stage',
+      args.stage,
+      '--json',
+      '--',
+      args.body,
+      ...args.flags,
+    ]);
+    return { code: r.code, out: r.json, stderr: r.stderr, stdout: r.stdout };
+  }
+
+  async topicClaim(topic: string, stage: string, driver: string): Promise<{ code: number | null; out: TopicClaimOutput | null; stderr: string }> {
+    const r = await this.cli.runJson<TopicClaimOutput>([
+      'topic',
+      'claim',
+      '--topic',
+      topic,
+      '--stage',
+      stage,
+      '--driver',
+      driver,
+      '--json',
+    ]);
+    return { code: r.code, out: r.json, stderr: r.stderr };
+  }
+
+  /**
+   * preflight：预检的是本轮实际入选的那几侧与**实际运行配置**（CLAUDE-03）。
+   * flags 传与 resolve 同源的运行旗标（--profile、--model-XX、--tier-XX、
+   * --effort-XX、--profile-XX、--native-XX）；--topic、--max-rounds、--context
+   * 不属预检面，不传。
+   */
+  async preflight(args: { stage: string; driver: string; critics: string[]; flags?: string[] }): Promise<{ code: number | null; out: PreflightOutput | null; stderr: string }> {
+    const r = await this.cli.runJson<PreflightOutput>([
+      'preflight',
+      '--stage',
+      args.stage,
+      '--driver',
+      args.driver,
+      '--critics',
+      args.critics.join(','),
+      ...(args.flags ?? []),
+      '--json',
+    ], 120_000);
+    return { code: r.code, out: r.json, stderr: r.stderr };
+  }
+
+  async reviewStatus(runId: string): Promise<{ code: number | null; out: ReviewStatusOutput | null }> {
+    const r = await this.cli.runJson<ReviewStatusOutput>(['review', '--status', runId, '--json']);
+    return { code: r.code, out: r.json };
+  }
+
+  async reviewCancel(runId: string): Promise<{ code: number | null; stdout: string; stderr: string }> {
+    const r = await this.cli.run(['review', '--cancel', runId], 120_000);
+    return { code: r.code, stdout: r.stdout, stderr: r.stderr };
+  }
+
+  /** 静态 doctor（--no-model-calls：不消耗厂商配额），用于健康面板手动刷新 */
+  async doctorStatic(): Promise<{ code: number | null; out: DoctorOutput | null }> {
+    const r = await this.cli.runJson<DoctorOutput>(['doctor', '--json', '--no-model-calls'], 300_000);
+    return { code: r.code, out: r.json };
+  }
+}
diff --git a/extension/src/cli/exitCodes.ts b/extension/src/cli/exitCodes.ts
new file mode 100644
index 00000000..01a65095
--- /dev/null
+++ b/extension/src/cli/exitCodes.ts
@@ -0,0 +1,40 @@
+/**
+ * CLI 退出码 → 中文语义（纯展示层，非判定逻辑）。
+ *
+ * 退出码协议是编排器的契约（src/trivium/exit-codes.ts），插件只消费不发明。
+ * 本表是展示映射，不是第二份判定：未知码原样显示。
+ */
+export interface ExitCodeMeaning {
+  /** 一句话定性 */
+  label: string;
+  /** 给用户的下一步建议 */
+  hint: string;
+}
+
+const TABLE: Record<number, ExitCodeMeaning> = {
+  0: { label: '成功', hint: '' },
+  1: { label: '一般失败', hint: '查看输出中的错误信息。' },
+  2: { label: '闸门阻断', hint: '流水线闸门判定未满足（如裁决不齐备）。' },
+  64: {
+    label: '参数错误',
+    hint: '多为缺提示语 / 模型 slug 非法 / 主题名非法，或正文里的 --xxx 被当旗标吞掉——请把正文写得不像旗标。',
+  },
+  65: {
+    label: '前置产物缺失',
+    hint: '找不到计划 / 根因材料 / 无代码变更。入口 B/C/D 需要先有被审对象。',
+  },
+  69: {
+    label: '环境或预检失败',
+    hint: 'CLI 不可调用、未认证、探针结论过期等——可在环境健康面板重新探测（doctor）。',
+  },
+  70: { label: '主题被锁', hint: '同主题已有运行持锁；可在监控区查看该运行或先中止。' },
+  73: { label: '运行仍在进行', hint: '这不是失败，等待或刷新状态即可。' },
+  75: { label: '超时或严格模式中止', hint: '单侧失败且为严格模式，整轮中止；工件保留。' },
+  76: { label: '探针部分完成', hint: 'doctor 到时限仍有段未探完；已探完的段照常落盘。' },
+};
+
+export function explainExitCode(code: number): ExitCodeMeaning {
+  return (
+    TABLE[code] ?? { label: `未知退出码 ${code}`, hint: '请把输出发给维护者排查。' }
+  );
+}
diff --git a/extension/src/cli/triviumCli.ts b/extension/src/cli/triviumCli.ts
new file mode 100644
index 00000000..c0624089
--- /dev/null
+++ b/extension/src/cli/triviumCli.ts
@@ -0,0 +1,112 @@
+/**
+ * wrapper 定位与执行。
+ *
+ * 一律经 `<工作区>/.trivium/bin/trivium` wrapper 调用编排器（wrapper 内嵌 node
+ * 绝对路径，GUI 进程安全；设计 §10.5 / 计划裁决 C1）。插件不解析 PATH、不读登录
+ * Shell 环境；子进程一律 `shell: false` + 绝对路径。
+ */
+import { spawn } from 'node:child_process';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+
+export interface CliResult {
+  /** 进程退出码；被超时杀死时为 null */
+  code: number | null;
+  stdout: string;
+  stderr: string;
+  /** 超时（毫秒），默认 60s */
+  timedOut: boolean;
+}
+
+export class TriviumCli {
+  constructor(private readonly workspaceRoot: string) {}
+
+  /** wrapper 绝对路径；不存在返回 null（调用方据此走「未 init 引导」） */
+  wrapperPath(): string {
+    return path.join(this.workspaceRoot, '.trivium', 'bin', 'trivium');
+  }
+
+  async wrapperExists(): Promise<boolean> {
+    try {
+      await fs.access(this.wrapperPath());
+      return true;
+    } catch {
+      return false;
+    }
+  }
+
+  /** 执行 wrapper 子命令。参数数组逐个透传，不做任何 shell 拼接。 */
+  async run(args: string[], timeoutMs = 60_000): Promise<CliResult> {
+    const wrapper = this.wrapperPath();
+    return new Promise<CliResult>((resolve) => {
+      const child = spawn(wrapper, args, {
+        shell: false,
+        cwd: this.workspaceRoot,
+        env: process.env,
+      });
+      // 分块收集 Buffer、收尾整体解码（CODEX-08）：逐块 toString 会把跨块的多字节
+      // 中文字符拆成替换符，topic 之类字段会悄悄变字
+      const outChunks: Buffer[] = [];
+      const errChunks: Buffer[] = [];
+      let timedOut = false;
+      const timer = setTimeout(() => {
+        timedOut = true;
+        child.kill('SIGTERM');
+        setTimeout(() => child.kill('SIGKILL'), 2_000);
+      }, timeoutMs);
+      child.stdout.on('data', (d: Buffer) => outChunks.push(d));
+      child.stderr.on('data', (d: Buffer) => errChunks.push(d));
+      child.on('error', (e) => {
+        clearTimeout(timer);
+        resolve({
+          code: null,
+          stdout: Buffer.concat(outChunks).toString('utf8'),
+          stderr: `${Buffer.concat(errChunks).toString('utf8')}\n${String(e)}`,
+          timedOut,
+        });
+      });
+      child.on('close', (code) => {
+        clearTimeout(timer);
+        resolve({
+          code,
+          stdout: Buffer.concat(outChunks).toString('utf8'),
+          stderr: Buffer.concat(errChunks).toString('utf8'),
+          timedOut,
+        });
+      });
+    });
+  }
+
+  /** 执行并抽取 stdout 中的 JSON 对象（doctor 等会在 JSON 前打进度行） */
+  async runJson<T>(args: string[], timeoutMs = 60_000): Promise<CliResult & { json: T | null }> {
+    const r = await this.run(args, timeoutMs);
+    return { ...r, json: extractJson<T>(r.stdout) };
+  }
+}
+
+/**
+ * 从混合文本中抽出 JSON 对象：优先整体解析，否则从每个候选 `{` 起试解析到结尾。
+ * 解析失败返回 null（调用方按「读不到数据」降级，不抛异常）。
+ */
+export function extractJson<T>(text: string): T | null {
+  const trimmed = text.trim();
+  if (!trimmed) return null;
+  try {
+    return JSON.parse(trimmed) as T;
+  } catch {
+    /* 整体不是 JSON，继续找候选起点 */
+  }
+  let idx = trimmed.indexOf('{');
+  let attempts = 0;
+  while (idx >= 0 && attempts < 8) {
+    const candidate = trimmed.slice(idx);
+    try {
+      return JSON.parse(candidate) as T;
+    } catch {
+      /* 下一个候选 */
+    }
+    idx = trimmed.indexOf('{', idx + 1);
+    attempts += 1;
+  }
+  return null;
+}
