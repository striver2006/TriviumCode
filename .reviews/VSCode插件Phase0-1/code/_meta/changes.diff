+/**
+ * 环境健康模型（FR-1）。
+ *
+ * 数据源：`.trivium/config.local.yaml` 的 probe 段（doctor 回填）。面板默认只读
+ * probe 结论；「重新探测」按钮才调 `doctor --json --no-model-calls`（静态、零配额）。
+ * 不展示指纹等敏感字段（D9′）。
+ */
+import type { ProbeSection } from './config';
+import { CARRIERS, type AgentId } from '../launch/carriers';
+
+export type AgentAvailability = 'available' | 'auth-missing' | 'not-probed' | 'unavailable';
+
+export interface AgentHealth {
+  agentId: AgentId;
+  display: string;
+  availability: AgentAvailability;
+  version: string | null;
+  entrypoint: string | null;
+  /** 探针结论时间（probed_at） */
+  probedAt: string | null;
+  /** auth 探活时间（checked_at） */
+  authCheckedAt: string | null;
+  /** 探针段里的模型清单（可能为空数组） */
+  models: string[];
+}
+
+export function buildHealth(probe: ProbeSection | null): AgentHealth[] {
+  return (Object.keys(CARRIERS) as AgentId[]).map((agentId) => {
+    const carrier = CARRIERS[agentId];
+    const cli = probe?.cli[carrier.cliKey];
+    const auth = probe?.auth[agentId];
+    const entrypoint = (cli?.['entrypoint'] as string | undefined) ?? null;
+    const version = (cli?.['version'] as string | undefined) ?? null;
+    const probedAt = (cli?.['probed_at'] as string | undefined) ?? null;
+    const modelsRaw = cli?.['models'];
+    const authOk = auth?.['ok'];
+    const authCheckedAt = (auth?.['checked_at'] as string | undefined) ?? null;
+
+    let availability: AgentAvailability;
+    if (!cli || !entrypoint) {
+      availability = 'not-probed';
+    } else if (authOk === false) {
+      availability = 'auth-missing';
+    } else {
+      availability = 'available';
+    }
+    return {
+      agentId,
+      display: carrier.display,
+      availability,
+      version,
+      entrypoint,
+      probedAt,
+      authCheckedAt,
+      models: Array.isArray(modelsRaw) ? (modelsRaw as string[]) : [],
+    };
+  });
+}
+
+export const AVAILABILITY_LABEL: Record<AgentAvailability, string> = {
+  available: '可用',
+  'auth-missing': '未认证',
+  'not-probed': '未探测（先跑 doctor）',
+  unavailable: '不可用',
+};
diff --git a/extension/src/env/versionCheck.ts b/extension/src/env/versionCheck.ts
new file mode 100644
index 00000000..5ab446a4
--- /dev/null
+++ b/extension/src/env/versionCheck.ts
@@ -0,0 +1,52 @@
+/**
+ * 版本对齐（N4，r2 计划 D10′）。
+ *
+ * 按插件实际消费的**文件类型**声明支持的 schema 串；逐文件判「未知主版本」即降级
+ * 只读。CLI `--version` 的数值版本与 schema 串不是同一命名空间（CLAUDE-09），
+ * 数值只作诊断展示，不参与判定。
+ */
+export type SchemaVerdict =
+  | { kind: 'ok' }
+  | { kind: 'incompatible'; reason: string }
+  | { kind: 'unknown'; reason: string };
+
+/** 插件消费的文件类型 → 支持的 schema 串（唯一事实源：本表） */
+export const SUPPORTED_SCHEMAS = {
+  config: 'trivium.config.v2',
+  state: 'trivium.state.v1',
+  status: 'trivium.status.v1',
+} as const;
+
+export type SchemaFileKind = keyof typeof SUPPORTED_SCHEMAS;
+
+/**
+ * 解析 `trivium.<name>.v<N>` 形态；主版本（N）超出支持即不兼容。
+ * 解析不了的串按 unknown 处理（保守降级，不误放行）。
+ */
+export function checkSchema(actual: string | null | undefined, kind: SchemaFileKind): SchemaVerdict {
+  const supported = SUPPORTED_SCHEMAS[kind];
+  if (!actual) {
+    return { kind: 'unknown', reason: `${kind}: 文件缺 schema 标识` };
+  }
+  const m = /^trivium\.([A-Za-z0-9_]+)\.v(\d+)$/.exec(actual);
+  const s = /^trivium\.([A-Za-z0-9_]+)\.v(\d+)$/.exec(supported);
+  if (!m || !s) {
+    return { kind: 'unknown', reason: `${kind}: schema 串 "${actual}" 无法解析` };
+  }
+  if (m[1] !== s[1]) {
+    return { kind: 'unknown', reason: `${kind}: 未知数据名 "${m[1]}"` };
+  }
+  if (Number(m[2]) !== Number(s[2])) {
+    return { kind: 'incompatible', reason: `${kind}: 支持 ${supported}，实际 ${actual}` };
+  }
+  return { kind: 'ok' };
+}
+
+/** 汇总判定：任一不兼容 → 降级只读（禁点火，监控照常） */
+export function worstVerdict(verdicts: SchemaVerdict[]): SchemaVerdict {
+  const inc = verdicts.find((v) => v.kind === 'incompatible');
+  if (inc) return inc;
+  const unk = verdicts.find((v) => v.kind === 'unknown');
+  if (unk) return unk;
+  return { kind: 'ok' };
+}
diff --git a/extension/src/extension.ts b/extension/src/extension.ts
new file mode 100644
index 00000000..ea3e88bf
--- /dev/null
+++ b/extension/src/extension.ts
@@ -0,0 +1,69 @@
+/**
+ * 插件激活入口。
+ *
+ * 注册命令、视图与配置；全部 Disposable 进 context.subscriptions 统一释放。
+ */
+import * as vscode from 'vscode';
+import { createServices, type TriviumServices } from './services';
+import { HealthProvider } from './ui/healthTree';
+import { Cockpit } from './ui/cockpit';
+
+export async function activate(context: vscode.ExtensionContext): Promise<void> {
+  const services = await createServices(context);
+  if (!services) {
+    // 无工作区文件夹：命令保留但全部提示（不做任何事）
+    registerWithNoWorkspace(context);
+    return;
+  }
+  registerAll(context, services);
+}
+
+function registerAll(context: vscode.ExtensionContext, services: TriviumServices): void {
+  const health = new HealthProvider(services);
+  // Cockpit 单例（AGY-02/CLAUDE-07）：重复命令 reveal 既有面板，不重复建实例与监听
+  const cockpit = new Cockpit(services);
+  context.subscriptions.push(cockpit);
+  context.subscriptions.push(
+    vscode.window.registerTreeDataProvider('triviumHealth', health),
+    vscode.commands.registerCommand('trivium.refreshHealth', () => void health.refresh()),
+    vscode.commands.registerCommand('trivium.openCockpit', () => void cockpit.open()),
+    vscode.commands.registerCommand('trivium.openManual', () => void openRepoDoc(services.root, [
+      'doc/07_manuals/使用手册.md',
+    ])),
+    vscode.commands.registerCommand('trivium.openDeployManual', () => void openRepoDoc(services.root, [
+      'doc/06_deployment/部署手册.md',
+      'doc/07_manuals/部署手册.md', // 兜底：文档目录可能重排
+    ])),
+  );
+}
+
+function registerWithNoWorkspace(context: vscode.ExtensionContext): void {
+  const hint = () => vscode.window.showWarningMessage('Trivium 驾驶舱需要先打开一个工作区文件夹。');
+  context.subscriptions.push(
+    vscode.commands.registerCommand('trivium.openCockpit', hint),
+    vscode.commands.registerCommand('trivium.refreshHealth', hint),
+    vscode.commands.registerCommand('trivium.openManual', hint),
+    vscode.commands.registerCommand('trivium.openDeployManual', hint),
+  );
+}
+
+/** 打开工作区内文档；都不存在则如实提示（CLAUDE-10：链接必须真实存在） */
+async function openRepoDoc(root: string, candidates: string[]): Promise<void> {
+  const { promises: fs } = await import('node:fs');
+  const path = await import('node:path');
+  for (const c of candidates) {
+    const abs = path.join(root, c);
+    try {
+      await fs.access(abs);
+      await vscode.window.showTextDocument(vscode.Uri.file(abs), { preview: true });
+      return;
+    } catch {
+      /* 下一个候选 */
+    }
+  }
+  vscode.window.showWarningMessage(`未找到文档（已尝试：${candidates.join('、')}）。请在 TriviumCode 仓库中打开本工作区。`);
+}
+
+export function deactivate(): void {
+  /* 订阅已由 context.subscriptions 统一释放 */
+}
diff --git a/extension/src/launch/carriers.ts b/extension/src/launch/carriers.ts
new file mode 100644
index 00000000..3aaef8c9
--- /dev/null
+++ b/extension/src/launch/carriers.ts
@@ -0,0 +1,123 @@
+/**
+ * 载体描述表（r2 计划 D1′/D2′）。
+ *
+ * 本表是注册表（src/trivium/agents/registry.ts 的 cliName / entrySkillRoot /
+ * entryInvocation）与 skills-src/carriers/*.yaml 所载事实的**插件侧镜像**——插件
+ * 无法 import 核心仓代码，这是允许的最小事实集。防漂移靠对账单测
+ * `test/unit/carriers.test.ts`：直接读注册表源码与载体 yaml 文本逐项核对，
+ * 核心侧演进时测试先红先知（CLAUDE-08）。
+ *
+ * `invocation` 是**终端 CLI 完整调用模板**（CLAUDE-01/CODEX-01：ZCode 命令行是
+ * `/skill <名字>`，不是桌面端的 `/名字`；插件拉起的恒为终端 CLI）。
+ */
+
+export type AgentId = 'claude' | 'codex' | 'gemini' | 'glm';
+/** 探针 probe.cli 的键（CLI 名，与 Agent id 不同名：gemini→agy、glm→zcode） */
+export type CliKey = 'claude' | 'codex' | 'agy' | 'zcode';
+
+export const AGENT_IDS: readonly AgentId[] = ['claude', 'codex', 'gemini', 'glm'];
+
+export interface CarrierDescriptor {
+  readonly agentId: AgentId;
+  readonly cliKey: CliKey;
+  readonly display: string;
+  /**
+   * 终端 CLI 调用模板，`{name}` 为命令名（dual-run 等）。
+   * 事实来源：registry.entryInvocation（桌面端形态）与 skills-src/carriers/*.yaml
+   * 注释中登记的 CLI 展开形态（zcode CLI 为 `/skill 名字`）。
+   */
+  readonly invocation: string;
+  /**
+   * 拉起模式（AGY-02）：direct = entrypoint 为可执行文件，可作 shellPath；
+   * shellCommand = entrypoint 为脚本（.cjs），须在默认 shell 里用解释器启动。
+   */
+  readonly launchMode: 'direct' | 'shellCommand';
+}
+
+export const CARRIERS: Readonly<Record<AgentId, CarrierDescriptor>> = {
+  claude: {
+    agentId: 'claude',
+    cliKey: 'claude',
+    display: 'Claude Code',
+    invocation: '/{name}',
+    launchMode: 'direct',
+  },
+  codex: {
+    agentId: 'codex',
+    cliKey: 'codex',
+    display: 'Codex',
+    invocation: '${name}',
+    launchMode: 'direct',
+  },
+  gemini: {
+    agentId: 'gemini',
+    cliKey: 'agy',
+    display: 'Antigravity',
+    invocation: '/{name}',
+    launchMode: 'direct',
+  },
+  glm: {
+    agentId: 'glm',
+    cliKey: 'zcode',
+    display: 'ZCode',
+    invocation: '/skill {name}',
+    launchMode: 'shellCommand',
+  },
+};
+
+export function carrierOf(agentId: string): CarrierDescriptor | undefined {
+  return (AGENT_IDS as readonly string[]).includes(agentId)
+    ? CARRIERS[agentId as AgentId]
+    : undefined;
+}
+
+/** 代入命令名得到完整调用（如 glm+`dual-run` → `/skill dual-run`） */
+export function invocationFor(agentId: AgentId, commandName: string): string {
+  return CARRIERS[agentId].invocation.replace('{name}', commandName);
+}
+
+/**
+ * 渲染产物（入口 SKILL.md）的查找根候选（安装位优先，仓内产品兜底）。
+ *
+ * 事实来源：registry.entrySkillRoot（claude: ~/.claude/skills；codex:
+ * $CODEX_HOME|~/.codex/skills；gemini: ~/.gemini/config/skills；glm:
+ * ~/.zcode/skills）与 layout（claude 为 top：仓内产物在 skills/，其余 entry/）。
+ */
+export function skillRootCandidates(agentId: AgentId, repoRoot: string | null): string[] {
+  const home = process.env['HOME'] ?? '';
+  const roots: string[] = [];
+  switch (agentId) {
+    case 'claude':
+      roots.push(joinHome(home, '.claude', 'skills'));
+      if (repoRoot) roots.push(joinHome(repoRoot, 'skills'));
+      break;
+    case 'codex': {
+      const codexHome = process.env['CODEX_HOME'] ?? joinHome(home, '.codex');
+      roots.push(joinHome(codexHome, 'skills'));
+      if (repoRoot) roots.push(joinHome(repoRoot, 'skills', 'dual-critic', 'entry', 'codex'));
+      break;
+    }
+    case 'gemini':
+      roots.push(joinHome(home, '.gemini', 'config', 'skills'));
+      if (repoRoot) roots.push(joinHome(repoRoot, 'skills', 'dual-critic', 'entry', 'gemini'));
+      break;
+    case 'glm':
+      roots.push(joinHome(home, '.zcode', 'skills'));
+      if (repoRoot) roots.push(joinHome(repoRoot, 'skills', 'dual-critic', 'entry', 'glm'));
+      break;
+  }
+  return roots;
+}
+
+function joinHome(...parts: string[]): string {
+  return parts.filter((p) => p !== '').join('/');
+}
+
+/**
+ * 解析 wrapper 脚本内嵌的 node 绝对路径（zcode 等 .cjs entrypoint 的解释器，
+ * AGY-02 兜底来源）。wrapper 形如：exec "/path/to/node" "/path/to/trivium.cjs" "$@"
+ */
+export function parseWrapperNodePath(wrapperContent: string): string | null {
+  const m = /exec\s+"([^"]+)"\s+"[^"]*trivium/.exec(wrapperContent);
+  return m?.[1] ?? null;
+}
diff --git a/extension/src/launch/entryCommand.ts b/extension/src/launch/entryCommand.ts
new file mode 100644
index 00000000..3de12e60
--- /dev/null
+++ b/extension/src/launch/entryCommand.ts
@@ -0,0 +1,106 @@
+/**
+ * 入口命令组装（r2 计划 D1′）。
+ *
+ * 注入文本 = `<终端 CLI 调用模板> <正文单行化> <旗标串>`：
+ * - 无 `--` 分隔符、无 shell 引号——这是**聊天输入**，不是 shell 命令（AGY-01）；
+ * - 调用模板来自 carriers.ts（完整模板，非前缀；CLAUDE-01/CODEX-01）；
+ * - 渲染产物（入口 SKILL.md）仅用于「旗标语法展示」，随 `npm run render` 演进。
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { invocationFor, skillRootCandidates, type AgentId } from './carriers';
+import { prepareBody } from '../util/injectText';
+
+export type EntryKind = 'A' | 'B' | 'C' | 'D';
+
+export const ENTRY_COMMAND: Record<EntryKind, string> = {
+  A: 'dual-run',
+  B: 'dual-review-plan',
+  C: 'dual-review-code',
+  D: 'dual-review-bug',
+};
+
+/** 入口 → 前置链的 resolve/preflight stage（A 用 all 校验全部三阶段） */
+export const ENTRY_STAGE: Record<EntryKind, string> = {
+  A: 'all',
+  B: 'plan',
+  C: 'code',
+  D: 'bug',
+};
+
+/** 入口 → 插件预认领的阶段（A/B 在主题确认后 claim plan；C/D 不预认领，归会话） */
+export const ENTRY_CLAIM_STAGE: Record<EntryKind, string | null> = {
+  A: 'plan',
+  B: 'plan',
+  C: null,
+  D: null,
+};
+
+export const ENTRY_LABEL: Record<EntryKind, string> = {
+  A: 'A · 全流程（方案→双审→编码→双审→编译测试）',
+  B: 'B · 计划双审',
+  C: 'C · 代码双审',
+  D: 'D · Bug 根因双审',
+};
+
+export interface AssembleInput {
+  agentId: AgentId;
+  entry: EntryKind;
+  /** 任务目标（A）或审查焦点（B/C/D）原文，可为多行 */
+  body: string;
+  /** CLI 旗标串（已含 --driver 等），如 ['--driver','codex','--critics','claude,gemini'] */
+  flags: string[];
+}
+
+export interface AssembleResult {
+  /** 最终注入文本（单行） */
+  text: string;
+  warnings: string[];
+}
+
+export function assembleEntryCommand(input: AssembleInput): AssembleResult {
+  const { text: body, warnings } = prepareBody(input.body);
+  const invocation = invocationFor(input.agentId, ENTRY_COMMAND[input.entry]);
+  const flagPart = input.flags.length > 0 ? ` ${input.flags.join(' ')}` : '';
+  const text = body ? `${invocation} ${body}${flagPart}` : `${invocation}${flagPart}`;
+  return { text: text.trim(), warnings };
+}
+
+// ── 渲染产物读取（旗标语法展示用） ──────────────────────────────────────────
+
+export interface SkillDocInfo {
+  /** 找到的 SKILL.md 绝对路径 */
+  path: string;
+  /** 旗标语法提示（claude 取 front-matter argument-hint；其余取正文「参数：」行） */
+  argHint: string | null;
+}
+
+/** 在根候选里找 `<命令名>/SKILL.md`，读出旗标语法提示；找不到返回 null */
+export async function findSkillDoc(
+  agentId: AgentId,
+  entry: EntryKind,
+  repoRoot: string | null,
+): Promise<SkillDocInfo | null> {
+  const cmd = ENTRY_COMMAND[entry];
+  for (const root of skillRootCandidates(agentId, repoRoot)) {
+    const docPath = path.join(root, cmd, 'SKILL.md');
+    try {
+      const text = await fs.readFile(docPath, 'utf8');
+      return { path: docPath, argHint: extractArgHint(text) };
+    } catch {
+      /* 下一个候选 */
+    }
+  }
+  return null;
+}
+
+function extractArgHint(doc: string): string | null {
+  const fm = /^---\n([\s\S]*?)\n---/.exec(doc);
+  if (fm) {
+    const hint = /^argument-hint:\s*(.+)$/m.exec(fm[1]!);
+    if (hint) return hint[1]!.trim();
+  }
+  const bodyHint = /^参数：.*?参数写法：(.+)$/m.exec(doc);
+  if (bodyHint) return bodyHint[1]!.trim();
+  return null;
+}
diff --git a/extension/src/launch/prechain.ts b/extension/src/launch/prechain.ts
new file mode 100644
index 00000000..1e57af6d
--- /dev/null
+++ b/extension/src/launch/prechain.ts
@@ -0,0 +1,163 @@
+/**
+ * 前置链（FR-3，r2 计划 CLAUDE-02 裁决后的次序）。
+ *
+ * 次序：resolve → preflight →（UI 回显主题、用户确认）→ claim（仅入口 A/B、
+ * 确认之后；C/D 不预认领，认领归终端会话的 S4.5/S0.8）。
+ *
+ * 终端里的入口 skill 会把同一条链再跑一遍：resolve 只读、preflight 可重复、
+ * claim 对同一 Driver 幂等（退 0 不改写）——重复开销可忽略，且不产生任何竞态。
+ */
+import type { TriviumCommands, TopicResolveOutput } from '../cli/commands';
+import { explainExitCode } from '../cli/exitCodes';
+import { ENTRY_STAGE, ENTRY_CLAIM_STAGE, type EntryKind } from './entryCommand';
+
+export interface PrechainFlags {
+  driver: string;
+  critics: string[];
+  maxRounds?: number;
+  topic?: string;
+  /** 其余透传旗标（--profile / --model-* 等），已按 CLI 形态组好 */
+  extra?: string[];
+}
+
+export type PrechainStep =
+  | { step: 'resolve'; state: 'ok'; out: TopicResolveOutput }
+  | { step: 'resolve'; state: 'failed'; code: number | null; message: string }
+  | { step: 'preflight'; state: 'ok'; warnings: { name: string; detail: string }[] }
+  | { step: 'preflight'; state: 'failed'; code: number | null; message: string }
+  | { step: 'claim'; state: 'ok' }
+  | { step: 'claim'; state: 'failed'; code: number | null; message: string }
+  | { step: 'skipped'; reason: string };
+
+export interface PrechainReport {
+  steps: PrechainStep[];
+  /** resolve 成功后的主题（UI 须回显确认后再 claim） */
+  topic: string | null;
+  topicInferred: boolean | null;
+  taskGoal: string | null;
+  notes: string[];
+  /** 任一步失败即 true；此后 UI 不应进入 claim/点火 */
+  failed: boolean;
+}
+
+/** 第一步 + 第二步：resolve → preflight（用 resolve 的 critics）。claim 独立成步（确认后调用）。 */
+export async function runResolveAndPreflight(
+  cmds: TriviumCommands,
+  args: { entry: EntryKind; body: string; flags: PrechainFlags },
+): Promise<PrechainReport> {
+  const steps: PrechainStep[] = [];
+  const cliFlags = buildCliFlags(args.flags);
+  const resolve = await cmds.topicResolve({
+    stage: ENTRY_STAGE[args.entry],
+    body: args.body,
+    flags: cliFlags,
+  });
+  if (resolve.code !== 0 || !resolve.out?.ok) {
+    const message = firstLine(resolve.stderr || resolve.stdout) || '解析失败';
+    steps.push({ step: 'resolve', state: 'failed', code: resolve.code, message });
+    return { steps, topic: null, topicInferred: null, taskGoal: null, notes: [], failed: true };
+  }
+  steps.push({ step: 'resolve', state: 'ok', out: resolve.out });
+
+  const critics = resolve.out.critics ?? [];
+  const preflight = await cmds.preflight({
+    stage: ENTRY_STAGE[args.entry],
+    driver: resolve.out.driver ?? args.flags.driver,
+    critics,
+    // CLAUDE-03：预检必须校验本轮实际运行配置——profile/模型/档位类旗标与
+    // resolve 同源透传；--topic/--max-rounds/--context 不属预检面
+    flags: preflightFlagList(args.flags.extra ?? []),
+  });
+  if (preflight.code !== 0 || !preflight.out?.ok) {
+    const failChecks = (preflight.out?.checks ?? [])
+      .filter((c) => !c.ok)
+      .map((c) => `${c.name}：${c.detail}`)
+      .join('\n');
+    const message = failChecks || firstLine(preflight.stderr) || explainExitCode(preflight.code ?? 1).label;
+    steps.push({ step: 'preflight', state: 'failed', code: preflight.code, message });
+    return {
+      steps,
+      topic: resolve.out.topic,
+      topicInferred: resolve.out.topic_inferred,
+      taskGoal: resolve.out.task_goal,
+      notes: resolve.out.notes ?? [],
+      failed: true,
+    };
+  }
+  steps.push({ step: 'preflight', state: 'ok', warnings: preflight.out.warnings ?? [] });
+  return {
+    steps,
+    topic: resolve.out.topic,
+    topicInferred: resolve.out.topic_inferred,
+    taskGoal: resolve.out.task_goal,
+    notes: resolve.out.notes ?? [],
+    failed: false,
+  };
+}
+
+/** 主题确认后的 claim（仅 A/B；其余入口调用方不触发本步） */
+export async function claimAfterConfirm(
+  cmds: TriviumCommands,
+  entry: EntryKind,
+  topic: string,
+  driver: string,
+): Promise<PrechainStep> {
+  const stage = ENTRY_CLAIM_STAGE[entry];
+  if (!stage) {
+    return { step: 'skipped', reason: `入口 ${entry} 不预认领（认领由终端会话在正确时点执行）` };
+  }
+  const r = await cmds.topicClaim(topic, stage, driver);
+  if (r.code === 0 && r.out?.ok) return { step: 'claim', state: 'ok' };
+  return {
+    step: 'claim',
+    state: 'failed',
+    code: r.code,
+    message: firstLine(r.stderr) || explainExitCode(r.code ?? 1).label,
+  };
+}
+
+/** 表单旗标 → CLI 旗标（--driver/--critics/--max-rounds/--topic + extra） */
+export function buildCliFlags(f: PrechainFlags): string[] {
+  const flags: string[] = ['--driver', f.driver, '--critics', f.critics.join(',')];
+  if (f.maxRounds !== undefined) flags.push('--max-rounds', String(f.maxRounds));
+  if (f.topic !== undefined && f.topic !== '') flags.push('--topic', f.topic);
+  if (f.extra && f.extra.length > 0) flags.push(...f.extra);
+  return flags;
+}
+
+function firstLine(text: string): string {
+  return (text ?? '').split('\n').find((l) => l.trim().length > 0)?.trim() ?? '';
+}
+
+/** preflight 接受的运行旗标前缀（CLAUDE-03：与 review --start 同一预检面） */
+const PREFLIGHT_FLAG_PREFIXES = [
+  '--profile',
+  '--model-',
+  '--tier-',
+  '--effort-',
+  '--profile-',
+  '--native-',
+];
+
+/** 从 extra 旗标数组筛出 preflight 面的旗标（保留其值位） */
+export function preflightFlagList(extra: readonly string[]): string[] {
+  const out: string[] = [];
+  for (let i = 0; i < extra.length; i++) {
+    const tok = extra[i]!;
+    if (PREFLIGHT_FLAG_PREFIXES.some((p) => tok === p || tok.startsWith(p))) {
+      out.push(tok);
+      // 值位：本组旗标形态均为 --flag value（布尔形态 --native-* 无值位）
+      const next = extra[i + 1];
+      if (next !== undefined && !next.startsWith('--')) {
+        out.push(next);
+        i += 1;
+      }
+    }
+  }
+  return out;
+}
+
+/** 失败步类型守卫（联合类型收窄用，测试与 UI 共用） */
+export function isFailedStep(s: PrechainStep): s is Extract<PrechainStep, { state: 'failed' }> {
+  return 'state' in s && s.state === 'failed';
+}
diff --git a/extension/src/launch/terminalRelay.ts b/extension/src/launch/terminalRelay.ts
new file mode 100644
index 00000000..7f854525
--- /dev/null
+++ b/extension/src/launch/terminalRelay.ts
@@ -0,0 +1,200 @@
+/**
+ * M1 终端协同（FR-5，r2 计划 D2′/D3′）。
+ *
+ * - 拉起：direct（entrypoint 为可执行，作 shellPath）或 shellCommand（zcode 的
+ *   .cjs 脚本：默认 shell 终端 + `"<node>" "<entrypoint>"` 启动，AGY-02）；
+ * - 身份：内部键 `agent|topic|entry`（CLAUDE-07），显示名只作展示；同键存活终端
+ *   复用聚焦，不同键永不复用；
+ * - 注入：就绪延迟（无事件驱动，D3′）→ 分段 sendText → 回车语义三模式；
+ * - 失败兜底由驾驶舱的命令条承担（本模块不做「无变化=失败」推断）；
+ * - 关闭：onDidCloseTerminal → 通知驾驶舱降级 M3。
+ */
+import * as vscode from 'vscode';
+import { existsSync } from 'node:fs';
+import type { AgentId } from './carriers';
+
+export type SendMode = 'execute' | 'split' | 'manual';
+
+export interface LaunchOptions {
+  agentId: AgentId;
+  display: string;
+  /** resolve 后的主题（含推导值）；点火前必须已 resolve（否则传 '?' 占位并禁止复用命中） */
+  topic: string;
+  entry: string;
+  entrypoint: string;
+  launchMode: 'direct' | 'shellCommand';
+  cwd: string;
+  /** shellCommand 模式的解释器绝对路径（探针 runner 或 wrapper 内嵌 node） */
+  nodePath?: string | null;
+}
+
+export interface LaunchSettings {
+  readyDelayMs: number;
+  sendMode: SendMode;
+  segmentBytes: number;
+}
+
+interface Session {
+  key: string;
+  terminal: vscode.Terminal;
+  /** 注入进行中（供 UI 提示，不做硬锁） */
+  injecting: boolean;
+}
+
+export const terminalKey = (agentId: string, topic: string, entry: string): string =>
+  `${agentId}|${topic}|${entry}`;
+
+const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+
+export class TerminalRelay implements vscode.Disposable {
+  private readonly sessions = new Map<string, Session>();
+  private readonly closeListener: vscode.Disposable;
+  private readonly closeHandlers = new Set<(key: string) => void>();
+
+  constructor() {
+    this.closeListener = vscode.window.onDidCloseTerminal((t) => {
+      for (const [key, s] of this.sessions) {
+        if (s.terminal === t) {
+          this.sessions.delete(key);
+          for (const h of this.closeHandlers) h(key);
+          return;
+        }
+      }
+    });
+  }
+
+  onSessionClosed(handler: (key: string) => void): vscode.Disposable {
+    this.closeHandlers.add(handler);
+    return new vscode.Disposable(() => this.closeHandlers.delete(handler));
+  }
+
+  find(key: string): Session | undefined {
+    return this.sessions.get(key);
+  }
+
+  /** 取同键存活会话（复用）或创建新终端 */
+  async ensureSession(opts: LaunchOptions): Promise<Session> {
+    const key = terminalKey(opts.agentId, opts.topic, opts.entry);
+    const existing = this.sessions.get(key);
+    if (existing) {
+      if (existing.terminal.exitStatus !== undefined) {
+        // 终端进程已退出（AGY-03）：旧记录失效，移除后新建
+        this.sessions.delete(key);
+      } else {
+        existing.terminal.show();
+        return existing;
+      }
+    }
+    const name = `Trivium · ${opts.display} · ${opts.topic}`;
+    let terminal: vscode.Terminal;
+    if (opts.launchMode === 'direct') {
+      terminal = vscode.window.createTerminal({ name, shellPath: opts.entrypoint, cwd: opts.cwd });
+    } else {
+      // 脚本类 entrypoint：显式 shell（不依赖宿主默认 profile），注入解释器启动命令
+      terminal = vscode.window.createTerminal({ name, shellPath: detectShell(), cwd: opts.cwd });
+      await sleep(600);
+      terminal.show();
+      terminal.sendText(nodeLaunchCommand(opts.entrypoint, opts.nodePath), true);
+    }
+    terminal.show();
+    const session: Session = { key, terminal, injecting: false };
+    this.sessions.set(key, session);
+    return session;
+  }
+
+  /**
+   * 就绪延迟后注入文本。
+   * 返回注入所用设置（供 UI 展示）；延迟由调用方配置注入（此方法内不再等待）。
+   */
+  async injectText(
+    session: Session,
+    text: string,
+    settings: LaunchSettings,
+    readyDelayMs: number,
+  ): Promise<void> {
+    session.injecting = true;
+    try {
+      await sleep(Math.max(0, readyDelayMs));
+      await this.sendWithMode(session.terminal, text, settings);
+    } finally {
+      session.injecting = false;
+    }
+  }
+
+  /** 续话中继：整段 + 回车（尽力而为；TUI 兼容性差的载体由用户改在终端直输） */
+  async relay(session: Session, text: string): Promise<void> {
+    await this.sendWithMode(session.terminal, text, { readyDelayMs: 0, sendMode: 'execute', segmentBytes: 512 });
+  }
+
+  private async sendWithMode(terminal: vscode.Terminal, text: string, s: LaunchSettings): Promise<void> {
+    const bytes = Buffer.byteLength(text, 'utf8');
+    if (bytes > s.segmentBytes) {
+      // 长文分段：按字节安全切分（UTF-8 多字节字符不截断），段间 80ms
+      const segments = splitUtf8(text, s.segmentBytes);
+      for (let i = 0; i < segments.length; i++) {
+        const last = i === segments.length - 1;
+        if (last && s.sendMode === 'execute') {
+          terminal.sendText(segments[i]!, true);
+        } else {
+          terminal.sendText(segments[i]!, false);
+          await sleep(80);
+        }
+      }
+      if (s.sendMode === 'split') {
+        await sleep(150);
+        terminal.sendText('', true);
+      }
+      // manual：只粘贴不回车，用户手按
+      return;
+    }
+    if (s.sendMode === 'execute') {
+      terminal.sendText(text, true);
+    } else if (s.sendMode === 'split') {
+      terminal.sendText(text, false);
+      await sleep(150);
+      terminal.sendText('', true);
+    } else {
+      terminal.sendText(text, false);
+    }
+  }
+
+  dispose(): void {
+    this.closeListener.dispose();
+    this.sessions.clear();
+  }
+}
+
+/** UTF-8 安全分段：切点回退到字符边界 */
+export function splitUtf8(text: string, maxBytes: number): string[] {
+  const out: string[] = [];
+  let buf = '';
+  let size = 0;
+  for (const ch of text) {
+    const b = Buffer.byteLength(ch, 'utf8');
+    if (size + b > maxBytes && buf !== '') {
+      out.push(buf);
+      buf = '';
+      size = 0;
+    }
+    buf += ch;
+    size += b;
+  }
+  if (buf !== '') out.push(buf);
+  return out;
+}
+
+/** shellCommand 模式的启动命令（加引号防空格路径） */
+export function nodeLaunchCommand(entrypoint: string, nodePath: string | null | undefined): string {
+  const node = nodePath && nodePath.length > 0 ? nodePath : 'node';
+  return `"${node}" "${entrypoint}"`;
+}
+
+/** 宿主 shell 探测：SHELL 环境变量优先，兜底常见路径（不读登录 Shell 配置内容） */
+export function detectShell(): string {
+  const fromEnv = process.env['SHELL'];
+  if (fromEnv && fromEnv.length > 0) return fromEnv;
+  for (const candidate of ['/bin/zsh', '/bin/bash', '/bin/sh']) {
+    if (existsSync(candidate)) return candidate;
+  }
+  return '/bin/sh';
+}
diff --git a/extension/src/monitor/reviewWatch.ts b/extension/src/monitor/reviewWatch.ts
new file mode 100644
index 00000000..f4b97b0a
--- /dev/null
+++ b/extension/src/monitor/reviewWatch.ts
@@ -0,0 +1,78 @@
+/**
+ * `.reviews/<topic>/<stage>/` 目录监视（CLAUDE-06：侧完成即归档该侧审查件）。
+ *
+ * status.json 的 artifacts 仅整 run 终态填写；侧完成即时的正文入口来自归档目录
+ * 的新文件（编排器 archive.ts 在每侧完成时立即落盘）。
+ */
+import * as vscode from 'vscode';
+import path from 'node:path';
+
+export interface ReviewFile {
+  /** 绝对路径 */
+  absPath: string;
+  /** 文件名 */
+  name: string;
+  /** 从 front-matter 解析的作者角色（解析不到为 null，如 verify 件） */
+  role: string | null;
+}
+
+export function parseRoleFromDoc(content: string): string | null {
+  const fm = /^---\n([\s\S]*?)\n---/.exec(content);
+  if (!fm) return null;
+  const m = /^role:\s*(\S+)$/m.exec(fm[1]!);
+  return m?.[1] ?? null;
+}
+
+export class ReviewWatch implements vscode.Disposable {
+  private readonly watcher: vscode.FileSystemWatcher;
+  private readonly listeners = new Set<(files: ReviewFile[]) => void>();
+  private disposed = false;
+
+  constructor(
+    private readonly stageDir: string,
+    private readonly readFile: (p: string) => Promise<string> = (p) =>
+      Promise.resolve(vscode.workspace.fs.readFile(vscode.Uri.file(p)).then((b) => Buffer.from(b).toString('utf8'))),
+  ) {
+    // 只看本阶段目录下的 md（_meta 除外）
+    this.watcher = vscode.workspace.createFileSystemWatcher(
+      vscode.Uri.file(path.join(stageDir, '*.md')).fsPath,
+    );
+    this.watcher.onDidChange(() => void this.rescan());
+    this.watcher.onDidCreate(() => void this.rescan());
+    this.watcher.onDidDelete(() => void this.rescan());
+    void this.rescan();
+  }
+
+  async rescan(): Promise<void> {
+    if (this.disposed) return;
+    const { promises: fs } = await import('node:fs');
+    let names: string[];
+    try {
+      names = await fs.readdir(this.stageDir);
+    } catch {
+      return;
+    }
+    const files: ReviewFile[] = [];
+    for (const name of names.filter((n) => n.endsWith('.md')).sort()) {
+      const absPath = path.join(this.stageDir, name);
+      let role: string | null = null;
+      try {
+        role = parseRoleFromDoc(await this.readFile(absPath));
+      } catch {
+        /* 读不到 front-matter 就不带角色 */
+      }
+      files.push({ absPath, name, role });
+    }
+    for (const l of this.listeners) l(files);
+  }
+
+  onChange(listener: (files: ReviewFile[]) => void): void {
+    this.listeners.add(listener);
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    this.watcher.dispose();
+    this.listeners.clear();
+  }
+}
diff --git a/extension/src/monitor/runDiscovery.ts b/extension/src/monitor/runDiscovery.ts
new file mode 100644
index 00000000..160f4817
--- /dev/null
+++ b/extension/src/monitor/runDiscovery.ts
@@ -0,0 +1,108 @@
+/**
+ * run 目录定位（r2 计划 D4″ + 代码审 CODEX-02）。
+ *
+ * 不复制核心的 repoId 推导（命名是核心内部约定）：按 run_id 在
+ * `<run_root>/<桶>/<run_id>/` 浅扫描。**run_id 是秒级时间戳，不同仓库可能同秒
+ * 撞号**——定位必须校验归属：先按桶名前缀（= 工作区目录名）过滤，再用候选
+ * status.json 的 topic 与闸门主题比对；无法唯一确定即不接管并明示，绝不取
+ * 跨桶首个同名目录。
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+
+export interface RetryPolicy {
+  intervalMs: number;
+  rounds: number;
+}
+
+export interface LocateOptions {
+  /** 工作区目录名（桶名前缀提示，如 TriviumCode-2217d505 的 TriviumCode） */
+  repoHint?: string;
+  /** 期望主题（来自闸门 gates 条目）；候选 status.json 的 topic 与之比对 */
+  expectTopic?: string;
+  /** 读文件失败时的提示（注入以便测试） */
+  readFile?: (p: string) => Promise<string>;
+}
+
+/** 列出全部命中桶（不判归属） */
+async function listCandidates(runRoot: string, runId: string): Promise<string[]> {
+  let buckets: string[];
+  try {
+    buckets = await fs.readdir(runRoot);
+  } catch {
+    return [];
+  }
+  const hits: string[] = [];
+  for (const bucket of buckets) {
+    const candidate = path.join(runRoot, bucket, runId);
+    try {
+      const st = await fs.stat(candidate);
+      if (st.isDirectory()) hits.push(candidate);
+    } catch {
+      /* 下一个桶 */
+    }
+  }
+  return hits;
+}
+
+async function readTopicOf(dir: string, opts: LocateOptions): Promise<string | null> {
+  const read = opts.readFile ?? ((p: string) => fs.readFile(p, 'utf8'));
+  try {
+    const text = await read(path.join(dir, 'status.json'));
+    const obj = JSON.parse(text) as { topic?: unknown };
+    return typeof obj.topic === 'string' ? obj.topic : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * 归属感知定位：桶前缀过滤 → topic 比对 → 唯一才返回。
+ * 无法唯一确定（跨仓撞号且判别不了）返回 null，调用方明示。
+ */
+export async function locateRunDir(runRoot: string, runId: string, opts: LocateOptions = {}): Promise<string | null> {
+  const candidates = await listCandidates(runRoot, runId);
+  if (candidates.length === 0) return null;
+  if (candidates.length === 1 && !opts.repoHint && !opts.expectTopic) return candidates[0]!;
+
+  // 1) 桶名前缀过滤（桶名形如 <工作区名>-<hash8>）
+  let pool = candidates;
+  if (opts.repoHint) {
+    const hinted = candidates.filter((c) => path.basename(path.dirname(c)).startsWith(`${opts.repoHint}-`));
+    if (hinted.length > 0) pool = hinted;
+  }
+  if (pool.length === 1) return pool[0]!;
+
+  // 2) topic 比对（status.json 尚未写好时读不到 → 该候选不加分）
+  if (opts.expectTopic) {
+    const matched: string[] = [];
+    for (const c of pool) {
+      if ((await readTopicOf(c, opts)) === opts.expectTopic) matched.push(c);
+    }
+    if (matched.length === 1) return matched[0]!;
+    if (matched.length > 1) return null; // 同主题同名仍歧义：不接管
+  }
+  return pool.length === 1 ? pool[0]! : null;
+}
+
+/**
+ * 带重试的定位：闸门已 running 而运行目录尚未落盘时按策略重试。
+ * sleep 可注入（单测不真等）。
+ */
+export async function locateRunDirWithRetry(
+  runRoot: string,
+  runId: string,
+  policy: RetryPolicy,
+  opts: LocateOptions = {},
+  sleep: (ms: number) => Promise<void> = (ms) => new Promise((r) => setTimeout(r, ms)),
+  onRetry?: (round: number) => void,
+): Promise<string | null> {
+  for (let round = 0; round <= policy.rounds; round++) {
+    const dir = await locateRunDir(runRoot, runId, opts);
+    if (dir) return dir;
+    if (round === policy.rounds) break;
+    onRetry?.(round + 1);
+    await sleep(policy.intervalMs);
+  }
+  return null;
+}
diff --git a/extension/src/monitor/stateModel.ts b/extension/src/monitor/stateModel.ts
new file mode 100644
index 00000000..c4e2081e
--- /dev/null
+++ b/extension/src/monitor/stateModel.ts
@@ -0,0 +1,84 @@
+/**
+ * state.json 纯函数模型（FR-4 / D4′）。
+ *
+ * 与 watcher（stateWatch.ts）分离：本模块不依赖 vscode，单测直接覆盖。
+ */
+import { checkSchema } from '../env/versionCheck';
+
+export const ACTIVE_GATE_STATES = new Set([
+  'running',
+  'review_done_awaiting_disposition',
+  'awaiting_approval',
+]);
+
+export interface GateRef {
+  key: string; // "<topic>/<stage>"
+  topic: string;
+  stage: string;
+  state: string;
+  runId: string;
+  since: string | null;
+}
+
+export interface StateSnapshot {
+  gates: GateRef[];
+  active: GateRef[];
+  /** schema 不兼容说明（null 表示正常） */
+  schemaReason: string | null;
+}
+
+export interface RunEndedEvent {
+  key: string;
+  topic: string;
+  stage: string;
+  runId: string;
+  /** 回落后的终态（idle/approved/rejected/abandoned） */
+  endState: string;
+}
+
+export function parseGates(text: string): StateSnapshot {
+  let obj: Record<string, unknown>;
+  try {
+    obj = JSON.parse(text) as Record<string, unknown>;
+  } catch {
+    return { gates: [], active: [], schemaReason: null };
+  }
+  const schema = typeof obj['schema'] === 'string' ? obj['schema'] : null;
+  const verdict = checkSchema(schema, 'state');
+  const schemaReason =
+    verdict.kind === 'incompatible' || verdict.kind === 'unknown' ? verdict.reason : null;
+  const gatesRaw = obj['gates'];
+  const gates: GateRef[] = [];
+  if (gatesRaw && typeof gatesRaw === 'object') {
+    for (const [key, v] of Object.entries(gatesRaw as Record<string, unknown>)) {
+      if (!v || typeof v !== 'object') continue;
+      const g = v as Record<string, unknown>;
+      gates.push({
+        key,
+        topic: typeof g['topic'] === 'string' ? g['topic'] : key,
+        stage: typeof g['stage'] === 'string' ? g['stage'] : '',
+        state: typeof g['state'] === 'string' ? g['state'] : 'unknown',
+        runId: typeof g['run_id'] === 'string' ? g['run_id'] : '',
+        since: typeof g['since'] === 'string' ? g['since'] : null,
+      });
+    }
+  }
+  const active = gates.filter((g) => ACTIVE_GATE_STATES.has(g.state) && g.runId !== '');
+  return { gates, active, schemaReason };
+}
+
+/** 由上一次快照与本帧快照推出「活跃→回落」事件（CODEX-02：失败回 idle 也能被看见） */
+export function diffRunEnded(prev: StateSnapshot | null, next: StateSnapshot): RunEndedEvent[] {
+  if (!prev) return [];
+  const prevActive = new Map(prev.active.map((g) => [g.key, g]));
+  const nextByKey = new Map(next.gates.map((g) => [g.key, g]));
+  const events: RunEndedEvent[] = [];
+  for (const [key, g] of prevActive) {
+    const now = nextByKey.get(key);
+    if (!now) continue;
+    if (!ACTIVE_GATE_STATES.has(now.state)) {
+      events.push({ key, topic: g.topic, stage: g.stage, runId: g.runId, endState: now.state });
+    }
+  }
+  return events;
+}
diff --git a/extension/src/monitor/stateWatch.ts b/extension/src/monitor/stateWatch.ts
new file mode 100644
index 00000000..1efd8c2c
--- /dev/null
+++ b/extension/src/monitor/stateWatch.ts
@@ -0,0 +1,66 @@
+/**
+ * state.json 监视（FR-4 / M3，r2 计划 D4′/D4″）。
+ *
+ * 解析与 diff 在纯函数模块 stateModel.ts（单测覆盖）；本模块只挂 watcher 与
+ * 激活期初始扫描。
+ */
+import * as vscode from 'vscode';
+import path from 'node:path';
+import { parseGates, diffRunEnded, type StateSnapshot, type RunEndedEvent } from './stateModel';
+
+export { ACTIVE_GATE_STATES } from './stateModel';
+export type { GateRef, StateSnapshot, RunEndedEvent } from './stateModel';
+
+export class StateWatch implements vscode.Disposable {
+  private readonly watcher: vscode.FileSystemWatcher;
+  private readonly statePath: string;
+  private readonly listeners = new Set<(snap: StateSnapshot, ended: RunEndedEvent[]) => void>();
+  private last: StateSnapshot | null = null;
+  private disposed = false;
+
+  constructor(
+    workspaceRoot: string,
+    private readonly readFile: (p: string) => Promise<string> = (p) =>
+      Promise.resolve(vscode.workspace.fs.readFile(vscode.Uri.file(p)).then((b) => Buffer.from(b).toString('utf8'))),
+  ) {
+    this.statePath = path.join(workspaceRoot, '.trivium', 'state.json');
+    this.watcher = vscode.workspace.createFileSystemWatcher(vscode.Uri.file(this.statePath).fsPath);
+    this.watcher.onDidChange(() => void this.rescan());
+    this.watcher.onDidCreate(() => void this.rescan());
+    void this.rescan();
+  }
+
+  /** 激活期初始扫描（CODEX-02：不依赖事件先看一眼） */
+  async rescan(): Promise<void> {
+    if (this.disposed) return;
+    let text: string;
+    try {
+      text = await this.readFile(this.statePath);
+    } catch {
+      return;
+    }
+    const snap = parseGates(text);
+    const ended = diffRunEnded(this.last, snap);
+    this.last = snap;
+    for (const l of this.listeners) l(snap, ended);
+  }
+
+  /**
+   * 订阅状态变化。**立即回放最近有效快照**（CODEX-03：晚订阅者不丢初始扫描），
+   * 并返回可释放句柄（CLAUDE-07：驾驶舱关闭时退订，避免泄漏广播）。
+   */
+  onChange(listener: (snap: StateSnapshot, ended: RunEndedEvent[]) => void): vscode.Disposable {
+    this.listeners.add(listener);
+    if (this.last) {
+      // 回放不产生回落事件（ended 属于增量语义）
+      listener(this.last, []);
+    }
+    return new vscode.Disposable(() => this.listeners.delete(listener));
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    this.watcher.dispose();
+    this.listeners.clear();
+  }
+}
diff --git a/extension/src/monitor/statusModel.ts b/extension/src/monitor/statusModel.ts
new file mode 100644
index 00000000..2494a7a6
--- /dev/null
+++ b/extension/src/monitor/statusModel.ts
@@ -0,0 +1,127 @@
+/**
+ * status.json 渲染模型（纯函数，FR-4 / N3 幂等）。
+ *
+ * 编排器契约 `trivium.status.v1`：phase / sides / heartbeat_at / artifacts /
+ * exit_code / message。已知竞态窗口（2026-11-03 分析 §3.5）：读到旧快照或半截
+ * JSON 一律**丢弃不报错**，终态以 `--status` 复核为准（N3）。
+ */
+import { checkSchema } from '../env/versionCheck';
+
+export const TERMINAL_PHASES = new Set(['success', 'failed', 'cancelled']);
+
+export interface SideRender {
+  critic: string;
+  state: string;
+  model: string | null;
+  attempt: number | null;
+  elapsedS: number | null;
+}
+
+export interface StatusRender {
+  runId: string | null;
+  topic: string | null;
+  stage: string | null;
+  phase: string;
+  terminal: boolean;
+  sides: SideRender[];
+  heartbeatAt: string | null;
+  startedAt: string | null;
+  artifacts: string[];
+  exitCode: number | null;
+  message: string | null;
+}
+
+export interface ParseOutcome {
+  /** null = 本次快照不可用（丢弃，保留上次渲染） */
+  render: StatusRender | null;
+  /** schema 不兼容说明（附在渲染上，由 UI 决定降级提示） */
+  schemaReason: string | null;
+}
+
+export function parseStatus(text: string): ParseOutcome {
+  let obj: Record<string, unknown>;
+  try {
+    obj = JSON.parse(text) as Record<string, unknown>;
+  } catch {
+    return { render: null, schemaReason: null };
+  }
+  const schema = typeof obj['schema'] === 'string' ? obj['schema'] : null;
+  const verdict = checkSchema(schema, 'status');
+  if (verdict.kind === 'incompatible') {
+    return { render: null, schemaReason: verdict.reason };
+  }
+  const phase = typeof obj['phase'] === 'string' ? obj['phase'] : 'unknown';
+  const sidesRaw = obj['sides'];
+  const sides: SideRender[] = [];
+  if (sidesRaw && typeof sidesRaw === 'object') {
+    for (const [critic, v] of Object.entries(sidesRaw as Record<string, unknown>)) {
+      if (!v || typeof v !== 'object') continue;
+      const s = v as Record<string, unknown>;
+      sides.push({
+        critic,
+        state: typeof s['state'] === 'string' ? s['state'] : 'unknown',
+        model: typeof s['model'] === 'string' ? s['model'] : null,
+        attempt: typeof s['attempt'] === 'number' ? s['attempt'] : null,
+        elapsedS: typeof s['elapsed_s'] === 'number' ? s['elapsed_s'] : null,
+      });
+    }
+  }
+  return {
+    render: {
+      runId: str(obj['run_id']),
+      topic: str(obj['topic']),
+      stage: str(obj['stage']),
+      phase,
+      terminal: TERMINAL_PHASES.has(phase),
+      sides,
+      heartbeatAt: str(obj['heartbeat_at']),
+      startedAt: str(obj['started_at']),
+      artifacts: Array.isArray(obj['artifacts']) ? (obj['artifacts'] as string[]) : [],
+      exitCode: typeof obj['exit_code'] === 'number' ? obj['exit_code'] : null,
+      message: str(obj['message']),
+    },
+    schemaReason: verdict.kind === 'unknown' ? verdict.reason : null,
+  };
+}
+
+/** 心跳失联判定（纯函数：D5′；stale 只提示，不判死） */
+export function heartbeatStale(
+  heartbeatAt: string | null,
+  nowMs: number,
+  staleS: number,
+): boolean {
+  if (!heartbeatAt) return false;
+  const t = Date.parse(heartbeatAt);
+  if (Number.isNaN(t)) return false;
+  return nowMs - t > staleS * 1000;
+}
+
+/** 侧状态 → 中文标签（未知态原样返回，不报错） */
+export function sideStateLabel(state: string): string {
+  const map: Record<string, string> = {
+    ok: '已完成',
+    running: '审查中',
+    failed: '失败',
+    timeout: '超时',
+    cancelled: '已取消',
+    pending: '排队中',
+  };
+  return map[state] ?? state;
+}
+
+export function phaseLabel(phase: string): string {
+  const map: Record<string, string> = {
+    starting: '启动中',
+    running: '审查中',
+    parsing: '解析归档中',
+    archiving: '归档中',
+    success: '成功',
+    failed: '失败',
+    cancelled: '已取消',
+  };
+  return map[phase] ?? phase;
+}
+
+function str(v: unknown): string | null {
+  return typeof v === 'string' ? v : null;
+}
diff --git a/extension/src/monitor/statusWatch.ts b/extension/src/monitor/statusWatch.ts
new file mode 100644
index 00000000..2f356146
--- /dev/null
+++ b/extension/src/monitor/statusWatch.ts
@@ -0,0 +1,234 @@
+/**
+ * 单个 run 的监控会话（FR-4，r2 计划 D5′）。
+ *
+ * status.json watcher（幂等渲染，N3）+ 独立周期心跳重估定时器（worker 停写
+ * 场景仍能发现失联，CLAUDE-05/CODEX-03）+ 终态 `--status` 复核（不一致以 CLI
+ * 为准）+ Disposable（终态复核完成即清理，AGY-05）。
+ *
+ * 运行目录在 run_root（工作区之外）：用 node fs.watch 做目录级监听——一次
+ * 覆盖 status.json / worker.log 的创建与原子替换；VS Code FileSystemWatcher
+ * 对 workspace 外路径的事件不可靠（集成测试实测）。目录尚不存在（闸门先行
+ * 窗口）时按 2s 重试挂载（CODEX-02）。
+ */
+import * as vscode from 'vscode';
+import { watch, type FSWatcher } from 'node:fs';
+import path from 'node:path';
+import { heartbeatStale, parseStatus, TERMINAL_PHASES, type StatusRender } from './statusModel';
+
+export interface RunWatchEvents {
+  onRender: (render: StatusRender, extra: { stale: boolean; note: string | null }) => void;
+  /**
+   * 终态复核完成（CODEX-04：render 已按 CLI 复核结果修正；此后本监控会话
+   * 自动 dispose）。
+   */
+  onFinal: (render: StatusRender, note: string | null) => void;
+  /** status.json 的 schema 不兼容/未知（CODEX-07：上报驾驶舱统一降级判定） */
+  onSchemaIssue?: (reason: string) => void;
+  onLog?: (tail: string) => void;
+}
+
+export interface RunWatchOptions {
+  runDir: string;
+  runId: string;
+  heartbeatStaleS: number;
+  /** 心跳重估周期（秒） */
+  heartbeatIntervalS: number;
+  logTailBytes: number;
+  /** 终态复核：调 review --status 的函数（注入以便测试） */
+  statusProbe: (runId: string) => Promise<{ phase: string | null; artifacts: string[] | null } | null>;
+}
+
+export class RunWatch implements vscode.Disposable {
+  private dirWatcher: FSWatcher | null = null;
+  private mountTimer: ReturnType<typeof setInterval> | null = null;
+  private heartbeatTimer: ReturnType<typeof setInterval> | null = null;
+  private lastRender: StatusRender | null = null;
+  private stale = false;
+  private crossChecked = false;
+  private disposed = false;
+  /** 目录事件去抖（原子替换会产生连续事件） */
+  private refreshTimer: NodeJS.Timeout | null = null;
+  private logTimer: NodeJS.Timeout | null = null;
+
+  constructor(
+    private readonly opts: RunWatchOptions,
+    private readonly events: RunWatchEvents,
+    private readonly readFile: (p: string) => Promise<string> = async (p) => {
+      const { promises: fs } = await import('node:fs');
+      return fs.readFile(p, 'utf8');
+    },
+  ) {
+    this.mountWatcher();
+    // 独立于文件事件的周期重估（D5′）
+    this.heartbeatTimer = setInterval(() => this.reassess(), Math.max(5, opts.heartbeatIntervalS) * 1000);
+    void this.refresh();
+    void this.tailLog();
+  }
+
+  /** 挂载目录级 watcher；目录未建（闸门先行窗口）按 2s 重试（CODEX-02） */
+  private mountWatcher(): void {
+    try {
+      this.dirWatcher = watch(this.opts.runDir, { persistent: false }, (_event, filename) => {
+        const name = filename ?? '';
+        if (name === '' || name === 'status.json' || name.endsWith('.tmp-')) this.scheduleRefresh();
+        if (name === '' || name === 'worker.log' || name.endsWith('.tmp-')) this.scheduleLog();
+      });
+    } catch {
+      this.mountTimer = setInterval(() => {
+        if (this.disposed) {
+          this.stopMount();
+          return;
+        }
+        this.mountWatcher();
+      }, 2_000);
+    }
+  }
+
+  private stopMount(): void {
+    if (this.mountTimer) {
+      clearInterval(this.mountTimer);
+      this.mountTimer = null;
+    }
+  }
+
+  private scheduleRefresh(): void {
+    this.stopMount(); // 已能收到事件：挂载重试使命完成
+    if (this.refreshTimer || this.disposed) return;
+    this.refreshTimer = setTimeout(() => {
+      this.refreshTimer = null;
+      void this.refresh();
+    }, 200);
+  }
+
+  private scheduleLog(): void {
+    if (this.logTimer || this.disposed) return;
+    this.logTimer = setTimeout(() => {
+      this.logTimer = null;
+      void this.tailLog();
+    }, 300);
+  }
+
+  private async refresh(): Promise<void> {
+    if (this.disposed || this.crossChecked) return;
+    let text: string;
+    try {
+      text = await this.readFile(path.join(this.opts.runDir, 'status.json'));
+    } catch {
+      return;
+    }
+    const { render, schemaReason } = parseStatus(text);
+    if (schemaReason) this.events.onSchemaIssue?.(schemaReason); // CODEX-07：上报统一降级
+    if (!render) return; // 旧快照/半截 JSON/不兼容：丢弃，保留上次渲染（N3）
+    this.lastRender = render;
+    this.stale = heartbeatStale(render.heartbeatAt, Date.now(), this.opts.heartbeatStaleS);
+    this.events.onRender(render, {
+      stale: this.stale,
+      note: this.stale ? this.staleNote() : null,
+    });
+    if (render.terminal) void this.crossCheck(render);
+  }
+
+  /** 周期重估：无文件事件也能发现失联（终态后停表） */
+  private reassess(): void {
+    if (this.disposed || !this.lastRender || this.lastRender.terminal) return;
+    const nowStale = heartbeatStale(this.lastRender.heartbeatAt, Date.now(), this.opts.heartbeatStaleS);
+    if (nowStale !== this.stale) {
+      this.stale = nowStale;
+      this.events.onRender(this.lastRender, { stale: nowStale, note: nowStale ? this.staleNote() : null });
+    }
+  }
+
+  private staleNote(): string {
+    return `心跳超过 ${this.opts.heartbeatStaleS}s 未更新：worker 可能失联（--wait 的失联收尾语义适用）。worker.log：${path.join(this.opts.runDir, 'worker.log')}`;
+  }
+
+  /**
+   * 终态复核（CODEX-04 三态，以 review --status 为准）：
+   * 1. CLI 也是终态 → 用 CLI 的 phase/artifacts 修正终稿 → onFinal → dispose；
+   * 2. CLI 仍在运行（文件快照竞态抢先）→ 恢复监控，以下次终态再复核，不 dispose；
+   * 3. 复核调用失败 → 文件快照作为终稿 + 注明（诚实降级），dispose。
+   */
+  private async crossCheck(render: StatusRender): Promise<void> {
+    if (this.crossChecked || this.disposed) return;
+    this.crossChecked = true;
+    let probe: { phase: string | null; artifacts: string[] | null } | null = null;
+    let probeFailed = false;
+    try {
+      probe = await this.opts.statusProbe(this.opts.runId);
+    } catch {
+      probeFailed = true;
+    }
+    if (probe && probe.phase && TERMINAL_PHASES.has(probe.phase)) {
+      const phaseChanged = probe.phase !== render.phase;
+      const artifacts = probe.artifacts && probe.artifacts.length > 0 ? probe.artifacts : render.artifacts;
+      const artifactsChanged = JSON.stringify(artifacts) !== JSON.stringify(render.artifacts);
+      const finalRender: StatusRender = phaseChanged || artifactsChanged
+        ? { ...render, phase: probe.phase, terminal: true, artifacts }
+        : render;
+      this.lastRender = finalRender;
+      this.events.onFinal(
+        finalRender,
+        phaseChanged || artifactsChanged ? '文件快照已按 --status 复核修正（以 CLI 为准）' : null,
+      );
+      this.dispose();
+      return;
+    }
+    if (probe && probe.phase && !TERMINAL_PHASES.has(probe.phase)) {
+      // 文件抢跑：CLI 权威仍在运行 → 恢复监控
+      this.crossChecked = false;
+      this.lastRender = { ...render, phase: probe.phase, terminal: false };
+      this.events.onRender(this.lastRender, {
+        stale: this.stale,
+        note: '文件快照显示终态，但 --status 复核仍在运行：已恢复监控，以下次终态为准',
+      });
+      return;
+    }
+    this.events.onFinal(render, probeFailed ? '终态复核调用失败：以文件快照为准展示' : '终态复核无有效结果：以文件快照为准展示');
+    this.dispose();
+  }
+
+  private async tailLog(): Promise<void> {
+    if (this.disposed || !this.events.onLog) return;
+    try {
+      const { open } = await import('node:fs/promises');
+      const fh = await open(path.join(this.opts.runDir, 'worker.log'), 'r');
+      try {
+        const size = (await fh.stat()).size;
+        const start = Math.max(0, size - this.opts.logTailBytes);
+        const buf = Buffer.alloc(size - start);
+        await fh.read(buf, 0, buf.length, start);
+        this.events.onLog(buf.toString('utf8'));
+      } finally {
+        await fh.close();
+      }
+    } catch {
+      /* worker.log 尚未创建：忽略 */
+    }
+  }
+
+  get current(): StatusRender | null {
+    return this.lastRender;
+  }
+
+  get isCrossChecked(): boolean {
+    return this.crossChecked;
+  }
+
+  dispose(): void {
+    if (this.disposed) return;
+    this.disposed = true;
+    this.stopMount();
+    if (this.heartbeatTimer) {
+      clearInterval(this.heartbeatTimer);
+      this.heartbeatTimer = null;
+    }
+    if (this.refreshTimer) clearTimeout(this.refreshTimer);
+    if (this.logTimer) clearTimeout(this.logTimer);
+    try {
+      this.dirWatcher?.close();
+    } catch {
+      /* 已关 */
+    }
+    this.dirWatcher = null;
+  }
+}
diff --git a/extension/src/services.ts b/extension/src/services.ts
new file mode 100644
index 00000000..f74be9bf
--- /dev/null
+++ b/extension/src/services.ts
@@ -0,0 +1,47 @@
+/**
+ * 插件级共享服务（单一实例，activate 时创建、deactivate 时统一释放）。
+ */
+import * as vscode from 'vscode';
+import { TriviumCli } from './cli/triviumCli';
+import { TriviumCommands } from './cli/commands';
+import { TriviumEnv } from './env/config';
+import { TerminalRelay } from './launch/terminalRelay';
+import { StateWatch } from './monitor/stateWatch';
+
+export interface TriviumServices {
+  root: string;
+  env: TriviumEnv;
+  cli: TriviumCli;
+  cmds: TriviumCommands;
+  relay: TerminalRelay;
+  stateWatch: StateWatch;
+  /** TriviumCode 仓根（工作区即本仓时才有值——渲染产物兜底用） */
+  repoRoot: string | null;
+  readonly disposables: { push(d: vscode.Disposable): void };
+}
+
+export function workspaceRoot(): string | null {
+  const folders = vscode.workspace.workspaceFolders;
+  return folders?.[0]?.uri.fsPath ?? null;
+}
+
+export async function createServices(context: vscode.ExtensionContext): Promise<TriviumServices | null> {
+  const root = workspaceRoot();
+  if (!root) return null;
+  const env = new TriviumEnv(root);
+  const cli = new TriviumCli(root);
+  const relay = new TerminalRelay();
+  const stateWatch = new StateWatch(root);
+  context.subscriptions.push(relay, stateWatch);
+  // 渲染产物兜底候选恒为工作区根（工作区即 TriviumCode 仓时命中 skills/ 产品）
+  return {
+    root,
+    env,
+    cli,
+    cmds: new TriviumCommands(cli),
+    relay,
+    stateWatch,
+    repoRoot: root,
+    disposables: context.subscriptions,
+  };
+}
diff --git a/extension/src/ui/cockpit.ts b/extension/src/ui/cockpit.ts
