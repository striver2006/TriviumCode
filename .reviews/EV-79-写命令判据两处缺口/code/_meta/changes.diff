+// EV-79 · 重定向运算符对账表：判据的分类结果 vs 外壳实测语义
+// （形态数不写死在抬头——本主题刚把承诺面从「共 N 种拼写」改成「按文法覆盖」，
+//   理由正是枚举数目不可证；实际条数见末行合计，由 CASES.length 派生）
+//
+// 为什么要有这份（代码双审 CODEX-06 ≡ GLM-02）：计划 §3.1 声称「55 个形态逐格对照、
+// 0 处不符」，而那张表此前只活在计划稿里，没有可复跑的留痕。
+//
+// 对账口径：
+//   · 判据侧 —— 直调 `writeSinksOfSegment` 的实际消费方 `classifyWriteCommands`，
+//     用**项目内/项目外**的落档差异反推它取到了哪个目标（writes 只给命令原文，
+//     取不到目标本身，这正是「目标钉死」那组用例用的同一招）。
+//   · 实测侧 —— 见同目录 probe-redirect-operators.out.txt（跑完看建出什么文件）。
+//
+// 用法：node redirect-operator-matrix.mjs   （先 node scripts/build.mjs --tests-only）
+import { execSync } from 'node:child_process';
+const m = await import('/Users/chenzhenbo/Work/TriviumCode/dist/test/src/trivium/adapters/base.js');
+
+const head = execSync('git -C /Users/chenzhenbo/Work/TriviumCode rev-parse --short HEAD', {
+  encoding: 'utf8',
+}).trim();
+const ROOT = '/proj';
+
+/**
+ * 期望值写法：
+ *   'F:<目标>'  该 token 取到的写目标就是 <目标>（用项目外路径时落疑似档反推）
+ *   'X:fd'      判据**正确**地判成 fd 操作 / 不取目标
+ *   'X:miss'    判据不取目标，但实测侧是**真实文件写入** —— 已知漏检，靠 BACKLOG 兜底
+ *
+ * **两档必须分开**（代码双审 GLM-06）：都记成 'X' 时，「不符期望：0」这句总结
+ * 会把**判据漏检**也算进「与实测相符」；将来新的静默漏检形态以 X 为期望加进表，
+ * 对账表会给它盖「相符」章——正是本主题 r1～r5 每轮被实测打脸的那类断言形态。
+ */
+const CASES = [
+  // ── 规则 4：非 fd 族，无条件取文件目标 ──
+  ['>out.txt', 'echo x >/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['> out.txt', 'echo x > /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>>out.txt', 'echo x >>/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>> out.txt', 'echo x >> /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&>out.txt', 'echo x &>/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&> out.txt', 'echo x &> /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&>>out.txt', 'echo x &>>/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&>> out.txt', 'echo x &>> /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>>&out.txt', 'echo x >>&/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>>& out.txt', 'echo x >>& /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['2>>&1', 'echo x 2>>&1', 'F:in'],
+  ['>>&-', 'echo x >>&-', 'F:in'],
+  // 纯数字 / 减号作目标位（r4 的漏检面）
+  ['> 2', 'echo x > 2', 'F:in'],
+  ['>> 2', 'echo x >> 2', 'F:in'],
+  ['&> 2', 'echo x &> 2', 'F:in'],
+  ['&>> 2', 'echo x &>> 2', 'F:in'],
+  ['>>& 2', 'echo x >>& 2', 'F:in'],
+  ['>>&2', 'echo x >>&2', 'F:in'],
+  ['> -', 'echo x > -', 'F:in'],
+  // 强制覆盖后缀 × 文件目标
+  ['>&| f', 'echo x >&| /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>&! f', 'echo x >&! /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&>| f', 'echo x &>| /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['&>! f', 'echo x &>! /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['2>&| f', 'echo x 2>&| /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['2>&! f', 'echo x 2>&! /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>&|f（紧贴）', 'echo x >&|/tmp/o.txt', 'F:/tmp/o.txt'],
+  // 强制覆盖后缀 × 数字/减号目标（r5 的漏检面）
+  ['>&| 2', 'echo x >&| 2', 'F:in'],
+  ['>&|2（紧贴）', 'echo x >&|2', 'F:in'],
+  ['>&!2（紧贴）', 'echo x >&!2', 'F:in'],
+  ['>&| -', 'echo x >&| -', 'F:in'],
+  ['2>&! 1', 'echo x 2>&! 1', 'F:in'],
+  ['2>&|1（紧贴）', 'echo x 2>&|1', 'F:in'],
+  // 普通覆盖后缀
+  ['>| f', 'echo x >| /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>|f（紧贴）', 'echo x >|/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>! f', 'echo x >! /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>>| f', 'echo x >>| /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>>! f', 'echo x >>! /tmp/o.txt', 'F:/tmp/o.txt'],
+
+  // ── 规则 3：fd 族 + 非数字非减号目标 ⇒ 文件 ──
+  ['>&f（紧贴）', 'echo x >&/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>& f（分离）', 'echo x >& /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['2>&f（紧贴）', 'echo x 2>&/tmp/o.txt', 'F:/tmp/o.txt'],
+  ['2>& f（分离）', 'echo x 2>& /tmp/o.txt', 'F:/tmp/o.txt'],
+  ['>&2foo（等值防线）', 'echo Y >&2foo', 'F:in'],
+
+  // ── 规则 1 / 2：fd 族 + 恰为数字或减号 ⇒ 排除 ──
+  ['>&2', 'echo x >&2', 'X:fd'],
+  ['>&1', 'echo x >&1', 'X:fd'],
+  ['2>&1', 'echo x 2>&1', 'X:fd'],
+  ['1>&2', 'echo x 1>&2', 'X:fd'],
+  ['>&-', 'echo x >&-', 'X:fd'],
+  ['2>&-', 'echo x 2>&-', 'X:fd'],
+  ['>& 2（分离）', 'echo x >& 2', 'X:fd'],
+  ['>& -（分离）', 'echo x >& -', 'X:fd'],
+  ['2>& 1（分离）', 'echo x 2>& 1', 'X:fd'],
+
+  // ── 与写动词交互：被排除的 fd 目标不得顶替真实写入点 ──
+  ['cp … >& 2', 'cp src/a.ts /tmp/out.ts >& 2', 'F:/tmp/out.ts'],
+  ['cp … >& -', 'cp src/a.ts /tmp/out.ts >& -', 'F:/tmp/out.ts'],
+  ['cp … 2>&1', 'cp src/a.ts /tmp/out.ts 2>&1', 'F:/tmp/out.ts'],
+
+  // ── 文法之外与语法错（已知残余 / 不可达）──
+  ['{fd}> f（文法外）', 'echo x {fd}> /tmp/o.txt', 'X:miss'],  // 实测建出文件，判据不取 ⇒ EV-99
+  ['引号内的 &> 字面量', "grep -n '&>' src/a.ts", 'X:fd'],   // 非写入，判据不取是对的
+];
+
+let bad = 0;
+const rows = [];
+for (const [label, cmd, want] of CASES) {
+  const r = m.classifyWriteCommands([cmd], ROOT);
+  let got;
+  if (r.writes.length > 0) {
+    got = 'F:in'; // 目标落在项目内
+  } else {
+    const outside = r.suspected.find((s) => s.why.startsWith('写入目标在项目外'));
+    got = outside ? `F:${outside.why.replace('写入目标在项目外：', '')}` : 'X';
+  }
+  // X 桶按期望值分档：判据侧两者都是「不取目标」，差别在实测侧是不是真写入
+  if (got === 'X') {
+    got = want === 'X:miss' ? 'X:miss' : 'X:fd';
+  }
+  const ok = got === want;
+  if (!ok) bad++;
+  rows.push([ok ? '  ' : '!!', label, cmd, got, want]);
+}
+
+console.log(`# EV-79 · 重定向运算符对账表 ｜ 基线 HEAD=${head} ｜ 生成于 ${new Date().toISOString()}`);
+console.log(`# 判据侧：classifyWriteCommands 的落档（F:in = 项目内、F:<路径> = 项目外、X:fd = 正确排除、X:miss = 已知漏检）`);
+console.log(`# 实测侧：见同目录 probe-redirect-operators.out.txt\n`);
+for (const [mark, label, cmd, got, want] of rows) {
+  console.log(`${mark} ${label.padEnd(22)} ${cmd.padEnd(38)} 判据=${got.padEnd(14)} 期望=${want}`);
+}
+const miss = rows.filter((r) => r[4] === 'X:miss').length;
+console.log(`\n共 ${CASES.length} 形态，不符期望：${bad}`);
+console.log(`其中 X:miss ${miss} 格 —— 判据不取目标而实测是真实写入，属**已知漏检**，`);
+console.log(`「不符期望：0」只说明判据行为与登记一致，**不等于无漏检**。`);
