+  const real = path.join(ctx.archiveRoot, 't/code/2026-09-19-t-claude.md');
+  await fs.writeFile(real, 'x');
+  const link = path.join(ctx.projectRoot, 'doc/2026-09-19-t-claude.md');
+  await fs.symlink(real, link);
