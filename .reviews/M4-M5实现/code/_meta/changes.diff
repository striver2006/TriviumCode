diff --git a/test/unit/report.test.ts b/test/unit/report.test.ts
new file mode 100644
index 0000000..851a843
--- /dev/null
+++ b/test/unit/report.test.ts
@@ -0,0 +1,296 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import os from 'node:os';
+import { promises as fs } from 'node:fs';
+import { acceptanceRate, buildTopicReport, renderTopicReport, type RoundReport } from '../../src/trivium/report.js';
+import { newRunMeta, writeRunMeta, registerRun, type TaskMeta } from '../../src/trivium/meta.js';
+import { writeArtifact, writeMeta, type ArchiveLayout } from '../../src/trivium/archive.js';
+import type { Review } from '../../src/trivium/types.js';
+
+/**
+ * 主题级复盘（设计 §5.1 / §9.3 / §15.2）。
+ *
+ * 报告只读 `.reviews/`，所以这些用例的做法是**真的把归档摆出来**再读回，
+ * 而不是往渲染函数里塞手造对象——后者测不出「归档里缺件时会怎样」，
+ * 而那恰恰是复盘最容易骗人的地方。
+ */
+
+const TOPIC = '复盘主题';
+
+async function archive(): Promise<ArchiveLayout & { root: string }> {
+  const raw = await fs.mkdtemp(path.join(os.tmpdir(), 'trivium-report-'));
+  const root = await fs.realpath(raw);
+  const archiveRoot = path.join(root, '.reviews');
+  await fs.mkdir(path.join(archiveRoot, TOPIC, 'plan', '_meta'), { recursive: true });
+  return { archiveRoot, topic: TOPIC, root };
+}
+
+/**
+ * 造一份合规结论。编号必须是 `AGY-NN` / `GLM-NN`：
+ * schema 的 id pattern 是 `^(AGY|GLM)-(r\\d+-)?\\d{2,}$`，
+ * 裁决件解析器也据此过滤（免得把表格里的小结行当数据行）。
+ */
+function review(locations: string[], severities: string[] = [], prefix = 'AGY'): Review {
+  return {
+    schema: 'trivium.review.v1',
+    verdict: 'request-changes',
+    summary: 's',
+    findings: locations.map((location, i) => ({
+      id: `${prefix}-${String(i + 1).padStart(2, '0')}`,
+      severity: severities[i] ?? 'minor',
+      layer: 'plan',
+      kind: 'correctness',
+      location,
+      problem: 'p',
+      evidence: 'e',
+      suggestion: 'g',
+      confidence: 'high',
+    })),
+  } as unknown as Review;
+}
+
+/** 摆一轮完整归档：两侧审查文档 + 两份 review json + run.json */
+async function seedRound(
+  l: ArchiveLayout,
+  opts: {
+    rerunIndex: number;
+    runId: string;
+    gemini?: Review | null;
+    glm?: Review | null;
+    glmFailed?: boolean;
+    usage?: Record<string, unknown>;
+    drift?: boolean;
+  },
+) {
+  const meta = newRunMeta({
+    runId: opts.runId, topic: l.topic, stage: 'plan', rerunIndex: opts.rerunIndex,
+    command: 'test', promptHint: '焦点',
+    treeHash: 'T', gitHead: 'HEAD', dirty: false, subjectSha256: 'S',
+    denyPaths: [], driftPolicy: 'warn',
+  });
+  if (opts.drift) meta.snapshot.drift = { changed: true, files: ['x.ts'], policy: 'warn' };
+
+  for (const [c, rv] of [['gemini', opts.gemini], ['glm', opts.glm]] as const) {
+    if (c === 'glm' && opts.glmFailed) {
+      meta.critics.glm = {
+        vendor: 'zcode', cli_version: null, model_requested: 'GLM-x', model_effective: null,
+        model_effective_source: 'unverified', status: 'timeout', exit_code: null, duration_s: 900,
+        tool_calls: {}, evidence_ok: false, heterogeneous: true, fail_reason: '脚本级超时（900s）',
+      };
+      await writeMeta(l, 'plan', `review-glm-${opts.runId}.failed.json`,
+        JSON.stringify({ critic: 'glm', status: 'timeout', fail_reason: '脚本级超时（900s）' }) + '\n');
+      meta.review_mode = 'single';
+      meta.degraded_reason = 'glm: timeout';
+      continue;
+    }
+    if (!rv) continue;
+    meta.critics[c] = {
+      vendor: c === 'gemini' ? 'antigravity' : 'zcode',
+      cli_version: '1.0', model_requested: c === 'gemini' ? 'gemini-x' : 'GLM-x',
+      model_effective: c === 'gemini' ? 'gemini-x' : 'provider/GLM-x',
+      model_effective_source: 'envelope', status: 'ok', exit_code: 0, duration_s: c === 'gemini' ? 100 : 200,
+      tool_calls: { read: 9 }, evidence_ok: true, heterogeneous: true,
+      ...(opts.usage ? { usage: opts.usage as Record<string, number> } : {}),
+    };
+    await writeMeta(l, 'plan', `review-${c}-${opts.runId}.json`, JSON.stringify(rv) + '\n');
+    await writeArtifact({
+      layout: l, stage: 'plan', role: c, writer: c,
+      rerunIndex: opts.rerunIndex, content: `# ${c} 审查\n\nrun_id: ${opts.runId}\n`,
+    });
+  }
+
+  meta.status = 'success';
+  await writeRunMeta(l, 'plan', meta);
+  await registerRun(l, meta);
+  return meta;
+}
+
+// ── 空主题 ──
+
+test('空主题：如实说「没有轮次」，不渲染成一份看起来干净的报告', async () => {
+  const l = await archive();
+  const r = await buildTopicReport(l);
+  assert.equal(r.rounds.length, 0);
+  assert.ok(r.notes.some((n) => /没有任何已产出审查工件/.test(n)));
+  const md = renderTopicReport(r);
+  assert.match(md, /没有任何已产出审查工件/);
+  assert.match(md, /（无数据）/);
+});
+
+// ── 正常一轮 ──
+
+test('一轮双审：时间线、意见数、严重度分布、生效模型齐备', async () => {
+  const l = await archive();
+  await seedRound(l, {
+    rerunIndex: 1, runId: 'R1',
+    gemini: review(['src/a.ts:10', 'src/b.ts:20'], ['blocker', 'major']),
+    glm: review(['src/a.ts:8-12'], ['minor'], 'GLM'),
+  });
+
+  const r = await buildTopicReport(l);
+  assert.equal(r.rounds.length, 1);
+  const d = r.rounds[0]!;
+  assert.equal(d.runId, 'R1');
+  assert.equal(d.reviewMode, 'dual');
+  assert.deepEqual(
+    d.sides.map((s) => [s.critic, s.findings]).sort(),
+    [['gemini', 2], ['glm', 1]],
+  );
+  assert.deepEqual(d.severity, { blocker: 1, major: 1, minor: 1, nit: 0 });
+
+  const md = renderTopicReport(r);
+  assert.match(md, /plan r1/);
+  assert.match(md, /provider\/GLM-x/, '生效模型须是回读值');
+});
+
+test('归一化后的重合度进表，且未归一化值一并给出', async () => {
+  const l = await archive();
+  await seedRound(l, {
+    rerunIndex: 1, runId: 'R1',
+    gemini: review(['src/a.ts:10']),
+    glm: review(['src/a.ts:8-12'], [], 'GLM'),
+  });
+  const r = await buildTopicReport(l);
+  const v = r.rounds[0]!.divergence!;
+  assert.equal(v.jaccard, 1, ':10 落在 :8-12 内，是同一处');
+  assert.equal(v.rawJaccard, 0, '原始字符串不相等');
+  assert.equal(v.degenerate, true);
+  assert.match(renderTopicReport(r), /双审退化|重合度超过阈值/);
+});
+
+// ── 降级与缺件 ──
+
+test('单侧超时：显示状态而非 0，并进降级清单', async () => {
+  const l = await archive();
+  await seedRound(l, {
+    rerunIndex: 1, runId: 'R1',
+    gemini: review(['src/a.ts:1']),
+    glmFailed: true,
+  });
+
+  const r = await buildTopicReport(l);
+  const d = r.rounds[0]!;
+  const glm = d.sides.find((s) => s.critic === 'glm')!;
+  assert.equal(glm.findings, null, '失败侧的意见数必须是 null，不能是 0');
+  assert.equal(glm.status, 'timeout');
+  assert.equal(d.reviewMode, 'single');
+  assert.equal(d.divergence, null, '只有一侧有结论时不算重合度');
+
+  const md = renderTopicReport(r);
+  assert.match(md, /（timeout）/, '表里显示状态');
+  assert.match(md, /脚本级超时/);
+  assert.match(md, /0.*会被读成「该侧认为没问题」/s);
+});
+
+test('审查完成但无裁决件 → 明确点出，采纳率不按 0 算', async () => {
+  const l = await archive();
+  await seedRound(l, { rerunIndex: 1, runId: 'R1', gemini: review(['a:1']), glm: review(['b:1'], [], 'GLM') });
+  const r = await buildTopicReport(l);
+  assert.equal(r.rounds[0]!.disposals, null);
+  assert.ok(r.rounds[0]!.notes.some((n) => /尚无裁决件/.test(n)));
+  assert.deepEqual(acceptanceRate(r.rounds), { accepted: 0, total: 0 });
+  assert.match(renderTopicReport(r), /尚无裁决件/);
+});
+
+// ── 裁决与驳回 ──
+
+test('裁决件被解析：采纳率与被驳回项带理由', async () => {
+  const l = await archive();
+  await seedRound(l, {
+    rerunIndex: 1, runId: 'R1',
+    gemini: review(['a:1', 'a:2']), glm: review(['b:1'], [], 'GLM'),
+  });
+  await writeArtifact({
+    layout: l, stage: 'plan', role: 'claude', writer: 'driver', kind: 'revised', rerunIndex: 1,
+    content: [
+      '# 修订计划', '',
+      '| 意见编号 | 来源 | 严重度 | 裁决 | 理由 | 修改落点 |',
+      '| :--- | :--- | :--- | :--- | :--- | :--- |',
+      '| AGY-01 | gemini | blocker | 接受 | 确实漏了 | §3 |',
+      '| AGY-02 | gemini | major | 驳回 | 与 ADR-001 冲突，镜像树已被推翻 | — |',
+      '| GLM-01 | glm | minor | 暂缓 | 依赖上游探针结论，M4 再定 | — |',
+      '',
+    ].join('\n'),
+  });
+
+  const r = await buildTopicReport(l);
+  const d = r.rounds[0]!;
+  assert.deepEqual(d.disposals, { 接受: 1, 驳回: 1, 暂缓: 1 });
+  assert.deepEqual(acceptanceRate(r.rounds), { accepted: 1, total: 3 });
+  assert.equal(d.contested.length, 2, '驳回与暂缓都算争议项');
+
+  const md = renderTopicReport(r);
+  assert.match(md, /1 \/ 3 = 33%/);
+  assert.match(md, /与 ADR-001 冲突/, '驳回理由必须出现在报告里');
+  assert.match(md, /M4 再定/);
+});
+
+// ── token 与告警 ──
+
+test('token 逐侧列出，字符串字段被丢弃而不是累加成垃圾', async () => {
+  const l = await archive();
+  await seedRound(l, {
+    rerunIndex: 1, runId: 'R1',
+    gemini: review(['a:1']), glm: review(['b:1'], [], 'GLM'),
+    // 实测 zcode 的 usage 里混了字符串 source 字段
+    usage: { input_tokens: 100, output_tokens: 20, source: 'provider' },
+  });
+  const r = await buildTopicReport(l);
+  const md = renderTopicReport(r);
+  assert.match(md, /input_tokens 100/);
+  assert.doesNotMatch(md, /0provider|source provider/, '字符串字段不得进汇总');
+  assert.match(md, /两侧\*\*不合计\*\*/);
+});
+
+test('漂移与路径 deny 降级进告警清单', async () => {
+  const l = await archive();
+  await seedRound(l, { rerunIndex: 1, runId: 'R1', gemini: review(['a:1']), glm: review(['b:1'], [], 'GLM'), drift: true });
+  const r = await buildTopicReport(l);
+  assert.ok(r.rounds[0]!.guardFlags.some((g) => /漂移 1 个文件/.test(g)));
+  assert.match(renderTopicReport(r), /漂移 1 个文件/);
+});
+
+// ── 多轮 ──
+
+test('多轮按轮次升序，采纳率跨轮累计', async () => {
+  const l = await archive();
+  await seedRound(l, { rerunIndex: 1, runId: 'R1', gemini: review(['a:1']), glm: review(['b:1'], [], 'GLM') });
+  await seedRound(l, { rerunIndex: 2, runId: 'R2', gemini: review(['c:1']), glm: review(['d:1'], [], 'GLM') });
+
+  const r = await buildTopicReport(l);
+  assert.deepEqual(r.rounds.map((d) => d.rerunIndex), [1, 2]);
+  assert.deepEqual(r.rounds.map((d) => d.runId), ['R1', 'R2']);
+
+  const rounds: RoundReport[] = r.rounds.map((d) => ({
+    ...d, disposals: { 接受: 2, 驳回: 1, 暂缓: 0 },
+  }));
+  assert.deepEqual(acceptanceRate(rounds), { accepted: 4, total: 6 });
+});
+
+test('缺 run.json 的轮次照样出现在报告里，并说明元数据缺失', async () => {
+  const l = await archive();
+  // 只放一份审查文档，不放 run.json
+  await writeArtifact({
+    layout: l, stage: 'plan', role: 'gemini', writer: 'gemini', rerunIndex: 1,
+    content: '# 孤立的审查文档\n',
+  });
+  const r = await buildTopicReport(l);
+  assert.equal(r.rounds.length, 1, '有工件就得出现，不能因为缺元数据就当它不存在');
+  assert.ok(r.rounds[0]!.notes.some((n) => /找不到对应的/.test(n)));
+  assert.match(renderTopicReport(r), /找不到对应的/);
+});
+
+test('task.json 的降级与争议项被带进报告', async () => {
+  const l = await archive();
+  await seedRound(l, { rerunIndex: 1, runId: 'R1', gemini: review(['a:1']), glm: review(['b:1'], [], 'GLM') });
+  const taskPath = path.join(l.archiveRoot, l.topic, 'task.json');
+  const task = JSON.parse(await fs.readFile(taskPath, 'utf8')) as TaskMeta;
+  task.disputed = true;
+  task.disputes = [{ run_id: 'R1', finding_ids: ['X-1', 'Y-2'], note: '双方共同 blocker 被驳回' }];
+  await fs.writeFile(taskPath, JSON.stringify(task, null, 2));
+
+  const md = renderTopicReport(await buildTopicReport(l));
+  assert.match(md, /双方共同 blocker 被驳回/);
+  assert.match(md, /X-1、Y-2/);
+});
diff --git a/test/unit/verify.test.ts b/test/unit/verify.test.ts
new file mode 100644
index 0000000..b6d20ac
--- /dev/null
+++ b/test/unit/verify.test.ts
@@ -0,0 +1,221 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import os from 'node:os';
+import { promises as fs } from 'node:fs';
+import {
+  assertVerifyConfigured,
+  collectCommands,
+  renderVerifyDoc,
+  runVerify,
+  summarizeVerify,
+  tailLines,
+  type VerifyRecord,
+} from '../../src/trivium/verify.js';
+import { defaultConfig } from '../../src/trivium/config.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import type { Ctx } from '../../src/trivium/types.js';
+
+/**
+ * 编译测试出口（设计 §14）。
+ *
+ * 这些用例跑的是真命令（`true` / `false` / `echo`），不是 mock：
+ * 「只执行显式配置的命令」「非零退出不得宣称成功」两条都只有真执行才测得出来。
+ */
+
+async function ctxWith(build: string[], testCmds: string[]): Promise<Ctx> {
+  const raw = await fs.mkdtemp(path.join(os.tmpdir(), 'trivium-verify-'));
+  const root = await fs.realpath(raw);
+  const cfg = defaultConfig();
+  cfg.verify.build = build;
+  cfg.verify.test = testCmds;
+  return {
+    config: cfg,
+    projectRoot: root,
+    archiveRoot: path.join(root, '.reviews'),
+    triviumDir: path.join(root, '.trivium'),
+    sources: ['<test>'],
+  };
+}
+
+const layoutFor = (ctx: Ctx) => ({ archiveRoot: ctx.archiveRoot, topic: '出口主题' });
+
+// ── 命令收集 ──
+
+test('命令顺序为 build 先于 test', () => {
+  const cfg = defaultConfig();
+  cfg.verify.build = ['b1', 'b2'];
+  cfg.verify.test = ['t1'];
+  assert.deepEqual(collectCommands(cfg).map((c) => `${c.group}:${c.cmd}`), [
+    'build:b1', 'build:b2', 'test:t1',
+  ]);
+});
+
+test('--only 只取一组', () => {
+  const cfg = defaultConfig();
+  cfg.verify.build = ['b1'];
+  cfg.verify.test = ['t1'];
+  assert.deepEqual(collectCommands(cfg, 'test').map((c) => c.cmd), ['t1']);
+  assert.deepEqual(collectCommands(cfg, 'build').map((c) => c.cmd), ['b1']);
+});
+
+test('未配置时命令集为空——绝不回退到猜测的默认命令', () => {
+  // §14.1：探测到的候选只展示不执行。这里断言的是「空就是空」
+  assert.deepEqual(collectCommands(defaultConfig()), []);
+});
+
+test('assertVerifyConfigured 在两组皆空时抛 64', () => {
+  const cfg = defaultConfig();
+  assert.throws(() => assertVerifyConfigured(cfg), /均未配置/);
+  cfg.verify.test = ['npm test'];
+  assert.doesNotThrow(() => assertVerifyConfigured(cfg));
+});
+
+// ── 真实执行 ──
+
+test('全部通过 → success，退 0，两份记录落盘', async () => {
+  const ctx = await ctxWith(['true'], ['echo hello']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R1' });
+
+  assert.equal(out.record.status, 'success');
+  assert.equal(out.exitCode, EXIT.OK);
+  assert.equal(out.record.commands.length, 2);
+  assert.match(out.record.commands[1]!.stdout_tail, /hello/);
+  assert.ok((await fs.stat(out.artifactPath)).isFile());
+  assert.ok((await fs.stat(out.metaPath)).isFile());
+  assert.match(path.basename(out.artifactPath), /-出口主题-verify\.md$/);
+});
+
+test('任一命令非零 → failed，退 1，绝不宣称成功', async () => {
+  const ctx = await ctxWith([], ['true', 'false', 'echo 不该跑到这里']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R2' });
+
+  assert.equal(out.record.status, 'failed');
+  assert.equal(out.exitCode, EXIT.FAIL);
+  // test 组内失败不中断后续 test 命令——只有 build 失败才中断
+  assert.equal(out.record.commands.length, 3);
+  const doc = await fs.readFile(out.artifactPath, 'utf8');
+  assert.match(doc, /❌ 失败/);
+  assert.doesNotMatch(doc, /✅ 通过/);
+});
+
+test('build 失败即不跑 test——免得根因被连带失败埋掉', async () => {
+  const ctx = await ctxWith(['false', 'echo 第二条构建'], ['echo 测试']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R3' });
+
+  assert.equal(out.record.commands.length, 1, `实际执行了：${out.record.commands.map((c) => c.cmd).join('、')}`);
+  assert.equal(out.record.commands[0]!.cmd, 'false');
+  assert.equal(out.record.status, 'failed');
+});
+
+test('两组皆空 → 落盘一份「未配置」记录并退 64，而不是静默算通过', async () => {
+  const ctx = await ctxWith([], []);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R4' });
+
+  assert.equal(out.record.unconfigured, true);
+  assert.equal(out.exitCode, EXIT.USAGE, '未配置不能退 0——「什么都没跑」不是「通过」');
+  const doc = await fs.readFile(out.artifactPath, 'utf8');
+  assert.match(doc, /均为空/);
+  assert.match(doc, /这\*\*不等于通过\*\*/);
+});
+
+test('命令原文与其 sha256 一并记录，可与配置对账（AC-10）', async () => {
+  const ctx = await ctxWith([], ['echo 对账']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R5' });
+  const rec = out.record.commands[0]!;
+  assert.equal(rec.cmd, 'echo 对账', '必须是配置里的原文，不得规整化');
+  assert.match(rec.cmd_sha256, /^[0-9a-f]{64}$/);
+
+  const meta = JSON.parse(await fs.readFile(out.metaPath, 'utf8')) as VerifyRecord;
+  assert.equal(meta.commands[0]!.cmd_sha256, rec.cmd_sha256);
+  assert.equal(meta.schema, 'trivium.verify.v1');
+});
+
+test('走 shell 执行，管道与 && 语义保留', async () => {
+  const ctx = await ctxWith([], ['echo a && echo b | tr a-z A-Z']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R6' });
+  assert.equal(out.record.status, 'success');
+  assert.match(out.record.commands[0]!.stdout_tail, /B/);
+});
+
+test('在项目根执行，而不是在编排器的工作目录', async () => {
+  const ctx = await ctxWith([], ['pwd']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R7' });
+  assert.equal(out.record.commands[0]!.stdout_tail.trim(), ctx.projectRoot);
+  assert.equal(out.record.project_root, ctx.projectRoot);
+});
+
+test('超时被记录为 timed_out 而非普通失败', async () => {
+  const ctx = await ctxWith([], ['sleep 5']);
+  const out = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R8', timeoutS: 1 });
+  assert.equal(out.record.commands[0]!.timed_out, true);
+  assert.equal(out.record.status, 'failed');
+  const doc = await fs.readFile(out.artifactPath, 'utf8');
+  assert.match(doc, /超时/);
+});
+
+test('重跑不覆盖既有记录（P6 只追加）', async () => {
+  const ctx = await ctxWith([], ['true']);
+  const first = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R9' });
+  const bytes = await fs.readFile(first.artifactPath);
+
+  const second = await runVerify({ ctx, layout: layoutFor(ctx), runId: 'R10' });
+  assert.notEqual(second.artifactPath, first.artifactPath, '第二次必须另起文件');
+  assert.deepEqual(await fs.readFile(first.artifactPath), bytes, '首份记录须逐字节不变');
+});
+
+// ── 渲染与摘要 ──
+
+test('尾部截断保留末尾并标注省略行数', () => {
+  const text = Array.from({ length: 500 }, (_, i) => `line${i}`).join('\n');
+  const t = tailLines(text, 10);
+  const lines = t.split('\n');
+  assert.equal(lines.length, 11, '10 行内容 + 1 行省略提示');
+  assert.match(lines[0]!, /已省略前 490 行/);
+  assert.equal(lines.at(-1), 'line499');
+  // 短文本原样返回
+  assert.equal(tailLines('a\nb', 10), 'a\nb');
+});
+
+test('渲染把失败项排在输出摘要最前', () => {
+  const rec: VerifyRecord = {
+    schema: 'trivium.verify.v1', run_id: 'R', topic: 'T',
+    started_at: 'S', finished_at: 'F', project_root: '/p',
+    commands: [
+      { cmd: 'ok1', cmd_sha256: 'a'.repeat(64), group: 'build', exit_code: 0, duration_s: 1, timed_out: false, stdout_tail: 'fine', stderr_tail: '' },
+      { cmd: 'bad', cmd_sha256: 'b'.repeat(64), group: 'test', exit_code: 3, duration_s: 2, timed_out: false, stdout_tail: '', stderr_tail: 'boom' },
+    ],
+    status: 'failed', unconfigured: false,
+  };
+  const doc = renderVerifyDoc(rec);
+  assert.ok(doc.indexOf('`bad`') < doc.indexOf('### `ok1`'), '看记录的人先要找哪条挂了');
+  assert.match(doc, /工件全部保留/);
+});
+
+test('表格里的管道符被转义，不破坏 Markdown 表格', () => {
+  const rec: VerifyRecord = {
+    schema: 'trivium.verify.v1', run_id: 'R', topic: 'T',
+    started_at: 'S', finished_at: 'F', project_root: '/p',
+    commands: [
+      { cmd: 'a | b', cmd_sha256: 'c'.repeat(64), group: 'test', exit_code: 0, duration_s: 1, timed_out: false, stdout_tail: '', stderr_tail: '' },
+    ],
+    status: 'success', unconfigured: false,
+  };
+  assert.match(renderVerifyDoc(rec), /`a \\\| b`/);
+});
+
+test('摘要点名失败的命令', () => {
+  const rec: VerifyRecord = {
+    schema: 'trivium.verify.v1', run_id: 'R', topic: 'T',
+    started_at: 'S', finished_at: 'F', project_root: '/p',
+    commands: [
+      { cmd: 'npm run build', cmd_sha256: 'd'.repeat(64), group: 'build', exit_code: 1, duration_s: 3, timed_out: false, stdout_tail: '', stderr_tail: '' },
+    ],
+    status: 'failed', unconfigured: false,
+  };
+  assert.match(summarizeVerify(rec), /失败：npm run build/);
+  assert.match(
+    summarizeVerify({ ...rec, unconfigured: true, commands: [] }),
+    /既非通过也非失败/,
+  );
+});
