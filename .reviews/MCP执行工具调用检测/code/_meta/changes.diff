+    capabilities: { glm: TOOL_TRACE_CAPABILITY },
+  });
+  assert.deepEqual(v.fingerprintChangedFiles, []);
+  assert.deepEqual(v.unattributedDriftFiles, ['b.ts']);
+  assert.deepEqual(v.unattributedCauses, ['evidence-untrusted']);
