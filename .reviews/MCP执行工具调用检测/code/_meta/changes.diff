+  assert.equal(result.write_events.length, 1);
+  assert.ok(result.write_events[0]!.startsWith(`${MCP_WRITE_EVENT_PREFIX}mcp__node_repl__js(`), result.write_events[0]);
+  assert.ok(result.write_events[0]!.includes('17 * 23'));
