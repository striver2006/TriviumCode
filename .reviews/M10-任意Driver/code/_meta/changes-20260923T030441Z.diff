diff --git a/test/contract/bash-recovery-wording.test.ts b/test/contract/bash-recovery-wording.test.ts
new file mode 100644
index 0000000..5835cc0
--- /dev/null
+++ b/test/contract/bash-recovery-wording.test.ts
@@ -0,0 +1,107 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { REPO_ROOT } from '../helpers/fixture.js';
+
+/**
+ * §3.2.2 扫描判据的机械核对（M10a 第 2 步 EV-55）。
+ *
+ * 计划把"清单的得出方式"从人工数处数改成一条可执行判据：扫 `src/trivium/` 下
+ * 所有提到 `git checkout|restore|stash|reset` 的文案源串，命中且**对象带保护字面**
+ * （`_meta` / `task.json` / `state.json` / 角色后缀）的，必须同时提示"这一步要在
+ * 终端里手动执行"——因为恢复命令本身会提到受保护路径，被 Bash 守卫的同一条判据
+ * 再拦一次，不是例外。
+ *
+ * **这是防"下次新增一处恢复文案又漏掉"的机械保证，取代人工数处数**（计划 §3.3）。
+ * 判据在**全文件内容**（不是逐行）上做窗口匹配：消息文案常是多行 `+` 拼接的模板串，
+ * "提到 git checkout"与"提到 _meta"可能分处不同行，逐行扫会像本条一开始实测的
+ * 那样**全部漏检**（登记为本测试的防空转依据，见下方防空转腿）。
+ */
+
+const GIT_RECOVERY_RE = /git\s+(checkout|restore|stash|reset)\b/g;
+const PROTECTED_LITERAL_RE = /_meta|task\.json|state\.json|-codex\.md|-gemini\.md|-glm\.md/;
+const TERMINAL_HINT_RE = /终端/;
+const WINDOW = 400; // 字符数，覆盖典型的多行模板串拼接跨度
+
+/**
+ * 粗剥注释（块注释 + 行注释），只为本文件这条窄判据服务——不追求
+ * `test/helpers/strip-non-code.ts` 那种 TS AST 级精度（那个反过来会把我要扫的
+ * 字符串字面量内容也剥掉，两者目标相反：那边要剥"非代码"保留调用实参，
+ * 这里要剥"注释"保留字符串消息本体）。误伤字符串里恰好出现 `//` 的极端情形
+ * 本判据的论域（git 恢复类错误文案）不会触发，代价可接受。
+ */
+function stripComments(src: string): string {
+  return src.replace(/\/\*[\s\S]*?\*\//g, ' ').replace(/\/\/.*$/gm, ' ');
+}
+
+async function collectSourceFiles(root: string): Promise<string[]> {
+  const out: string[] = [];
+  const walk = async (dir: string): Promise<void> => {
+    const entries = await fs.readdir(dir, { withFileTypes: true });
+    for (const e of entries) {
+      const abs = path.join(dir, e.name);
+      if (e.isDirectory()) {
+        await walk(abs);
+        continue;
+      }
+      if (e.name.endsWith('.ts')) out.push(abs);
+    }
+  };
+  await walk(root);
+  return out;
+}
+
+test('§3.2.2 扫描判据：git checkout|restore|stash|reset 文案若对象带保护字面，附近必须有"终端"提示', async () => {
+  const files = await collectSourceFiles(path.join(REPO_ROOT, 'src/trivium'));
+  const offenders: string[] = [];
+
+  for (const f of files) {
+    const raw = await fs.readFile(f, 'utf8');
+    const src = stripComments(raw);
+    for (const m of src.matchAll(GIT_RECOVERY_RE)) {
+      const start = Math.max(0, (m.index ?? 0) - WINDOW);
+      const end = Math.min(src.length, (m.index ?? 0) + WINDOW);
+      const windowText = src.slice(start, end);
+      if (!PROTECTED_LITERAL_RE.test(windowText)) continue; // 对象不带保护字面，不在本判据论域
+      if (!TERMINAL_HINT_RE.test(windowText)) {
+        const line = src.slice(0, m.index).split('\n').length;
+        offenders.push(`${path.relative(REPO_ROOT, f)}:${line}`);
+      }
+    }
+  }
+
+  assert.deepEqual(
+    offenders,
+    [],
+    '以下位置提到 git checkout/restore/stash/reset 且对象带保护字面，' +
+      '但附近没有"这一步需在终端执行"的提示——恢复命令本身会被 Bash 守卫再拦一次，\n' +
+      offenders.join('\n'),
+  );
+});
+
+test('防空转腿：stripComments 真的剥掉了注释，不是静默 no-op', () => {
+  const sample = '/** git checkout 与 _meta 只是在讲机制，不是恢复指引 */\nconst x = 1; // git restore 同上，纯注释\n';
+  const stripped = stripComments(sample);
+  assert.doesNotMatch(stripped, /git checkout/);
+  assert.doesNotMatch(stripped, /git restore/);
+  assert.match(stripped, /const x = 1;/, '代码本体不能被误剥');
+});
+
+test('防空转腿：判据确实是全文件窗口匹配而非逐行——逐行版本会漏掉本仓真实存在过的形态', async () => {
+  /*
+   * 这条锁住"为什么不能逐行扫"这个设计决定本身：构造一段与
+   * `hooks.ts` 提交锚恢复指引同构的多行模板串（git 提示语与 _meta 提示语分处
+   * 不同的字符串字面量、由 `+` 拼接），逐行正则扫不到，窗口扫描能扫到。
+   */
+  const sample =
+    "      '\\n\\n  请用 `git checkout -- <路径>` 或 `git restore <路径>` 恢复。\\n' +\n" +
+    "      '  这一步必须在终端里手动执行：恢复命令的参数正是归档内 _meta/ 下的路径。\\n'";
+  const perLineHit = sample.split('\n').some((line) => GIT_RECOVERY_RE.test(line) && PROTECTED_LITERAL_RE.test(line));
+  GIT_RECOVERY_RE.lastIndex = 0;
+  assert.equal(perLineHit, false, '逐行匹配确实找不到——这正是本测试改用全文件窗口匹配的理由');
+
+  const windowHit = PROTECTED_LITERAL_RE.test(sample) && TERMINAL_HINT_RE.test(sample) && GIT_RECOVERY_RE.test(sample);
+  GIT_RECOVERY_RE.lastIndex = 0;
+  assert.equal(windowHit, true, '窗口匹配应当抓得住这个样例（且样例本身已带"终端"提示，判为合规）');
+});
