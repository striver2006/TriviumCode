+
+/** 归一化：夹具根 / 运行根 / run_id / 时间戳 / pid / 相对时长 */
+function norm(text, fx) {
+  let t = String(text ?? '');
+  if (fx) {
+    t = t.split(fx.root).join('〈ROOT〉').split(fx.runRoot).join('〈RUNROOT〉');
+    const real = (p) => { try { return execFileSync('/bin/realpath', [p], { encoding: 'utf8' }).trim(); } catch { return p; } };
