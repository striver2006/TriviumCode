+  assert.match(r.ok ? '' : r.reason, /不符合 trivium\.review\.v1/);
+});
+
+test('extractJsonCandidates 去重并保序', () => {
+  const one = '{"x":1}';
+  const c = extractJsonCandidates(`${one}\n${one}`);
+  /*
+   * 整段仍「以 { 开头、以 } 结尾」，所以先作为 whole 入列（它解析不了，
