+    `  ${d.a} × ${d.b}：共同覆盖 ${d.overlap.length} 处 ｜ 仅 ${d.a} ${d.onlyA.length} 处 ｜ 仅 ${d.b} ${d.onlyB.length} 处`,
   ];
