+const spec = { targets: [PROTO, EXEC], suites: Object.values(S), cases };
+fs.writeFileSync(OUT, JSON.stringify(spec, null, 2) + '\n');
+console.log(`${cases.length} 条，锚点全部唯一 → ${OUT}`);
