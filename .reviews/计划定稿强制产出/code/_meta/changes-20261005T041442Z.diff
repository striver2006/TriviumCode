+  await put(l, fileName({ r: 2 }), '# r2\n\n相对上一轮的改动：AGY-01 补并发回滚；GLM-01 补超时。\n');
+  const r = await check(l, { reviews: { gemini: review(['AGY-01']), glm: review(['GLM-01']) }, planFinal: PF() });
