+  const seen = new Set<number>([rootPid]);
+  const queue = [rootPid];
+  while (queue.length > 0) {
+    const cur = queue.shift()!;
+    for (const c of children.get(cur) ?? []) {
+      if (seen.has(c)) continue;
+      seen.add(c);
+      n++;
+      queue.push(c);
+    }
+  }
+  return n;
+}
+
+/**
