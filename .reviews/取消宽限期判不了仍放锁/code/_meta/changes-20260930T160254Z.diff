+  const ctx = ctxFor(root);
+  const runId = `20260930T15${String(n).padStart(2, '0')}00Z`;
+  const topic = '探针';
+  const pid = spawnWorker(`trivium-ev176-probe-worker:${c.id}`, c.program);
