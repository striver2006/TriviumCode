+    assert.equal(await workerGoneForCancel(w.pid, rec), false, '同一进程');
+    assert.equal(await workerGoneForCancel(DEAD_PID, rec), true, '不在');
+    const stub = stubPsFailure('both', { pids: [w.pid] });
+    try {
