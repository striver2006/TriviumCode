+/** 本轮运行目录：`<运行根>/<项目槽>/<runId>`。项目槽是哈希后缀名，按 runId 找 */
+async function runDirOf(r: { runRoot: string; meta: RunMeta }): Promise<string> {
+  for (const slot of await fs.readdir(r.runRoot)) {
