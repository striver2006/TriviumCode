+export interface SideLeakVerdict {
+  voided: boolean;
+  path: { hit: boolean; hits: { path: string; category: DenyCategory }[] };
+  command: { hit: boolean; commands: string[]; hits: { command: string; path: string; category: DenyCategory }[] };
+}
