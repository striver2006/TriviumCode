+  '"', "'", '`',
+  '=', ':', ';', '&', '|', '(', ')', '<', '>', ',',
+  // brace expansion（`diff {<peer>,other.md}`，审查意见 AGY-04，已实跑复现漏检）
+  '{', '}',
