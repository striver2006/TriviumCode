+ * 这时不能只看紧邻的那一个字符——要把整段路径拿出来再判。
+ */
+function pathTokenAround(text: string, start: number, end: number): string {
+  let s = start;
+  while (s > 0 && !CMD_BOUNDARY.has(text[s - 1]!)) s--;
+  let e = end;
+  while (e < text.length && !CMD_BOUNDARY.has(text[e]!)) e++;
+  return text.slice(s, e);
