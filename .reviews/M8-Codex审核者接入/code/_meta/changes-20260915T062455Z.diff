+   */
+  const forms: Record<string, string> = {
+    'F-1 绝对路径': `cat ${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md`,
+    'F-2 项目相对': 'cat .reviews/t/code/2026-01-01-t-gemini.md',
