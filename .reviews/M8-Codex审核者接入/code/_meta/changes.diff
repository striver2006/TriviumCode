+export function topLevelKey(text: string, key: string): string | null {
+  for (const line of text.split('\n')) {
+    const s = line.trim();
+    if (s.startsWith('[')) break; // 进入段区，顶层结束
+    const m = new RegExp(`^${key}\\s*=\\s*["'](.+?)["']`).exec(s);
+    if (m) return m[1]!;
+  }
+  return null;
+}
