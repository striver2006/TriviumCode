+const WRITE_VERB_SINK: Record<string, 'last' | 'all-after-flags'> = {
+  cp: 'last', mv: 'last', install: 'last', ln: 'last', truncate: 'last',
+  tee: 'all-after-flags',
+  rm: 'all-after-flags', rmdir: 'all-after-flags',
+  mkdir: 'all-after-flags', touch: 'all-after-flags',
