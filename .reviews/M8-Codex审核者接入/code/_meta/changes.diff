+function judge(over: Partial<CriticResult>, cap?: TraceCapability, review: Review | null = null) {
+  return judgeSide(cfg, 'gemini', result(over), review, REQ, {
+    archiveRootAbs: OPTS.archiveRootAbs,
+    projectRoot: ROOT,
+    ...(cap ? { capability: cap } : {}),
+  });
+}
