+/**
+ * `guard`：只读失守、漂移、对方产出泄漏、Agent 证据下限的判定（设计 §10.3 / §11.4 / §9.2）。
+ *
+ * guard 只**判定**，不做中止决策——中止交给 `gate` 与失败策略。
+ * 这样「检出」与「处置」分开，处置策略可配而检出逻辑恒定。
+ */
+import type { Config, CriticId, CriticRequest, CriticResult, Review } from './types.js';
+import { checkEvidence, checkPeerLeak, checkPeerLeakViaCommand } from './adapters/base.js';
+import { checkReviewIntegrity } from './parse.js';
+import { judgeDrift, driftAction, type DriftVerdict, type Snapshot } from './freeze.js';
+import { ALL_CLI_NAMES } from './agents/registry.js';
+import { matchesAnyGlob } from './util/fsx.js';
+
+export interface SideVerdict {
+  critic: CriticId;
+  evidenceOk: boolean;
+  evidenceReasons: string[];
+  projectReads: number;
+  /** 轨迹中出现写事件 → 审查员失守（比指纹变化更确定） */
+  readonlyBreach: boolean;
+  breachEvidence: string[];
+  /** 轨迹读取路径命中禁读清单，**或**命令原文里出现了禁读条目（措施 b） */
+  peerArtifactRead: boolean;
+  /** 命中的读取路径（措施 a） */
+  peerHits: string[];
+  /**
+   * 命中的**命令原文**（措施 b，§10.2）。
+   *
+   * 与 `peerHits` 分开记而不是并进同一个数组：两者的性质不同——
+   * 路径命中说明它**读了**那个文件，命令命中说明它**跑了**一条提到那个文件的命令
+   * （可能经 git 对象库，文件系统上根本没发生读取）。处置相同，但排查时
+   * 要看得出是哪条通道，否则「为什么 deny 生效了还漏」永远查不清。
+   */
+  peerCommandHits: string[];
+  /** consulted 与轨迹交叉核对未通过 */
+  consultedUnverified: boolean;
+  /** 结构性问题（编号前缀错、重复编号等） */
+  integrityIssues: string[];
+}
+
+/**
+ * 单侧判定。
+ *
+ * `consulted` 交叉核对的阈值是 80%（§11.4）：允许少量路径写法差异，
+ * 但大面积对不上就说明是编造的。
+ */
+export function judgeSide(
+  cfg: Config,
+  critic: CriticId,
+  result: CriticResult,
+  review: Review | null,
+  req: CriticRequest,
+  opts: { archiveRootAbs: string; projectRoot: string },
+): SideVerdict {
+  const ev = checkEvidence(result, req, { archiveRootAbs: opts.archiveRootAbs });
+  const peer = checkPeerLeak(result.read_paths, req.deny_paths, opts.projectRoot);
+  /*
+   * 措施 b（§10.2 / EV-01）：命令原文的字面扫描。
+   *
+   * 与措施 a **同等处置**——两者任一命中即该侧作废。不设权重也不设开关：
+   * §18.1 #8 已拍板「不提供 hard|warn|off 开关」，理由是开关会引入
+   * 「绕过检测」的合法路径；确需收窄 git 通道时裁 `readonly_commands` 已是更强的旋钮。
+   */
+  const peerCmd = checkPeerLeakViaCommand(result.command_texts, req.deny_paths, opts.projectRoot);
+
+  // 轨迹里出现写工具/写命令 = 审查员失守（§10.3 末段：轨迹有写事件的判为失守）
+  const readonlyBreach = result.write_events.length > 0;
+
+  // consulted 与轨迹交叉核对
+  let consultedUnverified = false;
+  const consulted = review?.consulted ?? [];
+  if (consulted.length > 0) {
+    const traceSet = new Set(
+      result.read_paths.map((p) =>
+        p.startsWith(opts.projectRoot) ? p.slice(opts.projectRoot.length).replace(/^\/+/, '') : p,
+      ),
+    );
+    const matched = consulted.filter((c) => traceSet.has(c) || traceSet.has(`./${c}`)).length;
+    consultedUnverified = matched / consulted.length < 0.8;
+  } else if (review !== null) {
+    // 结构化成功但没填 consulted，无法核对
+    consultedUnverified = true;
+  }
+
+  const integrityIssues: string[] = [];
+  if (review) {
+    const i = checkReviewIntegrity(review, critic);
+    if (!i.prefixOk) integrityIssues.push(`编号前缀不属于本侧：${i.badIds.join(', ')}`);
+    if (i.duplicateIds.length > 0) integrityIssues.push(`编号重复：${i.duplicateIds.join(', ')}`);
+    if (i.evidenceNotInConsulted.length > 0) {
+      integrityIssues.push(`evidence 引用但未列入 consulted：${i.evidenceNotInConsulted.join(', ')}`);
+    }
+    if (i.emptyWithoutExplanation) integrityIssues.push('零意见但未说明检查了什么');
+  }
+
+  void cfg;
+  return {
+    critic,
+    evidenceOk: ev.ok,
+    evidenceReasons: ev.reasons,
+    projectReads: ev.projectReads,
+    readonlyBreach,
+    breachEvidence: result.write_events,
+    peerArtifactRead: peer.leaked || peerCmd.leaked,
+    peerHits: peer.hits,
+    peerCommandHits: peerCmd.hits,
+    consultedUnverified,
+    integrityIssues,
+  };
+}
+
+export interface RunVerdict {
+  sides: Partial<Record<CriticId, SideVerdict>>;
+  drift: DriftVerdict;
+  driftAction: 'ok' | 'warn' | 'fail';
+  /** 指纹变化但轨迹无写事件 → 开发者手改，按漂移处置而非失守（§9.2 第 4 步） */
+  fingerprintChangedFiles: string[];
+  readonlyBreach: boolean;
+  breachedFiles: string[];
+  peerArtifactRead: boolean;
+}
+
+export interface JudgeRunInput {
+  cfg: Config;
+  projectRoot: string;
+  archiveRootAbs: string;
+  /** 归档根的项目相对路径，漂移判定要整体排除它 */
+  archiveRootRel: string;
+  /** `.trivium/` 的项目相对路径，同样排除；缺省 `.trivium` */
+  triviumDirRel?: string;
+  before: Snapshot;
+  afterTreeHash: string;
+  afterSubjectSha256: string;
+  relatedPaths: string[];
+  results: Partial<Record<CriticId, CriticResult>>;
+  reviews: Partial<Record<CriticId, Review | null>>;
+  requests: Partial<Record<CriticId, CriticRequest>>;
+}
+
+/** 整次运行的判定 */
+export async function judgeRun(input: JudgeRunInput): Promise<RunVerdict> {
+  const { cfg, results, reviews, requests } = input;
+
+  /*
+   * 全部已探 CLI 的 scratch 白名单并集：这一步不能省，否则会把 Agent 自己的
+   * 会话缓存误判成「只读失守」（M0 实测本机两侧均为空，但别的机器上未必）。
+   *
+   * 遍历而不是写死两段（原文是 `[...cfg.probe.agy.scratch_paths, ...cfg.probe.zcode.scratch_paths]`）：
+   * 探针段 Partial 化之后那种写法在 `noUncheckedIndexedAccess` 下直接编译不过，
+   * 而若图省事强转，缺段时会变成运行期 TypeError——这是 guard 这条只读护栏的路径，
+   * 不能靠强转糊过去（审查意见 AGY-03）。取并集也天然对第三家成立。
+   *
+   * 按 `ALL_CLI_NAMES` 取键，**不按盘上实有键**（审查意见 GLM-08）：
+   * `Object.values(cfg.probe.cli)` 会把未登记的键也算进来，于是一个没人登记的段
+   * 能往只读失守的白名单里塞 glob——而 `preflight` / `doctor` 都按注册表遍历、
+   * 根本看不见它。`schemas.ts` 已补了「probe.cli 键 ⊆ 已登记 CLI」的校验把关，
+   * 这里同口径是第二道：即使有人直接改盘绕过校验，影响面也不会扩大。
+   */
+  const scratchGlobs = ALL_CLI_NAMES.flatMap((n) => cfg.probe.cli[n]?.scratch_paths ?? []);
+
+  const drift = await judgeDrift({
+    cfg,
+    projectRoot: input.projectRoot,
+    before: input.before,
+    afterTreeHash: input.afterTreeHash,
+    afterSubjectSha256: input.afterSubjectSha256,
+    relatedPaths: input.relatedPaths,
+    scratchGlobs,
+    archiveRootRel: input.archiveRootRel,
+    ...(input.triviumDirRel ? { triviumDirRel: input.triviumDirRel } : {}),
+  });
+
+  const sides: Partial<Record<CriticId, SideVerdict>> = {};
+  for (const c of Object.keys(results) as CriticId[]) {
+    const r = results[c];
+    const q = requests[c];
+    if (!r || !q) continue;
+    /*
+     * 已经失败或超时的一侧不再评判证据。
+     *
+     * 一个超时被 SIGTERM 掉的进程当然「零工具调用、零项目文件读取」——
+     * 再报一遍「证据不足」只会把真正的原因（超时）埋在噪音里。
+     * 真实运行中就出现过这种误导：glm 侧 900s 超时，人读输出却说它证据不足。
+     * 失败原因由 runner 的 fail_reason 与 decideMode 的 degraded_reason 负责。
+     */
+    if (r.status === 'timeout' || r.status === 'failed') continue;
+    sides[c] = judgeSide(cfg, c, r, reviews[c] ?? null, q, {
+      archiveRootAbs: input.archiveRootAbs,
+      projectRoot: input.projectRoot,
+    });
+  }
+
+  const breachedFiles = Object.values(sides).flatMap((s) => s?.breachEvidence ?? []);
+  const fingerprintChangedFiles =
+    drift.kind === 'related' || drift.kind === 'unrelated' ? drift.files : [];
+
+  return {
+    sides,
+    drift,
+    driftAction: driftAction(cfg, drift),
+    fingerprintChangedFiles: fingerprintChangedFiles.filter(
+      (f) => !matchesAnyGlob(f, scratchGlobs),
+    ),
+    readonlyBreach: Object.values(sides).some((s) => s?.readonlyBreach === true),
+    breachedFiles: [...new Set(breachedFiles)],
+    peerArtifactRead: Object.values(sides).some((s) => s?.peerArtifactRead === true),
+  };
+}
+
+/** 人读告警文本（命令输出用）。**绝不自动 git checkout 回滚**（§10.3） */
+export function renderGuardWarnings(v: RunVerdict): string[] {
+  const out: string[] = [];
+
+  if (v.readonlyBreach) {
+    out.push(
+      '只读失守：审查员的工具轨迹中出现了写事件。受影响的调用：\n' +
+        v.breachedFiles.map((f) => `    ${f}`).join('\n') +
+        '\n  编排器**不会**自动回滚。建议人工核对：\n' +
+        '    git status --porcelain -uall\n' +
+        '    git diff\n' +
+        '  确认无误后再决定是否 `git checkout --` 相关文件。',
+    );
+  }
+
+  if (v.peerArtifactRead) {
+    for (const s of Object.values(v.sides)) {
+      if (!s?.peerArtifactRead) continue;
+      /*
+       * 两条通道分开播报（措施 a / 措施 b）。
+       *
+       * 合并成一行会在**只有命令通道命中**时打出「读到了禁读清单内的文件：」后面跟空清单
+       * ——处置是对的（该侧照样作废），但人读留痕看起来像个 bug，排查的人会先去
+       * 怀疑检测器本身。两条通道的性质本来就不同：路径命中说明它读了那个文件，
+       * 命令命中说明它跑了一条提到那个文件的命令（可能经 git 对象库，文件系统上没发生读取）。
+       */
+      if (s.peerHits.length > 0) {
+        out.push(`${s.critic} 侧读到了禁读清单内的文件：${s.peerHits.join(', ')}——该侧结论作废`);
+      }
+      if (s.peerCommandHits.length > 0) {
+        out.push(
+          `${s.critic} 侧的命令里出现了禁读清单内的路径：${s.peerCommandHits.join(' ｜ ')}` +
+            '——该侧结论作废（措施 b：命令文本通道，可能经 git 对象库取值而不产生文件读取）',
+        );
+      }
+    }
+  }
+  switch (v.drift.kind) {
+    case 'subject_drift':
+      out.push('被审对象在审查期间被修改：本次结论已不对应送审的那份内容，整次运行作废');
+      break;
+    case 'related':
+      out.push(
+        `与被审范围相关的文件在审查期间被修改（策略 ${v.driftAction}）：\n` +
+          v.drift.files.map((f) => `    ${f}`).join('\n'),
+      );
+      break;
+    case 'unrelated':
+      out.push(
+        `审查期间有无关文件被修改（策略 ${v.driftAction}）：\n` +
+          v.drift.files.map((f) => `    ${f}`).join('\n'),
+      );
+      break;
+    case 'none':
+      break;
+  }
+  for (const s of Object.values(v.sides)) {
+    if (!s) continue;
+    if (!s.evidenceOk) out.push(`${s.critic} 侧 Agent 执行证据不足：${s.evidenceReasons.join('；')}`);
+    if (s.integrityIssues.length > 0) out.push(`${s.critic} 侧结论结构问题：${s.integrityIssues.join('；')}`);
+    if (s.consultedUnverified) out.push(`${s.critic} 侧 consulted 无法与工具轨迹交叉核对`);
+  }
+  return out;
+}
diff --git a/test/unit/peer-leak-command.test.ts b/test/unit/peer-leak-command.test.ts
new file mode 100644
index 0000000..8e52fa7
--- /dev/null
+++ b/test/unit/peer-leak-command.test.ts
@@ -0,0 +1,190 @@
+/**
+ * 措施 b（设计 §10.2 / BACKLOG EV-01）：命令文本字面扫描。
+ *
+ * **用例名与 `adapters/base.ts` 的已知形态清单一一对应**（`[F-n]` 前缀）。
+ * 计划双审 GLM-07 要求把论域钉成可审计的闭集：不写数量，写清单；
+ * 清单改了这里必须跟着改，`known-forms` 那条守卫会红。
+ *
+ * 为什么不写「五类」这个数字：起草计划时我从 `CLAUDE.md` 里 **RV-B1**（git commit
+ * 的 Bash 拦截）搬了「五类形态」这个说法过来，那是**另一件事**的计数，
+ * 与本措施毫无关系。数字随清单长度自然得出，不再单独出现。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { checkPeerLeakViaCommand } from '../../src/trivium/adapters/base.js';
+
+const ROOT = '/Users/x/proj';
+/** 典型 deny 条目：一份对端产物（文件）与一个运行目录（目录） */
+const DENY = [
+  `${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md`,
+  `${ROOT}/.trivium`,
+];
+
+function hit(cmd: string): boolean {
+  return checkPeerLeakViaCommand([cmd], DENY, ROOT).leaked;
+}
+
+/* ── 已知形态：必检 ────────────────────────────────────────────────── */
+
+test('[F-1] 绝对路径直引', () => {
+  assert.equal(hit(`cat ${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md`), true);
+});
+
+test('[F-2] 项目相对路径直引（含 ./ 前缀）', () => {
+  assert.equal(hit('cat .reviews/t/code/2026-01-01-t-gemini.md'), true);
+  assert.equal(hit('head -1 ./.reviews/t/code/2026-01-01-t-gemini.md'), true);
+});
+
+test('[F-3] git 对象库取值 —— 措施 a 看不见的那条通道', () => {
+  /*
+   * 这一条是整个措施 b 的存在理由：`git show HEAD:<path>` **不产生文件系统读取**，
+   * 轨迹的 read_paths 里什么都没有，路径侧核验对它的效力是零。
+   */
+  assert.equal(hit('git show HEAD:.reviews/t/code/2026-01-01-t-gemini.md'), true);
+  assert.equal(hit('git cat-file -p 9f2a1c3:.reviews/t/code/2026-01-01-t-gemini.md'), true);
+});
+
+test('[F-4] 目录级条目命中：deny 里是目录，命令读它下面的文件', () => {
+  assert.equal(hit('ls -la .trivium/'), true);
+  assert.equal(hit(`cat ${ROOT}/.trivium/state.json`), true);
+});
+
+test('[F-5] 引号与转义包裹', () => {
+  assert.equal(hit(`cat "${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md"`), true);
+  assert.equal(hit("cat '.reviews/t/code/2026-01-01-t-gemini.md'"), true);
+  assert.equal(hit('cat `echo .reviews/t/code/2026-01-01-t-gemini.md`'), true);
+});
+
+test('known-forms：清单里的每一类都有用例，且每一类都真的能命中', () => {
+  /*
+   * 这条守着「清单」与「实现」不分叉。它不是同义反复——上面五条各测各的形态，
+   * 这条测的是**集合**：任何一类被实现漏掉，这里会红在具体那一行上。
+   *
+   * 起草时我差点把它写成「用例数 === 5」——那种断言按构造恒真，
+   * 改坏实现不会红（本项目已四次栽在「绿测试证明不了任何事」上）。
+   */
+  const forms: Record<string, string> = {
+    'F-1 绝对路径': `cat ${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md`,
+    'F-2 项目相对': 'cat .reviews/t/code/2026-01-01-t-gemini.md',
+    'F-3 git 对象库': 'git show HEAD:.reviews/t/code/2026-01-01-t-gemini.md',
+    'F-4 目录级': 'ls .trivium/',
+    'F-5 引号包裹': `cat "${ROOT}/.reviews/t/code/2026-01-01-t-gemini.md"`,
+  };
+  for (const [name, cmd] of Object.entries(forms)) {
+    assert.equal(hit(cmd), true, `${name} 应被检出：${cmd}`);
+  }
+});
+
+/* ── 边界：不得误命中 ──────────────────────────────────────────────── */
+
+test('【误报】同前缀的兄弟目录不得命中', () => {
+  /*
+   * `.trivium` 是 deny 条目，`.trivium-backup` 不是。纯 startsWith 会误伤，
+   * 而误伤的后果是一次本该采纳的审查被判作废——比漏报更容易被当成系统故障。
+   * 路径侧的 checkPeerLeak 早有同款守卫（其注释点名了这个坑），这里是命令侧的对应物。
+   */
+  assert.equal(hit('ls .trivium-backup/'), false);
+  assert.equal(hit(`cat ${ROOT}/.trivium-backup/config.yaml`), false);
+});
+
+test('【误报】同名文件在别的仓库里，不得因项目相对写法命中', () => {
+  assert.equal(hit('cat /Users/other/repo/.reviews/t/code/2026-01-01-t-gemini.md'), false);
+});
+
+test('【误报】文件名是更长路径的一段尾巴，不得命中', () => {
+  assert.equal(hit('cat /tmp/backup-.reviews/t/code/2026-01-01-t-gemini.md'), false);
+});
+
+test('读自己的产出不算泄漏', () => {
+  assert.equal(hit('cat .reviews/t/code/2026-01-01-t-claude.md'), false);
+  assert.equal(hit('git log --oneline -5'), false);
+});
+
+/* ── macOS 的 /private 前缀：两侧归一必须一致 ──────────────────────── */
+
+test('项目根带 /private 前缀时，项目相对写法仍要能命中', () => {
+  /*
+   * **这条是被故障注入用例逼出来的，不是我想到的。**
+   *
+   * `normalizeAbs` 会剥掉 macOS 的 `/private`（`/private/var/…` → `/var/…`），
+   * 而 `spellingsOf` 起初拿 `nodePath.resolve(projectRoot)` 的**原样**去比前缀，
+   * 于是在临时目录下 `startsWith` 恒假、项目相对写法一个都派生不出来。
+   *
+   * 上面那 17 条全绿——因为它们用的是干净的 `/Users/x/proj`，两边都不带 `/private`，
+   * 恰好绕开了差异。**测试数据的「干净」本身就能藏 bug。**
+   */
+  const privRoot = '/private/var/folders/ab/T/trivium-fx-XYZ';
+  const deny = ['.env', '.trivium'];
+  const cmds = deny.map((p) => `git show HEAD:${p}`);
+  const r = checkPeerLeakViaCommand(cmds, deny, privRoot);
+  assert.equal(r.leaked, true);
+  assert.equal(r.hits.length, 2);
+});
+
+test('deny 条目本身带 /private 的绝对路径，命令照原样写也要命中', () => {
+  const privRoot = '/private/var/folders/ab/T/trivium-fx-XYZ';
+  const denyAbs = `${privRoot}-runs`;
+  assert.equal(
+    checkPeerLeakViaCommand([`ls ${denyAbs}`], [denyAbs], privRoot).leaked, true,
+  );
+});
+
+/* ── 空集与返回形态 ───────────────────────────────────────────────── */
+
+test('没有命令、或没有禁读条目时，恒不命中且不抛', () => {
+  assert.deepEqual(checkPeerLeakViaCommand([], DENY, ROOT), { leaked: false, hits: [] });
+  assert.deepEqual(checkPeerLeakViaCommand(['cat x'], [], ROOT), { leaked: false, hits: [] });
+});
+
+test('返回的是**命令原文**而不是命中的路径', () => {
+  /*
+   * 这是刻意的：`git show HEAD:<path>` 与 `cat <path>` 在留痕上必须区分得开——
+   * 两者的性质差别正是措施 b 存在的理由。只报路径的话，排查的人看不出
+   * 「deny 生效了为什么还漏」。
+   */
+  const cmd = 'git show HEAD:.reviews/t/code/2026-01-01-t-gemini.md';
+  const r = checkPeerLeakViaCommand([cmd, 'ls'], DENY, ROOT);
+  assert.deepEqual(r.hits, [cmd]);
+});
+
+test('多条命令命中时去重', () => {
+  const cmd = 'cat .reviews/t/code/2026-01-01-t-gemini.md';
+  const r = checkPeerLeakViaCommand([cmd, cmd, 'ls .trivium/'], DENY, ROOT);
+  assert.equal(r.hits.length, 2);
+});
+
+/* ── 明确检测不到的：把边界锁成断言，而不是只写在文档里 ──────────── */
+
+/*
+ * 把盲区写成**会红的断言**而不是只写进注释：哪天有人「顺手」扩了匹配面，
+ * 这些会红，那时必须回到 §10.1 重新掂量承诺面，而不是默默扩大它。
+ *
+ * **起草这组时我写错了两条，实测才发现**——两个方向都错：
+ * 一是把「变量拼接」整类判成盲区（实际只有**分段**拼接躲得过，
+ * 整条赋值里带完整字面量是能检出的）；二是举 `git log -p -- .reviews` 当例子，
+ * 而 `.reviews` 根本不在 deny 里，那个例子什么都证明不了。
+ * 盲区写成断言的价值正在这里：**它会红在我的错误认知上**，散文不会。
+ */
+
+test('【已知盲区 B-1】分段拼接 —— 完整字面量从不出现', () => {
+  assert.equal(hit('P=.reviews/t; cat $P/code/2026-01-01-t-gemini.md'), false);
+});
+
+test('【非盲区】整条赋值里带完整字面量，是能检出的', () => {
+  // 与 B-1 的差别只在字面量完不完整；它在命令文本里就检得出，与变量无关
+  assert.equal(hit('P=.reviews/t/code/2026-01-01-t-gemini.md; cat $P'), true);
+});
+
+test('【已知盲区 B-2】目录级 git 读取 —— 四条里唯一非蓄意也会撞上的', () => {
+  /*
+   * `git log -p -- <目录>` 会把该目录下全部历史内容吐出来（含对端产物），
+   * 而命令文本里只有目录名、没有文件名。这是 §10.1「git 通道保留能力而非封死」
+   * 那条取舍的代价：收窄它的旋钮是裁 readonly_commands，不是在这里加机制。
+   */
+  assert.equal(hit('git log -p -- .reviews/t/code'), false, '覆盖到了该文件却不指名');
+  assert.equal(hit('git log -p -- .reviews/t/code/2026-01-01-t-gemini.md'), true, '指名了就命中');
+});
+
+test('【已知盲区 B-3】glob 展开检测不到', () => {
+  assert.equal(hit('cat .reviews/*/code/*-gemini.md'), false);
+});
