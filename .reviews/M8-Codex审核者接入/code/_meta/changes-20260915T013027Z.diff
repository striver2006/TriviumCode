+      for (;;) {
+        const i = cmd.indexOf(s, from);
+        if (i < 0) return false;
+        if (boundaryOk(cmd, i, i + s.length)) return true;
+        from = i + 1;
+      }
+    }),
+  );
+  return { leaked: hits.length > 0, hits: [...new Set(hits)] };
+}
