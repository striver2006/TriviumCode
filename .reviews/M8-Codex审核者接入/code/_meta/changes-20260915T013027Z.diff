+/** 命令文本里能合法紧邻路径两侧的字符——用于避免子串误命中 */
+const CMD_BOUNDARY = new Set([
+  ' ', '\t', '\n', '\r',
+  '"', "'", '`',
+  '=', ':', ';', '&', '|', '(', ')', '<', '>', ',',
+]);
+
+function boundaryOk(text: string, start: number, end: number): boolean {
+  const before = start === 0 ? '' : text[start - 1]!;
+  const after = end >= text.length ? '' : text[end]!;
+  // 左边界：行首或分隔符。防「/other/proj/.reviews/…」被项目相对写法误命中
+  if (before !== '' && !CMD_BOUNDARY.has(before)) return false;
+  // 右边界：行尾、分隔符，或 `/`（目录条目下的更深路径，F-4）
+  if (after !== '' && after !== nodePath.sep && !CMD_BOUNDARY.has(after)) return false;
+  return true;
