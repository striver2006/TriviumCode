diff --git a/src/trivium/tier-flags.ts b/src/trivium/tier-flags.ts
new file mode 100644
index 00000000..0452f9b2
--- /dev/null
+++ b/src/trivium/tier-flags.ts
@@ -0,0 +1,133 @@
+/**
+ * 档位命令行旗标：`--tier-〈id〉` / `--effort-〈id〉` / `--profile-〈id〉`（M11 第 5 步，设计 7.1「档位旗标」、11.5）。
+ *
+ * **收集、键校验、取值校验、合并只此一份**——`cli.ts`（review / preflight）与 `topic-args.ts`（topic resolve）
+ * 共用。同一判定有两个入口时判定必须只有一份（EV-53）：上一次只收口一个入口，另一个原样丢参数。
+ *
+ * ## 三类旗标与 `--model-〈id〉` 的关系
+ *
+ * - **收集面 = 全部已登记 Agent**：写给本轮当不了审核者的一家，要落到明确报错上，而不是被 `topic resolve`
+ *   当正文吞进焦点（与 `collectModelOverrides` 同理）。
+ * - **键判定与 `--model-〈id〉` 同一份**：`critics.ts` 的 `assertCriticFlagKeys`。
+ * - **`--profile-〈id〉` 多一格**：只有适配器实现了 `vendorProfilesFor` 钩子的那一家成立——今天派生结果恰为
+ *   `--profile-codex`（规格写的名字），源码不写任何 Agent id（用户 2026-10-08 定）。它与 trivium 自己的
+ *   `--profile 〈档位表名〉` 是两个命名空间。
+ *
+ * ## 过渡期（第 6 步之前）
+ *
+ * 思考等级与厂商 profile 还没透传给适配器：`--effort-〈id〉` 与不等于 `agents.〈id〉.profile` 的 `--profile-〈id〉`
+ * 会被预检的过渡闸拦下退 64（`preflight.ts` `checkTierCombos`；gemini 的 slug 已编码档位时只告警）。
+ * 本模块只做形状层的判定，不替过渡闸做决定。
+ */
+import type { Config, CriticId, TierName } from './types.js';
+import { ALL_AGENT_IDS, type AgentId } from './agents/registry.js';
+import { TIER_NAMES, type TierOverrides } from './adapters/base.js';
+import { realAdapters } from './adapters/index.js';
+import { assertCriticFlagKeys, type CriticFlagPrefix } from './critics.js';
+import { usageError } from './exit-codes.js';
+
+/** 一侧的命令行精确值（不含 model——那一类仍走 `--model-〈id〉` 的既有通道） */
+export interface TierFlagValues {
+  tier?: TierName;
+  effort?: string;
+  vendorProfile?: string;
+}
+
+type Kind = Exclude<CriticFlagPrefix, 'model'>;
+const KINDS: readonly Kind[] = ['tier', 'effort', 'profile'];
+
+/** 三类旗标的全部名字（逐已登记 Agent）。`topic resolve` 的白名单与 help 都从这里取 */
+export function tierFlagNames(): string[] {
+  return KINDS.flatMap((k) => ALL_AGENT_IDS.map((id) => `${k}-${id}`));
+}
+
+/** 适配器实现了 `vendorProfilesFor` 的 Agent——`--profile-〈id〉` 只对它们成立 */
+export function vendorProfileAgents(): AgentId[] {
+  const table = realAdapters();
+  return ALL_AGENT_IDS.filter((id) => typeof table[id as CriticId]?.vendorProfilesFor === 'function');
+}
+
+/** 收集结果：键是 Agent id，值是原文（**空串表示写了没给值**，与「没写」区分） */
+export type RawTierFlags = Record<Kind, Record<string, string>>;
+
+/**
+ * 收集三类旗标。`get` 返回 `undefined` 表示没写；返回空串表示写了但没给值（计划三审 AGY-02：
+ * `topic resolve` 对缺值记空串，按真假过滤会把它静默丢掉）。
+ */
+export function collectTierFlags(get: (name: string) => string | undefined): RawTierFlags {
+  const out: RawTierFlags = { tier: {}, effort: {}, profile: {} };
+  for (const k of KINDS) {
+    for (const id of ALL_AGENT_IDS) {
+      const v = get(`${k}-${id}`);
+      if (v !== undefined) out[k][id] = v;
+    }
+  }
+  return out;
+}
+
+/** 有没有写任何一个 */
+export function hasTierFlags(raw: RawTierFlags): boolean {
+  return KINDS.some((k) => Object.keys(raw[k]).length > 0);
+}
+
+/**
+ * 键校验 + 取值的形状校验，通过即返回逐入选侧的精确值。全部退 64、在任何落盘之前。
+ *
+ * 次序：①键（与 `--model-〈id〉` 同一判定）；②`--profile-〈id〉` 的该侧有没有厂商 profile 概念；
+ * ③空值；④`--tier-〈id〉` 只收三档名。原生枚举、本机名单与过渡闸不在这里——那是 `checkTierCombos` 的事，
+ * 与配置来源同一处、同一文案。
+ */
+export function assertTierFlags(
+  cfg: Config,
+  driver: AgentId,
+  raw: RawTierFlags,
+  picked: readonly string[],
+): Partial<Record<CriticId, TierFlagValues>> {
+  for (const k of KINDS) assertCriticFlagKeys(cfg, driver, Object.keys(raw[k]), picked, k);
+
+  const withProfile = new Set<string>(vendorProfileAgents());
+  for (const id of Object.keys(raw.profile)) {
+    if (!withProfile.has(id)) {
+      throw usageError(
+        `--profile-${id}：${id} 没有厂商 profile 概念，这个旗标对它不成立。\n` +
+          `  --profile-〈id〉 是厂商 CLI 自己的配置分层名，不是 trivium 的 --profile 〈档位表名〉。\n` +
+          `  可用：${[...withProfile].map((a) => `--profile-${a}`).join(' | ') || '（本机没有任何一家有厂商 profile 概念）'}`,
+      );
+    }
+  }
+
+  for (const k of KINDS) {
+    for (const [id, v] of Object.entries(raw[k])) {
+      if (v === '') throw usageError(`--${k}-${id} 需要一个值，但没有给出。`);
+    }
+  }
+
+  for (const [id, v] of Object.entries(raw.tier)) {
+    if (!(TIER_NAMES as readonly string[]).includes(v)) {
+      throw usageError(`--tier-${id} 只接受 ${TIER_NAMES.join(' | ')}，收到：${v}`);
+    }
+  }
+
+  const out: Partial<Record<CriticId, TierFlagValues>> = {};
+  const slot = (id: string): TierFlagValues => (out[id as CriticId] ??= {});
+  for (const [id, v] of Object.entries(raw.tier)) slot(id).tier = v as TierName;
+  for (const [id, v] of Object.entries(raw.effort)) slot(id).effort = v;
+  for (const [id, v] of Object.entries(raw.profile)) slot(id).vendorProfile = v;
+  return out;
+}
+
+/**
+ * 模型覆盖与三类旗标逐侧合并成 `resolveTier` 的命令行一级。**合并只此一份**（计划三审 CODEX-02）：
+ * `checkModelSlugs` / `checkTierCombos` 内部调它，`review.ts` 的路由点用准备阶段算好的同一份结果。
+ */
+export function mergeCliOverrides(
+  models: Partial<Record<CriticId, string>>,
+  flags: Partial<Record<CriticId, TierFlagValues>> = {},
+): Partial<Record<CriticId, TierOverrides>> {
+  const out: Partial<Record<CriticId, TierOverrides>> = {};
+  for (const id of new Set([...Object.keys(models), ...Object.keys(flags)]) as Set<CriticId>) {
+    const m = models[id];
+    out[id] = { ...(m ? { model: m } : {}), ...(flags[id] ?? {}) };
+  }
+  return out;
+}
diff --git a/test/integration/tier-flags-cli.test.ts b/test/integration/tier-flags-cli.test.ts
new file mode 100644
index 00000000..04bbf427
--- /dev/null
+++ b/test/integration/tier-flags-cli.test.ts
@@ -0,0 +1,118 @@
+/**
+ * 档位命令行旗标的端到端（M11 第 5 步，设计 7.1「档位旗标」；计划 r2 §3.1）。
+ *
+ * 走真实打包产物：`topic resolve` 的输出字段、写了不给值的空值格（计划三审 AGY-02）、
+ * 以及「resolve 输出照抄进 preflight 与 `review --start`」——三处同一组值时预检通过、`--start` 能启动、
+ * 请求模型真的取自所选的档，且两处都念出留痕空窗告警（用户 2026-10-08 定 ②）。
+ * 非法旗标的零工件格在 `no-artifacts.test.ts`。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { promises as fs } from 'node:fs';
+import { bundleMissing, bundleSkipReason, cli, makeFixture, seedFakeProbes } from '../helpers/fixture.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import { extractJsonCandidate } from '../../src/trivium/parse.js';
+import type { StubConfig } from '../../src/trivium/adapters/stub.js';
+
+const TOPIC = '档位旗标端到端';
+const STUB: StubConfig = { gemini: { mode: 'ok' }, glm: { mode: 'ok' } };
+const parse = <T>(stdout: string): T => JSON.parse(extractJsonCandidate(stdout)!.json) as T;
+type Warning = { name: string; detail: string };
+type Resolved = { tiers: Record<string, string>; efforts: Record<string, string>; vendor_profiles: Record<string, string>; critics: string[] };
+
+/** 给 gemini 配一档 low（只写 model），追加在夹具配置末尾 */
+async function withGeminiTier(root: string, model: string): Promise<void> {
+  await fs.appendFile(
+    path.join(root, '.trivium', 'config.yaml'),
+    `agents:\n  gemini:\n    tiers:\n      low: { model: ${model} }\n`,
+    'utf8',
+  );
+}
+
+async function resolve(root: string, extra: string[]) {
+  const r = await cli(root, ['topic', 'resolve', '--stage', 'plan', '--json', '--', '做个功能', '--topic', TOPIC, '--focus', 'x', ...extra]);
+  return { r, json: r.code === EXIT.OK ? parse<Resolved>(r.stdout) : null };
+}
+
+/** 把 resolve 输出照抄成旗标——命令 A 的 S0.6 / S2 / S6 就是这样做的 */
+function relay(j: Resolved): string[] {
+  return [
+    '--critics', j.critics.join(','),
+    ...Object.entries(j.tiers).flatMap(([id, v]) => [`--tier-${id}`, v]),
+    ...Object.entries(j.efforts).flatMap(([id, v]) => [`--effort-${id}`, v]),
+    ...Object.entries(j.vendor_profiles).flatMap(([id, v]) => [`--profile-${id}`, v]),
+  ];
+}
+
+test('T1 resolve 输出三字段：只含本轮入选侧，没写时为空对象', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC });
+  const none = await resolve(fx.root, []);
+  assert.equal(none.r.code, EXIT.OK, none.r.stdout + none.r.stderr);
+  assert.deepEqual([none.json!.tiers, none.json!.efforts, none.json!.vendor_profiles], [{}, {}, {}]);
+
+  const some = await resolve(fx.root, ['--tier-gemini', 'low', '--effort-glm', 'whatever']);
+  assert.equal(some.r.code, EXIT.OK, some.r.stdout + some.r.stderr);
+  assert.deepEqual(some.json!.tiers, { gemini: 'low' });
+  assert.deepEqual(some.json!.efforts, { glm: 'whatever' }, '取值的形状这里只查非空，枚举与过渡闸在预检');
+  assert.deepEqual(some.json!.vendor_profiles, {});
+});
+
+test('T2 resolve：写了不给值（后面紧跟另一个旗标）⇒ 退 64，不静默丢弃（计划三审 AGY-02）', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC });
+  const r = await cli(fx.root, ['topic', 'resolve', '--stage', 'plan', '--json', '--', '做个功能', '--topic', TOPIC, '--tier-gemini', '--focus', 'x']);
+  assert.equal(r.code, EXIT.USAGE, r.stdout + r.stderr);
+  assert.match(r.stdout + r.stderr, /--tier-gemini 需要一个值/);
+});
+
+test('T3 resolve 输出照抄进 preflight：通过，并念出留痕空窗告警', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC });
+  await seedFakeProbes(fx.root);
+  await withGeminiTier(fx.root, 'gemini-3.8-flash-high');
+  const { json } = await resolve(fx.root, ['--critics', 'gemini', '--tier-gemini', 'low']);
+  assert.ok(json, '前提：resolve 通过');
+  const r = await cli(fx.root, ['preflight', '--stage', 'plan', ...relay(json!), '--skip-auth-check', '--json'], null, 180_000);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  const js = parse<{ ok: boolean; warnings: Warning[] }>(r.stdout);
+  assert.ok(js.warnings.some((w) => /本轮档位名与来源尚未入档.*--tier-gemini low/.test(w.detail)), JSON.stringify(js.warnings));
+});
+
+/*
+ * worker 从交接文件读到档位旗标（计划 r2 §2.4）：选一个与当轮 Driver 同族的档位模型，跑完核 run.json 的
+ * override_reason 认得 `--tier-gemini`——不认就会归因成「档位表默认模型」，把命令行的选择记到配置头上。
+ * 旧形状交接文件（不带 tierFlags）由其余全部 worker 用例覆盖：没写档位旗标时交接文件不含这个键。
+ */
+test('T5 --tier 选出的同族模型：override_reason 认得 --tier（worker 经交接文件拿到档位旗标）', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC });
+  await withGeminiTier(fx.root, 'claude-tier-x');
+  const r = await cli(fx.root, ['review', '--start', '--stage', 'plan', '--topic', TOPIC, '--focus', 'x', '--critics', 'gemini,glm', '--tier-gemini', 'low', '--json'], STUB);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  const runId = parse<{ run_id: string }>(r.stdout).run_id;
+  let code: number = EXIT.FAIL;
+  for (let i = 0; i < 10; i++) {
+    code = (await cli(fx.root, ['review', '--wait', runId, '--timeout', '20'], STUB, 60_000)).code ?? EXIT.FAIL;
+    if (code !== 73) break;
+  }
+  assert.equal(code, EXIT.OK, `运行没有正常结束（退 ${code}）`);
+  const meta = JSON.parse(await fs.readFile(path.join(fx.stageDir, '_meta', `run-${runId}.json`), 'utf8')) as {
+    critics: Record<string, { heterogeneous?: boolean; override_reason?: string | null }>;
+  };
+  assert.equal(meta.critics['gemini']?.heterogeneous, false, '前提：档位模型与当轮 Driver 同族');
+  assert.match(meta.critics['gemini']?.override_reason ?? '', /用户经 --tier-gemini low 选出了与当轮 Driver（.+）同族的模型/);
+});
+
+test('T4 resolve 输出照抄进 review --start：能启动、请求模型取自所选的档、warnings 念出留痕空窗', { skip: bundleMissing && bundleSkipReason }, async () => {
+  const fx = await makeFixture({ topic: TOPIC });
+  await withGeminiTier(fx.root, 'g-tier-low');
+  const { json } = await resolve(fx.root, ['--tier-gemini', 'low']);
+  assert.ok(json, '前提：resolve 通过');
+  const r = await cli(fx.root, ['review', '--start', '--stage', 'plan', '--topic', TOPIC, '--focus', 'x', ...relay(json!), '--json'], STUB);
+  assert.equal(r.code, EXIT.OK, r.stdout + r.stderr);
+  const js = parse<{ run_id: string; models: Record<string, string>; warnings: Warning[] }>(r.stdout);
+  try {
+    assert.equal(js.models['gemini'], 'g-tier-low', '--tier-gemini low 选出的模型要真的进请求');
+    assert.ok(js.warnings.some((w) => /本轮档位名与来源尚未入档.*--tier-gemini low/.test(w.detail)), JSON.stringify(js.warnings));
+  } finally {
+    await cli(fx.root, ['review', '--cancel', js.run_id], STUB);
+  }
+});
diff --git a/test/unit/tier-flags.test.ts b/test/unit/tier-flags.test.ts
new file mode 100644
index 00000000..ba84cfa3
--- /dev/null
+++ b/test/unit/tier-flags.test.ts
@@ -0,0 +1,103 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { defaultConfig } from '../../src/trivium/config.js';
+import { TIER_NAMES } from '../../src/trivium/adapters/base.js';
+import { ALL_AGENT_IDS } from '../../src/trivium/agents/registry.js';
+import { assertModelOverrideKeys } from '../../src/trivium/critics.js';
+import { EXIT } from '../../src/trivium/exit-codes.js';
+import {
+  assertTierFlags,
+  collectTierFlags,
+  mergeCliOverrides,
+  tierFlagNames,
+  vendorProfileAgents,
+  type RawTierFlags,
+} from '../../src/trivium/tier-flags.js';
+
+/*
+ * M11 第 5 步：档位命令行旗标的收集、键校验、取值校验与合并（设计 7.1「档位旗标」；计划 r2 §2.1、§3.1）。
+ * 这一层只管形状；原生枚举、本机名单与过渡闸在 `checkTierCombos`（见 tier-resolve.test.ts 的 F 组）。
+ */
+
+const PICKED = ['codex', 'gemini', 'glm'];
+const raw = (over: Partial<RawTierFlags> = {}): RawTierFlags => ({ tier: {}, effort: {}, profile: {}, ...over });
+const usage = (fn: () => unknown, re: RegExp): void => {
+  assert.throws(fn, (e: { code?: number; message: string }) => {
+    assert.equal(e.code, EXIT.USAGE);
+    assert.match(e.message, re);
+    return true;
+  });
+};
+
+test('K1 收集面是全部已登记 Agent；没写的不出现；写了空串的出现为空串（计划三审 AGY-02）', () => {
+  const names = tierFlagNames();
+  for (const id of ALL_AGENT_IDS) {
+    for (const k of ['tier', 'effort', 'profile']) assert.ok(names.includes(`${k}-${id}`), `缺 ${k}-${id}`);
+  }
+  const given: Record<string, string> = { 'tier-gemini': 'high', 'effort-codex': '', 'profile-glm': 'x' };
+  const r = collectTierFlags((n) => given[n]);
+  assert.deepEqual(r, { tier: { gemini: 'high' }, effort: { codex: '' }, profile: { glm: 'x' } });
+});
+
+test('K2 键校验与 --model-〈id〉 同一份判定：能入选未入选列本轮入选并给 --critics 出口；Driver 自己列当前可用', () => {
+  const cfg = defaultConfig();
+  for (const k of ['tier', 'effort', 'profile'] as const) {
+    usage(() => assertTierFlags(cfg, 'claude', raw({ [k]: { glm: 'high' } }), ['codex', 'gemini']),
+      new RegExp(`--${k}-glm：glm 本轮没有入选[\\s\\S]*本轮入选：codex \\| gemini[\\s\\S]*--critics`));
+    usage(() => assertTierFlags(cfg, 'claude', raw({ [k]: { claude: 'high' } }), PICKED),
+      new RegExp(`--${k}-claude：它是本轮的 Driver[\\s\\S]*当前可用`));
+  }
+});
+
+test('K3 --model-〈id〉 既有文案逐字不变（参数化之后的回归锁）', () => {
+  const cfg = defaultConfig();
+  assert.throws(() => assertModelOverrideKeys(cfg, 'claude', ['glm'], ['codex', 'gemini']), (e: Error) => {
+    assert.equal(
+      e.message,
+      '--model-glm：glm 本轮没有入选，为它指定的模型不会生效。\n' +
+        '  本轮入选：codex | gemini\n' +
+        '  要让它参审，请用 --critics 把它列进来；否则去掉这个旗标。',
+    );
+    return true;
+  });
+  assert.throws(() => assertModelOverrideKeys(cfg, 'claude', ['claude'], PICKED), (e: Error) => {
+    assert.match(e.message, /^--model-claude：它是本轮的 Driver（执笔者），不能同时充当审核者，不能为它指定模型。\n {2}当前可用：/);
+    return true;
+  });
+});
+
+test('K4 --profile-〈id〉 只对带厂商 profile 概念的侧成立；给别家退 64 并点明不是 --profile 档位表名', () => {
+  const cfg = defaultConfig();
+  assert.deepEqual(vendorProfileAgents(), ['codex'], '前提：今天只有 codex 实现了 vendorProfilesFor');
+  usage(() => assertTierFlags(cfg, 'claude', raw({ profile: { gemini: 'x' } }), PICKED),
+    /--profile-gemini：gemini 没有厂商 profile 概念[\s\S]*不是 trivium 的 --profile 〈档位表名〉[\s\S]*可用：--profile-codex/);
+  assert.deepEqual(assertTierFlags(cfg, 'claude', raw({ profile: { codex: 'deepseek' } }), PICKED), { codex: { vendorProfile: 'deepseek' } });
+});
+
+test('K5 --tier 只收三档名；三类旗标写了不给值都退 64', () => {
+  const cfg = defaultConfig();
+  usage(() => assertTierFlags(cfg, 'claude', raw({ tier: { gemini: 'ultra' } }), PICKED), /--tier-gemini 只接受 low \| medium \| high，收到：ultra/);
+  usage(() => assertTierFlags(cfg, 'claude', raw({ tier: { gemini: '' } }), PICKED), /--tier-gemini 需要一个值/);
+  usage(() => assertTierFlags(cfg, 'claude', raw({ effort: { codex: '' } }), PICKED), /--effort-codex 需要一个值/);
+  usage(() => assertTierFlags(cfg, 'claude', raw({ profile: { codex: '' } }), PICKED), /--profile-codex 需要一个值/);
+  assert.deepEqual(
+    assertTierFlags(cfg, 'claude', raw({ tier: { gemini: 'low' }, effort: { codex: 'max' } }), PICKED),
+    { gemini: { tier: 'low' }, codex: { effort: 'max' } },
+  );
+});
+
+test('K6 mergeCliOverrides：模型与三类旗标逐侧合并、互不覆盖；没给的侧不出现', () => {
+  assert.deepEqual(
+    mergeCliOverrides({ gemini: 'g-x' }, { gemini: { tier: 'high' }, codex: { effort: 'max', vendorProfile: 'kimi' } }),
+    { gemini: { model: 'g-x', tier: 'high' }, codex: { effort: 'max', vendorProfile: 'kimi' } },
+  );
+  assert.deepEqual(mergeCliOverrides({}, {}), {});
+  assert.deepEqual(mergeCliOverrides({ glm: 'GLM-5.3' }), { glm: { model: 'GLM-5.3' } });
+});
+
+test('K7 三档清单只有一份：旗标层用的就是 base.ts 导出的 TIER_NAMES（计划三审 GLM-03）', () => {
+  assert.deepEqual([...TIER_NAMES], ['low', 'medium', 'high']);
+  for (const t of TIER_NAMES) {
+    assert.deepEqual(assertTierFlags(defaultConfig(), 'claude', raw({ tier: { glm: t } }), PICKED), { glm: { tier: t } });
+  }
+});
