+    const a = await cli(root, [
+      'review', '--start', '--entry', 'B', '--stage', 'plan',
+      '--topic', TOPIC, '--focus', '看边界', '--critics', DEFAULT_DRIVER,
+    ]);
+    assert.equal(a.code, EXIT.USAGE, `${a.stdout}${a.stderr}`);
