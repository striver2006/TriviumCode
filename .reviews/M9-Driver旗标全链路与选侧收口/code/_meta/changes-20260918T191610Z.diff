+    // 显式写出同一家：接线之后这条走的是「用户给的 driver」，不是缺省值
+    const b = await cli(root, [
+      'review', '--start', '--entry', 'B', '--stage', 'plan',
+      '--topic', TOPIC, '--focus', '看边界',
+      '--driver', DEFAULT_DRIVER, '--critics', DEFAULT_DRIVER,
